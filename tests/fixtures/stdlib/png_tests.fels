// std.png, as `#test` functions: `fels test` runs them natively and on the comptime VM
// (tests/compiler/std_tests.zig). The images are a small encoder's (every color type and bit
// depth, every filter, Adam7, transparency keys) and Pillow's, each with the CRC-32 of the RGBA
// pixels it stands for, as a script computed them.
#import std.heap as heap;
#import std.hash as hash;
#import std.png as png;

// `data` in the arena, as a file read with fs::read_all is.
copy :: fn(a: *heap::Arena, data: []const u8) -> []const u8 {
    out := a.alloc_bytes(data.len);
    for k in 0..data.len { out[k] = data[k]; }
    return out;
}

#test
every_kind_of_png :: fn(t: *Test) {
    a := heap::make();
    for k in 0..SHOTS.len {
        s := SHOTS[k];
        img := png::decode(&a, copy(&a, image_data(k))) catch err { t.fatal("decode"); return; };
        t.eq(img.width, s.width);
        t.eq(img.height, s.height);
        t.eq(hash::crc32(img.pixels), s.crc);
        t.eq(img.at(0, 0), s.first);
    }
    a.deinit();
}

#test
written_and_read_back :: fn(t: *Test) {
    a := heap::make();
    img := png::image(&a, 31, 17);
    for y in 0..17 {
        for x in 0..31 {
            o := (y * 31 + x) * 4;
            img.pixels[o] = (x * 8) as u8;
            img.pixels[o + 1] = (y * 15) as u8;
            img.pixels[o + 2] = ((x * y) % 256) as u8;
            img.pixels[o + 3] = if x == 3 { 128 } else { 255 };
        }
    }
    bytes := png::encode(&a, img, 6);
    back := png::decode(&a, bytes) catch err { t.fatal("decode"); return; };
    t.eq(back.width, 31u32);
    t.eq(back.pixels, img.pixels);
    // all opaque: written as RGB, read back the same
    for y in 0..17 { img.pixels[(y * 31 + 3) * 4 + 3] = 255; }
    rgb := png::encode(&a, img, 9);
    t.eq(rgb[25], 2u8);                      // the color type in IHDR
    back2 := png::decode(&a, rgb) catch err { t.fatal("decode rgb"); return; };
    t.eq(back2.pixels, img.pixels);
    a.deinit();
}

#test
damaged_files :: fn(t: *Test) {
    a := heap::make();
    r1 := png::decode(&a, "GIF89a not a png") catch err {
        t.expect(err == .not_png);
        yield png::image(&a, 1, 1);
    };
    bad := a.alloc_bytes(GRAY2.len);
    for k in 0..GRAY2.len { bad[k] = GRAY2[k]; }
    bad[20] = bad[20] ^ 1;                   // inside IHDR: its CRC fails
    r2 := png::decode(&a, bad) catch err {
        t.expect(err == .corrupt);
        yield png::image(&a, 1, 1);
    };
    a.deinit();
}


image_data :: fn(k: usize) -> []const u8 {
    if k == 0 { return GRAY1_I[:]; }
    if k == 1 { return GRAY2[:]; }
    if k == 2 { return GRAY4_I_T[:]; }
    if k == 3 { return GRAY16_T[:]; }
    if k == 4 { return RGB8_I_T[:]; }
    if k == 5 { return RGB16[:]; }
    if k == 6 { return PAL2_T[:]; }
    if k == 7 { return PAL8_I[:]; }
    if k == 8 { return GA8[:]; }
    if k == 9 { return GA16_I[:]; }
    if k == 10 { return RGBA8_I[:]; }
    if k == 11 { return RGBA16[:]; }
    if k == 12 { return ONE[:]; }
    if k == 13 { return PIL_RGBA[:]; }
    if k == 14 { return PIL_PAL[:]; }
    if k == 15 { return PIL_L[:]; }
    return "";
}

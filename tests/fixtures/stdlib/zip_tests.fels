// std.zip, and std.flate's compression, as `#test` functions: `fels test` runs them natively and
// on the comptime VM (tests/compiler/std_tests.zig). PY_ZIP was made by Python's zipfile.
#import std.heap as heap;
#import std.strings as strings;
#import std.flate as flate;
#import std.zip as zip;

text_of :: fn(a: *heap::Arena) -> []const u8 {
    sb := strings::builder(a);
    words: [6][]const u8 = .{ "zip", "deflate", "huffman", "window", "length ", "distance\n" };
    for i in 0..600 { sb.append(words[(i * 7 + i / 5) % 6]); }
    return sb.str();
}

#test
deflate_round_trips :: fn(t: *Test) {
    a := heap::make();
    text := text_of(&a);
    levels: [4]u32 = .{ 0, 1, 6, 9 };
    for lv in levels {
        c := flate::deflate(&a, text, lv);
        back := flate::inflate(&a, c) catch err { yield "?"; };
        t.eq(back, text);
        if lv > 0 { t.expect(c.len * 4 < text.len); }
    }
    g := flate::gunzip(&a, flate::gzip(&a, text, 6)) catch err { yield "?"; };
    t.eq(g, text);
    z := flate::unzlib(&a, flate::zlib(&a, text, 9)) catch err { yield "?"; };
    t.eq(z, text);
    e := flate::inflate(&a, flate::deflate(&a, "", 6)) catch err { yield "?"; };
    t.eq(e.len, 0usize);
    a.deinit();
}

// PY_ZIP in the arena, as a file read with fs::read_all is (on the comptime VM a slice of
// static data cannot be kept in arena memory, which the entries' names would be).
py_zip :: fn(a: *heap::Arena) -> []const u8 {
    out := a.alloc_bytes(PY_ZIP.len);
    for k in 0..PY_ZIP.len { out[k] = PY_ZIP[k]; }
    return out;
}

#test
reading_a_python_zip :: fn(t: *Test) {
    a := heap::make();
    ar := zip::open(&a, py_zip(&a)) catch err { t.fatal("open"); return; };
    t.eq(ar.entries.len, 4usize);
    if ar.find("hello.txt") |e| {
        t.eq(e.method, 8u16);
        body := ar.read(&a, e) catch err { yield "?"; };
        t.eq(body.len, 240usize);
        t.eq(body[0..12], "Hello, zip! ");
        t.eq(e.modified(), 1710505844i64);       // 2024-03-15 12:30:44
    } else { t.expect(false); }
    if ar.find("dir/") |d| { t.expect(d.is_dir); } else { t.expect(false); }
    if ar.find("dir/raw.bin") |r| {
        raw := ar.read(&a, r) catch err { yield "?"; };
        t.eq(raw.len, 256usize);
        t.eq(raw[255], 255u8);
    } else { t.expect(false); }
    if ar.find("gr\u{fc}\u{df}e.txt") |g| {
        body := ar.read(&a, g) catch err { yield "?"; };
        t.eq(body, "Gr\u{fc}\u{df}e aus der Datei");
    } else { t.expect(false); }
    a.deinit();
}

#test
writing_and_reading_back :: fn(t: *Test) {
    a := heap::make();
    text := text_of(&a);
    w := zip::writer(&a);
    w.add("a.txt", text, 6);
    w.add("b.txt", "short", 6);              // too short to gain: stored
    w.add_dir("sub");
    w.add_at("sub/c.txt", text[0..100], 0, 1710505844);
    bytes := w.finish();
    ar := zip::open(&a, bytes) catch err { t.fatal("open"); return; };
    t.eq(ar.entries.len, 4usize);
    t.eq(ar.entries[0].method, 8u16);
    t.eq(ar.entries[1].method, 0u16);
    t.expect(ar.entries[2].is_dir);
    t.eq(ar.entries[2].name, "sub/");
    t.eq(ar.entries[3].modified(), 1710505844i64);
    for e in ar.entries {
        body := ar.read(&a, e) catch err { yield "?"; };
        if e.name == "a.txt" { t.eq(body, text); }
        if e.name == "b.txt" { t.eq(body, "short"); }
        if e.name == "sub/c.txt" { t.eq(body, text[0..100]); }
    }
    // damage: a changed byte in the stored entry
    broken := a.alloc_bytes(bytes.len);
    for k in 0..bytes.len { broken[k] = bytes[k]; }
    at := (ar.entries[1].header_offset as usize) + 30 + 5;
    broken[at] = broken[at] ^ 1;
    br := zip::open(&a, broken) catch err { t.fatal("open broken"); return; };
    r := br.read(&a, br.entries[1]) catch err {
        t.expect(err == .bad_checksum);
        yield "";
    };
    nz := zip::open(&a, "not a zip at all, really") catch err {
        t.expect(err == .not_zip);
        yield br;
    };
    a.deinit();
}


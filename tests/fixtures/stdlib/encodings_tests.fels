// std.base32 and std.leb128, as `#test` functions: `fels test` runs them natively and on the
// comptime VM (tests/compiler/std_tests.zig). The data at the end is from Python (base64's
// b32encode and b32hexencode; LEB128 written out by hand there): RFC 4648's strings and random
// bytes and numbers.
#import std.heap as heap;
#import std.hex as hex;
#import std.base32 as base32;
#import std.leb128 as leb128;

B32Case :: struct { bytes: []const u8, std: []const u8, hex: []const u8 }
UCase :: struct { v: u64, bytes: []const u8 }
SCase :: struct { v: i64, bytes: []const u8 }

NO_U: leb128::Unsigned = .{ 9, 9 };
NO_S: leb128::Signed = .{ 9, 9 };

#test
base32_both_ways :: fn(t: *Test) {
    a := heap::make();
    std_np := base32::STANDARD_NO_PAD;
    hex_c := base32::HEX;
    for c in B32 {
        raw := hex::decode_in(&a, c.bytes) catch err { yield ""; };
        t.eq(base32::encode_in(&a, raw), c.std);
        t.eq(hex_c.encode_in(&a, raw), c.hex);
        t.eq(base32::decode_in(&a, c.std) catch err { yield "?"; }, raw);
        t.eq(hex_c.decode_in(&a, c.hex) catch err { yield "?"; }, raw);
        // without the padding
        n := c.std.len;
        while n > 0 && c.std[n - 1] == '=' { n -= 1; }
        t.eq(std_np.encode_in(&a, raw), c.std[0..n]);
        t.eq(std_np.decode_in(&a, c.std[0..n]) catch err { yield "?"; }, raw);
    }
    a.deinit();
}

#test
base32_refuses :: fn(t: *Test) {
    a := heap::make();
    t.eq(base32::decode_in(&a, "mzxw6ytb") catch err { yield "?"; }, "fooba");   // lowercase
    bad := false;
    r1 := base32::decode_in(&a, "MZXW6") catch err {
        bad = err == .invalid_length;              // padding left out
        yield "";
    };
    t.expect(bad);
    bad = false;
    r2 := base32::decode_in(&a, "MZXW1===") catch err {
        bad = err == .invalid_character;           // 1 is not in the alphabet
        yield "";
    };
    t.expect(bad);
    bad = false;
    r3 := base32::decode_in(&a, "M=======") catch err {
        bad = err == .invalid_length;              // one character holds no byte
        yield "";
    };
    t.expect(bad);
    bad = false;
    std_np := base32::STANDARD_NO_PAD;
    r4 := std_np.decode_in(&a, "MY======") catch err {
        bad = err == .invalid_character;           // padding where there is none
        yield "";
    };
    t.expect(bad);
    bad = false;
    r5 := base32::decode_in(&a, "MZXW6Y==") catch err {
        bad = err == .invalid_length;              // 6 characters: no length has them
        yield "";
    };
    t.expect(bad);
    out: [4]u8 = .{};
    bad = false;
    n := std_np.encode(out[:], "foo") catch err {
        bad = err == .buffer_too_small;
        yield 0usize;
    };
    t.expect(bad);
    a.deinit();
}

#test
leb128_unsigned :: fn(t: *Test) {
    a := heap::make();
    buf: [leb128::MAX_LEN]u8 = .{};
    for c in ULEB {
        want := hex::decode_in(&a, c.bytes) catch err { yield ""; };
        n := leb128::encode_u64(buf[:], c.v) catch err { yield 0usize; };
        t.eq(buf[0..n], want);
        t.eq(leb128::len_u64(c.v), want.len);
        d := leb128::decode_u64(want) catch err { yield NO_U; };
        t.eq(d.value, c.v);
        t.eq(d.len, want.len);
    }
    a.deinit();
}

#test
leb128_signed :: fn(t: *Test) {
    a := heap::make();
    buf: [leb128::MAX_LEN]u8 = .{};
    for c in SLEB {
        want := hex::decode_in(&a, c.bytes) catch err { yield ""; };
        n := leb128::encode_i64(buf[:], c.v) catch err { yield 0usize; };
        t.eq(buf[0..n], want);
        t.eq(leb128::len_i64(c.v), want.len);
        d := leb128::decode_i64(want) catch err { yield NO_S; };
        t.eq(d.value, c.v);
        t.eq(d.len, want.len);
    }
    a.deinit();
}

#test
leb128_refuses :: fn(t: *Test) {
    // a longer form than needed is read; a number past 64 bits, or cut short, is not
    long: [3]u8 = .{ 0x80, 0x80, 0x00 };
    t.eq((leb128::decode_u64(long[:]) catch err { yield NO_U; }).len, 3usize);
    after: [4]u8 = .{ 0x05, 0xff, 0xff, 0xff };
    t.eq((leb128::decode_u64(after[:]) catch err { yield NO_U; }).value, 5u64);
    big: [10]u8 = .{ 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x03 };
    e1 := false;
    r1 := leb128::decode_u64(big[:]) catch err {
        e1 = err == .overflow;
        yield NO_U;
    };
    t.expect(e1);
    cut: [2]u8 = .{ 0x80, 0x80 };
    e2 := false;
    r2 := leb128::decode_i64(cut[:]) catch err {
        e2 = err == .truncated;
        yield NO_S;
    };
    t.expect(e2);
    wrong_sign: [10]u8 = .{ 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x3f };
    e3 := false;
    r3 := leb128::decode_i64(wrong_sign[:]) catch err {
        e3 = err == .overflow;
        yield NO_S;
    };
    t.expect(e3);
    small: [2]u8 = .{};
    e4 := false;
    n := leb128::encode_u64(small[:], 16384) catch err {          // 3 bytes
        e4 = err == .buffer_too_small;
        yield 0usize;
    };
    t.expect(e4);
}


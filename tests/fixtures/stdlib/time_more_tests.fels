// std.time's zones, patterns, RFC 3339 and durations, as `#test` functions: `fels test` runs them
// natively and on the comptime VM (tests/compiler/std_tests.zig). The zone files are
// /usr/share/zoneinfo's Europe/Berlin and Australia/Sydney; the offsets expected are Python's
// zoneinfo on them.
#import std.time as time;
#import std.time.{ DateTime };

check :: fn(t: *Test, data: []const u8, cases: []const Expect) {
    for c in cases {
        z := time::tzif_offset(data, c.secs) catch err { t.fatal("tzif"); return; };
        t.eq(z.seconds, c.offset);
        t.eq(z.dst, c.dst);
    }
}

#test
zones_from_tzif_files :: fn(t: *Test) {
    check(t, BERLIN[:], BERLIN_EXPECT[:]);
    check(t, SYDNEY[:], SYDNEY_EXPECT[:]);
    bad: [4]u8 = .{ 'T', 'Z', 'i', 'x' };
    none: time::ZoneOffset = .{ 0, false };
    r := time::tzif_offset(bad[:], 0) catch err {
        t.expect(err == .bad_zone);
        yield none;
    };
}

#test
posix_rules :: fn(t: *Test) {
    for c in NEW_YORK_EXPECT {
        z := time::posix_offset("EST5EDT,M3.2.0,M11.1.0", c.secs) catch err { t.fatal("posix"); return; };
        t.eq(z.seconds, c.offset);
    }
    india := time::posix_offset("<+0530>-5:30", 0) catch err { t.fatal("india"); return; };
    t.eq(india.seconds, 19800i64);
    u := time::posix_offset("UTC0", 1700000000) catch err { t.fatal("utc"); return; };
    t.eq(u.seconds, 0i64);
}

#test
patterns_and_names :: fn(t: *Test) {
    dt := time::utc(1709302049);                 // 2024-03-01 14:07:29 UTC, a Friday
    buf: [64]u8 = .{};
    t.eq(time::format_datetime(dt, 0, "%Y-%m-%d %H:%M:%S", buf[:]), "2024-03-01 14:07:29");
    t.eq(time::format_datetime(dt, 3600, "%a %e %b %y, %I:%M %p %z", buf[:]), "Fri  1 Mar 24, 02:07 PM +0100");
    t.eq(time::format_datetime(dt, -16200, "%A %B %j %Z 100%%", buf[:]), "Friday March 061 -04:30 100%");
    small: [5]u8 = .{};
    t.eq(time::format_datetime(dt, 0, "%Y-%m-%d", small[:]), "2024-");
    t.eq(time::to_unix(dt), 1709302049i64);
    t.eq(time::to_unix(time::utc(-86401)), -86401i64);
    t.eq(time::weekday_name(0), "Sunday");
    t.eq(time::month_name(12), "December");
}

#test
rfc3339_both_ways :: fn(t: *Test) {
    buf: [40]u8 = .{};
    t.eq(time::format_rfc3339(1709302049, 0, buf[:]), "2024-03-01T14:07:29Z");
    t.eq(time::format_rfc3339(1709302049, 3600, buf[:]), "2024-03-01T15:07:29+01:00");
    t.eq(time::format_rfc3339(1709302049, -34200, buf[:]), "2024-03-01T04:37:29-09:30");
    if time::parse_rfc3339("2024-03-01T15:07:29+01:00") |s| {
        t.eq(s.secs, 1709302049i64);
        t.eq(s.offset, 3600i64);
    } else { t.expect(false); }
    if time::parse_rfc3339("2024-03-01 14:07:29.25z") |s| {
        t.eq(s.secs, 1709302049i64);
        t.eq(s.nanos, 250000000u32);
    } else { t.expect(false); }
    t.expect(time::parse_rfc3339("2024-03-01T14:07:29") == null);
    t.expect(time::parse_rfc3339("2024-02-30T14:07:29Z") == null);
    t.expect(time::parse_rfc3339("2024-03-01T25:07:29Z") == null);
}

#test
durations_both_ways :: fn(t: *Test) {
    buf: [40]u8 = .{};
    t.eq(time::format_duration(80, buf[:]), "80ns");
    t.eq(time::format_duration(12000, buf[:]), "12us");
    t.eq(time::format_duration(1500000, buf[:]), "1.5ms");
    t.eq(time::format_duration(350000000, buf[:]), "350ms");
    t.eq(time::format_duration(4250000000, buf[:]), "4.25s");
    t.eq(time::format_duration(3612000000000, buf[:]), "1h 0m 12s");
    t.eq(time::format_duration(183900000000000, buf[:]), "2d 3h 5m");
    t.eq(time::format_duration(-90000000000, buf[:]), "-1m 30s");
    t.eq(time::parse_duration("1h30m") ?? 0, 5400000000000i64);
    t.eq(time::parse_duration("1.5s") ?? 0, 1500000000i64);
    t.eq(time::parse_duration("2d 4h") ?? 0, 187200000000000i64);
    t.eq(time::parse_duration("-250ms") ?? 0, -250000000i64);
    t.expect(time::parse_duration("5 parsecs") == null);
    t.expect(time::parse_duration("") == null);
}


// std.flate, as `#test` functions: `fels test` runs them natively and on the comptime VM
// (tests/compiler/std_tests.zig). The compressed data is Python's zlib on the texts that
// `fox`, `words` and `big` build here.
#import std.heap as heap;
#import std.hash as hash;
#import std.strings as strings;
#import std.flate as flate;

FOX :: "The quick brown fox jumps over the lazy dog";

// `b' '.join(words[(i * i + 3 * i) % 10] for i in range(400)) + b' the end'`
words :: fn(a: *heap::Arena) -> []const u8 {
    w: [10][]const u8 = .{ "alpha", "beta", "gamma", "delta", "stream", "block", "huffman", "code", "length", "distance" };
    sb := strings::builder(a);
    for i in 0..400 {
        if i > 0 { sb.append(" "); }
        sb.append(w[(i * i + 3 * i) % 10]);
    }
    sb.append(" the end");
    return sb.str();
}

// `bytes((i * 7 + (i // 13)) % 251 for i in range(3000)) + b'tail' * 50`
big :: fn(a: *heap::Arena) -> []const u8 {
    out := a.alloc_bytes(3200);
    for i in 0..3000 { out[i] = ((i * 7 + i / 13) % 251) as u8; }
    for k in 0..50 {
        out[3000 + 4 * k] = 't';
        out[3001 + 4 * k] = 'a';
        out[3002 + 4 * k] = 'i';
        out[3003 + 4 * k] = 'l';
    }
    return out;
}

#test
the_three_kinds_of_block :: fn(t: *Test) {
    a := heap::make();
    s := flate::inflate(&a, STORED[:]) catch err { t.fatal("stored"); return; };
    t.eq(s, FOX);
    f := flate::inflate(&a, FIXED[:]) catch err { t.fatal("fixed"); return; };
    t.eq(f, FOX);
    d := flate::inflate(&a, DYNAMIC[:]) catch err { t.fatal("dynamic"); return; };
    t.eq(d, words(&a));
    b := flate::inflate(&a, BIG[:]) catch err { t.fatal("big"); return; };
    t.eq(b.len, 3200usize);
    t.eq(b, big(&a));
    a.deinit();
}

#test
gzip_and_zlib :: fn(t: *Test) {
    a := heap::make();
    g := flate::gunzip(&a, GZIP[:]) catch err { t.fatal("gunzip"); return; };
    t.eq(g, FOX);
    z := flate::unzlib(&a, ZLIB[:]) catch err { t.fatal("unzlib"); return; };
    t.eq(z, words(&a));
    t.eq(hash::adler32(z), 0x8676d586u32);
    t.eq(hash::adler32("Wikipedia"), 0x11E60398u32);
    a.deinit();
}

expect_error :: fn(t: *Test, got: flate::FlateError, want: flate::FlateError) { t.expect(got == want); }

#test
damaged_data :: fn(t: *Test) {
    a := heap::make();
    // cut short
    r1 := flate::inflate(&a, DYNAMIC[0..20]) catch err {
        expect_error(t, err, .truncated);
        yield "";
    };
    // a changed byte in the data: the checksum catches what decoding does not
    bad: [62]u8 = GZIP;
    bad[20] = bad[20] ^ 0x10;
    r2 := flate::gunzip(&a, bad[:]) catch err {
        t.expect(err == .bad_checksum || err == .bad_code || err == .bad_distance);
        yield "";
    };
    t.eq(r2, "");
    // not gzip at all
    r3 := flate::gunzip(&a, ZLIB[:]) catch err {
        expect_error(t, err, .bad_header);
        yield "";
    };
    // a block of type 3
    three: [2]u8 = .{ 0x07, 0x00 };
    r4 := flate::inflate(&a, three[:]) catch err {
        expect_error(t, err, .bad_block);
        yield "";
    };
    a.deinit();
}


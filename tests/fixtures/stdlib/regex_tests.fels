// std.regex, as `#test` functions: `fels test` runs them natively and on the comptime VM
// (tests/compiler/std_tests.zig). CASES are what Python's re (bytes patterns, so ASCII classes)
// finds: every match of find_all with the span of each group, "s-e" or x for a group that
// took no part.
#import std.heap as heap;
#import std.strings as strings;
#import std.regex as regex;

Case :: struct {
    pattern: []const u8,
    text: []const u8,
    want: []const u8,
}

spans :: fn(a: *heap::Arena, re: *regex::Regex, text: []const u8) -> []const u8 {
    sb := strings::builder(a);
    first := true;
    for m in re.find_all(text) {
        if !first { sb.append(";"); }
        first = false;
        for g in 0..re.group_count() + 1 {
            if g > 0 { sb.append(","); }
            if m.span(g) |sp| {
                sb.append_u64(sp.start as u64);
                sb.append("-");
                sb.append_u64(sp.end as u64);
            } else {
                sb.append("x");
            }
        }
    }
    return sb.str();
}

#test
against_python :: fn(t: *Test) {
    a := heap::make();
    for c in CASES {
        re := regex::compile(&a, c.pattern) catch err {
            t.eq(c.pattern, "compiles");
            continue;
        };
        got := spans(&a, &re, c.text);
        if got != c.want {
            t.eq(c.pattern, "");      // which pattern
            t.eq(got, c.want);
        }
    }
    a.deinit();
}

#test
random_against_python :: fn(t: *Test) {
    a := heap::make();
    bad: usize = 0;
    for c in RANDOM {
        re := regex::compile(&a, c.pattern) catch err {
            bad += 1;
            continue;
        };
        if spans(&a, &re, c.text) != c.want { bad += 1; }
    }
    t.eq(bad, 0usize);
    a.deinit();
}

#test
groups_names_and_replacing :: fn(t: *Test) {
    a := heap::make();
    re := regex::compile(&a, "(?P<y>\\d{4})-(?P<m>\\d\\d)-(\\d\\d)") catch err { t.fatal("compile"); return; };
    if re.find("due 2024-03-15!") |m| {
        t.eq(m.str(), "2024-03-15");
        t.eq(m.start(), 4usize);
        t.eq(m.named("y") ?? "", "2024");
        t.eq(m.group(3) ?? "", "15");
        t.expect(m.group(4) == null);
    } else { t.expect(false); }
    t.eq(re.group_index("m") ?? 0, 2usize);
    t.eq(re.replace_all(&a, "a 2024-03-15 b 1999-12-31", "$3.${m}.${y} ($$)"), "a 15.03.2024 ($) b 31.12.1999 ($)");
    t.expect(re.is_match("x 2000-01-01"));
    t.expect(!re.is_match("x 2000-1-01"));
    sp := regex::compile(&a, "\\s*,\\s*") catch err { t.fatal("compile split"); return; };
    parts := sp.split(&a, "a , b,c ,  d");
    t.eq(parts.len, 4usize);
    t.eq(parts[3], "d");
    a.deinit();
}

#test
runes_and_the_mistakes :: fn(t: *Test) {
    a := heap::make();
    dot := regex::compile(&a, "^.{4}$") catch err { t.fatal("dot"); return; };
    t.expect(dot.is_match("grüß"));                  // four runes, six bytes
    cls := regex::compile(&a, "[äöü]+") catch err { t.fatal("class"); return; };
    if cls.find("Bär und Möwe") |m| { t.eq(m.str(), "ä"); } else { t.expect(false); }
    end := regex::compile(&a, "b\\z") catch err { t.fatal("z"); return; };
    t.expect(end.is_match("ab"));
    t.expect(!end.is_match("ab\n"));
    bad: [6][]const u8 = .{ "(ab", "ab)", "[ab", "*a", "a{3,2}", "\\q" };
    want: [6]regex::RegexError = .{ .unclosed_group, .unmatched_paren, .bad_class, .nothing_to_repeat, .bad_count, .bad_escape };
    for k in 0..6 {
        r := regex::compile(&a, bad[k]) catch err {
            t.expect(err == want[k]);
            continue;
        };
        t.eq(bad[k], "should fail");
    }
    a.deinit();
}

// The cases

CASES: [51]Case = .{
    .{ "abc", "xxabcabcx", "2-5;5-8" },
    .{ "a|b|c", "xaybzc", "1-2;3-4;5-6" },
    .{ "(a|ab)(c|bcd)(d*)", "abcd", "0-4,0-1,1-4,4-4" },
    .{ "x*", "axxb", "0-0;1-3;3-3;4-4" },
    .{ "a*", "baaa", "0-0;1-4;4-4" },
    .{ "a*|b", "b", "0-0;0-1;1-1" },
    .{ "a+?", "aaa", "0-1;1-2;2-3" },
    .{ "[a-c]+", "xxabcbaxyc", "2-7;9-10" },
    .{ "[^a-c]+", "abxyzcab", "2-5" },
    .{ "\\d+", "a12b345c6", "1-3;4-7;8-9" },
    .{ "\\w+", "hi, there_you 42!", "0-2;4-13;14-16" },
    .{ "\\s+", "a \t b\n\nc", "1-4;5-7" },
    .{ "[\\d.]+", "v1.25 and 3.x", "1-5;10-12" },
    .{ "\\bfoo\\b", "foo food afoo foo", "0-3;14-17" },
    .{ "\\Bo\\B", "foo bob", "1-2;5-6" },
    .{ "(?i)hello", "HeLLo hello HELLO", "0-5;6-11;12-17" },
    .{ "(?i)[a-c]+", "xAbCz", "1-4" },
    .{ "^ab", "abab", "0-2" },
    .{ "ab$", "abab", "2-4" },
    .{ "(?m)^\\w+$", "one\ntwo\nthree", "0-3;4-7;8-13" },
    .{ "a{2,3}", "aaaaaaa", "0-3;3-6" },
    .{ "a{2,}", "aaaaa a aa", "0-5;8-10" },
    .{ "a{2}", "aaaaa", "0-2;2-4" },
    .{ "a{0,2}?b", "aab", "0-3" },
    .{ "(\\w+)@(\\w+)\\.com", "mail ann@example.com or bo@x.com", "5-20,5-8,9-16;24-32,24-26,27-28" },
    .{ "(a)|(b)", "ab", "0-1,0-1,x;1-2,x,1-2" },
    .{ "(?:ab)+", "abababx", "0-6" },
    .{ "(a+)+b", "aaaaaaaaaaaaaaaaaaaaaaaaaaac", "" },
    .{ ".*", "one\ntwo", "0-3;3-3;4-7;7-7" },
    .{ "(?s).*", "one\ntwo", "0-7;7-7" },
    .{ "colou?r", "color colour colouur", "0-5;6-12" },
    .{ "<.*?>", "<a><b>", "0-3;3-6" },
    .{ "<.*>", "<a><b>", "0-6" },
    .{ "[\\w.-]+@[\\w-]+\\.\\w+", "to: first.last@my-site.org;", "4-26" },
    .{ "\\x41+", "xAAAy", "1-4" },
    .{ "a\\+b\\.", "a+b. ab.", "0-4" },
    .{ "a{b", "xa{by", "1-4" },
    .{ "((a)(b(c)))", "zabcz", "1-4,1-4,1-2,2-4,3-4" },
    .{ "(?P<y>\\d{4})-(?P<m>\\d\\d)", "on 2024-03 and 1999-12", "3-10,3-7,8-10;15-22,15-19,20-22" },
    .{ "(a*)*", "b", "0-0,0-0;1-1,1-1" },
    .{ "(a*)+", "b", "0-0,0-0;1-1,1-1" },
    .{ "(a|b)*c", "abababc", "0-7,5-6" },
    .{ "[]a]+", "a]]b", "0-3" },
    .{ "[a-]+", "a--b", "0-3" },
    .{ "\\D+", "12ab34", "2-4" },
    .{ "\\W+", "ab, cd", "2-4" },
    .{ "[^\\d\\s]+", "1 ab2 c", "2-4;6-7" },
    .{ "(?:x|xy)(y?)", "xy", "0-2,1-2" },
    .{ "", "ab", "0-0;1-1;2-2" },
    .{ "\\n", "a\nb", "1-2" },
    .{ ".", "a\nb", "0-1;2-3" },
};


// std.float's exp, ln and pow for f64, as `#test` functions: `fels test` runs them natively and on
// the comptime VM (tests/compiler/std_tests.zig).
#import std.float as float;

// Whether `got` is `want` to 12 digits.
close :: fn(got: f64, want: f64) -> bool {
    diff := got - want;
    if diff < 0.0 { diff = -diff; }
    size := want;
    if size < 0.0 { size = -size; }
    if size < 1.0 { size = 1.0; }
    return diff <= size * 0.000000000001;
}

#test
exp_of_known_values :: fn(t: *Test) {
    t.expect(close(float::exp(0.0), 1.0));
    t.expect(close(float::exp(1.0), 2.718281828459045));
    t.expect(close(float::exp(-1.0), 0.36787944117144233));
    t.expect(close(float::exp(10.0), 22026.465794806718));
    t.expect(close(float::exp(-20.0), 0.0000000020611536224385579));
    t.expect(float::exp(-800.0) == 0.0);
}

#test
ln_of_known_values :: fn(t: *Test) {
    t.expect(close(float::ln(1.0), 0.0));
    t.expect(close(float::ln(2.718281828459045), 1.0));
    t.expect(close(float::ln(10.0), 2.302585092994046));
    t.expect(close(float::ln(0.001), -6.907755278982137));
    t.expect(close(float::ln(1000000.0), 13.815510557964274));
    t.expect(float::ln(0.0) < -1000000.0);
}

#test
powers :: fn(t: *Test) {
    t.expect(close(float::pow(2.0, 10.0), 1024.0));
    t.expect(close(float::pow(1.1, 365.0 / 182.0), 1.2106338215370842));
    t.expect(close(float::pow(1.05, 0.5), 1.0246950765959599));
    t.expect(close(float::pow(-2.0, 3.0), -8.0));
    t.expect(close(float::pow(-2.0, 2.0), 4.0));
    t.expect(float::pow(5.0, 0.0) == 1.0);
    t.expect(float::pow(0.0, 3.0) == 0.0);
}

// std.decimal, as `#test` functions: `fels test` runs them natively and on the comptime VM
// (tests/compiler/std_tests.zig). CASES are random and hand-picked numbers with the results
// Python's decimal module gives for them, written out by a script.
#import std.heap as heap;
#import std.strings as strings;
#import std.decimal as decimal;
#import std.decimal.{ Decimal, Rounding };

// op: 0 add, 1 sub, 2 mul, 3 div(a, b, scale, mode), 4 round(a, scale, mode)
Case :: struct {
    op: u8,
    a: []const u8,
    b: []const u8,
    scale: u32,
    mode: u8,
    want: []const u8,
}

mode_of :: fn(m: u8) -> Rounding {
    if m == 0 { return .half_even; }
    if m == 1 { return .half_up; }
    if m == 2 { return .half_down; }
    if m == 3 { return .down; }
    if m == 4 { return .up; }
    if m == 5 { return .floor; }
    return .ceiling;
}

run :: fn(c: Case, buf: []u8) -> []const u8 {
    a := decimal::parse(c.a) catch err { return "bad a"; };
    b := decimal::parse(c.b) catch err { return "bad b"; };
    r := decimal::zero();
    ok := true;
    failure: []const u8 = "";
    if c.op == 0 { r = decimal::add(a, b) catch err { ok = false; failure = if err == .overflow { "overflow" } else { "?" }; yield r; }; }
    if c.op == 1 { r = decimal::sub(a, b) catch err { ok = false; failure = if err == .overflow { "overflow" } else { "?" }; yield r; }; }
    if c.op == 2 { r = decimal::mul(a, b) catch err { ok = false; failure = if err == .overflow { "overflow" } else { "?" }; yield r; }; }
    if c.op == 3 {
        r = decimal::div(a, b, c.scale, mode_of(c.mode)) catch err {
            ok = false;
            failure = if err == .overflow { "overflow" } else if err == .division_by_zero { "division_by_zero" } else { "?" };
            yield r;
        };
    }
    if c.op == 4 { r = decimal::round(a, c.scale, mode_of(c.mode)) catch err { ok = false; failure = if err == .overflow { "overflow" } else { "?" }; yield r; }; }
    if !ok { return failure; }
    return decimal::to_text(r, buf);
}

#test
against_python :: fn(t: *Test) {
    bad: usize = 0;
    for c in CASES {
        buf: [48]u8 = .{};
        got := run(c, buf[:]);
        if got != c.want {
            bad += 1;
            t.eq(got, c.want);   // shows the pair; the case is the one before in the list
        }
    }
    t.eq(bad, 0usize);
}

#test
text_both_ways :: fn(t: *Test) {
    buf: [48]u8 = .{};
    p := decimal::parse("-12.50") catch err { t.fatal("parse"); return; };
    t.eq(p.coef, -1250i64);
    t.eq(p.scale, 2u32);
    t.eq(decimal::to_text(p, buf[:]), "-12.50");
    e := decimal::parse("2.5E-3") catch err { t.fatal("exponent"); return; };
    t.eq(decimal::to_text(e, buf[:]), "0.0025");
    k := decimal::parse("1e3") catch err { t.fatal("1e3"); return; };
    t.eq(decimal::to_text(k, buf[:]), "1000");
    h := decimal::parse(".5") catch err { t.fatal(".5"); return; };
    t.eq(decimal::to_text(h, buf[:]), "0.5");
    bad := decimal::parse("1.2.3") catch err {
        t.expect(err == .invalid);
        yield decimal::zero();
    };
    long := decimal::parse("0.1234567890123456789") catch err {
        t.expect(err == .overflow);
        yield decimal::zero();
    };
    n := decimal::normalize(decimal::parse("2.500") catch err { yield decimal::zero(); });
    t.eq(decimal::to_text(n, buf[:]), "2.5");
}

#test
the_classic :: fn(t: *Test) {
    a := decimal::parse("0.1") catch err { t.fatal("0.1"); return; };
    b := decimal::parse("0.2") catch err { t.fatal("0.2"); return; };
    c := decimal::add(a, b) catch err { t.fatal("add"); return; };
    t.expect(decimal::eq(c, decimal::parse("0.3") catch err { yield decimal::zero(); }));
    t.expect(decimal::cmp(decimal::parse("2.50") catch err { yield c; }, decimal::parse("2.5") catch err { yield c; }) == 0);
    t.expect(decimal::less(decimal::parse("-3") catch err { yield c; }, decimal::parse("-2.99") catch err { yield c; }));
    xs: [3]Decimal = .{ a, b, c };
    s := decimal::sum(xs[:]) catch err { yield c; };
    buf: [48]u8 = .{};
    t.eq(decimal::to_text(s, buf[:]), "0.6");
    f := decimal::from_f64(19.99, 2) catch err { yield c; };
    t.eq(f.coef, 1999i64);
    t.expect(decimal::to_f64(f) > 19.98 && decimal::to_f64(f) < 20.0);
}


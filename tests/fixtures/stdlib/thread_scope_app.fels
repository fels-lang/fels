// Threads that end with a block: a `zone` of kind thread::Scope runs closures on threads and
// joins them where it ends; thread::Pool spreads a loop over worker threads; a sync::Channel
// carries values between them. What a closure captures is checked (`#spawns`): an Atomic and
// a Channel are shared through pointers, `Pool.each` gives each call an item of its own, and
// `unsafe` lets threads write a slice at places no two of them share.
#import std.thread as thread;
#import std.sync as sync;
#import std.atomics.{ Atomic };
#import std.heap as heap;

// The threads of a scope are joined on the way out of a `return` too.
count_until :: fn(stop: usize, hits: *Atomic(u64)) -> usize {
    zone s: thread::Scope {
        for i in 0..8 {
            if i == stop { return i; }
            s.spawn(fn() {
                thread::sleep(5);
                ign := hits.add(1);
            });
        }
    }
    return 8;
}

main :: fn() -> i32 {
    // Scope: each closure has its own `i`, kept in the zone.
    total: Atomic(u64) = .{ 0 };
    t := &total;
    zone s: thread::Scope {
        for i in 0..16 {
            s.spawn(fn() { ign := t.add(i as u64); });
        }
    }
    if total.get() != 120 { return 1; }

    // ... and a return out of the zone waits for the threads already started.
    hits: Atomic(u64) = .{ 0 };
    if count_until(3, &hits) != 3 || hits.get() != 3 { return 2; }

    // Pool: a range, items of their own, and many small jobs one after another.
    a := heap::make();
    defer a.deinit();
    prices := heap::alloc(f64, &a, 1000);
    for i in 0..1000 { prices[i] = i as f64; }
    sum: Atomic(u64) = .{ 0 };
    sp := &sum;
    rate := 2.0;
    zone pool: thread::Pool {
        pool.each(f64, prices, fn(p: *f64) { *p = *p * rate; });
        pool.range(0, 1000, fn(i: usize) { ign := sp.add(i as u64); });
        for n in 0..200 { pool.range(0, n % 5, fn(i: usize) { ign := sp.add(1); }); }
    }
    if prices[999] != 1998.0 || prices[0] != 0.0 { return 3; }
    // 0 + 1 + ... + 999, and 40 rounds of 0 + 1 + 2 + 3 + 4 jobs
    if sum.get() != 499500 + 400 { return 4; }

    // parallel: one loop on a pool of its own.
    seen: Atomic(u64) = .{ 0 };
    sn := &seen;
    thread::parallel(10, 20, fn(i: usize) { ign := sn.add(i as u64); });
    if seen.get() != 145 { return 5; }

    // Channel: four workers square what one producer sends; main adds the squares up.
    jobs := sync::channel(u64, &a, 8);
    results := sync::channel(u64, &a, 8);
    j := &jobs;
    r := &results;
    squares: u64 = 0;
    zone w: thread::Scope {
        for k in 0..4 {
            w.spawn(fn() { while j.recv() |n| { ok := r.send(n * n); } });
        }
        w.spawn(fn() {
            for n in 1..101 { ok := j.send(n as u64); }
            j.close();
        });
        for k in 0..100 {
            if r.recv() |v| { squares += v; }
        }
    }
    if squares != 338350 { return 6; }

    // Threads that write a slice at places of their own, as `unsafe` says.
    out: [8]u64 = .{};
    o := out[:];
    zone d: thread::Scope {
        for i in 0..8 {
            unsafe { d.spawn(fn() { o[i] = (i as u64) * 3; }); }
        }
    }
    if out[7] != 21 || out[1] != 3 { return 7; }
    return 42;
}

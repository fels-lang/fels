// Cross-module exercise of std.vec (generic `Vec(T)` on an Arena) — regression
// coverage for issue #6 and the surrounding generic/collision fixes, carried over from
// std.list, which Vec replaces:
//   * a generic STRUCT instantiated across a module boundary substitutes its
//     field type params (`data: []T` → `[]i32`, `value`-style scalar fields),
//   * `vec::make` colliding with `heap::make` (same bare name in two modules)
//     routes to the right function and doesn't corrupt sibling generic bodies,
//   * field type names in the template (`region: *Arena`) resolve in the module
//     that DEFINES `Vec`, even though the caller imports `Arena` as `heap::Arena`.
// Returns 42 iff every operation produced the expected value (exit codes are
// 8-bit, so we self-check rather than returning a large running total).
#import std.heap as heap;
#import std.vec as vec;

#entry
main :: fn() -> i32 {
    a := heap::make();
    ok: i32 = 0;

    xs := vec::make(i32, &a);
    for i in 0..10 { xs.push(i * i); }                        // grows past the initial capacity
    if xs.len() == 10 { ok = ok + 1; }

    sum: i32 = 0;
    for x in xs.items() { sum = sum + x; }
    if sum == 285 { ok = ok + 1; }                            // 0+1+4+...+81

    if xs.get(9) == 81 { ok = ok + 1; }                       // survives the grows
    removed := xs.remove_swap(0);                             // O(1) removal → xs[0] = last = 81
    if xs.get(0) == 81 && removed == 0 { ok = ok + 1; }
    if xs.pop() == 64 { ok = ok + 1; }                        // was xs[8]
    if xs.len() == 8 { ok = ok + 1; }

    // a second, independent Vec(T) + the items() slice view
    ys := vec::with_cap(i32, &a, 2);
    ys.push(5); ys.push(7);
    sl := ys.items();
    if sl.len == 2 && sl[0] + sl[1] == 12 { ok = ok + 1; }

    if ok == 7 { return 42; }
    return ok;
}

// std.cbor, as `#test` functions: `fels test` runs them natively and on the comptime VM
// (tests/compiler/std_tests.zig). The data at the end is from Python: an encoder of RFC 8949's
// preferred serialization (checked against the RFC's examples) and struct's packing of floats.
#import std.heap as heap;
#import std.hex as hex;
#import std.strings as strings;
#import std.cbor as cbor;

IntCase :: struct { v: i64, cbor: []const u8 }
// `special`: 1 infinity, 2 minus infinity, 3 -0.0, 4 NaN; else `v`
FloatCase :: struct { v: f64, special: u8, cbor: []const u8 }
TextCase :: struct { text: []const u8, cbor: []const u8 }

float_of :: fn(c: FloatCase) -> f64 {
    big := 1e308;
    if c.special == 1 { return big * 10.0; }
    if c.special == 2 { return -(big * 10.0); }
    if c.special == 3 { return -c.v; }
    if c.special == 4 { return big * 10.0 - big * 10.0; }
    return c.v;
}

#test
integers :: fn(t: *Test) {
    a := heap::make();
    for c in INTS {
        sb := strings::builder(&a);
        e := cbor::writer(&sb);
        e.int(c.v);
        t.eq(hex::encode_in(&a, strings::str(&sb)), c.cbor);
        bytes := hex::decode_in(&a, c.cbor) catch err { yield ""; };
        r := cbor::reader(bytes);
        it := r.next() catch err { t.fatal("next"); return; };
        t.eq(it.as_i64() ?? 7, c.v);
        t.expect(it.kind == (if c.v >= 0 { cbor::Kind.uint } else { cbor::Kind.negint }));
        t.expect(r.at_end());
    }
    sb := strings::builder(&a);
    e := cbor::writer(&sb);
    e.uint(18446744073709551615u64);
    t.eq(hex::encode_in(&a, strings::str(&sb)), "1bffffffffffffffff");
    r := cbor::reader(strings::str(&sb));
    it := r.next() catch err { t.fatal("next"); return; };
    t.eq(it.value, 18446744073709551615u64);
    t.expect(it.as_i64() == null);
    a.deinit();
}

#test
floats :: fn(t: *Test) {
    a := heap::make();
    for c in FLOATS {
        v := float_of(c);
        sb := strings::builder(&a);
        e := cbor::writer(&sb);
        e.float(v);
        t.eq(hex::encode_in(&a, strings::str(&sb)), c.cbor);
        bytes := hex::decode_in(&a, c.cbor) catch err { yield ""; };
        r := cbor::reader(bytes);
        it := r.next() catch err { t.fatal("next"); return; };
        t.expect(it.kind == .float);
        if c.special == 4 {
            t.expect(it.number != it.number);
        } else {
            t.expect(it.number == v);
            t.expect((1.0 / it.number < 0.0) == (1.0 / v < 0.0));     // the sign of a zero too
        }
    }
    a.deinit();
}

#test
texts_and_bytes :: fn(t: *Test) {
    a := heap::make();
    for c in TEXTS {
        sb := strings::builder(&a);
        e := cbor::writer(&sb);
        e.text(c.text);
        t.eq(hex::encode_in(&a, strings::str(&sb)), c.cbor);
        r := cbor::reader(strings::str(&sb));
        it := r.next() catch err { t.fatal("next"); return; };
        t.expect(it.kind == .text);
        t.eq(it.data, c.text);
    }
    sb := strings::builder(&a);
    e := cbor::writer(&sb);
    raw: [4]u8 = .{ 1, 2, 3, 4 };
    e.bytes(raw[:]);
    t.eq(hex::encode_in(&a, strings::str(&sb)), "4401020304");
    a.deinit();
}

#test
nested_and_skipped :: fn(t: *Test) {
    a := heap::make();
    sb := strings::builder(&a);
    e := cbor::writer(&sb);
    // {"a": 1, "b": [2, 3], "c": 1(1363896240), "d": [_ true, null, undefined, simple(16)], "e": h'00ff'}
    e.begin_map(5);
    e.text("a"); e.uint(1);
    e.text("b"); e.begin_array(2); e.uint(2); e.uint(3);
    e.text("c"); e.tag(1); e.uint(1363896240);
    e.text("d"); e.begin_array_indefinite(); e.boolean(true); e.null_value(); e.undefined(); e.simple(16); e.end();
    e.text("e");
    eb: [2]u8 = .{ 0x00, 0xff };
    e.bytes(eb[:]);
    e.finish() catch err { t.fatal("finish"); };
    t.eq(hex::encode_in(&a, strings::str(&sb)), "a561610161628202036163c11a514b67b061649ff5f6f7f0ff61654200ff");

    r := cbor::reader(strings::str(&sb));
    m := r.next() catch err { t.fatal("map"); return; };
    t.expect(m.kind == .map && m.value == 5 && !m.indefinite);
    seen: usize = 0;
    for k in 0..5 {
        key := r.next() catch err { t.fatal("key"); return; };
        t.expect(key.kind == .text);
        if key.data == "c" {
            tg := r.next() catch err { t.fatal("tag"); return; };
            t.expect(tg.kind == .tag && tg.value == 1);
            n := r.next() catch err { t.fatal("tagged"); return; };
            t.eq(n.value, 1363896240u64);
            seen += 1;
        } else if key.data == "d" {
            arr := r.next() catch err { t.fatal("array"); return; };
            t.expect(arr.kind == .array && arr.indefinite);
            b := r.next() catch err { t.fatal("bool"); return; };
            t.expect(b.kind == .boolean && b.value == 1);
            r.skip_contents(arr) catch err { t.fatal("rest"); };        // the rest, and the break
            seen += 1;
        } else {
            r.skip() catch err { t.fatal("skip"); };
        }
    }
    t.eq(seen, 2usize);
    t.expect(r.at_end());

    // RFC 8949's indefinite examples, read over whole
    for x in INDEFINITE {
        bytes := hex::decode_in(&a, x) catch err { yield ""; };
        r2 := cbor::reader(bytes);
        r2.skip() catch err { t.fatal("skip indefinite"); };
        t.expect(r2.at_end());
    }
    a.deinit();
}

#test
refused :: fn(t: *Test) {
    a := heap::make();
    for c in BAD {
        bytes := hex::decode_in(&a, c.cbor) catch err { yield ""; };
        r := cbor::reader(bytes);
        got: u8 = 0;
        r.skip() catch err {
            got = if err == .truncated { 1u8 } else if err == .malformed { 2u8 } else if err == .bad_text { 3u8 } else { 4u8 };
        };
        t.eq(got, c.err);
    }
    deep := a.alloc_bytes(1100);
    for k in 0..1100 { deep[k] = 0x81; }        // [[[[…
    r := cbor::reader(deep);
    too_deep := false;
    r.skip() catch err { too_deep = err == .too_deep; };
    t.expect(too_deep);
    a.deinit();
}

INDEFINITE: [5][]const u8 = .{
    "5f42010243030405ff",                                   // (_ h'0102', h'030405')
    "7f657374726561646d696e67ff",                           // (_ "strea", "ming")
    "9fff",                                                 // [_ ]
    "9f018202039f0405ffff",                                 // [_ 1, [2, 3], [_ 4, 5]]
    "bf61610161629f0203ffff",                               // {_ "a": 1, "b": [_ 2, 3]}
};

// bytes that are no CBOR, and the error: 1 truncated, 2 malformed, 3 bad_text
BadCase :: struct { cbor: []const u8, err: u8 }
BAD: [10]BadCase = .{
    .{ "", 1 },
    .{ "19", 1 },                   // a 2-byte number, cut off
    .{ "1c", 2 },                   // additional information 28
    .{ "1f", 2 },                   // an unsigned number of indefinite length
    .{ "ff", 2 },                   // a break with nothing open
    .{ "f818", 2 },                 // a simple value under 32 in two bytes
    .{ "62c328", 3 },               // not UTF-8
    .{ "44010203", 1 },             // 4 bytes, 3 given
    .{ "830102", 1 },               // an array short of an item
    .{ "a1", 1 },                   // a map with nothing in it
};


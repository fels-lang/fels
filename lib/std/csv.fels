// SPDX-License-Identifier: Apache-2.0
// std.csv: rfc 4180 reader; sep ',' ';' or tab; LF/CRLF; skips empty lines and a bom
// fields are slices of the text; only a quoted field with "" is copied into the arena

#import std.heap.{ Arena, alloc };
#import std.vec as vec;

pub CsvError :: errors {
    unterminated_quote,   // a field in quotes runs to the end of the text
}

QUOTE :: 34u8;
CR :: 13u8;
LF :: 10u8;

// not `Reader`: would clash with std.io's (modules share one type namespace)
pub CsvReader :: struct {
    text: []const u8,
    at: usize,            // where the next record starts
    sep: u8,
    line: usize,          // the line the last record started on, from 1
    breaks: usize,        // the line breaks read so far

    // true once every record is read
    pub done :: fn(self: *Self) -> bool {
        self.skip_empty_lines();
        return self.at >= self.text.len;
    }

    // next record's fields, in `a`; empty when done
    pub next :: fn(self: *Self, a: *Arena) -> [][]const u8 ! CsvError {
        self.skip_empty_lines();
        fields := vec::make([]const u8, a);
        if self.at >= self.text.len { return fields.items(); }
        self.line = self.breaks + 1;
        while true {
            f := self.field(a)?;
            fields.push(f);
            if self.at < self.text.len && self.text[self.at] == self.sep {
                self.at += 1;
                continue;
            }
            break;
        }
        if self.at < self.text.len && self.text[self.at] == CR { self.at += 1; }
        if self.at < self.text.len && self.text[self.at] == LF {
            self.at += 1;
            self.breaks += 1;
        }
        return fields.items();
    }

    skip_empty_lines :: fn(self: *Self) {
        while self.at < self.text.len && (self.text[self.at] == LF || self.text[self.at] == CR) {
            if self.text[self.at] == LF { self.breaks += 1; }
            self.at += 1;
        }
    }

    // one field, up to the separator or end of line
    field :: fn(self: *Self, a: *Arena) -> []const u8 ! CsvError {
        t := self.text;
        if self.at < t.len && t[self.at] == QUOTE {
            start := self.at + 1;
            i := start;
            doubled := false;
            while true {
                if i >= t.len { fail .unterminated_quote; }
                if t[i] == QUOTE {
                    if i + 1 < t.len && t[i + 1] == QUOTE {
                        doubled = true;
                        i += 2;
                        continue;
                    }
                    break;
                }
                if t[i] == LF { self.breaks += 1; }
                i += 1;
            }
            raw := t[start..i];
            // after the closing quote: anything before the separator is left out
            self.at = i + 1;
            self.skip_to_end_of_field();
            if !doubled { return raw; }
            return undouble(raw, a);
        }
        start := self.at;
        self.skip_to_end_of_field();
        return t[start..self.at];
    }

    skip_to_end_of_field :: fn(self: *Self) {
        t := self.text;
        while self.at < t.len && t[self.at] != self.sep && t[self.at] != CR && t[self.at] != LF {
            self.at += 1;
        }
    }
}

// reader over `text`; `sep` 44 ',', 59 ';', 9 tab
pub reader :: fn(text: []const u8, sep: u8) -> CsvReader {
    at: usize = 0;
    if text.len >= 3 && text[0] == 0xEF && text[1] == 0xBB && text[2] == 0xBF { at = 3; }
    r: CsvReader = .{ text, at, sep, 0, 0 };
    return r;
}

// all records, fields in `a`
pub records :: fn(text: []const u8, sep: u8, a: *Arena) -> [][][]const u8 ! CsvError {
    out := vec::make([][]const u8, a);
    r := reader(text, sep);
    while !r.done() {
        row := r.next(a)?;
        out.push(row);
    }
    return out.items();
}

// most common of ';' tab ',' on line 1, outside quotes; ',' if none
pub guess_separator :: fn(text: []const u8) -> u8 {
    semicolons: usize = 0;
    tabs: usize = 0;
    commas: usize = 0;
    quoted := false;
    started := false;
    for c in text {
        if !quoted && (c == LF || c == CR) {
            if started { break; }
            continue;
        }
        started = true;
        if c == QUOTE { quoted = !quoted; }
        if !quoted {
            if c == 59 { semicolons += 1; }
            if c == 9 { tabs += 1; }
            if c == 44 { commas += 1; }
        }
    }
    if semicolons > 0 && semicolons >= tabs && semicolons >= commas { return 59; }
    if tabs > 0 && tabs >= commas { return 9; }
    return 44;
}

// `raw` with "" made ", in `a`
undouble :: fn(raw: []const u8, a: *Arena) -> []const u8 {
    out := alloc(u8, a, raw.len);
    n: usize = 0;
    i: usize = 0;
    while i < raw.len {
        out[n] = raw[i];
        n += 1;
        if raw[i] == QUOTE && i + 1 < raw.len && raw[i + 1] == QUOTE { i += 1; }
        i += 1;
    }
    return out[0..n];
}

// std.slice: fn-pointer predicate helpers over []T (find, count_where, any, all, ...)

// index of the first match, or null
pub find :: fn($T: type, s: []T, pred: fn(T) -> bool) -> ?usize {
    i: usize = 0;
    while i < s.len { if pred(s[i]) { return i; } i += 1; }
    return null;
}

// number of matches
pub count_where :: fn($T: type, s: []T, pred: fn(T) -> bool) -> usize {
    n: usize = 0;
    i: usize = 0;
    while i < s.len { if pred(s[i]) { n += 1; } i += 1; }
    return n;
}

pub any :: fn($T: type, s: []T, pred: fn(T) -> bool) -> bool {
    i: usize = 0;
    while i < s.len { if pred(s[i]) { return true; } i += 1; }
    return false;
}

pub all :: fn($T: type, s: []T, pred: fn(T) -> bool) -> bool {
    i: usize = 0;
    while i < s.len { if !pred(s[i]) { return false; } i += 1; }
    return true;
}

pub each :: fn($T: type, s: []T, f: fn(T)) {
    i: usize = 0;
    while i < s.len { f(s[i]); i += 1; }
}

// dst[i] = f(src[i]) over the shorter length; returns that length
pub map_into :: fn($T: type, $U: type, dst: []U, src: []T, f: fn(T) -> U) -> usize {
    n: usize = src.len;
    if dst.len < n { n = dst.len; }
    i: usize = 0;
    while i < n { dst[i] = f(src[i]); i += 1; }
    return n;
}

// index of the last match, or null
pub rfind :: fn($T: type, s: []T, pred: fn(T) -> bool) -> ?usize {
    i: usize = s.len;
    while i > 0 { i -= 1; if pred(s[i]) { return i; } }
    return null;
}

// plain search/equality (eql, index_of, contains, ...): see std.mem
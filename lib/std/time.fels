// SPDX-License-Identifier: Apache-2.0
// std.time — wall-clock time, a monotonic clock, sleeping, a UTC calendar
// breakdown, calendar dates, the local time zone, patterns (`%Y-%m-%d`), RFC 3339 and durations
// as text. Cross-platform.
//
//   secs := time::unix_seconds();          // seconds since 1970-01-01 UTC
//   dt   := time::utc(secs);               // → DateTime { year, month, day, ... }
//   start := time::now();                  // monotonic Instant
//   time::sleep_ms(16u32);
//   ns := time::since_nanos(start);        // elapsed, never goes backwards
//
//   d := time::date(2024i64, 1i64, 31i64) ?? time::today_utc();
//   e := d.add_months(1i64);               // 2024-02-29: the day is kept inside the month
//   n := d.days_until(e);                  // 29
//
// OS clocks come through the runtime's nanosecond seam (os_wall_nanos,
// os_monotonic_nanos, os_sleep_nanos; windows.fels → kernel32, linux.fels →
// clock_gettime/nanosleep). The UTC breakdown is pure arithmetic (civil-from-days). The local
// zone comes from Windows (os_local_offset), or on Linux from the TZif file `TZ` or
// /etc/localtime names, read here.

#import std.process as process;
#import std.fs as fs;
#import std.io.{ Reader };

// Wall clock (Unix epoch)

// Nanoseconds since 1970-01-01 00:00:00 UTC.
pub unix_nanos :: fn() -> i64 { return os_wall_nanos(); }

// Milliseconds since the Unix epoch.
pub unix_millis :: fn() -> i64 { return os_wall_nanos() / 1000000i64; }

// Whole seconds since 1970-01-01 00:00:00 UTC.
pub unix_seconds :: fn() -> i64 { return os_wall_nanos() / 1000000000i64; }

// Monotonic clock

// A point on the monotonic clock. Compare via `since_*`; never wall-time.
pub Instant :: struct { nanos: i64 }

// Capture the current monotonic instant.
pub now :: fn() -> Instant { r: Instant = .{ os_monotonic_nanos() }; return r; }

// Nanoseconds elapsed since `start` (monotonic — never negative for `start`
// captured in the past).
pub since_nanos :: fn(start: Instant) -> i64 { return os_monotonic_nanos() - start.nanos; }

// Milliseconds elapsed since `start`.
pub since_millis :: fn(start: Instant) -> i64 { return since_nanos(start) / 1000000i64; }

// Fractional seconds elapsed since `start`.
pub since_seconds :: fn(start: Instant) -> f64 {
    return (since_nanos(start) as f64) / 1000000000.0;
}

// Milliseconds on the monotonic clock (handy for frame timing).
pub monotonic_millis :: fn() -> u64 { return (os_monotonic_nanos() / 1000000i64) as u64; }

// Suspend the current thread for at least `millis` milliseconds.
pub sleep_ms :: fn(millis: u32) { os_sleep_nanos((millis as i64) * 1000000i64); }

// UTC calendar breakdown

// A broken-down UTC date and time. `weekday` is 0=Sunday … 6=Saturday.
pub DateTime :: struct {
    year:    i64,
    month:   u8,   // 1–12
    day:     u8,   // 1–31
    hour:    u8,   // 0–23
    minute:  u8,   // 0–59
    second:  u8,   // 0–59
    weekday: u8,   // 0=Sun … 6=Sat
}

// Floor-divide (rounds toward −∞), so pre-epoch times still break down correctly.
fdiv :: fn(a: i64, b: i64) -> i64 {
    q: i64 = a / b;
    if (a % b != 0) && ((a < 0) != (b < 0)) { return q - 1; }
    return q;
}

// The year, month and day of a calendar date.
pub DateParts :: struct {
    year:  i64,
    month: u8,   // 1–12
    day:   u8,   // 1–31
}

// Howard Hinnant's civil-from-days: the date `days` days after 1970-01-01.
parts_from_days :: fn(days: i64) -> DateParts {
    // Shift the epoch to 0000-03-01, so the leap day is the last day of a year.
    z:   i64 = days + 719468;
    era: i64 = fdiv(z, 146097);
    doe: i64 = z - era * 146097;                                  // 0 … 146096
    yoe: i64 = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365; // 0 … 399
    y:   i64 = yoe + era * 400;
    doy: i64 = doe - (365 * yoe + yoe / 4 - yoe / 100);     // 0 … 365
    mp:  i64 = (5 * doy + 2) / 153;                         // 0 … 11
    d:   i64 = doy - (153 * mp + 2) / 5 + 1;             // 1 … 31
    m:   i64 = mp + 3;
    if mp >= 10 { m = mp - 9; }
    if m <= 2 { y = y + 1; }
    out: DateParts = .{ y, m as u8, d as u8 };
    return out;
}

// The other way: the days from 1970-01-01 to `year`-`month`-`day` (which must exist).
days_from_parts :: fn(year: i64, month: i64, day: i64) -> i64 {
    y: i64 = year;
    if month <= 2 { y = year - 1; }
    era: i64 = fdiv(y, 400);
    yoe: i64 = y - era * 400;                                     // 0 … 399
    mp:  i64 = month - 3;                                         // March = 0
    if month <= 2 { mp = month + 9; }
    doy: i64 = (153 * mp + 2) / 5 + day - 1;             // 0 … 365
    doe: i64 = yoe * 365 + yoe / 4 - yoe / 100 + doy;       // 0 … 146096
    return era * 146097 + doe - 719468;
}

// The weekday of the day `days` days after 1970-01-01 (a Thursday): 0=Sunday … 6=Saturday.
weekday_of :: fn(days: i64) -> u8 {
    return (days + 4 - fdiv(days + 4, 7) * 7) as u8;
}

// Break `secs` (seconds since the Unix epoch) into its UTC components.
pub utc :: fn(secs: i64) -> DateTime {
    days:    i64 = fdiv(secs, 86400);
    rem:     i64 = secs - days * 86400;   // 0 … 86399 (floor-correct)
    p := parts_from_days(days);
    out: DateTime = .{
        p.year,
        p.month,
        p.day,
        (rem / 3600) as u8,
        ((rem / 60) % 60) as u8,
        (rem % 60) as u8,
        weekday_of(days),
    };
    return out;
}

// `utc(unix_seconds())` — the current UTC date and time.
pub now_utc :: fn() -> DateTime { return utc(unix_seconds()); }

// Calendar dates

// A day of the Gregorian calendar (also before 1582), as the number of days since
// 1970-01-01; negative before it. Dates compare by their `days`, and `a.days_until(b)` is the
// number of days from one to the other. Make one with `date`, `parse_date` or `today_utc`.
pub Date :: struct {
    days: i64

    // The year, month and day.
    pub parts :: fn(self: *Self) -> DateParts { return parts_from_days(self.days); }
    pub year  :: fn(self: *Self) -> i64 { return parts_from_days(self.days).year; }
    pub month :: fn(self: *Self) -> u8  { return parts_from_days(self.days).month; }
    pub day   :: fn(self: *Self) -> u8  { return parts_from_days(self.days).day; }

    // 0=Sunday … 6=Saturday, as in DateTime.
    pub weekday :: fn(self: *Self) -> u8 { return weekday_of(self.days); }

    // The date `n` days later (earlier for a negative `n`).
    pub add_days :: fn(self: *Self, n: i64) -> Date {
        out: Date = .{ self.days + n };
        return out;
    }

    // The date `n` months later (earlier for a negative `n`). The day stays the same when the
    // month has it, else it becomes the month's last: 2024-01-31 plus one month is 2024-02-29.
    pub add_months :: fn(self: *Self, n: i64) -> Date {
        p := parts_from_days(self.days);
        total: i64 = p.year * 12 + (p.month as i64) - 1 + n;
        y: i64 = fdiv(total, 12);
        m: i64 = total - y * 12 + 1;
        d: i64 = p.day as i64;
        last: i64 = days_in_month(y, m);
        if d > last { d = last; }
        out: Date = .{ days_from_parts(y, m, d) };
        return out;
    }

    // The date `n` years later, as `add_months(12 * n)`: February 29 becomes February 28.
    pub add_years :: fn(self: *Self, n: i64) -> Date { return self.add_months(n * 12i64); }

    // The days from this date to `other`: positive when `other` is later.
    pub days_until :: fn(self: *Self, other: Date) -> i64 { return other.days - self.days; }
}

// Whether `year` has a February 29.
pub is_leap_year :: fn(year: i64) -> bool {
    if year % 4 != 0 { return false; }
    if year % 100 != 0 { return true; }
    return year % 400 == 0;
}

// The number of days of `month` (1–12) in `year`; 0 for a month that does not exist.
pub days_in_month :: fn(year: i64, month: i64) -> i64 {
    if month < 1 || month > 12 { return 0; }
    if month == 2 {
        if is_leap_year(year) { return 29; }
        return 28;
    }
    if month == 4 || month == 6 || month == 9 || month == 11 { return 30; }
    return 31;
}

// The date `year`-`month`-`day`, or null when there is no such day (2023-02-29, month 13).
pub date :: fn(year: i64, month: i64, day: i64) -> ?Date {
    if day < 1 || day > days_in_month(year, month) { return null; }
    out: Date = .{ days_from_parts(year, month, day) };
    return out;
}

// Today's date in UTC.
pub today_utc :: fn() -> Date {
    out: Date = .{ fdiv(unix_seconds(), 86400) };
    return out;
}

// The number made of the `n` digits of `text` from `at`, or -1 when one of them is no digit.
digits_at :: fn(text: []const u8, at: usize, n: usize) -> i64 {
    v: i64 = 0;
    for i in at..at + n {
        c := text[i];
        if c < 48 || c > 57 { return -1; }
        v = v * 10 + ((c - 48) as i64);
    }
    return v;
}

// The date written as `YYYY-MM-DD` (ISO 8601), or null when `text` is not one.
pub parse_date :: fn(text: []const u8) -> ?Date {
    if text.len != 10 || text[4] != 45 || text[7] != 45 { return null; }
    y := digits_at(text, 0, 4);
    m := digits_at(text, 5, 2);
    d := digits_at(text, 8, 2);
    if y < 0 || m < 0 || d < 0 { return null; }
    return date(y, m, d);
}

// Write `d` as `YYYY-MM-DD` into `buf` (10 bytes or more) and return that part of it. Years
// outside 0 … 9999 give an empty text.
pub format_date :: fn(d: Date, buf: []u8) -> []const u8 {
    p := parts_from_days(d.days);
    if buf.len < 10 || p.year < 0 || p.year > 9999 { return buf[0..0usize]; }
    put_digits(buf, 0, 4, p.year);
    buf[4] = 45;
    put_digits(buf, 5, 2, p.month as i64);
    buf[7] = 45;
    put_digits(buf, 8, 2, p.day as i64);
    return buf[0..10usize];
}

// Write `v` with `n` digits, zeros in front, into `buf` from `at`.
put_digits :: fn(buf: []u8, at: usize, n: usize, v: i64) {
    rest: i64 = v;
    i: usize = n;
    while i > 0 {
        i -= 1;
        buf[at + i] = 48 + ((rest % 10) as u8);
        rest = rest / 10;
    }
}

// Back to seconds

/// The seconds since 1970-01-01 of `dt` read as UTC (its weekday is not looked at): the inverse
/// of `utc`.
pub to_unix :: fn(dt: DateTime) -> i64 {
    days := days_from_parts(dt.year, dt.month as i64, dt.day as i64);
    return days * 86400 + (dt.hour as i64) * 3600 + (dt.minute as i64) * 60 + (dt.second as i64);
}

// Names

WEEKDAYS: [7][]const u8 = .{ "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };
MONTHS: [12][]const u8 = .{
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December",
};

/// The English name of weekday `wd` (0 = Sunday), as `DateTime` and `Date.weekday` count them.
pub weekday_name :: fn(wd: u8) -> []const u8 { return WEEKDAYS[(wd % 7) as usize]; }

/// The English name of month `m` (1 = January).
pub month_name :: fn(m: u8) -> []const u8 { return MONTHS[((m + 11) % 12) as usize]; }

// The local time zone

/// What a time zone was at an instant: its offset east of UTC in seconds, and whether that is
/// daylight saving time.
pub ZoneOffset :: struct {
    seconds: i64,
    dst: bool,
}

/// Seconds east of UTC of this machine's time zone at `secs` (seconds since 1970, UTC), with
/// daylight saving time as it was then: 3600 for Berlin in winter, 7200 in summer, -18000 for New
/// York in winter. 0 when the zone is not known (Linux without /etc/localtime, or a `TZ` this
/// cannot read).
pub local_offset :: fn(secs: i64) -> i64 { return os_local_offset_of(secs); }

/// `secs` as the date and time on this machine's clocks: `utc(secs + local_offset(secs))`.
pub local :: fn(secs: i64) -> DateTime { return utc(secs + local_offset(secs)); }

/// The date and time now on this machine's clocks.
pub now_local :: fn() -> DateTime { return local(unix_seconds()); }

#if TARGET.os == .windows {
    os_local_offset_of :: fn(secs: i64) -> i64 { return os_local_offset(secs); }
} else {
    // `TZ` (":Area/City", "Area/City" or a path), else /etc/localtime, read as a TZif file.
    os_local_offset_of :: fn(secs: i64) -> i64 {
        buf: [65536]u8 = .{};
        n := read_zone_file(buf[:]);
        if n == 0 { return 0; }
        z := tzif_offset(buf[0..n], secs) catch err { yield zero_offset(); };
        return z.seconds;
    }

    read_zone_file :: fn(buf: []u8) -> usize {
        env: [256]u8 = .{};
        path: [300]u8 = .{};
        p: []const u8 = "/etc/localtime";
        if process::get_env("TZ", env[:]) |tz| {
            name := tz;
            if name.len > 0 && name[0] == ':' { name = name[1..name.len]; }
            if name.len > 0 && name[0] == '/' {
                p = name;
            } else if name.len > 0 && name.len < 200 {
                prefix := "/usr/share/zoneinfo/";
                for i in 0..prefix.len { path[i] = prefix[i]; }
                for i in 0..name.len { path[prefix.len + i] = name[i]; }
                p = path[0..prefix.len + name.len];
            }
        }
        return read_small_file(p, buf);
    }

    // As much of the file `path` as fits in `buf`; 0 when it cannot be read.
    read_small_file :: fn(path: []const u8, buf: []u8) -> usize {
        f := fs::open(path) catch err { return 0; };
        rd: *Reader = &f;
        n: usize = 0;
        while n < buf.len {
            got := rd.read(buf[n..buf.len]) catch err { yield 0usize; };
            if got == 0 { break; }
            n += got;
        }
        fs::close(&f);
        return n;
    }
}

zero_offset :: fn() -> ZoneOffset {
    z: ZoneOffset = .{ 0, false };
    return z;
}

pub TimeError :: errors {
    bad_zone,     // a TZif file or POSIX TZ rule this cannot read
}

be32 :: fn(b: []const u8, at: usize) -> i64 {
    v := ((b[at] as u32) << 24) | ((b[at + 1] as u32) << 16) | ((b[at + 2] as u32) << 8) | (b[at + 3] as u32);
    return (v as i32) as i64;
}

be64 :: fn(b: []const u8, at: usize) -> i64 {
    v: u64 = 0;
    for k in 0..8 { v = (v << 8) | (b[at + k] as u64); }
    return v as i64;
}

be_count :: fn(b: []const u8, at: usize) -> usize { return be32(b, at) as usize; }

/// The offset at `secs` of the zone a TZif file (RFC 8536, as in /usr/share/zoneinfo) describes.
/// Past its last transition the POSIX rule at its end decides.
pub tzif_offset :: fn(data: []const u8, secs: i64) -> ZoneOffset ! TimeError {
    if data.len < 44 || data[0] != 'T' || data[1] != 'Z' || data[2] != 'i' || data[3] != 'f' { fail .bad_zone; }
    version := data[4];
    // the counts: UT/local indicators, standard/wall indicators, leap seconds, transitions,
    // local time types, abbreviation bytes
    p: usize = 0;
    tsize: usize = 4;
    if version >= '2' {
        // skip the 32-bit part to the 64-bit one
        v1 := 44 + be_count(data, 32) * 5 + be_count(data, 36) * 6 + be_count(data, 40) +
            be_count(data, 28) * 8 + be_count(data, 24) + be_count(data, 20);
        if v1 + 44 > data.len { fail .bad_zone; }
        p = v1;
        tsize = 8;
    }
    isut := be_count(data, p + 20);
    isstd := be_count(data, p + 24);
    leap := be_count(data, p + 28);
    timecnt := be_count(data, p + 32);
    typecnt := be_count(data, p + 36);
    charcnt := be_count(data, p + 40);
    times := p + 44;
    idx := times + timecnt * tsize;
    types := idx + timecnt;
    end := types + typecnt * 6 + charcnt + leap * (tsize + 4) + isstd + isut;
    if typecnt == 0 || end > data.len { fail .bad_zone; }
    // the last transition at or before `secs`
    found: i64 = -1;
    lo: usize = 0;
    hi := timecnt;
    while lo < hi {
        mid := lo + (hi - lo) / 2;
        at := if tsize == 8 { be64(data, times + mid * 8) } else { be32(data, times + mid * 4) };
        if at <= secs { lo = mid + 1; } else { hi = mid; }
    }
    if lo > 0 { found = (lo - 1) as i64; }
    // past the last one, the rule in the footer
    if tsize == 8 && found == (timecnt as i64) - 1 && end + 2 < data.len && data[end] == '\n' {
        f0 := end + 1;
        f1 := f0;
        while f1 < data.len && data[f1] != '\n' { f1 += 1; }
        if f1 > f0 { return posix_offset(data[f0..f1], secs); }
    }
    ti: usize = 0;
    if found >= 0 {
        ti = data[idx + (found as usize)] as usize;
    } else {
        // before the first transition: the first standard-time type, else the first
        for k in 0..typecnt {
            if data[types + k * 6 + 4] == 0 {
                ti = k;
                break;
            }
        }
    }
    if ti >= typecnt { fail .bad_zone; }
    z: ZoneOffset = .{ be32(data, types + ti * 6), data[types + ti * 6 + 4] != 0 };
    return z;
}

// POSIX TZ rules: "CET-1CEST,M3.5.0,M10.5.0/3", "EST5EDT,M3.2.0,M11.1.0", "<+0530>-5:30"

TzReader :: struct {
    s: []const u8,
    i: usize,

    // A zone name: letters, or anything in <...>.
    name :: fn(self: *Self) -> bool {
        if self.i < self.s.len && self.s[self.i] == '<' {
            while self.i < self.s.len && self.s[self.i] != '>' { self.i += 1; }
            if self.i >= self.s.len { return false; }
            self.i += 1;
            return true;
        }
        start := self.i;
        while self.i < self.s.len && ((self.s[self.i] >= 'A' && self.s[self.i] <= 'Z') || (self.s[self.i] >= 'a' && self.s[self.i] <= 'z')) { self.i += 1; }
        return self.i - start >= 3;
    }

    number :: fn(self: *Self) -> i64 {
        v: i64 = 0;
        while self.i < self.s.len && self.s[self.i] >= '0' && self.s[self.i] <= '9' {
            v = v * 10 + (self.s[self.i] - '0') as i64;
            self.i += 1;
        }
        return v;
    }

    // [+-]hh[:mm[:ss]] in seconds.
    hms :: fn(self: *Self) -> i64 {
        sign: i64 = 1;
        if self.i < self.s.len && (self.s[self.i] == '+' || self.s[self.i] == '-') {
            if self.s[self.i] == '-' { sign = -1; }
            self.i += 1;
        }
        v := self.number() * 3600;
        if self.i < self.s.len && self.s[self.i] == ':' {
            self.i += 1;
            v += self.number() * 60;
            if self.i < self.s.len && self.s[self.i] == ':' {
                self.i += 1;
                v += self.number();
            }
        }
        return sign * v;
    }

    at :: fn(self: *Self, c: u8) -> bool { return self.i < self.s.len && self.s[self.i] == c; }
}

// A rule's day: Mm.w.d (kind 0), Jn (1, no Feb 29), n (2, from 0); and the time of day.
TzRule :: struct {
    kind: u8,
    m: i64,
    w: i64,
    d: i64,
    time: i64,
}

read_rule :: fn(r: *TzReader) -> TzRule ! TimeError {
    out: TzRule = .{ 0, 0, 0, 0, 7200 };
    if r.at('M') {
        r.i += 1;
        out.m = r.number();
        if !r.at('.') { fail .bad_zone; }
        r.i += 1;
        out.w = r.number();
        if !r.at('.') { fail .bad_zone; }
        r.i += 1;
        out.d = r.number();
    } else if r.at('J') {
        r.i += 1;
        out.kind = 1;
        out.d = r.number();
    } else {
        out.kind = 2;
        out.d = r.number();
    }
    if r.at('/') {
        r.i += 1;
        out.time = r.hms();
    }
    return out;
}

// The local seconds since 1970 at which `rule` happens in `year` (in the local time then in
// effect).
rule_moment :: fn(rule: TzRule, year: i64) -> i64 {
    day: i64 = 0;
    if rule.kind == 0 {
        first := days_from_parts(year, rule.m, 1);
        wd := weekday_of(first) as i64;
        dom := 1 + (rule.d - wd + 7) % 7 + (rule.w - 1) * 7;
        last := days_in_month(year, rule.m);
        while dom > last { dom -= 7; }
        day = first + dom - 1;
    } else if rule.kind == 1 {
        // Julian 1..365, February 29 never counted
        day = days_from_parts(year, 1, 1) + rule.d - 1;
        if is_leap_year(year) && rule.d >= 60 { day += 1; }
    } else {
        day = days_from_parts(year, 1, 1) + rule.d;
    }
    return day * 86400 + rule.time;
}

/// The offset at `secs` of a POSIX TZ rule (`"CET-1CEST,M3.5.0,M10.5.0/3"`): standard time,
/// and daylight saving time between the two dates of each year.
pub posix_offset :: fn(rule: []const u8, secs: i64) -> ZoneOffset ! TimeError {
    r: TzReader = .{ rule, 0 };
    if !r.name() { fail .bad_zone; }
    std_off := -r.hms();      // POSIX counts west; this, east
    z: ZoneOffset = .{ std_off, false };
    if r.i >= rule.len { return z; }
    if !r.name() { fail .bad_zone; }
    dst_off := std_off + 3600;
    if r.i < rule.len && !r.at(',') { dst_off = -r.hms(); }
    if !r.at(',') { return z; }   // daylight saving without rules: none is applied
    r.i += 1;
    start := read_rule(&r)?;
    if !r.at(',') { fail .bad_zone; }
    r.i += 1;
    end := read_rule(&r)?;
    year := utc(secs + std_off).year;
    // the start is in standard local time, the end in daylight saving local time
    s := rule_moment(start, year) - std_off;
    e := rule_moment(end, year) - dst_off;
    in_dst := if s < e { secs >= s && secs < e } else { !(secs >= e && secs < s) };
    if in_dst {
        z.seconds = dst_off;
        z.dst = true;
    }
    return z;
}

// Text

// Writing into a buffer, cutting what does not fit.
Put :: struct {
    out: []u8,
    n: usize,

    text :: fn(self: *Self, s: []const u8) {
        for c in s {
            if self.n < self.out.len {
                self.out[self.n] = c;
                self.n += 1;
            }
        }
    }

    num :: fn(self: *Self, v: i64, width: usize, pad: u8) {
        digits: [24]u8 = .{};
        neg := v < 0;
        m: u64 = if neg { (0 - v) as u64 } else { v as u64 };
        k: usize = 0;
        while m > 0 || k == 0 {
            digits[k] = '0' + (m % 10) as u8;
            m = m / 10;
            k += 1;
        }
        if neg { self.text("-"); }
        w := k;
        while w < width {
            one: [1]u8 = .{ pad };
            self.text(one[:]);
            w += 1;
        }
        while k > 0 {
            k -= 1;
            self.text(digits[k..k + 1]);
        }
    }

    // +hhmm, or +hh:mm with `colon`
    offset :: fn(self: *Self, secs: i64, colon: bool) {
        self.text(if secs < 0 { "-" } else { "+" });
        a := if secs < 0 { -secs } else { secs };
        self.num(a / 3600, 2, '0');
        if colon { self.text(":"); }
        self.num((a / 60) % 60, 2, '0');
    }
}

/// `dt` written as `pattern` says, into `out`; the slice of `out` used (what does not fit is
/// cut). `offset` (seconds east of UTC) is what `%z` writes; 0 for a UTC time.
///
///   %Y 2024   %y 24   %m 01   %d 05   %e  5   %j 005 (day of the year)
///   %H 13   %I 01   %p PM   %M 07   %S 09
///   %a Fri   %A Friday   %b Jan   %B January
///   %z +0100   %Z +01:00   %% %
///
/// Anything else is written as it is.
pub format_datetime :: fn(dt: DateTime, offset: i64, pattern: []const u8, out: []u8) -> []const u8 {
    w: Put = .{ out, 0 };
    i: usize = 0;
    while i < pattern.len {
        c := pattern[i];
        if c != '%' || i + 1 >= pattern.len {
            w.text(pattern[i..i + 1]);
            i += 1;
            continue;
        }
        k := pattern[i + 1];
        i += 2;
        if k == 'Y' { w.num(dt.year, 4, '0'); }
        else if k == 'y' { w.num(((dt.year % 100) + 100) % 100, 2, '0'); }
        else if k == 'm' { w.num(dt.month as i64, 2, '0'); }
        else if k == 'd' { w.num(dt.day as i64, 2, '0'); }
        else if k == 'e' { w.num(dt.day as i64, 2, ' '); }
        else if k == 'j' {
            doy := days_from_parts(dt.year, dt.month as i64, dt.day as i64) - days_from_parts(dt.year, 1, 1) + 1;
            w.num(doy, 3, '0');
        }
        else if k == 'H' { w.num(dt.hour as i64, 2, '0'); }
        else if k == 'I' { w.num(((dt.hour as i64) + 11) % 12 + 1, 2, '0'); }
        else if k == 'p' { w.text(if dt.hour < 12 { "AM" } else { "PM" }); }
        else if k == 'M' { w.num(dt.minute as i64, 2, '0'); }
        else if k == 'S' { w.num(dt.second as i64, 2, '0'); }
        else if k == 'a' { w.text(weekday_name(dt.weekday)[0..3]); }
        else if k == 'A' { w.text(weekday_name(dt.weekday)); }
        else if k == 'b' { w.text(month_name(dt.month)[0..3]); }
        else if k == 'B' { w.text(month_name(dt.month)); }
        else if k == 'z' { w.offset(offset, false); }
        else if k == 'Z' { w.offset(offset, true); }
        else if k == '%' { w.text("%"); }
        else { w.text(pattern[i - 2..i]); }
    }
    return out[0..w.n];
}

/// `secs` as RFC 3339 / ISO 8601 (`2024-01-31T12:34:56+01:00`), at `offset` seconds east of UTC
/// (`Z` for 0), into `out` (32 bytes are enough).
pub format_rfc3339 :: fn(secs: i64, offset: i64, out: []u8) -> []const u8 {
    dt := utc(secs + offset);
    w: Put = .{ out, 0 };
    w.num(dt.year, 4, '0');
    w.text("-");
    w.num(dt.month as i64, 2, '0');
    w.text("-");
    w.num(dt.day as i64, 2, '0');
    w.text("T");
    w.num(dt.hour as i64, 2, '0');
    w.text(":");
    w.num(dt.minute as i64, 2, '0');
    w.text(":");
    w.num(dt.second as i64, 2, '0');
    if offset == 0 { w.text("Z"); } else { w.offset(offset, true); }
    return out[0..w.n];
}

/// An instant read from text: seconds since 1970 (UTC), the nanoseconds after them, and the
/// offset east of UTC it was written with.
pub Stamp :: struct {
    secs: i64,
    nanos: u32,
    offset: i64,
}

/// The instant an RFC 3339 date and time names: `2024-01-31T12:34:56Z`,
/// `2024-01-31 12:34:56.250+01:00` (`T`, `t` or a space between; `Z` or `z` for UTC); null when
/// `text` is not one.
pub parse_rfc3339 :: fn(text: []const u8) -> ?Stamp {
    if text.len < 20 { return null; }
    od := parse_date(text[0..10]);
    if od == null { return null; }
    d := od!!;
    sep := text[10];
    if sep != 'T' && sep != 't' && sep != ' ' { return null; }
    if text[13] != ':' || text[16] != ':' { return null; }
    h := digits_at(text, 11, 2);
    mi := digits_at(text, 14, 2);
    s := digits_at(text, 17, 2);
    if h < 0 || h > 23 || mi < 0 || mi > 59 || s < 0 || s > 60 { return null; }
    i: usize = 19;
    nanos: u32 = 0;
    if i < text.len && text[i] == '.' {
        i += 1;
        scale: u32 = 100000000;
        start := i;
        while i < text.len && text[i] >= '0' && text[i] <= '9' {
            nanos += ((text[i] - '0') as u32) * scale;
            scale = scale / 10;
            i += 1;
        }
        if i == start { return null; }
    }
    if i >= text.len { return null; }
    offset: i64 = 0;
    z := text[i];
    if z == 'Z' || z == 'z' {
        i += 1;
    } else if z == '+' || z == '-' {
        if i + 6 != text.len || text[i + 3] != ':' { return null; }
        oh := digits_at(text, i + 1, 2);
        om := digits_at(text, i + 4, 2);
        if oh < 0 || om < 0 || oh > 23 || om > 59 { return null; }
        offset = oh * 3600 + om * 60;
        if z == '-' { offset = -offset; }
        i += 6;
    } else {
        return null;
    }
    if i != text.len { return null; }
    local := d.days * 86400 + h * 3600 + mi * 60 + s;
    st: Stamp = .{ local - offset, nanos, offset };
    return st;
}

// Durations

/// `ns` nanoseconds as people read them, into `out` (32 bytes are enough): `2d 3h 5m`,
/// `1h 0m 12s`, `4.25s`, `350ms`, `1.5ms`, `12us`, `80ns`.
pub format_duration :: fn(ns: i64, out: []u8) -> []const u8 {
    w: Put = .{ out, 0 };
    v := ns;
    if v < 0 {
        w.text("-");
        v = -v;
    }
    if v >= 60000000000 {
        secs := v / 1000000000;
        days := secs / 86400;
        hours := (secs / 3600) % 24;
        mins := (secs / 60) % 60;
        rest := secs % 60;
        if days > 0 {
            w.num(days, 1, ' ');
            w.text("d ");
        }
        if days > 0 || hours > 0 {
            w.num(hours, 1, ' ');
            w.text("h ");
        }
        w.num(mins, 1, ' ');
        w.text("m");
        if rest > 0 && days == 0 {
            w.text(" ");
            w.num(rest, 1, ' ');
            w.text("s");
        }
        return out[0..w.n];
    }
    unit: i64 = 1000000000;
    name: []const u8 = "s";
    if v < 1000 {
        unit = 1;
        name = "ns";
    } else if v < 1000000 {
        unit = 1000;
        name = "us";
    } else if v < 1000000000 {
        unit = 1000000;
        name = "ms";
    }
    w.num(v / unit, 1, ' ');
    if unit > 1 {
        // up to three places, no zeros at the end
        frac := (v % unit) * 1000 / unit;
        if frac > 0 {
            w.text(".");
            places: i64 = 100;
            while frac > 0 {
                w.num(frac / places, 1, ' ');
                frac = frac % places;
                places = places / 10;
            }
        }
    }
    w.text(name);
    return out[0..w.n];
}

/// The nanoseconds a duration written as numbers and units names: `1h30m`, `1.5s`, `250ms`,
/// `2d 4h`, `-3m`, `90s`. The units are d, h, m, s, ms, us and ns; null for anything else.
pub parse_duration :: fn(text: []const u8) -> ?i64 {
    i: usize = 0;
    negative := false;
    if i < text.len && (text[i] == '-' || text[i] == '+') {
        negative = text[i] == '-';
        i += 1;
    }
    total: i64 = 0;
    parts: usize = 0;
    while i < text.len {
        if text[i] == ' ' {
            i += 1;
            continue;
        }
        whole: i64 = 0;
        frac: i64 = 0;
        frac_scale: i64 = 1;
        start := i;
        while i < text.len && text[i] >= '0' && text[i] <= '9' {
            whole = whole * 10 + (text[i] - '0') as i64;
            i += 1;
        }
        if i < text.len && text[i] == '.' {
            i += 1;
            while i < text.len && text[i] >= '0' && text[i] <= '9' {
                if frac_scale < 1000000000 {
                    frac = frac * 10 + (text[i] - '0') as i64;
                    frac_scale *= 10;
                }
                i += 1;
            }
        }
        if i == start { return null; }
        u0 := i;
        while i < text.len && text[i] >= 'a' && text[i] <= 'z' { i += 1; }
        unit_text := text[u0..i];
        unit: i64 = 0;
        if unit_text == "d" { unit = 86400000000000; }
        else if unit_text == "h" { unit = 3600000000000; }
        else if unit_text == "m" { unit = 60000000000; }
        else if unit_text == "s" { unit = 1000000000; }
        else if unit_text == "ms" { unit = 1000000; }
        else if unit_text == "us" { unit = 1000; }
        else if unit_text == "ns" { unit = 1; }
        else { return null; }
        total += whole * unit + frac * unit / frac_scale;
        parts += 1;
    }
    if parts == 0 { return null; }
    return if negative { -total } else { total };
}

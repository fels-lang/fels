// SPDX-License-Identifier: Apache-2.0
// std.com: COM/WinRT types as data (GUID, HRESULT, IUnknown, vtables); no OS calls
// out-pointers carry one ref, release exactly once; lent pointers aren't yours

// ---- GUID ----
// 16 bytes, align 4; IIDs and CLSIDs are GUIDs
pub Guid :: struct {
    data1: u32
    data2: u16
    data3: u16
    data4: [8]u8

    pub eq :: fn(self: *const Self, other: *const Guid) -> bool {
        if self.data1 != other.data1 { return false; }
        if self.data2 != other.data2 { return false; }
        if self.data3 != other.data3 { return false; }
        i: usize = 0;
        while i < 8 {
            if self.data4[i] != other.data4[i] { return false; }
            i += 1;
        }
        return true;
    }

    // all zero (GUID_NULL)
    pub is_null :: fn(self: *const Self) -> bool {
        if self.data1 != 0 { return false; }
        if self.data2 != 0 { return false; }
        if self.data3 != 0 { return false; }
        i: usize = 0;
        while i < 8 {
            if self.data4[i] != 0 { return false; }
            i += 1;
        }
        return true;
    }

    // upper-case "{8-4-4-4-12}" into `out`, returns 38; `.buffer_too_small` if shorter
    pub format :: fn(self: *const Self, out: []u8) -> usize ! GuidError {
        if out.len < 38 { fail .buffer_too_small; }
        out[0] = 123;                                  // '{'
        put_hex(out, 1, self.data1 as u64, 8);
        out[9] = 45;                                   // '-'
        put_hex(out, 10, self.data2 as u64, 4);
        out[14] = 45;
        put_hex(out, 15, self.data3 as u64, 4);
        out[19] = 45;
        put_hex(out, 20, ((self.data4[0] as u64) << 8) | (self.data4[1] as u64), 4);
        out[24] = 45;
        v: u64 = 0;
        i: usize = 2;
        while i < 8 {
            v = (v << 8) | (self.data4[i] as u64);
            i += 1;
        }
        put_hex(out, 25, v, 12);
        out[37] = 125;                                 // '}'
        return 38;
    }
}

// text form length, with braces
pub GUID_TEXT_LEN :: 38;

pub GuidError :: errors {
    invalid_format,     // not 8-4-4-4-12 hex, braces optional
    buffer_too_small,   // the output buffer is shorter than GUID_TEXT_LEN
}

HEX_DIGITS :: "0123456789ABCDEF";

// `digits` upper-case hex digits of `v` at out[at..], msb first
put_hex :: fn(out: []u8, at: usize, v: u64, digits: usize) {
    for i in 0..digits {
        shift: u64 = ((digits - 1 - i) as u64) * 4;
        out[at + i] = HEX_DIGITS[((v >> shift) & 15) as usize];
    }
}

// hex digit value, either case; 255 if not hex
hex_val :: fn(c: u8) -> u8 {
    if c >= 48 && c <= 57 { return c - 48; }        // 0-9
    if c >= 65 && c <= 70 { return c - 55; }        // A-F
    if c >= 97 && c <= 102 { return c - 87; }       // a-f
    return 255;
}

// `digits` hex digits at s[at..]; false on a non-hex byte
read_hex :: fn(s: []const u8, at: usize, digits: usize, out: *u64) -> bool {
    v: u64 = 0;
    for i in 0..digits {
        h := hex_val(s[at + i]);
        if h == 255 { return false; }
        v = (v << 4) | (h as u64);
    }
    *out = v;
    return true;
}

// strict 8-4-4-4-12 hex, either case, braces optional; no spaces or extra text
pub parse_guid :: fn(text: []const u8) -> Guid ! GuidError {
    start: usize = 0;
    if text.len == 38 {
        if text[0] != 123 { fail .invalid_format; }
        if text[37] != 125 { fail .invalid_format; }
        start = 1;
    } else {
        if text.len != 36 { fail .invalid_format; }
    }
    if text[start + 8] != 45 { fail .invalid_format; }
    if text[start + 13] != 45 { fail .invalid_format; }
    if text[start + 18] != 45 { fail .invalid_format; }
    if text[start + 23] != 45 { fail .invalid_format; }
    a: u64 = 0;
    b: u64 = 0;
    c: u64 = 0;
    d: u64 = 0;
    e: u64 = 0;
    if !read_hex(text, start, 8, &a) { fail .invalid_format; }
    if !read_hex(text, start + 9, 4, &b) { fail .invalid_format; }
    if !read_hex(text, start + 14, 4, &c) { fail .invalid_format; }
    if !read_hex(text, start + 19, 4, &d) { fail .invalid_format; }
    if !read_hex(text, start + 24, 12, &e) { fail .invalid_format; }
    g: Guid = .{ a as u32, b as u16, c as u16, .{ (d >> 8) as u8, d as u8, (e >> 40) as u8, (e >> 32) as u8, (e >> 24) as u8, (e >> 16) as u8, (e >> 8) as u8, e as u8 } };
    return g;
}

// guiddef.h GUID layout
#assert(core::sizeof(Guid) == 16, "GUID is 16 bytes");
#assert(core::align_of(Guid) == 4, "GUID is aligned to 4");
#assert(core::offset_of(Guid, "data2") == 4);
#assert(core::offset_of(Guid, "data3") == 6);
#assert(core::offset_of(Guid, "data4") == 8);

// well-known IIDs; pass by address (`&IID_IUnknown`)
pub IID_IUnknown : Guid : .{ 0x00000000, 0x0000, 0x0000, .{ 0xC0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46 } };   // {00000000-0000-0000-C000-000000000046}
pub IID_IInspectable : Guid : .{ 0xAF86E2E0, 0xB12D, 0x4C6A, .{ 0x9C, 0x5A, 0xD7, 0xAA, 0x65, 0x10, 0x1E, 0x90 } };   // {AF86E2E0-B12D-4C6A-9C5A-D7AA65101E90}
pub IID_IAgileObject : Guid : .{ 0x94EA2B94, 0xE9CC, 0x49E0, .{ 0xC0, 0xFF, 0xEE, 0x64, 0xCA, 0x8F, 0x5B, 0x90 } };   // {94EA2B94-E9CC-49E0-C0FF-EE64CA8F5B90}
pub IID_IActivationFactory : Guid : .{ 0x00000035, 0x0000, 0x0000, .{ 0xC0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46 } };   // {00000035-0000-0000-C000-000000000046}

// ---- HRESULT ----
// bit 31 failure, bits 16-26 facility, bits 0-15 code; values from winerror.h
pub Hresult :: i32;

pub S_OK                   :: 0;
pub S_FALSE                :: 1;
pub E_NOTIMPL              :: -2147467263;   // 0x80004001
pub E_NOINTERFACE          :: -2147467262;   // 0x80004002
pub E_POINTER              :: -2147467261;   // 0x80004003
pub E_ABORT                :: -2147467260;   // 0x80004004
pub E_FAIL                 :: -2147467259;   // 0x80004005
pub E_UNEXPECTED           :: -2147418113;   // 0x8000FFFF
pub E_OUTOFMEMORY          :: -2147024882;   // 0x8007000E
pub E_INVALIDARG           :: -2147024809;   // 0x80070057
pub E_ACCESSDENIED         :: -2147024891;   // 0x80070005
pub E_HANDLE               :: -2147024890;   // 0x80070006
pub E_PENDING              :: -2147483638;   // 0x8000000A
pub E_BOUNDS               :: -2147483637;   // 0x8000000B
pub E_CHANGED_STATE        :: -2147483636;   // 0x8000000C
pub E_ILLEGAL_METHOD_CALL  :: -2147483634;   // 0x8000000E
pub RPC_E_CHANGED_MODE     :: -2147417850;   // 0x80010106
pub REGDB_E_CLASSNOTREG    :: -2147221164;   // 0x80040154
pub CO_E_NOTINITIALIZED    :: -2147221008;   // 0x800401F0
pub CLASS_E_NOAGGREGATION  :: -2147221232;   // 0x80040110
pub CLASS_E_CLASSNOTAVAILABLE :: -2147221231; // 0x80040111

pub FACILITY_NULL    :: 0;
pub FACILITY_RPC     :: 1;
pub FACILITY_STORAGE :: 3;
pub FACILITY_ITF     :: 4;
pub FACILITY_WIN32   :: 7;
pub FACILITY_WINDOWS :: 8;

pub succeeded :: fn(hr: i32) -> bool { return hr >= 0; }

pub failed :: fn(hr: i32) -> bool { return hr < 0; }

pub facility :: fn(hr: i32) -> u32 { return (((hr as u32) >> 16u32) & 0x7FFu32); }

pub code :: fn(hr: i32) -> u32 { return (hr as u32) & 0xFFFFu32; }

// HRESULT_FROM_WIN32; 0 stays 0, negative passes through
pub from_win32 :: fn(err: u32) -> i32 {
    if (err as i32) <= 0 { return err as i32; }
    return (((err & 0xFFFF) | 0x80070000) as i32);
}

// common failures by name; the rest are `.other`
pub ComError :: errors {
    not_implemented,        // E_NOTIMPL
    no_interface,           // E_NOINTERFACE
    invalid_pointer,        // E_POINTER
    aborted,                // E_ABORT
    failed,                 // E_FAIL
    unexpected,             // E_UNEXPECTED
    out_of_memory,          // E_OUTOFMEMORY
    invalid_arg,            // E_INVALIDARG
    access_denied,          // E_ACCESSDENIED
    bad_handle,             // E_HANDLE
    bounds,                 // E_BOUNDS
    changed_state,          // E_CHANGED_STATE
    illegal_call,           // E_ILLEGAL_METHOD_CALL
    changed_mode,           // RPC_E_CHANGED_MODE: already initialised the other way
    class_not_registered,   // REGDB_E_CLASSNOTREG
    not_initialized,        // CO_E_NOTINITIALIZED
    other,                  // any other failure
}

// ok on any success (S_FALSE too); `.other` loses the code, keep hr if you need it
pub check :: fn(hr: i32) -> void ! ComError {
    if hr >= 0 { return; }
    if hr == E_NOTIMPL { fail .not_implemented; }
    if hr == E_NOINTERFACE { fail .no_interface; }
    if hr == E_POINTER { fail .invalid_pointer; }
    if hr == E_ABORT { fail .aborted; }
    if hr == E_FAIL { fail .failed; }
    if hr == E_UNEXPECTED { fail .unexpected; }
    if hr == E_OUTOFMEMORY { fail .out_of_memory; }
    if hr == E_INVALIDARG { fail .invalid_arg; }
    if hr == E_ACCESSDENIED { fail .access_denied; }
    if hr == E_HANDLE { fail .bad_handle; }
    if hr == E_BOUNDS { fail .bounds; }
    if hr == E_CHANGED_STATE { fail .changed_state; }
    if hr == E_ILLEGAL_METHOD_CALL { fail .illegal_call; }
    if hr == RPC_E_CHANGED_MODE { fail .changed_mode; }
    if hr == REGDB_E_CLASSNOTREG { fail .class_not_registered; }
    if hr == CO_E_NOTINITIALIZED { fail .not_initialized; }
    fail .other;
}

// ---- IUnknown and IInspectable ----
// vtables in header order, self first; your own: IUnknown's 3 first, then #assert

pub IUnknownVtbl :: struct {
    query_interface: extern fn(*IUnknown, *const Guid, **void) -> i32
    add_ref:         extern fn(*IUnknown) -> u32
    release:         extern fn(*IUnknown) -> u32
}

pub IUnknown :: struct {
    vtbl: *IUnknownVtbl

    // on success `*out` has its own ref to release; null on E_NOINTERFACE
    pub query_interface :: fn(self: *Self, iid: *const Guid, out: **void) -> i32 {
        return self.vtbl.query_interface(self, iid, out);
    }

    // returns the count; diagnostics only, don't branch on it
    pub add_ref :: fn(self: *Self) -> u32 { return self.vtbl.add_ref(self); }

    // last ref destroys the object, pointer is dead after; count is diagnostics only
    pub release :: fn(self: *Self) -> u32 { return self.vtbl.release(self); }
}

// base of every WinRT interface; read/release its HSTRING with std.winrt
pub IInspectableVtbl :: struct {
    query_interface:        extern fn(*IInspectable, *const Guid, **void) -> i32
    add_ref:                extern fn(*IInspectable) -> u32
    release:                extern fn(*IInspectable) -> u32
    get_iids:               extern fn(*IInspectable, *u32, **Guid) -> i32       // ULONG*, IID**: free the array with CoTaskMemFree
    get_runtime_class_name: extern fn(*IInspectable, *usize) -> i32             // HSTRING*: an owned string
    get_trust_level:        extern fn(*IInspectable, *i32) -> i32               // TrustLevel*
}

pub IInspectable :: struct {
    vtbl: *IInspectableVtbl

    pub add_ref :: fn(self: *Self) -> u32 { return self.vtbl.add_ref(self); }
    pub release :: fn(self: *Self) -> u32 { return self.vtbl.release(self); }
    pub query_interface :: fn(self: *Self, iid: *const Guid, out: **void) -> i32 {
        return self.vtbl.query_interface(self, iid, out);
    }

    // same object; first three vtable entries match
    pub as_unknown :: fn(self: *Self) -> *IUnknown { return unsafe (self as *IUnknown); }
}

// WinRT class factory, default construction
pub IActivationFactoryVtbl :: struct {
    query_interface:  extern fn(*IActivationFactory, *const Guid, **void) -> i32
    add_ref:          extern fn(*IActivationFactory) -> u32
    release:          extern fn(*IActivationFactory) -> u32
    get_iids:         extern fn(*IActivationFactory, *u32, **Guid) -> i32
    get_runtime_class_name: extern fn(*IActivationFactory, *usize) -> i32
    get_trust_level:  extern fn(*IActivationFactory, *i32) -> i32
    activate_instance: extern fn(*IActivationFactory, **IInspectable) -> i32
}

pub IActivationFactory :: struct {
    vtbl: *IActivationFactoryVtbl

    pub add_ref :: fn(self: *Self) -> u32 { return self.vtbl.add_ref(self); }
    pub release :: fn(self: *Self) -> u32 { return self.vtbl.release(self); }

    // default ctor; `*out` gets an owned IInspectable
    pub activate_instance :: fn(self: *Self, out: **IInspectable) -> i32 {
        return self.vtbl.activate_instance(self, out);
    }
}

#assert(core::sizeof(IUnknownVtbl) == 24, "IUnknownVtbl is three pointers");
#assert(core::offset_of(IUnknownVtbl, "add_ref") == 8);
#assert(core::offset_of(IUnknownVtbl, "release") == 16);
#assert(core::sizeof(IInspectableVtbl) == 48, "IInspectableVtbl is IUnknown's three plus three");
#assert(core::offset_of(IInspectableVtbl, "get_iids") == 24);
#assert(core::offset_of(IInspectableVtbl, "get_runtime_class_name") == 32);
#assert(core::offset_of(IInspectableVtbl, "get_trust_level") == 40);
#assert(core::offset_of(IActivationFactoryVtbl, "activate_instance") == 48);

// TrustLevel (inspectable.h)
pub BASE_TRUST    :: 0;
pub PARTIAL_TRUST :: 1;
pub FULL_TRUST    :: 2;

// ---- RefCount ----
// atomic, thread-safe; start at 1, free your object when release() returns 0
pub RefCount :: struct {
    n: u32

    // returns the new count
    pub add :: fn(self: *Self) -> u32 { return core::atomic_add(&self.n, 1u32, 4) + 1u32; }

    // returns the new count; release at zero is a caller bug, traps in checked builds
    pub release :: fn(self: *Self) -> u32 { return core::atomic_sub(&self.n, 1u32, 4) - 1u32; }

    // snapshot
    pub get :: fn(self: *Self) -> u32 { return core::atomic_load(&self.n, 4); }
}

// starts at 1, the creator's ref
pub new_refcount :: fn() -> RefCount {
    r: RefCount = .{ 1 };
    return r;
}

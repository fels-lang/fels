// SPDX-License-Identifier: Apache-2.0
// std.com - the types of COM and WinRT, as data: GUID, HRESULT, IUnknown and IInspectable
// with their vtables, and a reference counter for implementing your own objects.
//
// Pure Fels, no OS calls, so it compiles on every target (and the layouts can be tested
// anywhere). Calling the operating system - initialising COM or WinRT, creating objects,
// HSTRINGs - is std.winrt, which is Windows only.
//
// What is checked against what. Every layout, GUID and constant here was compared with the
// official Windows SDK headers (guiddef.h, winerror.h, unknwn.h, inspectable.h, activation.h)
// by compiling them with clang for x86_64-pc-windows-msvc and printing sizeof, offsetof, the
// __uuidof of each interface and the value of each constant; the `#assert`s below fix the
// layouts so a mistake here is a build error, not a crash in someone else's process.
//
// The ABI, in short. On x86-64 Windows every COM method is an ordinary call in the one
// calling convention there is (`__stdcall` is the same as the default), with the interface
// pointer as the first argument. A COM interface pointer points to an object whose first
// word points to a table of function pointers - the vtable - so a call is
// `p.vtbl.method(p, ...)`. The first three entries of every vtable are those of IUnknown.
//
// Ownership. COM counts references and nothing else owns anything:
//   - An interface pointer you receive from a function (an out-parameter, or what
//     query_interface hands back) comes with one reference that belongs to you. Release it
//     exactly once, `defer p.release();` being the usual way.
//   - A pointer you are only lent (a parameter) is not yours to release; add_ref it if you
//     keep it past the call.
//   - Releasing the last reference destroys the object. Using the pointer afterwards is a
//     crash, and nothing here can prevent it.
//
// Errors. A COM function returns an HRESULT: negative is failure, zero or positive is
// success (S_FALSE, 1, is a success that means "no"). `succeeded(hr)` / `failed(hr)` test it,
// and `check(hr)` turns a failure into the error `ComError` so `?` and `catch` apply:
// the common codes get their own names; any other failure becomes `.other`, which no longer
// says which code it was - keep the HRESULT around if you need it, or call the function
// whose result you are checking through its raw form and `check` only for the verdict.

// GUID ───────────────────────────────────────────────────────────────────────
// 16 bytes, aligned to 4: {Data1 u32, Data2 u16, Data3 u16, Data4 [8]u8}. An IID (interface
// id) and a CLSID (class id) are GUIDs. The text form is the registry's:
// {00000000-0000-0000-C000-000000000046}, groups of 8-4-4-4-12 hex digits.
pub Guid :: struct {
    data1: u32
    data2: u16
    data3: u16
    data4: [8]u8

    // Are the two GUIDs the same value?
    pub eq :: fn(self: *const Self, other: *const Guid) -> bool {
        if self.data1 != other.data1 { return false; }
        if self.data2 != other.data2 { return false; }
        if self.data3 != other.data3 { return false; }
        i: usize = 0;
        while i < 8 {
            if self.data4[i] != other.data4[i] { return false; }
            i += 1;
        }
        return true;
    }

    // Is every byte zero? (GUID_NULL, "no GUID".)
    pub is_null :: fn(self: *const Self) -> bool {
        if self.data1 != 0 { return false; }
        if self.data2 != 0 { return false; }
        if self.data3 != 0 { return false; }
        i: usize = 0;
        while i < 8 {
            if self.data4[i] != 0 { return false; }
            i += 1;
        }
        return true;
    }

    // Write the text form, "{XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}" (upper-case, braces),
    // into `out` and return its length, always GUID_TEXT_LEN (38). `out` must hold that
    // many bytes, else `.buffer_too_small` and `out` is untouched.
    pub format :: fn(self: *const Self, out: []u8) -> usize ! GuidError {
        if out.len < 38 { fail .buffer_too_small; }
        out[0] = 123;                                  // '{'
        put_hex(out, 1, self.data1 as u64, 8);
        out[9] = 45;                                   // '-'
        put_hex(out, 10, self.data2 as u64, 4);
        out[14] = 45;
        put_hex(out, 15, self.data3 as u64, 4);
        out[19] = 45;
        put_hex(out, 20, ((self.data4[0] as u64) << 8) | (self.data4[1] as u64), 4);
        out[24] = 45;
        v: u64 = 0;
        i: usize = 2;
        while i < 8 {
            v = (v << 8) | (self.data4[i] as u64);
            i += 1;
        }
        put_hex(out, 25, v, 12);
        out[37] = 125;                                 // '}'
        return 38;
    }
}

// Length of the text form with braces.
pub GUID_TEXT_LEN :: 38;

pub GuidError :: errors {
    invalid_format,     // not 8-4-4-4-12 hex digits (with or without braces)
    buffer_too_small,   // the output buffer is shorter than GUID_TEXT_LEN
}

HEX_DIGITS :: "0123456789ABCDEF";

// Write `digits` hex digits of `v` (most significant first, upper-case) at out[at..].
put_hex :: fn(out: []u8, at: usize, v: u64, digits: usize) {
    for i in 0..digits {
        shift: u64 = ((digits - 1 - i) as u64) * 4;
        out[at + i] = HEX_DIGITS[((v >> shift) & 15) as usize];
    }
}

// The value of a hex digit, or 255 if `c` is not one (either case).
hex_val :: fn(c: u8) -> u8 {
    if c >= 48 && c <= 57 { return c - 48; }        // 0-9
    if c >= 65 && c <= 70 { return c - 55; }        // A-F
    if c >= 97 && c <= 102 { return c - 87; }       // a-f
    return 255;
}

// Read `digits` hex digits of s starting at `at`; false if any is not one.
read_hex :: fn(s: []const u8, at: usize, digits: usize, out: *u64) -> bool {
    v: u64 = 0;
    for i in 0..digits {
        h := hex_val(s[at + i]);
        if h == 255 { return false; }
        v = (v << 4) | (h as u64);
    }
    *out = v;
    return true;
}

// Parse the text form: exactly 8-4-4-4-12 hex digits (either case), with the surrounding
// braces or without them. Nothing else is accepted - no spaces, no extra text, no other
// separators.
pub parse_guid :: fn(text: []const u8) -> Guid ! GuidError {
    start: usize = 0;
    if text.len == 38 {
        if text[0] != 123 { fail .invalid_format; }
        if text[37] != 125 { fail .invalid_format; }
        start = 1;
    } else {
        if text.len != 36 { fail .invalid_format; }
    }
    if text[start + 8] != 45 { fail .invalid_format; }
    if text[start + 13] != 45 { fail .invalid_format; }
    if text[start + 18] != 45 { fail .invalid_format; }
    if text[start + 23] != 45 { fail .invalid_format; }
    a: u64 = 0;
    b: u64 = 0;
    c: u64 = 0;
    d: u64 = 0;
    e: u64 = 0;
    if !read_hex(text, start, 8, &a) { fail .invalid_format; }
    if !read_hex(text, start + 9, 4, &b) { fail .invalid_format; }
    if !read_hex(text, start + 14, 4, &c) { fail .invalid_format; }
    if !read_hex(text, start + 19, 4, &d) { fail .invalid_format; }
    if !read_hex(text, start + 24, 12, &e) { fail .invalid_format; }
    g: Guid = .{ a as u32, b as u16, c as u16, .{ (d >> 8) as u8, d as u8, (e >> 40) as u8, (e >> 32) as u8, (e >> 24) as u8, (e >> 16) as u8, (e >> 8) as u8, e as u8 } };
    return g;
}

// Layout: sizeof 16, alignment 4, fields at 0, 4, 6, 8 - guiddef.h's GUID.
#assert(core::sizeof(Guid) == 16, "GUID is 16 bytes");
#assert(core::align_of(Guid) == 4, "GUID is aligned to 4");
#assert(core::offset_of(Guid, "data2") == 4);
#assert(core::offset_of(Guid, "data3") == 6);
#assert(core::offset_of(Guid, "data4") == 8);

// Well-known interface ids, as constants: pass their address (`&IID_IUnknown`, a `*const Guid`).
pub IID_IUnknown : Guid : .{ 0x00000000, 0x0000, 0x0000, .{ 0xC0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46 } };   // {00000000-0000-0000-C000-000000000046}
pub IID_IInspectable : Guid : .{ 0xAF86E2E0, 0xB12D, 0x4C6A, .{ 0x9C, 0x5A, 0xD7, 0xAA, 0x65, 0x10, 0x1E, 0x90 } };   // {AF86E2E0-B12D-4C6A-9C5A-D7AA65101E90}
pub IID_IAgileObject : Guid : .{ 0x94EA2B94, 0xE9CC, 0x49E0, .{ 0xC0, 0xFF, 0xEE, 0x64, 0xCA, 0x8F, 0x5B, 0x90 } };   // {94EA2B94-E9CC-49E0-C0FF-EE64CA8F5B90}
pub IID_IActivationFactory : Guid : .{ 0x00000035, 0x0000, 0x0000, .{ 0xC0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46 } };   // {00000035-0000-0000-C000-000000000046}

// HRESULT ────────────────────────────────────────────────────────────────────
// A signed 32-bit result code. Bit 31 is the severity (set = failure), bits 16-26 the
// facility (which component), bits 0-15 the code. The values below are those of winerror.h.
pub Hresult :: i32;

pub S_OK                   :: 0;
pub S_FALSE                :: 1;
pub E_NOTIMPL              :: -2147467263;   // 0x80004001
pub E_NOINTERFACE          :: -2147467262;   // 0x80004002
pub E_POINTER              :: -2147467261;   // 0x80004003
pub E_ABORT                :: -2147467260;   // 0x80004004
pub E_FAIL                 :: -2147467259;   // 0x80004005
pub E_UNEXPECTED           :: -2147418113;   // 0x8000FFFF
pub E_OUTOFMEMORY          :: -2147024882;   // 0x8007000E
pub E_INVALIDARG           :: -2147024809;   // 0x80070057
pub E_ACCESSDENIED         :: -2147024891;   // 0x80070005
pub E_HANDLE               :: -2147024890;   // 0x80070006
pub E_PENDING              :: -2147483638;   // 0x8000000A
pub E_BOUNDS               :: -2147483637;   // 0x8000000B
pub E_CHANGED_STATE        :: -2147483636;   // 0x8000000C
pub E_ILLEGAL_METHOD_CALL  :: -2147483634;   // 0x8000000E
pub RPC_E_CHANGED_MODE     :: -2147417850;   // 0x80010106
pub REGDB_E_CLASSNOTREG    :: -2147221164;   // 0x80040154
pub CO_E_NOTINITIALIZED    :: -2147221008;   // 0x800401F0
pub CLASS_E_NOAGGREGATION  :: -2147221232;   // 0x80040110
pub CLASS_E_CLASSNOTAVAILABLE :: -2147221231; // 0x80040111

pub FACILITY_NULL    :: 0;
pub FACILITY_RPC     :: 1;
pub FACILITY_STORAGE :: 3;
pub FACILITY_ITF     :: 4;
pub FACILITY_WIN32   :: 7;
pub FACILITY_WINDOWS :: 8;

// Did the call succeed? (zero or positive.)
pub succeeded :: fn(hr: i32) -> bool { return hr >= 0; }

// Did it fail? (negative.)
pub failed :: fn(hr: i32) -> bool { return hr < 0; }

// The facility field, bits 16-26.
pub facility :: fn(hr: i32) -> u32 { return (((hr as u32) >> 16u32) & 0x7FFu32); }

// The code field, bits 0-15.
pub code :: fn(hr: i32) -> u32 { return (hr as u32) & 0xFFFFu32; }

// HRESULT_FROM_WIN32: a Win32 error number as an HRESULT. Zero stays zero (success); an
// HRESULT that is already negative passes through unchanged.
pub from_win32 :: fn(err: u32) -> i32 {
    if (err as i32) <= 0 { return err as i32; }
    return (((err & 0xFFFF) | 0x80070000) as i32);
}

// A failure, by name. The common codes have their own; any other is `.other`.
pub ComError :: errors {
    not_implemented,        // E_NOTIMPL
    no_interface,           // E_NOINTERFACE
    invalid_pointer,        // E_POINTER
    aborted,                // E_ABORT
    failed,                 // E_FAIL
    unexpected,             // E_UNEXPECTED
    out_of_memory,          // E_OUTOFMEMORY
    invalid_arg,            // E_INVALIDARG
    access_denied,          // E_ACCESSDENIED
    bad_handle,             // E_HANDLE
    bounds,                 // E_BOUNDS
    changed_state,          // E_CHANGED_STATE
    illegal_call,           // E_ILLEGAL_METHOD_CALL
    changed_mode,           // RPC_E_CHANGED_MODE: COM/WinRT already initialised the other way
    class_not_registered,   // REGDB_E_CLASSNOTREG
    not_initialized,        // CO_E_NOTINITIALIZED
    other,                  // any other failure
}

// Succeed on a success HRESULT (S_OK and S_FALSE alike); fail on a failure one.
pub check :: fn(hr: i32) -> void ! ComError {
    if hr >= 0 { return; }
    if hr == E_NOTIMPL { fail .not_implemented; }
    if hr == E_NOINTERFACE { fail .no_interface; }
    if hr == E_POINTER { fail .invalid_pointer; }
    if hr == E_ABORT { fail .aborted; }
    if hr == E_FAIL { fail .failed; }
    if hr == E_UNEXPECTED { fail .unexpected; }
    if hr == E_OUTOFMEMORY { fail .out_of_memory; }
    if hr == E_INVALIDARG { fail .invalid_arg; }
    if hr == E_ACCESSDENIED { fail .access_denied; }
    if hr == E_HANDLE { fail .bad_handle; }
    if hr == E_BOUNDS { fail .bounds; }
    if hr == E_CHANGED_STATE { fail .changed_state; }
    if hr == E_ILLEGAL_METHOD_CALL { fail .illegal_call; }
    if hr == RPC_E_CHANGED_MODE { fail .changed_mode; }
    if hr == REGDB_E_CLASSNOTREG { fail .class_not_registered; }
    if hr == CO_E_NOTINITIALIZED { fail .not_initialized; }
    fail .other;
}

// The other direction, from a failure back to an HRESULT, is written where the error is
// caught - an error is not yet a value that can be handed to another function - and says
// what the method you are implementing should return:
//
//     read_header(self) catch e {
//         if e == .no_interface { return E_NOINTERFACE; }
//         return E_FAIL;
//     };
//     return S_OK;

// IUnknown and IInspectable ───────────────────────────────────────────────────
// The vtable lists the methods in the order the header does, each taking the interface
// pointer first. Declare an interface of your own the same way: the three IUnknown entries,
// then the interface's methods in declaration order, then `#assert` the offsets against the
// header (see the ones below).

pub IUnknownVtbl :: struct {
    query_interface: fn(*IUnknown, *const Guid, **void) -> i32
    add_ref:         fn(*IUnknown) -> u32
    release:         fn(*IUnknown) -> u32
}

pub IUnknown :: struct {
    vtbl: *IUnknownVtbl

    // Ask for another interface of the same object. On success `*out` holds a new interface
    // pointer with a reference of its own to release; on E_NOINTERFACE it holds null.
    pub query_interface :: fn(self: *Self, iid: *const Guid, out: **void) -> i32 {
        return self.vtbl.query_interface(self, iid, out);
    }

    // Take another reference; returns the count (for diagnostics only - do not branch on it).
    pub add_ref :: fn(self: *Self) -> u32 { return self.vtbl.add_ref(self); }

    // Give up a reference; the object destroys itself when the last goes. Returns the count
    // that remains (for diagnostics only).
    pub release :: fn(self: *Self) -> u32 { return self.vtbl.release(self); }
}

// IInspectable: the base of every WinRT interface. The HSTRING it returns is std.winrt's
// to read and release.
pub IInspectableVtbl :: struct {
    query_interface:        fn(*IInspectable, *const Guid, **void) -> i32
    add_ref:                fn(*IInspectable) -> u32
    release:                fn(*IInspectable) -> u32
    get_iids:               fn(*IInspectable, *u32, **Guid) -> i32       // ULONG*, IID**: free the array with CoTaskMemFree
    get_runtime_class_name: fn(*IInspectable, *usize) -> i32             // HSTRING*: an owned string
    get_trust_level:        fn(*IInspectable, *i32) -> i32               // TrustLevel*
}

pub IInspectable :: struct {
    vtbl: *IInspectableVtbl

    pub add_ref :: fn(self: *Self) -> u32 { return self.vtbl.add_ref(self); }
    pub release :: fn(self: *Self) -> u32 { return self.vtbl.release(self); }
    pub query_interface :: fn(self: *Self, iid: *const Guid, out: **void) -> i32 {
        return self.vtbl.query_interface(self, iid, out);
    }

    // The same object as an IUnknown (the first three vtable entries are identical).
    pub as_unknown :: fn(self: *Self) -> *IUnknown { return unsafe (self as *IUnknown); }
}

// IActivationFactory: what a WinRT class's factory object offers for default construction.
pub IActivationFactoryVtbl :: struct {
    query_interface:  fn(*IActivationFactory, *const Guid, **void) -> i32
    add_ref:          fn(*IActivationFactory) -> u32
    release:          fn(*IActivationFactory) -> u32
    get_iids:         fn(*IActivationFactory, *u32, **Guid) -> i32
    get_runtime_class_name: fn(*IActivationFactory, *usize) -> i32
    get_trust_level:  fn(*IActivationFactory, *i32) -> i32
    activate_instance: fn(*IActivationFactory, **IInspectable) -> i32
}

pub IActivationFactory :: struct {
    vtbl: *IActivationFactoryVtbl

    pub add_ref :: fn(self: *Self) -> u32 { return self.vtbl.add_ref(self); }
    pub release :: fn(self: *Self) -> u32 { return self.vtbl.release(self); }

    // Construct an instance with the class's default constructor. `*out` receives an owned
    // IInspectable.
    pub activate_instance :: fn(self: *Self, out: **IInspectable) -> i32 {
        return self.vtbl.activate_instance(self, out);
    }
}

#assert(core::sizeof(IUnknownVtbl) == 24, "IUnknownVtbl is three pointers");
#assert(core::offset_of(IUnknownVtbl, "add_ref") == 8);
#assert(core::offset_of(IUnknownVtbl, "release") == 16);
#assert(core::sizeof(IInspectableVtbl) == 48, "IInspectableVtbl is IUnknown's three plus three");
#assert(core::offset_of(IInspectableVtbl, "get_iids") == 24);
#assert(core::offset_of(IInspectableVtbl, "get_runtime_class_name") == 32);
#assert(core::offset_of(IInspectableVtbl, "get_trust_level") == 40);
#assert(core::offset_of(IActivationFactoryVtbl, "activate_instance") == 48);

// TrustLevel values (inspectable.h).
pub BASE_TRUST    :: 0;
pub PARTIAL_TRUST :: 1;
pub FULL_TRUST    :: 2;

// RefCount: the counter for a COM object you implement ────────────────────────
// One 32-bit atomic counter. Embed it in your object, start it at 1 (the reference the
// creator holds), call add() from your add_ref and release() from your release; when
// release() returns 0 the object is unreferenced and yours to free. Atomic, because the
// calls may arrive from any thread.
pub RefCount :: struct {
    n: u32

    // One more reference. Returns the new count.
    pub add :: fn(self: *Self) -> u32 { return core::atomic_add(&self.n, 1u32, 4) + 1u32; }

    // One fewer. Returns the new count. Releasing at zero is a bug in the caller; it traps
    // in a checked build rather than wrapping.
    pub release :: fn(self: *Self) -> u32 { return core::atomic_sub(&self.n, 1u32, 4) - 1u32; }

    // The current count (a snapshot).
    pub get :: fn(self: *Self) -> u32 { return core::atomic_load(&self.n, 4); }
}

// A counter holding the creator's reference.
pub new_refcount :: fn() -> RefCount {
    r: RefCount = .{ 1 };
    return r;
}

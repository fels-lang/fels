// SPDX-License-Identifier: Apache-2.0
// std.crypto — hashing and checksums (pure computation, no I/O).
//
//   d := crypto::sha256("abc");                   // → Digest (32 bytes)
//   h := crypto::to_hex(&a, d);                   // "ba7816bf8f01cfea…"
//
//   s := crypto::sha256_start();                  // in parts: a file, a stream
//   hash::feed(&s, &file, buf[:])?;
//   d := s.final();
//
// The non-cryptographic hashes (FNV-1a, CRC-32, XXH64) are std.hash's; `crc32`, `fnv1a_64` and
// `fnv1a_32` here are the same functions.
//
// SHA-256 follows FIPS 180-4 and matches the standard test vectors (wrapping +%/*%,
// since every add is mod 2^32/2^64). From-scratch software — fine for integrity and
// content addressing, not audited for adversarial use.

#import std.heap.{ Arena };
#import std.hash as hash;
#import std.hash.{ Hasher };
#import std.hex as hexes;

// FNV-1a and CRC-32, as std.hash has them

pub fnv1a_64 :: fn(data: []const u8) -> u64 { return hash::fnv1a_64(data); }
pub fnv1a_32 :: fn(data: []const u8) -> u32 { return hash::fnv1a_32(data); }

// CRC-32 (IEEE 802.3, the zip/png polynomial): `crc32("123456789")` == 0xcbf43926.
pub crc32 :: fn(data: []const u8) -> u32 { return hash::crc32(data); }

// SHA-256 (FIPS 180-4)

// Digest length in bytes — `sha256_into`'s `out` must be at least this long.
pub SHA256_LEN :: 32usize;

// A 256-bit digest. Render with `to_hex`, or read `.bytes` directly.
pub Digest :: struct { bytes: [32]u8 }

rotr :: fn(x: u32, n: u32) -> u32 { return (x >> n) | (x << (32u32 - n)); }

// The state SHA-256 starts from, and its round constants.
SHA256_H: [8]u32 = .{
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
    0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
};
SHA256_K: [64]u32 = .{
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
};

// Mix the 64-byte block at `blk[at..at + 64]` into the running state `h` (8 words).
sha256_block :: fn(blk: []const u8, at: usize, h: []u32) {
    k := SHA256_K[0..64];
    w: [64]u32 = .{};
    t: usize = 0;
    while t < 16 {
        o: usize = at + t * 4;
        w[t] = ((blk[o] as u32) << 24) | ((blk[o + 1] as u32) << 16)
             | ((blk[o + 2] as u32) << 8) | (blk[o + 3] as u32);
        t = t + 1;
    }
    t = 16;
    while t < 64 {
        x15: u32 = w[t - 15];
        x2:  u32 = w[t - 2];
        s0: u32 = rotr(x15, 7) ^ rotr(x15, 18) ^ (x15 >> 3);
        s1: u32 = rotr(x2, 17) ^ rotr(x2, 19) ^ (x2 >> 10);
        w[t] = w[t - 16] +% s0 +% w[t - 7] +% s1;
        t = t + 1;
    }

    a: u32 = h[0]; b: u32 = h[1]; c: u32 = h[2]; d: u32 = h[3];
    e: u32 = h[4]; f: u32 = h[5]; g: u32 = h[6]; hh: u32 = h[7];
    t = 0;
    while t < 64 {
        s1: u32 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
        ch: u32 = (e & f) ^ ((~e) & g);
        t1: u32 = hh +% s1 +% ch +% k[t] +% w[t];
        s0: u32 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
        maj: u32 = (a & b) ^ (a & c) ^ (b & c);
        t2: u32 = s0 +% maj;
        hh = g; g = f; f = e; e = d +% t1; d = c; c = b; b = a; a = t1 +% t2;
        t = t + 1;
    }

    h[0] = h[0] +% a; h[1] = h[1] +% b; h[2] = h[2] +% c; h[3] = h[3] +% d;
    h[4] = h[4] +% e; h[5] = h[5] +% f; h[6] = h[6] +% g; h[7] = h[7] +% hh;
}

/// SHA-256 in parts (`sha256_start`): `update` with the bytes as they come, then `final`. It is
/// a `hash::Hasher`, so `hash::feed(&s, &file, buf[:])` hashes a whole file. The bytes of a
/// block that is not complete wait in `block`.
pub Sha256 :: struct {
    h: [8]u32,
    block: [64]u8,
    buffered: usize,
    total: u64,

    pub update :: fn(self: *Self, data: []const u8) { sha256_add(self, data); }

    /// The digest of all the bytes given so far; `self` is left as it was.
    pub final :: fn(self: *Self) -> Digest {
        h: [8]u32 = self.h;
        // the padding: 0x80, zeros, and the length in bits in the last 8 bytes of a block (one
        // block, or two when the bytes waiting leave no room for the length)
        rem := self.buffered;
        tail: [128]u8 = .{};
        for i in 0..rem { tail[i] = self.block[i]; }
        tail[rem] = 0x80;
        nblk: usize = 1;
        if rem >= 56 { nblk = 2; }
        end := nblk * 64;
        bits := self.total *% 8;
        for j in 0..8 { tail[end - 1 - j] = ((bits >> ((j * 8) as u64)) & 0xff) as u8; }
        sha256_block(tail[0..128], 0, h[0..8]);
        if nblk == 2 { sha256_block(tail[0..128], 64, h[0..8]); }
        d: Digest = .{ .{} };
        for o in 0..8 {
            v := h[o];
            d.bytes[o * 4] = (v >> 24) as u8;
            d.bytes[o * 4 + 1] = (v >> 16) as u8;
            d.bytes[o * 4 + 2] = (v >> 8) as u8;
            d.bytes[o * 4 + 3] = v as u8;
        }
        return d;
    }
}

Sha256 as Hasher {
    update :: fn(self: *Self, data: []const u8) { sha256_add(self, data); }
}

sha256_add :: fn(self: *Sha256, data: []const u8) {
    self.total = self.total +% (data.len as u64);
    i: usize = 0;
    if self.buffered > 0 {
        while self.buffered < 64 && i < data.len {
            self.block[self.buffered] = data[i];
            self.buffered += 1;
            i += 1;
        }
        if self.buffered < 64 { return; }
        sha256_block(self.block[0..64], 0, self.h[0..8]);
        self.buffered = 0;
    }
    while i + 64 <= data.len {
        sha256_block(data, i, self.h[0..8]);
        i += 64;
    }
    while i < data.len {
        self.block[self.buffered] = data[i];
        self.buffered += 1;
        i += 1;
    }
}

pub sha256_start :: fn() -> Sha256 {
    s: Sha256 = .{ SHA256_H, .{}, 0, 0 };
    return s;
}

// Write the 32-byte SHA-256 digest of `data` into `out` (which must be at least
// `SHA256_LEN` bytes). Out-param form — the caller owns the buffer:
//   d: [32]u8 = .{};
//   crypto::sha256_into(msg, d[0..32usize]);
//   hex := crypto::hex(&a, d[0..32usize]);
pub sha256_into :: fn(data: []const u8, out: []u8) {
    s := sha256_start();
    sha256_add(&s, data);
    d := s.final();
    for i in 0..32 { out[i] = d.bytes[i]; }
}

// One-shot SHA-256 of `data`, returned as a `Digest`.
pub sha256 :: fn(data: []const u8) -> Digest {
    d: Digest = .{ .{} };
    sha256_into(data, d.bytes[0..32usize]);
    return d;
}

// Lowercase hex of a byte slice (2 characters per byte): `hex::encode_in`.
pub hex :: fn(a: *Arena, bytes: []const u8) -> []const u8 {
    return hexes::encode_in(a, bytes);
}

// Lowercase hex of a digest (64 characters) — `hex(a, d.bytes[0..32])`.
pub to_hex :: fn(a: *Arena, d: Digest) -> []const u8 {
    return hex(a, d.bytes[0..32usize]);
}
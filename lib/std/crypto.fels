// SPDX-License-Identifier: Apache-2.0
// std.crypto — hashing and checksums (pure computation, no I/O).
//
//   d := crypto::sha256("abc");                   // → Digest (32 bytes)
//   h := crypto::to_hex(&a, d);                   // "ba7816bf8f01cfea…"
//   c := crypto::crc32("123456789");              // 0xcbf43926
//   k := crypto::fnv1a_64("key");                 // fast non-crypto hash for tables
//
// SHA-256 follows FIPS 180-4 and matches the standard test vectors (wrapping +%/*%,
// since every add is mod 2^32/2^64). From-scratch software — fine for integrity and
// content addressing, not audited for adversarial use.

#import std.heap.{ Arena };
#import std.strings as strings;

// FNV-1a (fast, non-cryptographic — hash maps, content keys)

pub fnv1a_64 :: fn(data: []const u8) -> u64 {
    h: u64 = 0xcbf29ce484222325;
    i: usize = 0;
    while i < data.len {
        h = (h ^ (data[i] as u64)) *% 0x100000001b3;
        i = i + 1;
    }
    return h;
}

pub fnv1a_32 :: fn(data: []const u8) -> u32 {
    h: u32 = 0x811c9dc5;
    i: usize = 0;
    while i < data.len {
        h = (h ^ (data[i] as u32)) *% 0x01000193;
        i = i + 1;
    }
    return h;
}

// CRC-32 (IEEE 802.3, the zip/png polynomial)

// Bitwise (table-free) CRC-32. `crc32("123456789")` == 0xcbf43926.
pub crc32 :: fn(data: []const u8) -> u32 {
    crc: u32 = 0xffffffff;
    i: usize = 0;
    while i < data.len {
        crc = crc ^ (data[i] as u32);
        b: usize = 0;
        while b < 8 {
            mask: u32 = 0 -% (crc & 1);          // 0xffffffff if low bit set
            crc = (crc >> 1) ^ (0xedb88320 & mask);
            b = b + 1;
        }
        i = i + 1;
    }
    return crc ^ 0xffffffff;
}

// SHA-256 (FIPS 180-4)

// Digest length in bytes — `sha256_into`'s `out` must be at least this long.
pub SHA256_LEN :: 32usize;

// A 256-bit digest. Render with `to_hex`, or read `.bytes` directly.
pub Digest :: struct { bytes: [32]u8 }

rotr :: fn(x: u32, n: u32) -> u32 { return (x >> n) | (x << (32u32 - n)); }

// Mix one 64-byte block `blk` into the running state `h` (8 words), using the
// round-constant table `k`.
sha256_block :: fn(blk: []const u8, h: []u32, k: []const u32) {
    w: [64]u32 = .{};
    t: usize = 0;
    while t < 16 {
        o: usize = t * 4;
        w[t] = ((blk[o] as u32) << 24) | ((blk[o + 1] as u32) << 16)
             | ((blk[o + 2] as u32) << 8) | (blk[o + 3] as u32);
        t = t + 1;
    }
    t = 16;
    while t < 64 {
        x15: u32 = w[t - 15];
        x2:  u32 = w[t - 2];
        s0: u32 = rotr(x15, 7) ^ rotr(x15, 18) ^ (x15 >> 3);
        s1: u32 = rotr(x2, 17) ^ rotr(x2, 19) ^ (x2 >> 10);
        w[t] = w[t - 16] +% s0 +% w[t - 7] +% s1;
        t = t + 1;
    }

    a: u32 = h[0]; b: u32 = h[1]; c: u32 = h[2]; d: u32 = h[3];
    e: u32 = h[4]; f: u32 = h[5]; g: u32 = h[6]; hh: u32 = h[7];
    t = 0;
    while t < 64 {
        s1: u32 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
        ch: u32 = (e & f) ^ ((~e) & g);
        t1: u32 = hh +% s1 +% ch +% k[t] +% w[t];
        s0: u32 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
        maj: u32 = (a & b) ^ (a & c) ^ (b & c);
        t2: u32 = s0 +% maj;
        hh = g; g = f; f = e; e = d +% t1; d = c; c = b; b = a; a = t1 +% t2;
        t = t + 1;
    }

    h[0] = h[0] +% a; h[1] = h[1] +% b; h[2] = h[2] +% c; h[3] = h[3] +% d;
    h[4] = h[4] +% e; h[5] = h[5] +% f; h[6] = h[6] +% g; h[7] = h[7] +% hh;
}

// Write the 32-byte SHA-256 digest of `data` into `out` (which must be at least
// `SHA256_LEN` bytes). Out-param form — the caller owns the buffer:
//   d: [32]u8 = .{};
//   crypto::sha256_into(msg, d[0..32usize]);
//   hex := crypto::hex(&a, d[0..32usize]);
pub sha256_into :: fn(data: []const u8, out: []u8) {
    h: [8]u32 = .{
        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
        0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
    };
    k: [64]u32 = .{
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    };

    full: usize = data.len / 64;
    b: usize = 0;
    while b < full {
        sha256_block(data[(b * 64)..((b * 64) + 64)], h[0..8usize], k[0..64usize]);
        b = b + 1;
    }

    // Final padded block(s) in a zeroed stack buffer (one block, or two when the
    // remaining bytes leave no room for the 64-bit length).
    rem: usize = data.len - full * 64;
    tail: [128]u8 = .{};
    i: usize = 0;
    while i < rem { tail[i] = data[full * 64 + i]; i = i + 1; }
    tail[rem] = 0x80;

    nblk: usize = 1;
    if rem >= 56 { nblk = 2; }
    end: usize = nblk * 64;

    bits: u64 = (data.len as u64) * 8;
    j: usize = 0;
    while j < 8 {
        sh: u64 = (j as u64) * 8;
        tail[end - 1 - j] = ((bits >> sh) & 0xff) as u8;
        j = j + 1;
    }

    sha256_block(tail[0..64usize], h[0..8usize], k[0..64usize]);
    if nblk == 2 { sha256_block(tail[64..128usize], h[0..8usize], k[0..64usize]); }

    o: usize = 0;
    while o < 8 {
        v: u32 = h[o];
        out[o * 4]          = (v >> 24) as u8;
        out[o * 4 + 1] = (v >> 16) as u8;
        out[o * 4 + 2] = (v >> 8) as u8;
        out[o * 4 + 3] = v as u8;
        o = o + 1;
    }
}

// One-shot SHA-256 of `data`, returned as a `Digest`.
pub sha256 :: fn(data: []const u8) -> Digest {
    d: Digest = .{ .{} };
    sha256_into(data, d.bytes[0..32usize]);
    return d;
}

// Lowercase hex of a byte slice (2 characters per byte).
pub hex :: fn(a: *Arena, bytes: []const u8) -> []const u8 {
    sb := strings::builder(a);
    i: usize = 0;
    while i < bytes.len {
        strings::append_hex_byte(&sb, bytes[i]);
        i = i + 1;
    }
    return strings::str(&sb);
}

// Lowercase hex of a digest (64 characters) — `hex(a, d.bytes[0..32])`.
pub to_hex :: fn(a: *Arena, d: Digest) -> []const u8 {
    return hex(a, d.bytes[0..32usize]);
}
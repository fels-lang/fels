// std.process — process info, env vars, and child-process spawning for Fels. OS
// calls go through the platform runtime (windows.fels → kernel32; linux.fels → getpid +
// /proc + fork/execve/wait4/kill), so this file is OS-agnostic. It has current_pid,
// command_line, args/split_command_line, get_env/set_env/unset_env, Child +
// spawn/wait/try_wait/kill/release, spawn_piped with pipes to the child's standard streams, and
// output to run a command and keep its stdout, all sharing ProcessError. (exit/abort/@panic live in the runtime — no
// import needed.)
//
// Linux: command_line/get_env read /proc/self/{cmdline,environ}; set_env/unset_env
// mutate a process-wide overlay that get_env consults first and spawn passes to the
// child (run via /bin/sh -c).

#import std.io.{ IoError };
#import std.heap.{ Arena, alloc };
#import std.vec as vec;
#import std.fs as fs;
#import std.bufio as bufio;

// The process seam, provided by the platform runtime:
//   os_pid() -> i64
//   os_cmdline(out) -> i64                 length copied into `out`
//   os_args_raw(out) -> i64                the arguments, each ended by a NUL; -1 where the OS
//                                          has only one command-line text (Windows)
//   os_get_env(name, out) -> i64           value length, or -1 if unset
//   os_set_env(name, value) -> bool / os_unset_env(name) -> bool
//   os_spawn(cmd) -> i64                   opaque child token, or -1
//   os_wait(token, block) -> i64           exit code, -2 if still running, -1 error
//   os_kill(token) -> bool / os_proc_release(token)
//   os_spawn_piped(cmd, which, in_w, out_r, err_r) -> i64   pipes for stdin (1), stdout (2),
//                                          stderr (4); our ends, -1 for one not piped

PROC_INVALID :: -1i64;
MAX_NAME_BYTES :: 128usize;

// Errors

pub ProcessError :: errors {
    spawn_failed,       // the child couldn't be launched
    wait_failed,        // waiting on the child failed
    exit_code_failed,   // the child's exit code couldn't be read
    command_too_long,   // command line doesn't fit in the internal buffer
    name_too_long,      // env-var name/value doesn't fit in the internal buffer
    read_failed,        // reading what the child wrote failed
}

// Internal helpers

// Copy `s` into `buf`, NUL-terminate, and return a pointer to the start.
proc_to_cstr :: fn(s: []const u8, buf: []u8) -> *const u8 ! ProcessError {
    if s.len + 1 > buf.len { fail .name_too_long; }
    for i in 0..s.len {
        buf[i] = s[i];
    }
    buf[s.len] = 0;
    return buf.ptr;
}

// Process info

// The PID of the calling process.
pub current_pid :: fn() -> u32 {
    return os_pid() as u32;
}

// The OS command line, copied into `out` (truncated if it doesn't fit).
pub command_line :: fn(out: []u8) -> []const u8 {
    n := os_cmdline(out);
    if n < 0 { return out[0..0usize]; }
    return out[0..(n as usize)];
}

// The arguments the program was started with, the program first, in `a`. On Windows they are
// split from the command line as the C runtime splits it (`split_command_line`); on Linux they
// are as the kernel passed them.
pub args :: fn(a: *Arena) -> [][]const u8 {
    buf := alloc(u8, a, 32768);
    n := os_args_raw(buf);
    if n < 0 { return split_command_line(command_line(buf), a); }
    out := vec::make([]const u8, a);
    start: usize = 0;
    i: usize = 0;
    while i < (n as usize) {
        if buf[i] == 0 {
            out.push(buf[start..i]);
            start = i + 1;
        }
        i += 1;
    }
    if start < (n as usize) { out.push(buf[start..(n as usize)]); }
    return out.items();
}

// A Windows command line split into its arguments, as the C runtime splits it: spaces and tabs
// part them outside quotes; `\"` is a quote, `\\"` a backslash before a quote that opens or
// closes, and `""` inside quotes a quote; other backslashes are kept. The program, first, ends
// at the first space, or at its closing quote, and has no backslash rules (`C:\dir\`).
pub split_command_line :: fn(line: []const u8, a: *Arena) -> [][]const u8 {
    out := vec::make([]const u8, a);
    text := alloc(u8, a, line.len);
    n: usize = 0;
    i: usize = 0;
    // the program
    if i < line.len && line[i] == 34 {
        i += 1;
        start := i;
        while i < line.len && line[i] != 34 { i += 1; }
        out.push(line[start..i]);
        if i < line.len { i += 1; }
    } else {
        start := i;
        while i < line.len && line[i] != 32 && line[i] != 9 { i += 1; }
        out.push(line[start..i]);
    }
    while true {
        while i < line.len && (line[i] == 32 || line[i] == 9) { i += 1; }
        if i >= line.len { break; }
        start := n;
        quoted := false;
        while i < line.len {
            c := line[i];
            if !quoted && (c == 32 || c == 9) { break; }
            if c == 92 {
                slashes: usize = 0;
                while i < line.len && line[i] == 92 {
                    slashes += 1;
                    i += 1;
                }
                if i < line.len && line[i] == 34 {
                    for k in 0..slashes / 2 {
                        text[n] = 92;
                        n += 1;
                    }
                    if slashes % 2 == 1 {
                        text[n] = 34;
                        n += 1;
                        i += 1;
                    }
                } else {
                    for k in 0..slashes {
                        text[n] = 92;
                        n += 1;
                    }
                }
                continue;
            }
            if c == 34 {
                if quoted && i + 1 < line.len && line[i + 1] == 34 {
                    text[n] = 34;
                    n += 1;
                    i += 2;
                    continue;
                }
                quoted = !quoted;
                i += 1;
                continue;
            }
            text[n] = c;
            n += 1;
            i += 1;
        }
        out.push(text[start..n]);
    }
    return out.items();
}

// Environment variables

// Look up an environment variable, copying its value into `out`. Returns `null`
// if the variable isn't set or its value doesn't fit in `out`.
pub get_env :: fn(name: []const u8, out: []u8) -> ?[]const u8 {
    name_buf: [128]u8 = .{};
    cname := proc_to_cstr(name, name_buf[:]) catch err { return null; };
    n := os_get_env(cname, out);
    if n < 0 { return null; }
    return out[0..(n as usize)];
}

// Set (or overwrite) an environment variable for the current process — and for
// any processes it spawns afterwards.
pub set_env :: fn(name: []const u8, value: []const u8) -> bool {
    name_buf:  [128]u8 = .{};
    value_buf: [512]u8 = .{};
    cname  := proc_to_cstr(name, name_buf[:])   catch err { return false; };
    cvalue := proc_to_cstr(value, value_buf[:]) catch err { return false; };
    return os_set_env(cname, cvalue);
}

// Remove an environment variable.
pub unset_env :: fn(name: []const u8) -> bool {
    name_buf: [128]u8 = .{};
    cname := proc_to_cstr(name, name_buf[:]) catch err { return false; };
    return os_unset_env(cname);
}

// Child processes

// A spawned child process, identified by an opaque OS token. Release it with
// `release` once you're done (named `release` rather than `close` to avoid
// colliding with `std.fs.File`'s `close`). Methods are called as
// `(&child).wait()`, `(&child).release()`, etc.
pub Child :: struct {
    token: i64,
    stdin: i64,    // our end of the pipe to its stdin, or -1 (`spawn_piped`)
    stdout: i64,   // our end of the pipe from its stdout, or -1
    stderr: i64,   // our end of the pipe from its stderr, or -1
}

// Launch `command` (program plus arguments, exactly as you'd type at a shell —
// e.g. `"fels build --release"`) as a new process. The child inherits the parent's
// console/standard handles. On Linux the command runs via `/bin/sh -c`.
pub spawn :: fn(command: []const u8) -> Child ! ProcessError {
    cmd_buf: [1024]u8 = .{};
    if command.len + 1 > cmd_buf.len { fail .command_too_long; }
    for i in 0..command.len {
        cmd_buf[i] = command[i];
    }
    cmd_buf[command.len] = 0;
    token := os_spawn(cmd_buf[:].ptr);
    if token == PROC_INVALID { fail .spawn_failed; }
    return .{ token, PROC_INVALID, PROC_INVALID, PROC_INVALID };
}

// Block until the child exits, then return its exit code.
pub wait :: fn(self: *Child) -> u32 ! ProcessError {
    code := os_wait(self.token, true);
    if code < 0 { fail .wait_failed; }
    return code as u32;
}

// Check whether the child has exited yet, without blocking. Returns its exit
// code if it has, or `null` if it's still running.
pub try_wait :: fn(self: *Child) -> ?u32 ! ProcessError {
    code := os_wait(self.token, false);
    if code == -2 { return null; }      // still running
    if code < 0 { fail .wait_failed; }
    return code as u32;
}

// Forcibly terminate the child process.
pub kill :: fn(self: *Child) -> bool {
    return os_kill(self.token);
}

// Release the OS resources owned by this child, its pipes included. Safe to call more than once.
pub release :: fn(self: *Child) {
    close_stdin(self);
    if self.stdout != PROC_INVALID { os_file_close(self.stdout); self.stdout = PROC_INVALID; }
    if self.stderr != PROC_INVALID { os_file_close(self.stderr); self.stderr = PROC_INVALID; }
    if self.token == PROC_INVALID { return; }
    os_proc_release(self.token);
    self.token = PROC_INVALID;
}

// Pipes to a child

/// Which of a child's standard streams `spawn_piped` connects to this process; the others are
/// this process's own (the console, or where they were redirected).
pub Pipes :: struct {
    stdin: bool,
    stdout: bool,
    stderr: bool,
}

/// Launch `command` as `spawn` does, with pipes for the streams `pipes` names. Write to the
/// child's stdin with `stdin_file()`, read its output with `stdout_file()` and `stderr_file()`.
///
///   c := process::spawn_piped("sort", .{ true, true, false })?;
///   w := (&c).stdin_file();  ... write ...  (&c).close_stdin();   // the child sees the end
///   r := (&c).stdout_file();
///   out := bufio::read_all(&a, &r)?;
///   code := (&c).wait()?;
///   (&c).release();
///
/// Read what the child writes while it runs: a child whose pipe is full waits for a reader. With
/// both stdout and stderr piped, read one on another thread, or the child can wait on the one
/// not read while this process waits on the other.
pub spawn_piped :: fn(command: []const u8, pipes: Pipes) -> Child ! ProcessError {
    cmd_buf: [1024]u8 = .{};
    if command.len + 1 > cmd_buf.len { fail .command_too_long; }
    for i in 0..command.len { cmd_buf[i] = command[i]; }
    cmd_buf[command.len] = 0;
    which: u32 = 0;
    if pipes.stdin { which = which | 1; }
    if pipes.stdout { which = which | 2; }
    if pipes.stderr { which = which | 4; }
    in_w: i64 = PROC_INVALID;
    out_r: i64 = PROC_INVALID;
    err_r: i64 = PROC_INVALID;
    token := os_spawn_piped(cmd_buf[:].ptr, which, &in_w, &out_r, &err_r);
    if token == PROC_INVALID { fail .spawn_failed; }
    c: Child = .{ token, in_w, out_r, err_r };
    return c;
}

/// The child's stdin, to write to (a `File`, an `io::Writer`); a closed `File` when stdin was not
/// piped.
pub stdin_file :: fn(self: *Child) -> fs::File {
    f: fs::File = .{ self.stdin };
    return f;
}

/// The child's stdout, to read (a `File`, an `io::Reader`, which gives 0 when the child has
/// closed it); a closed `File` when stdout was not piped.
pub stdout_file :: fn(self: *Child) -> fs::File {
    f: fs::File = .{ self.stdout };
    return f;
}

/// The child's stderr, to read, as `stdout_file`.
pub stderr_file :: fn(self: *Child) -> fs::File {
    f: fs::File = .{ self.stderr };
    return f;
}

/// Close the pipe to the child's stdin: it reads the end of its input.
pub close_stdin :: fn(self: *Child) {
    if self.stdin == PROC_INVALID { return; }
    os_file_close(self.stdin);
    self.stdin = PROC_INVALID;
}

/// What `output` gives: the exit code and everything the child wrote to stdout.
pub Output :: struct {
    code: u32,
    stdout: []u8,
}

/// Run `command` to its end and keep what it writes to stdout, in memory from `a`. Its stdin and
/// stderr are this process's.
///
///   r := process::output(&a, "git rev-parse HEAD")?;
///   if r.code == 0 { hash := strings::str_trim(r.stdout); }
pub output :: fn(a: *Arena, command: []const u8) -> Output ! ProcessError {
    p: Pipes = .{ false, true, false };
    c := spawn_piped(command, p)?;
    f := stdout_file(&c);
    bytes := bufio::read_all(a, &f) catch err {
        release(&c);
        fail .read_failed;
    };
    code := wait(&c) catch err {
        release(&c);
        fail .wait_failed;
    };
    release(&c);
    r: Output = .{ code, bytes };
    return r;
}

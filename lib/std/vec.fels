// std.vec: growable arrays that bump-allocate from an arena; no per-element frees
// resetting the arena frees every Vec in it; don't touch one after

#import std.heap.{ Arena, alloc };

pub Vec :: struct($T: type) {
    region: *Arena,    // grows into this; borrowed, not owned
    data:   []T,       // backing storage; capacity == data.len
    count:  usize      // elements in use

    // size and access
    pub len      :: fn(self: *Self) -> usize { return self.count; }
    pub cap      :: fn(self: *Self) -> usize { return self.data.len; }
    pub is_empty :: fn(self: *Self) -> bool  { return self.count == 0usize; }

    pub get :: fn(self: *Self, i: usize) -> T    { return self.data[i]; }
    pub set :: fn(self: *Self, i: usize, v: T)   { self.data[i] = v; }

    // pointer to element `i`, for in-place mutation
    pub at :: fn(self: *Self, i: usize) -> *T { return &self.data[i]; }

    // assumes non-empty
    pub last :: fn(self: *Self) -> T { return self.data[self.count - 1usize]; }

    // valid until the next growth
    pub items :: fn(self: *Self) -> []T { return self.data[0..self.count]; }

    // capacity for at least `want`; doubles, never shrinks
    pub reserve :: fn(self: *Self, want: usize) {
        if want <= self.data.len { return; }
        new_cap: usize = self.data.len * 2;
        if new_cap < 4 { new_cap = 4; }
        if new_cap < want { new_cap = want; }
        nbuf: []T = alloc(T, self.region, new_cap);
        i: usize = 0;
        while i < self.count { nbuf[i] = self.data[i]; i += 1; }
        self.data = nbuf;
    }

    // mutation
    pub push :: fn(self: *Self, item: T) {
        self.reserve(self.count + 1);
        self.data[self.count] = item;
        self.count += 1;
    }

    // append all of `src`
    pub extend :: fn(self: *Self, src: []const T) {
        self.reserve(self.count + src.len);
        i: usize = 0;
        while i < src.len { self.data[self.count] = src[i]; self.count += 1; i += 1; }
    }

    // assumes non-empty
    pub pop :: fn(self: *Self) -> T {
        self.count -= 1;
        return self.data[self.count];
    }

    // shifts the tail right; O(n)
    pub insert :: fn(self: *Self, i: usize, item: T) {
        self.reserve(self.count + 1);
        j: usize = self.count;
        while j > i { self.data[j] = self.data[j - 1]; j -= 1; }
        self.data[i] = item;
        self.count += 1;
    }

    // shifts the tail left, keeps order; O(n)
    pub remove :: fn(self: *Self, i: usize) -> T {
        gone: T = self.data[i];
        j: usize = i;
        while j + 1 < self.count { self.data[j] = self.data[j + 1]; j += 1; }
        self.count -= 1;
        return gone;
    }

    // O(1): last element moves into `i`; order NOT kept
    pub remove_swap :: fn(self: *Self, i: usize) -> T {
        gone: T = self.data[i];
        self.count -= 1;
        if i < self.count { self.data[i] = self.data[self.count]; }
        return gone;
    }

    // keeps capacity
    pub clear :: fn(self: *Self) { self.count = 0usize; }

    // deep copy into `into`; lets data escape a scratch arena
    pub clone_into :: fn(self: *Self, into: *Arena) -> Vec(T) {
        n: usize = self.count;
        if n < 1 { n = 1; }
        nbuf: []T = alloc(T, into, n);
        i: usize = 0;
        while i < self.count { nbuf[i] = self.data[i]; i += 1; }
        out: Vec(T) = .{ into, nbuf, self.count };
        return out;
    }
}

// constructors

// empty, bound to `a`
pub make :: fn($T: type, a: *Arena) -> Vec(T) {
    r: Vec(T) = .{ a, alloc(T, a, 4), 0 };
    return r;
}

// empty with `cap` reserved
pub with_cap :: fn($T: type, a: *Arena, cap: usize) -> Vec(T) {
    want: usize = cap;
    if want < 1 { want = 1; }
    r: Vec(T) = .{ a, alloc(T, a, want), 0 };
    return r;
}

// copies `src` into `a`
pub from :: fn($T: type, a: *Arena, src: []const T) -> Vec(T) {
    r: Vec(T) = with_cap(T, a, src.len);
    r.extend(src);
    return r;
}

// VecUnmanaged(T): no region of its own; growing calls take the *Arena
pub VecUnmanaged :: struct($T: type) {
    data:  []T,
    count: usize

    pub len      :: fn(self: *Self) -> usize { return self.count; }
    pub cap      :: fn(self: *Self) -> usize { return self.data.len; }
    pub is_empty :: fn(self: *Self) -> bool  { return self.count == 0usize; }
    pub get      :: fn(self: *Self, i: usize) -> T  { return self.data[i]; }
    pub set      :: fn(self: *Self, i: usize, v: T) { self.data[i] = v; }
    pub last     :: fn(self: *Self) -> T { return self.data[self.count - 1usize]; }
    pub items    :: fn(self: *Self) -> []T { return self.data[0..self.count]; }
    pub clear    :: fn(self: *Self) { self.count = 0usize; }

    pub reserve :: fn(self: *Self, a: *Arena, want: usize) {
        if want <= self.data.len { return; }
        new_cap: usize = self.data.len * 2;
        if new_cap < 4 { new_cap = 4; }
        if new_cap < want { new_cap = want; }
        nbuf: []T = alloc(T, a, new_cap);
        i: usize = 0;
        while i < self.count { nbuf[i] = self.data[i]; i += 1; }
        self.data = nbuf;
    }

    pub push :: fn(self: *Self, a: *Arena, item: T) {
        self.reserve(a, self.count + 1);
        self.data[self.count] = item;
        self.count += 1;
    }

    pub pop :: fn(self: *Self) -> T {
        self.count -= 1;
        return self.data[self.count];
    }
}
// copy into a Vec with vec::from(T, a, v.items())

// no storage yet; first push allocates
pub empty :: fn($T: type) -> VecUnmanaged(T) {
    e: VecUnmanaged(T) = .{ alloc_none(T), 0 };
    return e;
}

// null zero-length slice; reserve/push replace it
alloc_none :: fn($T: type) -> []T {
    return unsafe core::slice_raw(T, core::ptr_from_int(*T, 0), 0);
}
// std.net.addr: ipv4 and socket addresses

#import std.strings.{StringBuilder};

pub AddrError :: errors {
    bad_format,   // not a dotted-quad `a.b.c.d`
    octet_range,  // an octet was > 255
}

// ipv4 address; #derive(Eq) gives a.eq(&b); format prints 127.0.0.1
#derive(Eq)
pub IpV4 :: struct {
    a: u8, b: u8, c: u8, d: u8

    // packed u32 in network byte order, as in sockaddr_in
    pub to_net :: fn(self: *Self) -> u32 {
        return (self.a as u32) | ((self.b as u32) << 8) | ((self.c as u32) << 16) | ((self.d as u32) << 24);
    }

    // 127.x.x.x
    pub is_loopback :: fn(self: *Self) -> bool { return self.a == 127u8; }

    // 0.0.0.0, "any interface"
    pub is_unspecified :: fn(self: *Self) -> bool {
        return self.a == 0 && self.b == 0 && self.c == 0 && self.d == 0;
    }

    // dotted quad into `sb`
    pub format :: fn(self: *Self, sb: *StringBuilder) {
        sb.append_u64(self.a as u64); sb.append(".");
        sb.append_u64(self.b as u64); sb.append(".");
        sb.append_u64(self.c as u64); sb.append(".");
        sb.append_u64(self.d as u64);
    }
}

// address from four octets
pub ipv4 :: fn(a: u8, b: u8, c: u8, d: u8) -> IpV4 { return .{ a, b, c, d }; }

// 127.0.0.1
pub localhost :: fn() -> IpV4 { return .{ 127u8, 0u8, 0u8, 1u8 }; }

// 0.0.0.0; bind to every interface
pub any :: fn() -> IpV4 { return .{ 0u8, 0u8, 0u8, 0u8 }; }

// 255.255.255.255, limited broadcast
pub broadcast :: fn() -> IpV4 { return .{ 255u8, 255u8, 255u8, 255u8 }; }

// network-order in_addr -> octets; inverse of to_net
pub from_net :: fn(n: u32) -> IpV4 {
    return .{
        (n & 0xFF) as u8,
        ((n >> 8) & 0xFF) as u8,
        ((n >> 16) & 0xFF) as u8,
        ((n >> 24) & 0xFF) as u8,
    };
}

// parse a dotted quad
pub parse :: fn(s: []const u8) -> IpV4 ! AddrError {
    octets: [4]u32 = .{ 0, 0, 0, 0 };
    idx: usize = 0;       // which octet
    seen: bool = false;        // saw a digit for this octet
    for i in 0..s.len {
        c := s[i];
        if c == 46 {                       // '.'
            if !seen || idx >= 3 { fail .bad_format; }
            idx += 1;
            seen = false;
        } else {
            if c < 48 || c > 57 { fail .bad_format; }   // not 0-9
            octets[idx] = octets[idx] * 10 + ((c - 48) as u32);
            if octets[idx] > 255 { fail .octet_range; }
            seen = true;
        }
    }
    if idx != 3 || !seen { fail .bad_format; }
    return .{ octets[0] as u8, octets[1] as u8, octets[2] as u8, octets[3] as u8 };
}

// ipv4 address + port
#derive(Eq)
pub SocketAddr :: struct {
    ip: IpV4, port: u16

    pub format :: fn(self: *Self, sb: *StringBuilder) {
        self.ip.format(sb);
        sb.append(":");
        sb.append_u64(self.port as u64);
    }
}

pub socket_addr :: fn(ip: IpV4, port: u16) -> SocketAddr { return .{ ip, port }; }
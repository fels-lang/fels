// std.sync: locks, condvars, queues, channels, wait groups; every type is #sync
// share by address; never copy, move or free one while a thread uses it (join first)

#import std.atomics as atomics;
#import std.heap as heap;
#import std.heap.{ Arena };

// runtime seam: os_mutex_lock/try_lock/unlock, os_cond_wait/signal/broadcast

// no timeout, for os_cond_wait
WAIT_FOREVER :: 0xFFFFFFFFu32;

// zero value is unlocked; no init, no destroy; not recursive, not fair
#sync
pub Mutex :: struct {
    word: u64   // OS lock state; all zero bits is the unlocked state

    // sleeps until free; relocking from the same thread deadlocks
    pub lock :: fn(self: *Self) { os_mutex_lock(&self.word); }

    // take it only if free now; true = caller holds it
    pub try_lock :: fn(self: *Self) -> bool { return os_mutex_try_lock(&self.word); }

    // caller must hold it; unlocking one it does not hold is UB
    pub unlock :: fn(self: *Self) { os_mutex_unlock(&self.word); }
}

// wait() may wake spuriously: loop on the condition with the lock held
// signal/broadcast work with or without the lock; a signal with no waiter is lost
#sync
pub CondVar :: struct {
    word: u64   // OS state; zero = nobody waiting

    // release `m`, sleep, retake `m`; caller holds `m`, same Mutex for every waiter
    pub wait :: fn(self: *Self, m: *Mutex) {
        woken := os_cond_wait(&self.word, &m.word, WAIT_FOREVER);
    }

    // like wait(), but false after `ms` ms (0xFFFFFFFF = never); lock retaken either way
    pub wait_timeout :: fn(self: *Self, m: *Mutex, ms: u32) -> bool {
        return os_cond_wait(&self.word, &m.word, ms);
    }

    // wake one waiter, if any
    pub signal :: fn(self: *Self) { os_cond_signal(&self.word); }

    // wake every waiter
    pub broadcast :: fn(self: *Self) { os_cond_broadcast(&self.word); }
}

// bounded blocking MPMC FIFO over caller storage; no alloc, nothing to destroy
// after close(): push false, pop drains then null; free storage only after joining
#sync
pub Queue :: struct($T: type) {
    mu:        Mutex
    not_empty: CondVar
    not_full:  CondVar
    buf:       []T       // the caller's storage; capacity == buf.len
    head:      usize     // index of the oldest item
    count:     usize     // items queued
    closed:    bool

    // sleeps while full; false if closed or zero capacity (item not added)
    pub push :: fn(self: *Self, item: T) -> bool {
        if self.buf.len == 0 { return false; }
        self.mu.lock();
        while self.count == self.buf.len {
            if self.closed { break; }
            self.not_full.wait(&self.mu);
        }
        if self.closed {
            self.mu.unlock();
            return false;
        }
        self.buf[(self.head + self.count) % self.buf.len] = item;
        self.count += 1;
        self.mu.unlock();
        self.not_empty.signal();
        return true;
    }

    // push only if room now; false if full, closed or zero capacity
    pub try_push :: fn(self: *Self, item: T) -> bool {
        if self.buf.len == 0 { return false; }
        self.mu.lock();
        if self.closed || self.count == self.buf.len {
            self.mu.unlock();
            return false;
        }
        self.buf[(self.head + self.count) % self.buf.len] = item;
        self.count += 1;
        self.mu.unlock();
        self.not_empty.signal();
        return true;
    }

    // pop the oldest, sleeping while empty; null once closed and drained
    pub pop :: fn(self: *Self) -> ?T {
        self.mu.lock();
        while self.count == 0 {
            if self.closed { break; }
            self.not_empty.wait(&self.mu);
        }
        if self.count == 0 {
            self.mu.unlock();
            return null;
        }
        item: T = self.buf[self.head];
        self.head = (self.head + 1) % self.buf.len;
        self.count -= 1;
        self.mu.unlock();
        self.not_full.signal();
        return item;
    }

    // pop the oldest if any now; null if empty
    pub try_pop :: fn(self: *Self) -> ?T {
        self.mu.lock();
        if self.count == 0 {
            self.mu.unlock();
            return null;
        }
        item: T = self.buf[self.head];
        self.head = (self.head + 1) % self.buf.len;
        self.count -= 1;
        self.mu.unlock();
        self.not_full.signal();
        return item;
    }

    // end the queue, wake all blocked producers and consumers; idempotent
    pub close :: fn(self: *Self) {
        self.mu.lock();
        self.closed = true;
        self.mu.unlock();
        self.not_empty.broadcast();
        self.not_full.broadcast();
    }

    // items queued now; a snapshot
    pub len :: fn(self: *Self) -> usize {
        self.mu.lock();
        n: usize = self.count;
        self.mu.unlock();
        return n;
    }

    pub capacity :: fn(self: *Self) -> usize { return self.buf.len; }

    pub is_closed :: fn(self: *Self) -> bool {
        self.mu.lock();
        c: bool = self.closed;
        self.mu.unlock();
        return c;
    }
}

// queue over `storage`; it must outlive all users and nothing else may touch it
pub make_queue :: fn($T: type, storage: []T) -> Queue(T) {
    q: Queue(T) = .{ .{}, .{}, .{}, storage, 0, 0, false };
    return q;
}

// Queue with its own storage; share by pointer, don't move it while threads use it
// after close(): send gives false, recv drains then null
#sync
pub Channel :: struct($T: type) {
    queue: Queue(T)

    // waits while full; false if closed
    pub send :: fn(self: *Self, item: T) -> bool { return self.queue.push(item); }

    // send if room now; false if full or closed
    pub try_send :: fn(self: *Self, item: T) -> bool { return self.queue.try_push(item); }

    // waits while empty; null once closed and empty
    pub recv :: fn(self: *Self) -> ?T { return self.queue.pop(); }

    // next item if any now, else null
    pub try_recv :: fn(self: *Self) -> ?T { return self.queue.try_pop(); }

    // no more sends; wakes all waiters; idempotent
    pub close :: fn(self: *Self) { self.queue.close(); }

    // items now; a snapshot
    pub len :: fn(self: *Self) -> usize { return self.queue.len(); }

    pub capacity :: fn(self: *Self) -> usize { return self.queue.capacity(); }

    pub is_closed :: fn(self: *Self) -> bool { return self.queue.is_closed(); }
}

// channel of `capacity` items; storage in `a`
pub channel :: fn($T: type, a: *Arena, capacity: usize) -> Channel(T) {
    ch: Channel(T) = .{ make_queue(T, heap::alloc(T, a, capacity)) };
    return ch;
}

// add(n) before the tasks start, done() in each, wait() sleeps until all are done
#sync
pub WaitGroup :: struct {
    mu:      Mutex
    cv:      CondVar
    pending: usize

    // `n` more tasks to wait for
    pub add :: fn(self: *Self, n: usize) {
        self.mu.lock();
        self.pending += n;
        self.mu.unlock();
    }

    // one task done; the last one wakes every waiter
    pub done :: fn(self: *Self) {
        self.mu.lock();
        self.pending -= 1;
        if self.pending == 0 { self.cv.broadcast(); }
        self.mu.unlock();
    }

    // sleep until every added task called `done`
    pub wait :: fn(self: *Self) {
        self.mu.lock();
        while self.pending > 0 { self.cv.wait(&self.mu); }
        self.mu.unlock();
    }
}

// run something exactly once across threads; later callers wait for it to finish
#sync
pub Once :: struct {
    mu:   Mutex
    done: u32       // 1 once the function has returned

    // run `f` unless already run; every caller returns after `f` has returned
    pub call :: fn(self: *Self, f: fn()) {
        if atomics::load_acquire(u32, &self.done) == 1 { return; }
        self.mu.lock();
        if self.done == 0 {
            f();
            atomics::store_release(u32, &self.done, 1);
        }
        self.mu.unlock();
    }

    pub is_done :: fn(self: *Self) -> bool { return atomics::load_acquire(u32, &self.done) == 1; }
}

// many readers or one writer; a waiting writer blocks new readers; not recursive
#sync
pub RwLock :: struct {
    mu:              Mutex
    readers_go:      CondVar
    writer_go:       CondVar
    readers:         usize    // threads that hold it shared
    writer:          bool     // a thread holds it exclusively
    writers_waiting: usize

    pub lock_shared :: fn(self: *Self) {
        self.mu.lock();
        while self.writer || self.writers_waiting > 0 { self.readers_go.wait(&self.mu); }
        self.readers += 1;
        self.mu.unlock();
    }

    pub unlock_shared :: fn(self: *Self) {
        self.mu.lock();
        self.readers -= 1;
        if self.readers == 0 && self.writers_waiting > 0 { self.writer_go.signal(); }
        self.mu.unlock();
    }

    pub lock :: fn(self: *Self) {
        self.mu.lock();
        self.writers_waiting += 1;
        while self.writer || self.readers > 0 { self.writer_go.wait(&self.mu); }
        self.writers_waiting -= 1;
        self.writer = true;
        self.mu.unlock();
    }

    pub unlock :: fn(self: *Self) {
        self.mu.lock();
        self.writer = false;
        if self.writers_waiting > 0 {
            self.writer_go.signal();
        } else {
            self.readers_go.broadcast();
        }
        self.mu.unlock();
    }
}

// at most n threads at once
#sync
pub Semaphore :: struct {
    mu:      Mutex
    cv:      CondVar
    permits: usize

    // take a permit, sleeping until one is free
    pub acquire :: fn(self: *Self) {
        self.mu.lock();
        while self.permits == 0 { self.cv.wait(&self.mu); }
        self.permits -= 1;
        self.mu.unlock();
    }

    // take a permit only if one is free now
    pub try_acquire :: fn(self: *Self) -> bool {
        self.mu.lock();
        ok := self.permits > 0;
        if ok { self.permits -= 1; }
        self.mu.unlock();
        return ok;
    }

    // give a permit back, wake one waiter
    pub release :: fn(self: *Self) {
        self.mu.lock();
        self.permits += 1;
        self.cv.signal();
        self.mu.unlock();
    }
}

// semaphore with `permits` permits; keep it in place, share by address
pub semaphore :: fn(permits: usize) -> Semaphore {
    s: Semaphore = .{ .{}, .{}, permits };
    return s;
}

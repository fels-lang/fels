// SPDX-License-Identifier: Apache-2.0
// std.heap: bump arena; growable (64 KiB chunks), reserved, or over a fixed buffer

#import std.ptr.{ align_up };

// os_reserve/commit/alloc/release come from the platform runtime (or a host shim)

// ---- tunables ----

// growable chunk payload; bigger allocs get an exact-fit chunk
DEFAULT_CHUNK :: 65536usize;

// sizeof(Chunk), a multiple of ALIGN so the data stays aligned
CHUNK_HEADER :: 32usize;

// every allocation; the strictest any Fels scalar/pointer needs
ALIGN :: 16usize;

// x64 page; reserved arenas commit a page at a time
PAGE :: 4096usize;

// Arena.mode
ARENA_FIXED    :: 0u8;       // over a caller buffer; never touches the OS
ARENA_CHUNKED  :: 1u8;       // grows by reserving fresh 64 KiB chunks
ARENA_RESERVED :: 2u8;       // one up-front reservation, pages committed lazily

// ---- types ----

pub MemError :: errors {
    out_of_memory,      // OS alloc failed, or fixed/reserved cap full
}

// in-place at each chunk's base; `next` in alloc order; `committed` lazy when reserved
Chunk :: struct {
    next:      usize,
    cap:       usize,
    committed: usize,
    used:      usize,
}

// `first` oldest chunk, `head` current bump chunk, `mode` an ARENA_* value
pub Arena :: struct {
    first: usize,
    head:  usize,
    mode:  u8,
}

// saved bump position for `restore`
pub Mark :: struct {
    chunk: usize,
    used:  usize,
}

// ---- constructors ----

// reserves nothing until the first alloc
pub make :: fn() -> Arena {
    return .{ 0, 0, ARENA_CHUNKED };
}

// `max` bytes of address space, committed lazily; pointers never move
pub reserve :: fn(max: usize) -> Arena {
    base := os_reserve(CHUNK_HEADER + max);
    if base == 0 { return .{ 0, 0, ARENA_RESERVED }; }
    // first page holds the header
    if !os_commit(base, PAGE) {
        os_release(base, CHUNK_HEADER + max);
        return .{ 0, 0, ARENA_RESERVED };
    }
    c := unsafe core::ptr_from_int(*Chunk, base);
    c.next = 0;
    c.cap = max;
    init := PAGE - CHUNK_HEADER;
    if init > max { init = max; }
    c.committed = init;
    c.used = 0;
    return .{ base, base, ARENA_RESERVED };
}

// no syscalls, can't grow; `buf` must outlive the arena
pub fixed :: fn(buf: []u8) -> Arena {
    if buf.len < CHUNK_HEADER { return .{ 0, 0, ARENA_FIXED }; }
    base := unsafe (buf.ptr as usize);
    c := unsafe core::ptr_from_int(*Chunk, base);
    c.next = 0;
    cap := buf.len - CHUNK_HEADER;
    c.cap = cap;
    c.committed = cap;
    c.used = 0;
    return .{ base, base, ARENA_FIXED };
}

// ---- bump ----

// back `need_payload` bytes of `c`; only reserved arenas need this
commit_more :: fn(chunk_addr: usize, c: *Chunk, need_payload: usize) -> bool {
    want := align_up(need_payload, PAGE);
    if want > c.cap { want = c.cap; }
    if !os_commit(chunk_addr, CHUNK_HEADER + want) {
        return false;
    }
    c.committed = want;
    return true;
}

// address of `need` aligned bytes; null when exhausted
carve :: fn(self: *Arena, need: usize) -> ?usize {
    if self.head != 0 {
        c := unsafe core::ptr_from_int(*Chunk, self.head);
        data := self.head + CHUNK_HEADER;
        aligned := align_up(data + c.used, ALIGN);
        if aligned + need <= data + c.cap {
            np := (aligned + need) - data;
            if np > c.committed {
                if !commit_more(self.head, c, np) { return null; }
            }
            c.used = np;
            return aligned;
        }
        // chunk full; after reset/restore the next one is reusable
        if c.next != 0 {
            nx := unsafe core::ptr_from_int(*Chunk, c.next);
            nd := c.next + CHUNK_HEADER;
            na := align_up(nd, ALIGN);
            if na + need <= nd + nx.cap {
                np2 := (na + need) - nd;
                if np2 > nx.committed {
                    if !commit_more(c.next, nx, np2) { return null; }
                }
                nx.used = np2;
                self.head = c.next;
                return na;
            }
        }
    }

    // only a growable arena gets new chunks
    if self.mode != ARENA_CHUNKED { return null; }
    cap := DEFAULT_CHUNK;
    if need + ALIGN > cap { cap = need + ALIGN; }
    raw := os_alloc(CHUNK_HEADER + cap);
    if raw == 0 { return null; }

    nc := unsafe core::ptr_from_int(*Chunk, raw);
    nc.cap = cap;
    nc.committed = cap;
    data2 := raw + CHUNK_HEADER;
    aligned2 := align_up(data2, ALIGN);
    nc.used = (aligned2 + need) - data2;

    if self.head != 0 {
        hc := unsafe core::ptr_from_int(*Chunk, self.head);
        nc.next = hc.next;
        hc.next = raw;
    } else {
        nc.next = 0;
        self.first = raw;
    }
    self.head = raw;
    return aligned2;
}

// ---- bytes ----

// aborts on exhaustion
pub alloc_bytes :: fn(self: *Arena, n: usize) -> []u8 {
    addr := carve(self, n);
    if addr == null { core::panic("std.heap: out of memory"); }
    p := unsafe core::ptr_from_int(*u8, addr!!);
    return unsafe core::slice_raw(u8, p, n);
}

// `.out_of_memory` instead of aborting
pub try_alloc_bytes :: fn(self: *Arena, n: usize) -> []u8 ! MemError {
    addr := carve(self, n);
    if addr == null { fail .out_of_memory; }
    p := unsafe core::ptr_from_int(*u8, addr!!);
    return unsafe core::slice_raw(u8, p, n);
}

// ---- typed ----

// 16-byte aligned; aborts on exhaustion
pub alloc :: fn($T: type, self: *Arena, n: usize) -> []T {
    bytes := alloc_bytes(self, n * core::sizeof(T));
    tp := unsafe (bytes.ptr as *T);
    return unsafe core::slice_raw(T, tp, n);
}

// fallible alloc
pub try_alloc :: fn($T: type, self: *Arena, n: usize) -> []T ! MemError {
    bytes := try_alloc_bytes(self, n * core::sizeof(T))?;
    tp := unsafe (bytes.ptr as *T);
    return unsafe core::slice_raw(T, tp, n);
}

// aborts on exhaustion
pub alloc_one :: fn($T: type, self: *Arena) -> *T {
    bytes := alloc_bytes(self, core::sizeof(T));
    return unsafe (bytes.ptr as *T);
}

// copy into the arena; aborts on exhaustion
pub dupe :: fn($T: type, self: *Arena, src: []const T) -> []T {
    out := alloc(T, self, src.len);
    for i in 0..src.len {
        out[i] = src[i];
    }
    return out;
}

// zone spellings of alloc_one / alloc
pub new :: fn($T: type, self: *Arena) -> *T {
    return alloc_one(T, self);
}

pub new_slice :: fn($T: type, self: *Arena, n: usize) -> []T {
    return alloc(T, self, n);
}

// ---- reuse and lifetime ----

// rewind, keep chunks, O(1); everything allocated before is invalid
pub reset :: fn(self: *Arena) {
    if self.first != 0 {
        c := unsafe core::ptr_from_int(*Chunk, self.first);
        c.used = 0;
    }
    self.head = self.first;
}

// for restore; invalid after the next reset/deinit
pub mark :: fn(self: *Arena) -> Mark {
    if self.head == 0 { return .{ 0, 0 }; }
    c := unsafe core::ptr_from_int(*Chunk, self.head);
    return .{ self.head, c.used };
}

// frees everything since `m` for reuse; chunks are kept
pub restore :: fn(self: *Arena, m: Mark) {
    if m.chunk == 0 {
        reset(self);
        return;
    }
    // later chunks are rewound when carve moves into them
    mc := unsafe core::ptr_from_int(*Chunk, m.chunk);
    mc.used = m.used;
    self.head = m.chunk;
}

// memory back to the OS (fixed: just cleared); reusable after
pub deinit :: fn(self: *Arena) {
    if self.mode != ARENA_FIXED {
        cur := self.first;
        while cur != 0 {
            c := unsafe core::ptr_from_int(*Chunk, cur);
            nx := c.next;
            os_release(cur, CHUNK_HEADER + c.cap);
            cur = nx;
        }
    }
    self.first = 0;
    self.head = 0;
}

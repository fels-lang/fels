// SPDX-License-Identifier: Apache-2.0
// std.bitset: bits 0..n-1, 64 per word, in an arena; index past the end panics

#import std.heap.{ Arena, alloc };
#import std.bits as bits;

pub BitSet :: struct {
    words: []u64,
    n: usize,      // how many bits

    pub len :: fn(self: *Self) -> usize { return self.n; }

    pub has :: fn(self: *Self, i: usize) -> bool {
        if i >= self.n { core::panic("std.bitset: bit index past the end"); }
        return (self.words[i / 64] >> ((i % 64) as u64)) & 1 != 0;
    }

    pub set :: fn(self: *Self, i: usize) {
        if i >= self.n { core::panic("std.bitset: bit index past the end"); }
        self.words[i / 64] = self.words[i / 64] | ((1 as u64) << ((i % 64) as u64));
    }

    pub unset :: fn(self: *Self, i: usize) {
        if i >= self.n { core::panic("std.bitset: bit index past the end"); }
        self.words[i / 64] = self.words[i / 64] & ~((1 as u64) << ((i % 64) as u64));
    }

    pub toggle :: fn(self: *Self, i: usize) {
        if i >= self.n { core::panic("std.bitset: bit index past the end"); }
        self.words[i / 64] = self.words[i / 64] ^ ((1 as u64) << ((i % 64) as u64));
    }

    // set or clear bit `i`
    pub put :: fn(self: *Self, i: usize, on: bool) {
        if on { self.set(i); } else { self.unset(i); }
    }

    // number of set bits
    pub count :: fn(self: *Self) -> usize {
        total: usize = 0;
        for w in self.words { total += bits::count_ones_u64(w) as usize; }
        return total;
    }

    pub set_all :: fn(self: *Self) {
        for i in 0..self.words.len { self.words[i] = ~(0 as u64); }
        self.trim();
    }

    pub clear_all :: fn(self: *Self) {
        for i in 0..self.words.len { self.words[i] = 0; }
    }

    // self |= other; same length required
    pub union_with :: fn(self: *Self, other: *BitSet) {
        for i in 0..self.words.len { self.words[i] = self.words[i] | other.words[i]; }
    }

    // self &= other
    pub intersect_with :: fn(self: *Self, other: *BitSet) {
        for i in 0..self.words.len { self.words[i] = self.words[i] & other.words[i]; }
    }

    // self &= ~other
    pub subtract :: fn(self: *Self, other: *BitSet) {
        for i in 0..self.words.len { self.words[i] = self.words[i] & ~other.words[i]; }
    }

    // set bits, smallest first
    pub ones :: fn(self: *Self) -> Ones {
        it: Ones = .{ self, 0, if self.words.len > 0 { self.words[0] } else { 0 } };
        return it;
    }

    // keep bits past `n` clear so `count`/`ones` skip them
    trim :: fn(self: *Self) {
        extra := self.n % 64;
        if extra != 0 && self.words.len > 0 {
            last := self.words.len - 1;
            self.words[last] = self.words[last] & (((1 as u64) << (extra as u64)) - 1);
        }
    }
}

// iterator from BitSet.ones
pub Ones :: struct {
    s: *BitSet,
    word: usize,   // the word being looked at
    rest: u64,     // its bits not given yet

    pub next :: fn(self: *Self) -> ?usize {
        while self.rest == 0 {
            self.word += 1;
            if self.word >= self.s.words.len { return null; }
            self.rest = self.s.words[self.word];
        }
        low := bits::trailing_zeros_u64(self.rest) as usize;
        self.rest = self.rest & (self.rest - 1);
        return self.word * 64 + low;
    }
}

// `n` clear bits in `a`
pub make :: fn(a: *Arena, n: usize) -> BitSet {
    words := alloc(u64, a, (n + 63) / 64);
    for i in 0..words.len { words[i] = 0; }
    s: BitSet = .{ words, n };
    return s;
}

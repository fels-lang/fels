// std.hex: bytes <-> hex; encodes lowercase (or upper), decodes either case

#import std.heap.{ Arena, alloc_bytes };

pub HexError :: errors {
    invalid_character,   // not a hex digit
    odd_length,          // half a byte at the end
    buffer_too_small,    // `out` too small; nothing written
}

LOWER :: "0123456789abcdef";
UPPER :: "0123456789ABCDEF";

encode_with :: fn(digits: []const u8, out: []u8, src: []const u8) -> usize ! HexError {
    if out.len / 2 < src.len { fail .buffer_too_small; }
    for i in 0..src.len {
        out[2 * i] = digits[(src[i] >> 4) as usize];
        out[2 * i + 1] = digits[(src[i] & 15) as usize];
    }
    return 2 * src.len;
}

// lowercase hex of `src` into `out`; returns 2 * src.len
pub encode :: fn(out: []u8, src: []const u8) -> usize ! HexError { return encode_with(LOWER, out, src); }

// `encode`, uppercase
pub encode_upper :: fn(out: []u8, src: []const u8) -> usize ! HexError { return encode_with(UPPER, out, src); }

// lowercase hex of `src`, in `a`
pub encode_in :: fn(a: *Arena, src: []const u8) -> []u8 {
    out := a.alloc_bytes(2 * src.len);
    n := encode_with(LOWER, out, src) catch err { yield 0; };
    return out[0..n];
}

// uppercase hex of `src`, in `a`
pub encode_upper_in :: fn(a: *Arena, src: []const u8) -> []u8 {
    out := a.alloc_bytes(2 * src.len);
    n := encode_with(UPPER, out, src) catch err { yield 0; };
    return out[0..n];
}

// value of hex digit `c`, either case; null if not hex
pub digit_value :: fn(c: u8) -> ?u8 {
    if c >= '0' && c <= '9' { return c - '0'; }
    if c >= 'a' && c <= 'f' { return c - 'a' + 10; }
    if c >= 'A' && c <= 'F' { return c - 'A' + 10; }
    return null;
}

// decode `text` into `out`; returns text.len / 2; writes nothing on error
pub decode :: fn(out: []u8, text: []const u8) -> usize ! HexError {
    if text.len % 2 != 0 { fail .odd_length; }
    n := text.len / 2;
    if out.len < n { fail .buffer_too_small; }
    for c in text {
        if digit_value(c) == null { fail .invalid_character; }
    }
    for i in 0..n {
        hi := digit_value(text[2 * i]) ?? 0;
        lo := digit_value(text[2 * i + 1]) ?? 0;
        out[i] = (hi << 4) | lo;
    }
    return n;
}

// decode `text` into `a`
pub decode_in :: fn(a: *Arena, text: []const u8) -> []u8 ! HexError {
    if text.len % 2 != 0 { fail .odd_length; }
    out := a.alloc_bytes(text.len / 2);
    n := decode(out, text)?;
    return out[0..n];
}

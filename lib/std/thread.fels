// std.thread: OS threads, Scope (joined at block end), Pool (parallel loops)

#import std.heap as heap;
#import std.heap.{ Arena };
#import std.sync.{ Mutex, CondVar };
#import std.atomics as atomics;

// os_thread_* and os_cpu_count come from the platform runtime; spawn gives -1 on failure

THREAD_INVALID :: -1i64;
MAX_GROUP :: 64;

pub Thread :: struct {
    token: i64

    // false if spawn failed
    pub ok :: fn(self: *Self) -> bool { return self.token != THREAD_INVALID; }

    // blocks, returns the exit code (8 bits on linux); don't reuse after
    pub join :: fn(self: *Self) -> u32 {
        if self.token == THREAD_INVALID { return 0; }
        code := os_thread_join(self.token);
        self.token = THREAD_INVALID;
        return code;
    }

    // no wait; it runs to completion on its own
    pub detach :: fn(self: *Self) {
        if self.token == THREAD_INVALID { return; }
        os_thread_detach(self.token);
        self.token = THREAD_INVALID;
    }

    // non-blocking poll
    pub is_running :: fn(self: *Self) -> bool {
        if self.token == THREAD_INVALID { return false; }
        return os_thread_running(self.token);
    }
}

// `entry` is `fn(*void) -> u32` via core::fn_ptr; `arg` must outlive the thread
pub spawn :: fn(entry: *void, arg: *void) -> Thread {
    return .{ os_thread_spawn(entry, arg) };
}

// ---- helpers ----

pub current_id :: fn() -> u32 { return os_thread_id(); }

// at least `ms` ms
pub sleep :: fn(ms: u32) { os_sleep_nanos((ms as i64) * 1000000i64); }

// scheduler hint, cooperative back-off
pub yield_now :: fn() { os_thread_yield(); }

// logical cpus; a sane default thread count
pub cpu_count :: fn() -> u32 { return os_cpu_count(); }

// ---- ThreadGroup ----
// up to MAX_GROUP threads; join_all blocks until all are done
pub ThreadGroup :: struct {
    tokens: [64]i64 // MAX_GROUP slots
    count: usize

    // silently ignored past MAX_GROUP
    pub spawn :: fn(self: *Self, entry: *void, arg: *void) {
        if self.count >= 64 { return; }
        self.tokens[self.count] = os_thread_spawn(entry, arg);
        self.count += 1;
    }

    // blocks until all are done, then resets for reuse
    pub join_all :: fn(self: *Self) {
        for i in 0..self.count {
            if self.tokens[i] != THREAD_INVALID { ig := os_thread_join(self.tokens[i]); }
        }
        self.count = 0;
    }
}

pub group :: fn() -> ThreadGroup { return .{ }; }

// ---- Scope ----
// zone kind; joined on every exit from the block, so captured locals stay valid
pub Scope :: struct {
    arena:   Arena
    tasks:   ?*ScopeTask // the spawned closures, the newest first
    spawned: usize

    // reserves nothing until the first spawn
    pub make :: fn() -> Scope { return .{ heap::make(), null, 0 }; }

    // runs `f` inline if no thread starts; captures are shared, checked by #spawns
    #spawns
    pub spawn :: fn(self: *Self, f: fn()) {
        task := self.arena.alloc_one(ScopeTask);
        task.f = f;
        task.next = self.tasks;
        task.token = os_thread_spawn(core::fn_ptr(run_scope_task), unsafe (task as *void));
        if task.token == THREAD_INVALID { f(); }
        self.tasks = task;
        self.spawned += 1;
    }

    // waits for all spawned so far; zone end does it anyway, spawning after is fine
    pub join :: fn(self: *Self) {
        t := self.tasks;
        while t |task| {
            if task.token != THREAD_INVALID {
                code := os_thread_join(task.token);
                task.token = THREAD_INVALID;
            }
            t = task.next;
        }
    }

    pub count :: fn(self: *Self) -> usize { return self.spawned; }

    // zone protocol: closure memory
    pub alloc_bytes :: fn(self: *Self, n: usize) -> []u8 { return self.arena.alloc_bytes(n); }

    // zone end: join all, then free
    pub deinit :: fn(self: *Self) {
        self.join();
        self.arena.deinit();
    }
}

// one Scope closure and its thread
ScopeTask :: struct {
    f:     fn()
    token: i64
    next:  ?*ScopeTask
}

// thread entry for a ScopeTask
run_scope_task :: fn(p: *void) -> u32 {
    task := unsafe (p as *ScopeTask);
    f := task.f;
    f();
    return 0;
}

// ---- Pool ----
// zone kind for parallel loops; cores-1 workers plus the caller, started at the first job
pub Pool :: struct {
    arena:    Arena
    mu:       Mutex = .{}
    wake:     CondVar = .{} // a job is posted, or the pool stops
    finished: CondVar = .{} // the last worker is done with the job
    workers:  []i64 = .{}   // their threads, started at the first job
    started:  bool = false
    stopping: bool = false
    job:      fn(usize)
    round:    u64 = 0       // jobs posted so far
    next:     usize = 0     // the next index to take
    end:      usize = 0
    chunk:    usize = 1
    working:  usize = 0     // workers not yet done with the job

    // no thread starts until the first job
    pub make :: fn() -> Pool { return .{ .arena = heap::make(), .job = idle_job }; }

    // f(i) for i in start..end across the pool; returns when every call is done
    #spawns
    pub range :: fn(self: *Self, start: usize, end: usize, f: fn(usize)) {
        if end <= start { return; }
        self.start_workers();
        n := self.workers.len;
        chunk := (end - start) / ((n + 1) * 8);
        self.mu.lock();
        self.job = f;
        self.next = start;
        self.end = end;
        self.chunk = if chunk == 0 { 1 } else { chunk };
        self.working = n;
        self.round += 1;
        self.mu.unlock();
        self.wake.broadcast();
        self.work(f);
        self.mu.lock();
        while self.working != 0 { self.finished.wait(&self.mu); }
        self.mu.unlock();
    }

    // f(&items[i]) across the pool; each call writes only its own item
    #spawns
    pub each :: fn($T: type, self: *Self, items: borrow []T, f: fn(*T)) {
        // one item per call; `f` was checked at the call site
        unsafe { self.range(0, items.len, fn(i: usize) { f(&items[i]); }); }
    }

    // workers + the caller
    pub threads :: fn(self: *Self) -> usize {
        self.start_workers();
        return self.workers.len + 1;
    }

    // grab index chunks until none left
    work :: fn(self: *Self, f: fn(usize)) {
        while true {
            from := atomics::fetch_add(usize, &self.next, self.chunk);
            if from >= self.end { return; }
            to := from + self.chunk;
            if to > self.end { to = self.end; }
            for i in from..to { f(i); }
        }
    }

    start_workers :: fn(self: *Self) {
        if self.started { return; }
        self.started = true;
        cpus := os_cpu_count() as usize;
        n: usize = if cpus > 64 { 63 } else if cpus > 1 { cpus - 1 } else { 0 };
        all := self.arena.alloc(i64, n);
        // a thread that does not start takes no part
        k: usize = 0;
        for i in 0..n {
            t := os_thread_spawn(core::fn_ptr(run_pool_worker), unsafe (self as *void));
            if t != THREAD_INVALID {
                all[k] = t;
                k += 1;
            }
        }
        self.workers = all[0..k];
    }

    // zone protocol: closure memory
    pub alloc_bytes :: fn(self: *Self, n: usize) -> []u8 { return self.arena.alloc_bytes(n); }

    // zone end: stop the workers, then free
    pub deinit :: fn(self: *Self) {
        if self.started {
            self.mu.lock();
            self.stopping = true;
            self.mu.unlock();
            self.wake.broadcast();
            for t in self.workers { code := os_thread_join(t); }
        }
        self.arena.deinit();
    }
}

// placeholder until the first job
idle_job :: fn(i: usize) {}

// worker loop: wait for a job, work it, signal, repeat
run_pool_worker :: fn(p: *void) -> u32 {
    pool := unsafe (p as *Pool);
    seen: u64 = 0;
    while true {
        pool.mu.lock();
        while pool.round == seen && !pool.stopping { pool.wake.wait(&pool.mu); }
        if pool.stopping {
            pool.mu.unlock();
            return 0;
        }
        seen = pool.round;
        f := pool.job;
        pool.mu.unlock();
        pool.work(f);
        pool.mu.lock();
        pool.working -= 1;
        last := pool.working == 0;
        pool.mu.unlock();
        if last { pool.finished.broadcast(); }
    }
    return 0;
}

// one loop on a throwaway pool (a thread start per core); reuse a Pool for many loops
#spawns
pub parallel :: fn(start: usize, end: usize, f: fn(usize)) {
    pool := Pool::make();
    pool.range(start, end, f);
    pool.deinit();
}

// std.uefi: the firmware's services, for a program built with --target uefi
// println works as everywhere; the console is the firmware's

// the system table the firmware started the program with
pub system_table :: fn() -> *EfiSystemTable {
    return efi_system_table();
}

// the program's image handle
pub image :: fn() -> usize {
    return efi_image;
}

// waits `us` microseconds
pub stall :: fn(us: usize) {
    ignored := efi_system_table().boot_services.stall(us);
}

// clears the console
pub clear :: fn() {
    out := efi_system_table().con_out;
    ignored := out.clear_screen(out);
}

// turns the machine off; ends QEMU
#noreturn
pub shutdown :: fn() {
    efi_system_table().runtime_services.reset_system(2u32, 0usize, 0usize, 0usize);
    while true {}
}

#noreturn
pub reboot :: fn() {
    efi_system_table().runtime_services.reset_system(0u32, 0usize, 0usize, 0usize);
    while true {}
}

// ---- keys ----

// `char` is the character typed, 0 for a special key; `scan` the key's scan code then
pub Key :: struct {
    char: u16,
    scan: u16,
}

// waits for a key
pub read_key :: fn() -> Key {
    st := efi_system_table();
    input := st.con_in;
    index: usize = 0usize;
    ignored := st.boot_services.wait_for_event(1usize, &input.wait_for_key, &index);
    k: EfiInputKey = .{ .scan_code = 0u16, .unicode_char = 0u16 };
    ignored2 := input.read_key_stroke(input, &k);
    return .{ .char = k.unicode_char, .scan = k.scan_code };
}

// ---- graphics ----

GopModeInfo :: struct {
    version: u32,
    horizontal_resolution: u32,
    vertical_resolution: u32,
    // 0 rgb, 1 bgr, 2 bit masks, 3 blt only (no framebuffer)
    pixel_format: u32,
    red_mask: u32,
    green_mask: u32,
    blue_mask: u32,
    reserved_mask: u32,
    pixels_per_scan_line: u32,
}

GopMode :: struct {
    max_mode: u32,
    mode: u32,
    info: *GopModeInfo,
    size_of_info: usize,
    frame_buffer_base: u64,
    frame_buffer_size: usize,
}

Gop :: struct {
    query_mode: usize,
    set_mode: usize,
    blt: usize,
    mode: *GopMode,
}

// EFI_GRAPHICS_OUTPUT_PROTOCOL_GUID
GOP_GUID: EfiGuid = .{
    .data1 = 0x9042a9deu32,
    .data2 = 0x23dcu16,
    .data3 = 0x4a38u16,
    .data4 = .{ 0x96u8, 0xfbu8, 0x7au8, 0xdeu8, 0xd0u8, 0x80u8, 0x51u8, 0x6au8 },
};

// 32-bit pixels, `stride` pixels per line; `bgr` when blue is the low byte
pub Framebuffer :: struct {
    base: usize,
    width: u32,
    height: u32,
    stride: u32,
    bgr: bool,

    // `rgb` as 0xRRGGBB; nothing outside the screen
    pub put :: fn(self: *const Self, x: u32, y: u32, rgb: u32) {
        if x >= self.width || y >= self.height { return; }
        v := rgb;
        if self.bgr { v = rgb; } else { v = ((rgb & 0xFFu32) << 16u32) | (rgb & 0xFF00u32) | ((rgb >> 16u32) & 0xFFu32); }
        p := unsafe core::ptr_from_int(*u32, self.base + ((y as usize) * (self.stride as usize) + (x as usize)) * 4usize);
        unsafe { *p = v; }
    }

    // a filled rectangle
    pub fill :: fn(self: *const Self, x: u32, y: u32, w: u32, h: u32, rgb: u32) {
        for j in 0u32..h {
            for i in 0u32..w { self.put(x + i, y + j, rgb); }
        }
    }
}

// the screen of the graphics output protocol; null without one
pub framebuffer :: fn() -> ?Framebuffer {
    raw: usize = 0usize;
    if efi_system_table().boot_services.locate_protocol(&GOP_GUID, 0usize, &raw) != 0usize { return null; }
    if raw == 0usize { return null; }
    gop := unsafe core::ptr_from_int(*Gop, raw);
    info := gop.mode.info;
    if info.pixel_format > 1u32 { return null; }
    return .{
        .base = gop.mode.frame_buffer_base as usize,
        .width = info.horizontal_resolution,
        .height = info.vertical_resolution,
        .stride = info.pixels_per_scan_line,
        .bgr = info.pixel_format == 1u32,
    };
}

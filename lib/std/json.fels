// SPDX-License-Identifier: Apache-2.0
// std.json — reading JSON (RFC 8259): the text becomes a tree of values in an arena, to look
// into with `get` (a member of an object), `at` (an element of an array) and the `as_*`
// readers.
//
//   doc := json::parse(text, &a) catch err { ... };      // a JsonError
//   quote := doc.get("chart").get("result").at(0);
//   for t in quote.get("timestamp").items { day := t.as_i64() ?? 0i64; ... }
//
// A lookup that finds nothing gives a null value, so a chain of them needs no checks on the
// way; an `as_*` reader gives null for a value of another kind. A number keeps the text it was
// written as (for a decimal type, or digits an f64 cannot hold) next to its f64, which is exact
// for numbers of up to 15 digits. Strings are unescaped, a \u escape (also a surrogate pair) as
// UTF-8; a string without escapes is a slice of the text. Nesting deeper than 512 is refused.

#import std.heap.{ Arena };
#import std.vec as vec;
#import std.vec.{ Vec };

pub JsonError :: errors {
    unexpected_end,     // the text ends inside a value
    unexpected_byte,    // a byte that cannot stand where it stands
    bad_number,
    bad_string,         // a bad escape, or a control character in a string
    too_deep,           // arrays and objects nested deeper than 512
    trailing_text,      // something after the value
}

pub Kind :: enum { null_value, boolean, number, string, array, object }

pub Value :: struct {
    kind: Kind,
    flag: bool,             // the value of a boolean
    number: f64,            // the value of a number
    text: []const u8,       // the value of a string, or a number as it was written
    items: []Value,         // the elements of an array, or the values of an object's members
    keys: [][]const u8,     // the names of an object's members, in the order of `items`

    // The member `key` of an object (the first of that name); null when there is none, or for
    // a value that is no object.
    pub get :: fn(self: Self, key: []const u8) -> Value {
        if self.kind == .object {
            i: usize = 0;
            while i < self.keys.len {
                if self.keys[i] == key { return self.items[i]; }
                i += 1;
            }
        }
        return null_value();
    }

    // Element `i` of an array; null past its end, or for a value that is no array.
    pub at :: fn(self: Self, i: usize) -> Value {
        if self.kind == .array && i < self.items.len { return self.items[i]; }
        return null_value();
    }

    // How many elements an array has, or members an object; 0 for any other value.
    pub len :: fn(self: Self) -> usize {
        if self.kind == .array || self.kind == .object { return self.items.len; }
        return 0;
    }

    pub is_null :: fn(self: Self) -> bool { return self.kind == .null_value; }

    pub as_f64 :: fn(self: Self) -> ?f64 {
        if self.kind == .number { return self.number; }
        return null;
    }

    // A number that is a whole number and fits an i64 (exact for up to 18 digits).
    pub as_i64 :: fn(self: Self) -> ?i64 {
        if self.kind != .number { return null; }
        exact := whole(self.text);
        if exact != null { return exact; }
        if self.number != self.number { return null; }
        if self.number < -9223372036854774784.0 || self.number > 9223372036854774784.0 { return null; }
        n := self.number as i64;
        if (n as f64) != self.number { return null; }
        return n;
    }

    pub as_text :: fn(self: Self) -> ?[]const u8 {
        if self.kind == .string { return self.text; }
        return null;
    }

    pub as_bool :: fn(self: Self) -> ?bool {
        if self.kind == .boolean { return self.flag; }
        return null;
    }
}

// The null value, which a lookup that finds nothing gives too.
pub null_value :: fn() -> Value {
    none: [0]Value = .{};
    names: [0][]const u8 = .{};
    out: Value = .{ .null_value, false, 0.0, "", none[:], names[:] };
    return out;
}

// The value `text` holds, in `a`. A UTF-8 byte order mark at the start is skipped.
pub parse :: fn(text: []const u8, a: *Arena) -> Value ! JsonError {
    p: Parser = .{ text, 0, a, 0 };
    if text.len >= 3 && text[0] == 0xEF && text[1] == 0xBB && text[2] == 0xBF { p.at = 3; }
    v := value(&p)?;
    skip_space(&p);
    if p.at < p.text.len { fail .trailing_text; }
    return v;
}

MAX_DEPTH :: 512u32;
TEN_22 :: 10000000000000000000000.0;

QUOTE :: 34u8;
BACKSLASH :: 92u8;

Parser :: struct {
    text: []const u8,
    at: usize,
    a: *Arena,
    depth: u32,
}

value :: fn(p: *Parser) -> Value ! JsonError {
    skip_space(p);
    if p.at >= p.text.len { fail .unexpected_end; }
    c := p.text[p.at];
    if c == 123 { return object(p); }
    if c == 91 { return array(p); }
    if c == QUOTE {
        s := string(p)?;
        out := null_value();
        out.kind = .string;
        out.text = s;
        return out;
    }
    if c == 116 {
        word(p, "true")?;
        out := null_value();
        out.kind = .boolean;
        out.flag = true;
        return out;
    }
    if c == 102 {
        word(p, "false")?;
        out := null_value();
        out.kind = .boolean;
        return out;
    }
    if c == 110 {
        word(p, "null")?;
        return null_value();
    }
    if c == 45 || is_digit(c) { return number(p); }
    fail .unexpected_byte;
}

object :: fn(p: *Parser) -> Value ! JsonError {
    p.depth += 1;
    if p.depth > MAX_DEPTH { fail .too_deep; }
    p.at += 1;
    keys := vec::make([]const u8, p.a);
    items := vec::make(Value, p.a);
    skip_space(p);
    if p.at < p.text.len && p.text[p.at] == 125 {
        p.at += 1;
    } else {
        while true {
            skip_space(p);
            if p.at >= p.text.len { fail .unexpected_end; }
            if p.text[p.at] != QUOTE { fail .unexpected_byte; }
            k := string(p)?;
            skip_space(p);
            if p.at >= p.text.len { fail .unexpected_end; }
            if p.text[p.at] != 58 { fail .unexpected_byte; }
            p.at += 1;
            v := value(p)?;
            keys.push(k);
            items.push(v);
            if end_of(p, 125)? { break; }
        }
    }
    p.depth -= 1;
    out := null_value();
    out.kind = .object;
    out.items = items.items();
    out.keys = keys.items();
    return out;
}

array :: fn(p: *Parser) -> Value ! JsonError {
    p.depth += 1;
    if p.depth > MAX_DEPTH { fail .too_deep; }
    p.at += 1;
    items := vec::make(Value, p.a);
    skip_space(p);
    if p.at < p.text.len && p.text[p.at] == 93 {
        p.at += 1;
    } else {
        while true {
            v := value(p)?;
            items.push(v);
            if end_of(p, 93)? { break; }
        }
    }
    p.depth -= 1;
    out := null_value();
    out.kind = .array;
    out.items = items.items();
    return out;
}

// After a member or an element: true at `close`, false at a comma (both read).
end_of :: fn(p: *Parser, close: u8) -> bool ! JsonError {
    skip_space(p);
    if p.at >= p.text.len { fail .unexpected_end; }
    c := p.text[p.at];
    p.at += 1;
    if c == close { return true; }
    if c == 44 { return false; }
    fail .unexpected_byte;
}

// The string that starts at the quote at `p.at`, unescaped: a slice of the text when it has no
// escapes, else a copy in the arena.
string :: fn(p: *Parser) -> []const u8 ! JsonError {
    p.at += 1;
    start := p.at;
    while p.at < p.text.len {
        c := p.text[p.at];
        if c == QUOTE {
            plain := p.text[start..p.at];
            p.at += 1;
            return plain;
        }
        if c == BACKSLASH { break; }
        if c < 32 { fail .bad_string; }
        p.at += 1;
    }
    if p.at >= p.text.len { fail .unexpected_end; }
    out := vec::make(u8, p.a);
    out.extend(p.text[start..p.at]);
    while p.at < p.text.len {
        c := p.text[p.at];
        if c == QUOTE {
            p.at += 1;
            return out.items();
        }
        if c < 32 { fail .bad_string; }
        p.at += 1;
        if c != BACKSLASH {
            out.push(c);
            continue;
        }
        if p.at >= p.text.len { fail .unexpected_end; }
        e := p.text[p.at];
        p.at += 1;
        if e == QUOTE || e == BACKSLASH || e == 47 {
            out.push(e);
        } else if e == 98 {
            out.push(8);
        } else if e == 102 {
            out.push(12);
        } else if e == 110 {
            out.push(10);
        } else if e == 114 {
            out.push(13);
        } else if e == 116 {
            out.push(9);
        } else if e == 117 {
            cp := hex4(p)?;
            if cp >= 0xDC00 && cp < 0xE000 { fail .bad_string; }
            if cp >= 0xD800 && cp < 0xDC00 {
                // a surrogate pair: the low half must follow
                if p.at + 2 > p.text.len || p.text[p.at] != BACKSLASH || p.text[p.at + 1] != 117 { fail .bad_string; }
                p.at += 2;
                low := hex4(p)?;
                if low < 0xDC00 || low >= 0xE000 { fail .bad_string; }
                cp = 0x10000 + ((cp - 0xD800) << 10) + (low - 0xDC00);
            }
            utf8(&out, cp);
        } else {
            fail .bad_string;
        }
    }
    fail .unexpected_end;
}

// The four hex digits at `p.at`.
hex4 :: fn(p: *Parser) -> u32 ! JsonError {
    if p.at + 4 > p.text.len { fail .unexpected_end; }
    v: u32 = 0;
    i: usize = 0;
    while i < 4 {
        c := p.text[p.at + i];
        d: u32 = 0;
        if is_digit(c) {
            d = (c - 48) as u32;
        } else if c >= 97 && c <= 102 {
            d = ((c - 97) as u32) + 10;
        } else if c >= 65 && c <= 70 {
            d = ((c - 65) as u32) + 10;
        } else {
            fail .bad_string;
        }
        v = v * 16 + d;
        i += 1;
    }
    p.at += 4;
    return v;
}

// `cp` as UTF-8 at the end of `out`.
utf8 :: fn(out: *Vec(u8), cp: u32) {
    if cp < 0x80 {
        out.push(cp as u8);
    } else if cp < 0x800 {
        out.push(0xC0 | ((cp >> 6) as u8));
        out.push(0x80 | ((cp & 0x3F) as u8));
    } else if cp < 0x10000 {
        out.push(0xE0 | ((cp >> 12) as u8));
        out.push(0x80 | (((cp >> 6) & 0x3F) as u8));
        out.push(0x80 | ((cp & 0x3F) as u8));
    } else {
        out.push(0xF0 | ((cp >> 18) as u8));
        out.push(0x80 | (((cp >> 12) & 0x3F) as u8));
        out.push(0x80 | (((cp >> 6) & 0x3F) as u8));
        out.push(0x80 | ((cp & 0x3F) as u8));
    }
}

// The number at `p.at`: a minus, the whole part (no leading zero), a fraction, an exponent.
number :: fn(p: *Parser) -> Value ! JsonError {
    start := p.at;
    if p.text[p.at] == 45 { p.at += 1; }
    if p.at >= p.text.len { fail .bad_number; }
    if p.text[p.at] == 48 {
        p.at += 1;
    } else if is_digit(p.text[p.at]) {
        digits(p);
    } else {
        fail .bad_number;
    }
    if p.at < p.text.len && p.text[p.at] == 46 {
        p.at += 1;
        if p.at >= p.text.len || !is_digit(p.text[p.at]) { fail .bad_number; }
        digits(p);
    }
    if p.at < p.text.len && (p.text[p.at] == 101 || p.text[p.at] == 69) {
        p.at += 1;
        if p.at < p.text.len && (p.text[p.at] == 43 || p.text[p.at] == 45) { p.at += 1; }
        if p.at >= p.text.len || !is_digit(p.text[p.at]) { fail .bad_number; }
        digits(p);
    }
    out := null_value();
    out.kind = .number;
    out.text = p.text[start..p.at];
    out.number = to_f64(out.text);
    return out;
}

digits :: fn(p: *Parser) {
    while p.at < p.text.len && is_digit(p.text[p.at]) { p.at += 1; }
}

// The value of a number written as JSON writes it (checked before): its first 19 digits as a
// whole number, times a power of ten.
to_f64 :: fn(text: []const u8) -> f64 {
    i: usize = 0;
    negative := false;
    if text[0] == 45 {
        negative = true;
        i = 1;
    }
    mantissa: u64 = 0;
    kept: u32 = 0;
    exp: i64 = 0;
    while i < text.len && is_digit(text[i]) {
        if kept < 19 {
            mantissa = mantissa * 10 + ((text[i] - 48) as u64);
            if mantissa != 0 { kept += 1; }
        } else {
            exp += 1;
        }
        i += 1;
    }
    if i < text.len && text[i] == 46 {
        i += 1;
        while i < text.len && is_digit(text[i]) {
            if kept < 19 {
                mantissa = mantissa * 10 + ((text[i] - 48) as u64);
                if mantissa != 0 { kept += 1; }
                exp -= 1;
            }
            i += 1;
        }
    }
    if i < text.len {
        i += 1;
        sign: i64 = 1;
        if text[i] == 45 {
            sign = -1;
            i += 1;
        } else if text[i] == 43 {
            i += 1;
        }
        e: i64 = 0;
        while i < text.len {
            // beyond this an f64 is infinite or 0 anyway
            if e < 1000 { e = e * 10 + ((text[i] - 48) as i64); }
            i += 1;
        }
        exp += sign * e;
    }
    v := mantissa as f64;
    if mantissa != 0 {
        // powers of ten up to 10^22 are exact, so a number of up to 15 digits is too
        while exp > 22 {
            v *= TEN_22;
            exp -= 22;
        }
        while exp < -22 {
            v /= TEN_22;
            exp += 22;
        }
        if exp > 0 {
            v *= power(exp);
        } else if exp < 0 {
            v /= power(0 - exp);
        }
    }
    if negative { return 0.0 - v; }
    return v;
}

// 10^n for n up to 22, exact.
power :: fn(n: i64) -> f64 {
    v: f64 = 1.0;
    i: i64 = 0;
    while i < n {
        v *= 10.0;
        i += 1;
    }
    return v;
}

// The whole number `text` writes, when it is one of up to 18 digits.
whole :: fn(text: []const u8) -> ?i64 {
    i: usize = 0;
    negative := text.len > 0 && text[0] == 45;
    if negative { i = 1; }
    if text.len - i == 0 || text.len - i > 18 { return null; }
    n: i64 = 0;
    while i < text.len {
        if !is_digit(text[i]) { return null; }
        n = n * 10 + ((text[i] - 48) as i64);
        i += 1;
    }
    if negative { return 0 - n; }
    return n;
}

skip_space :: fn(p: *Parser) {
    while p.at < p.text.len {
        c := p.text[p.at];
        if c != 32 && c != 9 && c != 10 && c != 13 { return; }
        p.at += 1;
    }
}

// The literal `w` at `p.at`.
word :: fn(p: *Parser, w: []const u8) -> void ! JsonError {
    if p.at + w.len > p.text.len { fail .unexpected_end; }
    if p.text[p.at..(p.at + w.len)] != w { fail .unexpected_byte; }
    p.at += w.len;
}

is_digit :: fn(c: u8) -> bool { return c >= 48u8 && c <= 57u8; }

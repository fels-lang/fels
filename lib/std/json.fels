// SPDX-License-Identifier: Apache-2.0
// std.json: rfc 8259; parse into an arena tree, write with Out

#import std.heap.{ Arena };
#import std.fmt as fmt;
#import std.vec as vec;
#import std.vec.{ Vec };
#import std.io as io;
#import std.io.{ Writer, IoError };
#import std.strings as strings;

pub JsonError :: errors {
    unexpected_end,     // the text ends inside a value
    unexpected_byte,    // a byte that cannot stand where it stands
    bad_number,
    bad_string,         // bad escape or control char in a string
    too_deep,           // arrays and objects nested deeper than 512
    trailing_text,      // something after the value
}

pub Kind :: enum { null_value, boolean, number, string, array, object }

pub Value :: struct {
    kind: Kind,
    flag: bool,             // the value of a boolean
    number: f64,            // the value of a number
    text: []const u8,       // string value, or a number's source text
    items: []Value,         // array elements or object member values
    keys: [][]const u8,     // object member names, parallel to `items`

    // first member named key; null value if none or not an object
    pub get :: fn(self: Self, key: []const u8) -> Value {
        if self.kind == .object {
            i: usize = 0;
            while i < self.keys.len {
                if self.keys[i] == key { return self.items[i]; }
                i += 1;
            }
        }
        return null_value();
    }

    // null value past the end or if not an array
    pub at :: fn(self: Self, i: usize) -> Value {
        if self.kind == .array && i < self.items.len { return self.items[i]; }
        return null_value();
    }

    // elements or members; 0 for anything else
    pub len :: fn(self: Self) -> usize {
        if self.kind == .array || self.kind == .object { return self.items.len; }
        return 0;
    }

    pub is_null :: fn(self: Self) -> bool { return self.kind == .null_value; }

    pub as_f64 :: fn(self: Self) -> ?f64 {
        if self.kind == .number { return self.number; }
        return null;
    }

    // whole numbers that fit i64; exact over the full range
    pub as_i64 :: fn(self: Self) -> ?i64 {
        if self.kind != .number { return null; }
        exact := whole(self.text);
        if exact != null { return exact; }
        if self.number != self.number { return null; }
        if self.number < -9223372036854774784.0 || self.number > 9223372036854774784.0 { return null; }
        n := self.number as i64;
        if (n as f64) != self.number { return null; }
        return n;
    }

    pub as_text :: fn(self: Self) -> ?[]const u8 {
        if self.kind == .string { return self.text; }
        return null;
    }

    pub as_bool :: fn(self: Self) -> ?bool {
        if self.kind == .boolean { return self.flag; }
        return null;
    }
}

// also what failed lookups return, so lookup chains need no checks
pub null_value :: fn() -> Value {
    none: [0]Value = .{};
    names: [0][]const u8 = .{};
    out: Value = .{ .null_value, false, 0.0, "", none[:], names[:] };
    return out;
}

// tree in `a`; skips a utf-8 bom; escape-free strings slice `text`; max depth 512
pub parse :: fn(text: []const u8, a: *Arena) -> Value ! JsonError {
    p: Parser = .{ text, 0, a, 0 };
    if text.len >= 3 && text[0] == 0xEF && text[1] == 0xBB && text[2] == 0xBF { p.at = 3; }
    v := value(&p)?;
    skip_space(&p);
    if p.at < p.text.len { fail .trailing_text; }
    return v;
}

MAX_DEPTH :: 512u32;
TEN_22 :: 10000000000000000000000.0;

QUOTE :: 34u8;
BACKSLASH :: 92u8;

Parser :: struct {
    text: []const u8,
    at: usize,
    a: *Arena,
    depth: u32,
}

value :: fn(p: *Parser) -> Value ! JsonError {
    skip_space(p);
    if p.at >= p.text.len { fail .unexpected_end; }
    c := p.text[p.at];
    if c == 123 { return object(p); }
    if c == 91 { return array(p); }
    if c == QUOTE {
        s := string(p)?;
        out := null_value();
        out.kind = .string;
        out.text = s;
        return out;
    }
    if c == 116 {
        word(p, "true")?;
        out := null_value();
        out.kind = .boolean;
        out.flag = true;
        return out;
    }
    if c == 102 {
        word(p, "false")?;
        out := null_value();
        out.kind = .boolean;
        return out;
    }
    if c == 110 {
        word(p, "null")?;
        return null_value();
    }
    if c == 45 || is_digit(c) { return number(p); }
    fail .unexpected_byte;
}

object :: fn(p: *Parser) -> Value ! JsonError {
    p.depth += 1;
    if p.depth > MAX_DEPTH { fail .too_deep; }
    p.at += 1;
    keys := vec::make([]const u8, p.a);
    items := vec::make(Value, p.a);
    skip_space(p);
    if p.at < p.text.len && p.text[p.at] == 125 {
        p.at += 1;
    } else {
        while true {
            skip_space(p);
            if p.at >= p.text.len { fail .unexpected_end; }
            if p.text[p.at] != QUOTE { fail .unexpected_byte; }
            k := string(p)?;
            skip_space(p);
            if p.at >= p.text.len { fail .unexpected_end; }
            if p.text[p.at] != 58 { fail .unexpected_byte; }
            p.at += 1;
            v := value(p)?;
            keys.push(k);
            items.push(v);
            if end_of(p, 125)? { break; }
        }
    }
    p.depth -= 1;
    out := null_value();
    out.kind = .object;
    out.items = items.items();
    out.keys = keys.items();
    return out;
}

array :: fn(p: *Parser) -> Value ! JsonError {
    p.depth += 1;
    if p.depth > MAX_DEPTH { fail .too_deep; }
    p.at += 1;
    items := vec::make(Value, p.a);
    skip_space(p);
    if p.at < p.text.len && p.text[p.at] == 93 {
        p.at += 1;
    } else {
        while true {
            v := value(p)?;
            items.push(v);
            if end_of(p, 93)? { break; }
        }
    }
    p.depth -= 1;
    out := null_value();
    out.kind = .array;
    out.items = items.items();
    return out;
}

// after a member/element: true at close, false at a comma (both consumed)
end_of :: fn(p: *Parser, close: u8) -> bool ! JsonError {
    skip_space(p);
    if p.at >= p.text.len { fail .unexpected_end; }
    c := p.text[p.at];
    p.at += 1;
    if c == close { return true; }
    if c == 44 { return false; }
    fail .unexpected_byte;
}

// string at the quote at p.at; slice of text if no escapes, else unescaped copy in arena
string :: fn(p: *Parser) -> []const u8 ! JsonError {
    p.at += 1;
    start := p.at;
    while p.at < p.text.len {
        c := p.text[p.at];
        if c == QUOTE {
            plain := p.text[start..p.at];
            p.at += 1;
            return plain;
        }
        if c == BACKSLASH { break; }
        if c < 32 { fail .bad_string; }
        p.at += 1;
    }
    if p.at >= p.text.len { fail .unexpected_end; }
    out := vec::make(u8, p.a);
    out.extend(p.text[start..p.at]);
    while p.at < p.text.len {
        c := p.text[p.at];
        if c == QUOTE {
            p.at += 1;
            return out.items();
        }
        if c < 32 { fail .bad_string; }
        p.at += 1;
        if c != BACKSLASH {
            out.push(c);
            continue;
        }
        if p.at >= p.text.len { fail .unexpected_end; }
        e := p.text[p.at];
        p.at += 1;
        if e == QUOTE || e == BACKSLASH || e == 47 {
            out.push(e);
        } else if e == 98 {
            out.push(8);
        } else if e == 102 {
            out.push(12);
        } else if e == 110 {
            out.push(10);
        } else if e == 114 {
            out.push(13);
        } else if e == 116 {
            out.push(9);
        } else if e == 117 {
            cp := hex4(p)?;
            if cp >= 0xDC00 && cp < 0xE000 { fail .bad_string; }
            if cp >= 0xD800 && cp < 0xDC00 {
                // a surrogate pair: the low half must follow
                if p.at + 2 > p.text.len || p.text[p.at] != BACKSLASH || p.text[p.at + 1] != 117 { fail .bad_string; }
                p.at += 2;
                low := hex4(p)?;
                if low < 0xDC00 || low >= 0xE000 { fail .bad_string; }
                cp = 0x10000 + ((cp - 0xD800) << 10) + (low - 0xDC00);
            }
            utf8(&out, cp);
        } else {
            fail .bad_string;
        }
    }
    fail .unexpected_end;
}

// 4 hex digits at p.at
hex4 :: fn(p: *Parser) -> u32 ! JsonError {
    if p.at + 4 > p.text.len { fail .unexpected_end; }
    v: u32 = 0;
    i: usize = 0;
    while i < 4 {
        c := p.text[p.at + i];
        d: u32 = 0;
        if is_digit(c) {
            d = (c - 48) as u32;
        } else if c >= 97 && c <= 102 {
            d = ((c - 97) as u32) + 10;
        } else if c >= 65 && c <= 70 {
            d = ((c - 65) as u32) + 10;
        } else {
            fail .bad_string;
        }
        v = v * 16 + d;
        i += 1;
    }
    p.at += 4;
    return v;
}

// appends cp as utf-8
utf8 :: fn(out: *Vec(u8), cp: u32) {
    if cp < 0x80 {
        out.push(cp as u8);
    } else if cp < 0x800 {
        out.push(0xC0 | ((cp >> 6) as u8));
        out.push(0x80 | ((cp & 0x3F) as u8));
    } else if cp < 0x10000 {
        out.push(0xE0 | ((cp >> 12) as u8));
        out.push(0x80 | (((cp >> 6) & 0x3F) as u8));
        out.push(0x80 | ((cp & 0x3F) as u8));
    } else {
        out.push(0xF0 | ((cp >> 18) as u8));
        out.push(0x80 | (((cp >> 12) & 0x3F) as u8));
        out.push(0x80 | (((cp >> 6) & 0x3F) as u8));
        out.push(0x80 | ((cp & 0x3F) as u8));
    }
}

// minus, int part (no leading zero), fraction, exponent
number :: fn(p: *Parser) -> Value ! JsonError {
    start := p.at;
    if p.text[p.at] == 45 { p.at += 1; }
    if p.at >= p.text.len { fail .bad_number; }
    if p.text[p.at] == 48 {
        p.at += 1;
    } else if is_digit(p.text[p.at]) {
        digits(p);
    } else {
        fail .bad_number;
    }
    if p.at < p.text.len && p.text[p.at] == 46 {
        p.at += 1;
        if p.at >= p.text.len || !is_digit(p.text[p.at]) { fail .bad_number; }
        digits(p);
    }
    if p.at < p.text.len && (p.text[p.at] == 101 || p.text[p.at] == 69) {
        p.at += 1;
        if p.at < p.text.len && (p.text[p.at] == 43 || p.text[p.at] == 45) { p.at += 1; }
        if p.at >= p.text.len || !is_digit(p.text[p.at]) { fail .bad_number; }
        digits(p);
    }
    out := null_value();
    out.kind = .number;
    out.text = p.text[start..p.at];
    // checked above, so it parses
    out.number = fmt::parse_float(out.text) catch e { yield 0.0; };
    return out;
}

digits :: fn(p: *Parser) {
    while p.at < p.text.len && is_digit(p.text[p.at]) { p.at += 1; }
}

// text as i64, if it is a whole number that fits
whole :: fn(text: []const u8) -> ?i64 {
    return fmt::parse_int(i64, text, 10) catch e { return null; };
}

skip_space :: fn(p: *Parser) {
    while p.at < p.text.len {
        c := p.text[p.at];
        if c != 32 && c != 9 && c != 10 && c != 13 { return; }
        p.at += 1;
    }
}

// expects literal w at p.at
word :: fn(p: *Parser, w: []const u8) -> void ! JsonError {
    if p.at + w.len > p.text.len { fail .unexpected_end; }
    if p.text[p.at..(p.at + w.len)] != w { fail .unexpected_byte; }
    p.at += w.len;
}

is_digit :: fn(c: u8) -> bool { return c >= 48u8 && c <= 57u8; }

// writing

// streaming writer; does commas, quotes, escapes; write errors show in finish
pub Out :: struct {
    w: *Writer,
    indent: usize,     // spaces a level; 0 writes it all on one line
    depth: usize,
    first: bool,       // nothing written yet at this depth
    after_key: bool,   // a key was written: its value comes next
    failed: bool,

    put :: fn(self: *Self, s: []const u8) {
        if self.failed { return; }
        n := io::write_all(self.w, s) catch err {
            self.failed = true;
            yield 0usize;
        };
    }

    newline :: fn(self: *Self) {
        if self.indent == 0 || self.failed { return; }
        self.put("\n");
        n := io::write_repeat(self.w, ' ', self.depth * self.indent) catch err {
            self.failed = true;
            yield 0usize;
        };
    }

    // comma + newline before a value, unless right after a key
    before :: fn(self: *Self) {
        if self.after_key {
            self.after_key = false;
            return;
        }
        if !self.first { self.put(","); }
        self.first = false;
        if self.depth > 0 { self.newline(); }
    }

    pub begin_object :: fn(self: *Self) {
        self.before();
        self.put("{");
        self.depth += 1;
        self.first = true;
    }

    pub end_object :: fn(self: *Self) {
        self.depth -= 1;
        if !self.first { self.newline(); }
        self.put("}");
        self.first = false;
    }

    pub begin_array :: fn(self: *Self) {
        self.before();
        self.put("[");
        self.depth += 1;
        self.first = true;
    }

    pub end_array :: fn(self: *Self) {
        self.depth -= 1;
        if !self.first { self.newline(); }
        self.put("]");
        self.first = false;
    }

    // next member's name; write its value right after
    pub key :: fn(self: *Self, name: []const u8) {
        self.before();
        self.quoted(name);
        self.put(if self.indent > 0 { ": " } else { ":" });
        self.after_key = true;
    }

    pub string :: fn(self: *Self, s: []const u8) {
        self.before();
        self.quoted(s);
    }

    pub int :: fn(self: *Self, v: i64) {
        self.before();
        if self.failed { return; }
        n := io::write_i64(self.w, v) catch err {
            self.failed = true;
            yield 0usize;
        };
    }

    pub uint :: fn(self: *Self, v: u64) {
        self.before();
        if self.failed { return; }
        n := io::write_u64(self.w, v) catch err {
            self.failed = true;
            yield 0usize;
        };
    }

    // up to 15 significant digits; NaN/inf written as null
    pub float :: fn(self: *Self, v: f64) {
        if v != v || v > 1.7976931348623157e308 || v < -1.7976931348623157e308 {
            self.null_value();
            return;
        }
        self.before();
        if self.failed { return; }
        n := io::write_fmt(self.w, "{v}") catch err {
            self.failed = true;
            yield 0usize;
        };
    }

    pub boolean :: fn(self: *Self, v: bool) {
        self.before();
        self.put(if v { "true" } else { "false" });
    }

    pub null_value :: fn(self: *Self) {
        self.before();
        self.put("null");
    }

    // whole tree; numbers written as they were read
    pub value :: fn(self: *Self, v: Value) {
        match v.kind {
            .null_value => { self.null_value(); },
            .boolean => { self.boolean(v.flag); },
            .number => {
                if v.text.len > 0 {
                    self.before();
                    self.put(v.text);
                } else {
                    self.float(v.number);
                }
            },
            .string => { self.string(v.text); },
            .array => {
                self.begin_array();
                for item in v.items { self.value(item); }
                self.end_array();
            },
            .object => {
                self.begin_object();
                for i in 0..v.items.len {
                    self.key(v.keys[i]);
                    self.value(v.items[i]);
                }
                self.end_object();
            },
        }
    }

    // .write_failed if any write failed
    pub finish :: fn(self: *Self) -> void ! IoError {
        if self.failed { fail .write_failed; }
    }

    // quoted; escapes ", \ and control chars
    quoted :: fn(self: *Self, s: []const u8) {
        self.put("\"");
        start: usize = 0;
        for i in 0..s.len {
            c := s[i];
            if c == '"' || c == '\\' || c < 0x20 {
                self.put(s[start..i]);
                if c == '"' { self.put("\\\""); }
                else if c == '\\' { self.put("\\\\"); }
                else if c == '\n' { self.put("\\n"); }
                else if c == '\r' { self.put("\\r"); }
                else if c == '\t' { self.put("\\t"); }
                else if c == 8 { self.put("\\b"); }
                else if c == 12 { self.put("\\f"); }
                else {
                    esc: [6]u8 = .{ '\\', 'u', '0', '0', HEX_DIGITS[(c >> 4) as usize], HEX_DIGITS[(c & 15) as usize] };
                    self.put(esc[:]);
                }
                start = i + 1;
            }
        }
        self.put(s[start..s.len]);
        self.put("\"");
    }
}

HEX_DIGITS :: "0123456789abcdef";

// single line
pub writer :: fn(w: *Writer) -> Out {
    o: Out = .{ w, 0, 0, true, false, false };
    return o;
}

// one member/element per line, indent spaces per level
pub pretty :: fn(w: *Writer, indent: usize) -> Out {
    o: Out = .{ w, indent, 0, true, false, false };
    return o;
}

// one line, in `a`
pub stringify :: fn(a: *Arena, v: Value) -> []const u8 {
    sb := strings::builder(a);
    o := writer(&sb);
    o.value(v);
    return strings::str(&sb);
}

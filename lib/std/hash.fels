// crc32("123456789") == 0xCBF43926
pub crc32 :: fn(data: []const u8) -> u32 {
    h := crc32_start();
    crc32_add(&h, data);
    return h.final();
}

// streaming; from crc32_start
pub Crc32 :: struct {
    crc: u32,

    pub update :: fn(self: *Self, data: []const u8) { crc32_add(self, data); }
    pub final :: fn(self: *Self) -> u32 { return self.crc ^ 0xFFFFFFFF; }
}

Crc32 as Hasher {
    update :: fn(self: *Self, data: []const u8) { crc32_add(self, data); }
}

crc32_add :: fn(self: *Crc32, data: []const u8) {
    c := self.crc;
    for b in data { c = CRC_TABLE[((c ^ (b as u32)) & 0xFF) as usize] ^ (c >> 8); }
    self.crc = c;
}

pub crc32_start :: fn() -> Crc32 {
    h: Crc32 = .{ 0xFFFFFFFF };
    return h;
}

// XXH64: 32-byte rounds in four lanes

P1 :: 0x9E3779B185EBCA87u64;
P2 :: 0xC2B2AE3D27D4EB4Fu64;
P3 :: 0x165667B19E3779F9u64;
P4 :: 0x85EBCA77C2B2AE63u64;
P5 :: 0x27D4EB2F165667C5u64;

rotl :: fn(x: u64, r: u64) -> u64 { return (x << r) | (x >> (64 - r)); }

le64 :: fn(b: []const u8, i: usize) -> u64 {
    v: u64 = 0;
    for k in 0..8 { v = v | ((b[i + k] as u64) << ((8 * k) as u64)); }
    return v;
}

le32 :: fn(b: []const u8, i: usize) -> u64 {
    v: u64 = 0;
    for k in 0..4 { v = v | ((b[i + k] as u64) << ((8 * k) as u64)); }
    return v;
}

xx_round :: fn(acc: u64, input: u64) -> u64 {
    return rotl(acc +% (input *% P2), 31) *% P1;
}

xx_merge :: fn(acc: u64, lane: u64) -> u64 {
    return ((acc ^ xx_round(0, lane)) *% P1) +% P4;
}

// fold the four lanes into one value
xx_converge :: fn(v1: u64, v2: u64, v3: u64, v4: u64) -> u64 {
    h := rotl(v1, 1) +% rotl(v2, 7) +% rotl(v3, 12) +% rotl(v4, 18);
    h = xx_merge(h, v1);
    h = xx_merge(h, v2);
    h = xx_merge(h, v3);
    return xx_merge(h, v4);
}

// tail (< 32 bytes) and final mix
xx_finish :: fn(start: u64, rest: []const u8) -> u64 {
    h := start;
    i: usize = 0;
    while i + 8 <= rest.len {
        h = (rotl(h ^ xx_round(0, le64(rest, i)), 27) *% P1) +% P4;
        i += 8;
    }
    if i + 4 <= rest.len {
        h = (rotl(h ^ (le32(rest, i) *% P1), 23) *% P2) +% P3;
        i += 4;
    }
    while i < rest.len {
        h = rotl(h ^ ((rest[i] as u64) *% P5), 11) *% P1;
        i += 1;
    }
    h = (h ^ (h >> 33)) *% P2;
    h = (h ^ (h >> 29)) *% P3;
    return h ^ (h >> 32);
}

// seed 0 is the usual; xxhash64(0, "") == 0xEF46DB3751D8E999
pub xxhash64 :: fn(seed: u64, data: []const u8) -> u64 {
    i: usize = 0;
    h: u64 = 0;
    if data.len >= 32 {
        v1 := seed +% P1 +% P2;
        v2 := seed +% P2;
        v3 := seed;
        v4 := seed -% P1;
        while i + 32 <= data.len {
            v1 = xx_round(v1, le64(data, i));
            v2 = xx_round(v2, le64(data, i + 8));
            v3 = xx_round(v3, le64(data, i + 16));
            v4 = xx_round(v4, le64(data, i + 24));
            i += 32;
        }
        h = xx_converge(v1, v2, v3, v4);
    } else {
        h = seed +% P5;
    }
    return xx_finish(h +% (data.len as u64), data[i..data.len]);
}

// streaming; from xxhash64_start; a partial round waits in `buf`
pub XxHash64 :: struct {
    seed: u64,
    v1: u64,
    v2: u64,
    v3: u64,
    v4: u64,
    buf: [32]u8,
    buffered: usize,
    total: u64,

    pub update :: fn(self: *Self, data: []const u8) { xx_add(self, data); }

    pub final :: fn(self: *Self) -> u64 {
        h: u64 = 0;
        if self.total >= 32 {
            h = xx_converge(self.v1, self.v2, self.v3, self.v4);
        } else {
            h = self.seed +% P5;
        }
        return xx_finish(h +% self.total, self.buf[0..self.buffered]);
    }
}

XxHash64 as Hasher {
    update :: fn(self: *Self, data: []const u8) { xx_add(self, data); }
}

xx_add :: fn(self: *XxHash64, data: []const u8) {
    self.total = self.total +% (data.len as u64);
    i: usize = 0;
    if self.buffered > 0 {
        while self.buffered < 32 && i < data.len {
            self.buf[self.buffered] = data[i];
            self.buffered += 1;
            i += 1;
        }
        if self.buffered < 32 { return; }
        xx_stripe(self, self.buf[0..32], 0);
        self.buffered = 0;
    }
    while i + 32 <= data.len {
        xx_stripe(self, data, i);
        i += 32;
    }
    while i < data.len {
        self.buf[self.buffered] = data[i];
        self.buffered += 1;
        i += 1;
    }
}

xx_stripe :: fn(self: *XxHash64, b: []const u8, at: usize) {
    self.v1 = xx_round(self.v1, le64(b, at));
    self.v2 = xx_round(self.v2, le64(b, at + 8));
    self.v3 = xx_round(self.v3, le64(b, at + 16));
    self.v4 = xx_round(self.v4, le64(b, at + 24));
}

pub xxhash64_start :: fn(seed: u64) -> XxHash64 {
    h: XxHash64 = .{ seed, seed +% P1 +% P2, seed +% P2, seed, seed -% P1, .{}, 0, 0 };
    return h;
}

// Adler-32 (zlib)

// as zlib appends it; adler32("Wikipedia") == 0x11E60398
pub adler32 :: fn(data: []const u8) -> u32 {
    h := adler32_start();
    adler32_add(&h, data);
    return h.final();
}

// streaming; from adler32_start
pub Adler32 :: struct {
    a: u32,
    b: u32,

    pub update :: fn(self: *Self, data: []const u8) { adler32_add(self, data); }
    pub final :: fn(self: *Self) -> u32 { return (self.b << 16) | self.a; }
}

Adler32 as Hasher {
    update :: fn(self: *Self, data: []const u8) { adler32_add(self, data); }
}

adler32_add :: fn(self: *Adler32, data: []const u8) {
    a := self.a;
    b := self.b;
    i: usize = 0;
    while i < data.len {
        // 5552-byte blocks keep b < 2^32 before the modulo (zlib's NMAX)
        end := i + 5552;
        if end > data.len { end = data.len; }
        while i < end {
            a += data[i] as u32;
            b += a;
            i += 1;
        }
        a = a % 65521;
        b = b % 65521;
    }
    self.a = a;
    self.b = b;
}

pub adler32_start :: fn() -> Adler32 {
    h: Adler32 = .{ 1, 0 };
    return h;
}

// one integer

// MurmurHash3 finalizer: full avalanche, for integer keys
pub mix64 :: fn(x: u64) -> u64 {
    h := (x ^ (x >> 33)) *% 0xFF51AFD7ED558CCDu64;
    h = (h ^ (h >> 33)) *% 0xC4CEB9FE1A85EC53u64;
    return h ^ (h >> 33);
}

// std.hash: non-crypto hashes (FNV-1a, CRC-32, Adler-32, XXH64), one-shot or streaming
// not attack-resistant; use std.crypto for adversarial input

#import std.io.{ Reader, IoError };

// incremental hasher; all of these plus std.crypto's Sha256
pub Hasher :: interface {
    update :: fn(self: *Self, data: []const u8);
}

// hashes all of `src` through `buf`; returns bytes hashed
pub feed :: fn(h: *Hasher, src: *Reader, buf: []u8) -> u64 ! IoError {
    total: u64 = 0;
    while true {
        n := src.read(buf)?;
        if n == 0 { return total; }
        h.update(buf[0..n]);
        total += n as u64;
    }
    return total;
}

// FNV-1a

FNV64_START :: 0xCBF29CE484222325u64;
FNV64_PRIME :: 0x100000001B3u64;
FNV32_START :: 0x811C9DC5u32;
FNV32_PRIME :: 0x01000193u32;

// quick for short keys
pub fnv1a_64 :: fn(data: []const u8) -> u64 {
    h := FNV64_START;
    for b in data { h = (h ^ (b as u64)) *% FNV64_PRIME; }
    return h;
}

pub fnv1a_32 :: fn(data: []const u8) -> u32 {
    h := FNV32_START;
    for b in data { h = (h ^ (b as u32)) *% FNV32_PRIME; }
    return h;
}

// streaming; from fnv1a_64_start
pub Fnv1a64 :: struct {
    state: u64,

    pub update :: fn(self: *Self, data: []const u8) { fnv64_add(self, data); }
    pub final :: fn(self: *Self) -> u64 { return self.state; }
}

Fnv1a64 as Hasher {
    update :: fn(self: *Self, data: []const u8) { fnv64_add(self, data); }
}

fnv64_add :: fn(self: *Fnv1a64, data: []const u8) {
    h := self.state;
    for b in data { h = (h ^ (b as u64)) *% FNV64_PRIME; }
    self.state = h;
}

pub fnv1a_64_start :: fn() -> Fnv1a64 {
    h: Fnv1a64 = .{ FNV64_START };
    return h;
}

// streaming; from fnv1a_32_start
pub Fnv1a32 :: struct {
    state: u32,

    pub update :: fn(self: *Self, data: []const u8) { fnv32_add(self, data); }
    pub final :: fn(self: *Self) -> u32 { return self.state; }
}

Fnv1a32 as Hasher {
    update :: fn(self: *Self, data: []const u8) { fnv32_add(self, data); }
}

fnv32_add :: fn(self: *Fnv1a32, data: []const u8) {
    h := self.state;
    for b in data { h = (h ^ (b as u32)) *% FNV32_PRIME; }
    self.state = h;
}

pub fnv1a_32_start :: fn() -> Fnv1a32 {
    h: Fnv1a32 = .{ FNV32_START };
    return h;
}


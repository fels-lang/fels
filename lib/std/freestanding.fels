// std.freestanding: for a program built with --target freestanding, which has no os under it

// println and the panic message go to `write`, e.g. a serial port; nothing is printed before
pub set_output :: fn(write: extern fn(*const u8, usize)) {
    fels_output = unsafe (write as usize);
}

// interrupts off, halted for good
#noreturn
pub halt :: fn() {
    fels_halt();
}

// gives zones the memory [base, base + len), e.g. a free range of the boot loader's memory map;
// it must be memory nothing else uses. before any is given, and after it runs out, zones take
// a 1 MiB static heap
pub add_memory :: fn(base: usize, len: usize) {
    fels_heap_add(base, len);
}

// the bytes zones can still take
pub free_memory :: fn() -> usize {
    return fels_heap_free();
}

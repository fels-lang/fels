// SPDX-License-Identifier: Apache-2.0
// std.fs: sync files and folders; paths over 1023 bytes fail with path_too_long

#import std.io.{ Writer, Reader, IoError };
#import std.heap.{ Arena };
#import std.vec as vec;
#import std.vec.{ Vec };
#import std.path as path;
#import std.hash as hash;

// seam: os_file_open mode 0 read, 1 trunc, 2 append, 3 new-only; i64 results -1 = fail
// os_path_kind 0 missing, 1 file, 2 dir; i32 results 0 = ok; seek whence 0 set, 2 end

FS_INVALID :: -1i64;       // closed/invalid handle; the seam's failure value
MAX_PATH_BYTES :: 1024usize;

// errors

pub FsError :: errors {
    not_found,       // missing path (or access denied)
    create_failed,   // create/append failed
    read_failed,     // a read returned an error
    write_failed,    // a write returned an error
    seek_failed,     // a seek returned an error
    delete_failed,   // delete failed (or folder not empty)
    path_too_long,   // path + NUL over 1024 bytes
    rename_failed,   // rename could not move the file
}

// path helpers

// `path` + NUL into `buf` for OS calls; UTF-8 (windows runtime converts to UTF-16)
fs_to_cstr :: fn(path: []const u8, buf: []u8) -> *const u8 ! FsError {
    if path.len + 1 > buf.len { fail .path_too_long; }
    for i in 0..path.len {
        buf[i] = path[i];
    }
    buf[path.len] = 0;
    return buf.ptr;
}

// file

// open OS file; a Reader and a Writer
pub File :: struct {
    handle: i64,
}

File as Reader {
    read :: fn(self: *Self, buf: []u8) -> usize ! IoError {
        if buf.len == 0 { return 0; }
        n := os_file_read(self.handle, buf.ptr, buf.len);
        if n < 0 { fail .read_failed; }
        return n as usize;
    }
}

File as Writer {
    write :: fn(self: *Self, data: []const u8) -> usize ! IoError {
        if data.len == 0 { return 0; }
        n := os_file_write(self.handle, data.ptr, data.len);
        if n < 0 { fail .write_failed; }
        return n as usize;
    }
    flush :: fn(self: *Self) -> void ! IoError {
        return;
    }
}

pub is_open :: fn(self: *File) -> bool {
    return self.handle != FS_INVALID;
}

// close the handle; idempotent
pub close :: fn(self: *File) {
    if self.handle == FS_INVALID { return; }
    os_file_close(self.handle);
    self.handle = FS_INVALID;
}

// open for reading; not_found if it can't be
pub open :: fn(path: []const u8) -> File ! FsError {
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:])?;
    h := os_file_open(cpath, 0);
    if h == FS_INVALID { fail .not_found; }
    return .{ h };
}

// create for writing; truncates an existing file
pub create :: fn(path: []const u8) -> File ! FsError {
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:])?;
    h := os_file_open(cpath, 1);
    if h == FS_INVALID { fail .create_failed; }
    return .{ h };
}

// open for appending; creates it if missing
pub append :: fn(path: []const u8) -> File ! FsError {
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:])?;
    h := os_file_open(cpath, 2);
    if h == FS_INVALID { fail .create_failed; }
    return .{ h };
}

// file or dir exists; never fails
pub exists :: fn(path: []const u8) -> bool {
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:]) catch err { return false; };
    return os_path_kind(cpath) != 0;
}

pub is_dir :: fn(path: []const u8) -> bool {
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:]) catch err { return false; };
    return os_path_kind(cpath) == 2;
}

// remove a file; delete_failed if it can't
pub delete :: fn(path: []const u8) -> void ! FsError {
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:])?;
    if os_unlink(cpath) != 0 { fail .delete_failed; }
    return;
}

// make folder `path` (ok if it exists); create_failed if no parent or a file is there
pub make_dir :: fn(path: []const u8) -> void ! FsError {
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:])?;
    if os_mkdir(cpath) != 0 && os_path_kind(cpath) != 2 { fail .create_failed; }
    return;
}

// make `path` and any missing parents (`/` or `\` separators)
pub make_dirs :: fn(path: []const u8) -> void ! FsError {
    for i in 1..path.len {
        c := path[i];
        // the folder up to here, unless that is a drive (`C:`)
        if (c == 47 || c == 92) && path[i - 1] != 58 && !is_dir(path[0..i]) {
            make_dir(path[0..i])?;
        }
    }
    make_dir(path)?;
    return;
}

// remove empty folder `path`; delete_failed otherwise
pub remove_dir :: fn(path: []const u8) -> void ! FsError {
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:])?;
    if os_rmdir(cpath) != 0 { fail .delete_failed; }
    return;
}

// whole file into a new buffer in `a`
pub read_all :: fn(path: []const u8, a: *Arena) -> []u8 ! FsError {
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:])?;
    h := os_file_open(cpath, 0);
    if h == FS_INVALID { fail .not_found; }
    sz := os_file_seek(h, 0, 2);     // SEEK_END -> size
    back := os_file_seek(h, 0, 0);   // SEEK_SET -> rewind
    if sz < 0 || back < 0 { os_file_close(h); fail .seek_failed; }
    buf: []u8 = a.alloc_bytes(sz as usize);
    total: usize = 0;
    while total < buf.len {
        n := os_file_read(h, &buf[total], buf.len - total);
        if n < 0 { os_file_close(h); fail .read_failed; }
        if n == 0 { break; }
        total += n as usize;
    }
    os_file_close(h);
    return buf[0..total];
}

// dir iteration; names include "." and "..", valid only until the next dir_next
pub DirIter :: struct {
    handle:  i64,
    namebuf: [1024]u8,
    namelen: usize,
}

pub open_dir :: fn(path: []const u8) -> DirIter ! FsError {
    iter: DirIter = .{ FS_INVALID, .{}, 0 };
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:])?;
    iter.handle = os_dir_open(cpath);
    if iter.handle == FS_INVALID { fail .not_found; }
    return iter;
}

// next entry name, or null at the end
pub dir_next :: fn(self: *DirIter) -> ?[]const u8 {
    if self.handle == FS_INVALID { return null; }
    n := os_dir_next(self.handle, self.namebuf[:]);
    if n < 0 { return null; }
    self.namelen = n as usize;
    return self.namebuf[0..self.namelen];
}

// last entry is a dir
pub dir_is_dir :: fn(self: *DirIter) -> bool {
    if self.handle == FS_INVALID { return false; }
    return os_dir_is_dir(self.handle);
}

// last entry's size in bytes; always 0 on linux (stat the path)
pub dir_size :: fn(self: *DirIter) -> u64 {
    if self.handle == FS_INVALID { return 0; }
    return os_dir_size(self.handle);
}

// last entry is a symlink/reparse point; skip these to avoid cycles
pub dir_is_reparse :: fn(self: *DirIter) -> bool {
    if self.handle == FS_INVALID { return false; }
    return os_dir_is_reparse(self.handle);
}

pub dir_close :: fn(self: *DirIter) {
    if self.handle == FS_INVALID { return; }
    os_dir_close(self.handle);
    self.handle = FS_INVALID;
}

// metadata, rename, copy

// result of `info`
pub Info :: struct {
    size: u64,           // bytes (0 for a folder on Linux and others)
    modified_ns: i64,    // last write, ns since the unix epoch
    is_dir: bool,
}

// size, mtime, kind of `path`; not_found if nothing is there
pub info :: fn(path: []const u8) -> Info ! FsError {
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:])?;
    size: i64 = 0;
    mtime: i64 = 0;
    kind: i64 = 0;
    if os_file_info(cpath, &size, &mtime, &kind) != 0 { fail .not_found; }
    i: Info = .{ size as u64, mtime, kind == 2 };
    return i;
}

// rename/move; replaces a file at `to`; rename_failed (missing, dir target, cross-volume)
pub rename :: fn(from: []const u8, to: []const u8) -> void ! FsError {
    a_buf: [1024]u8 = .{};
    b_buf: [1024]u8 = .{};
    a := fs_to_cstr(from, a_buf[:])?;
    b := fs_to_cstr(to, b_buf[:])?;
    if os_rename(a, b) != 0 { fail .rename_failed; }
}

// write `data` to `path`, created or truncated
pub write_file :: fn(path: []const u8, data: []const u8) -> void ! FsError {
    f := create(path)?;
    done: usize = 0;
    while done < data.len {
        n := os_file_write(f.handle, &data[done], data.len - done);
        if n <= 0 {
            close(&f);
            fail .write_failed;
        }
        done += n as usize;
    }
    close(&f);
}

// copy a file, `to` created or truncated; returns bytes copied
pub copy_file :: fn(from: []const u8, to: []const u8) -> u64 ! FsError {
    src := open(from)?;
    dst := create(to) catch err {
        close(&src);
        fail .create_failed;
    };
    buf: [16384]u8 = .{};
    total: u64 = 0;
    while true {
        n := os_file_read(src.handle, &buf[0], 16384);
        if n < 0 {
            close(&src);
            close(&dst);
            fail .read_failed;
        }
        if n == 0 { break; }
        done: i64 = 0;
        while done < n {
            w := os_file_write(dst.handle, &buf[done as usize], (n - done) as usize);
            if w <= 0 {
                close(&src);
                close(&dst);
                fail .write_failed;
            }
            done += w;
        }
        total += n as u64;
    }
    close(&src);
    close(&dst);
    return total;
}

// tree walk

// a `walk` entry
pub Entry :: struct {
    path: []const u8,   // root + names below it, joined by "/"
    name: []const u8,   // the last part of `path`
    is_dir: bool,
    depth: usize,       // 1 for an entry of the root folder itself
}

// recursive walk, folders before their contents; links listed but not followed
pub Walker :: struct {
    region: *Arena,
    dirs: Vec(DirIter),        // the open folders, the innermost last
    paths: Vec([]const u8),    // their paths
    // set if a subfolder couldn't be opened; it was returned but not entered
    failed: bool,

    pub next :: fn(self: *Self) -> ?Entry {
        while self.dirs.len() > 0 {
            top := self.dirs.at(self.dirs.len() - 1);
            if dir_next(top) |name| {
                if name == "." || name == ".." { continue; }
                dir := self.paths.last();
                path := join_path(self.region, dir, name);
                is_folder := dir_is_dir(top) && !dir_is_reparse(top);
                e: Entry = .{ path, path[path.len - name.len..path.len], is_folder, self.dirs.len() };
                if is_folder {
                    it := open_dir(path) catch err {
                        self.failed = true;
                        return e;
                    };
                    self.dirs.push(it);
                    self.paths.push(path);
                }
                return e;
            }
            done := self.dirs.pop();
            dir_close(&done);
            last := self.paths.pop();
        }
        return null;
    }

    // close what's still open if the loop stops early
    pub close :: fn(self: *Self) {
        while self.dirs.len() > 0 {
            d := self.dirs.pop();
            dir_close(&d);
        }
        self.paths.clear();
    }
}

join_path :: fn(a: *Arena, dir: []const u8, name: []const u8) -> []const u8 {
    sep: usize = if dir.len > 0 && dir[dir.len - 1] != '/' && dir[dir.len - 1] != '\\' { 1 } else { 0 };
    out := a.alloc_bytes(dir.len + sep + name.len);
    for i in 0..dir.len { out[i] = dir[i]; }
    if sep == 1 { out[dir.len] = '/'; }
    for i in 0..name.len { out[dir.len + sep + i] = name[i]; }
    return out;
}

// recursive walk; paths live in `a`
pub walk :: fn(a: *Arena, root: []const u8) -> Walker ! FsError {
    it := open_dir(root)?;
    w: Walker = .{ a, vec::make(DirIter, a), vec::make([]const u8, a), false };
    w.dirs.push(it);
    w.paths.push(root);
    return w;
}

// cwd and absolute paths

// current folder, absolute, in `a`; not_found if removed or path too long
pub cwd :: fn(a: *Arena) -> []const u8 ! FsError {
    buf: [1024]u8 = .{};
    n := os_cwd(buf[:]);
    if n < 0 { fail .not_found; }
    return copy_text(a, buf[0..(n as usize)]);
}

// set the current folder, process-wide (all threads); not_found if not a folder
pub set_cwd :: fn(path: []const u8) -> void ! FsError {
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:])?;
    if os_chdir(cpath) != 0 { fail .not_found; }
}

// absolute `p` in `a` via path::normalize; only cwd is read, so `..` is lexical
pub absolute :: fn(a: *Arena, p: []const u8) -> []const u8 ! FsError {
    if p.len >= 2 && path::is_sep(p[0]) && path::is_sep(p[1]) { return path::normalize(a, p); }
    if p.len >= 1 && path::is_sep(p[0]) {
        here := cwd(a)?;
        if here.len >= 2 && here[1] == ':' { return path::normalize(a, concat(a, here[0..2], p)); }
        return path::normalize(a, p);
    }
    if p.len >= 2 && p[1] == ':' {
        if p.len >= 3 && path::is_sep(p[2]) { return path::normalize(a, p); }
        here := cwd(a)?;
        if here.len >= 2 && here[1] == ':' && lower(here[0]) == lower(p[0]) {
            return path::normalize(a, path::join(a, here, p[2..p.len]));
        }
        return path::normalize(a, concat(a, p[0..2], concat(a, "/", p[2..p.len])));
    }
    here := cwd(a)?;
    return path::normalize(a, path::join(a, here, p));
}

copy_text :: fn(a: *Arena, s: []const u8) -> []const u8 {
    out := a.alloc_bytes(s.len);
    for i in 0..s.len { out[i] = s[i]; }
    return out;
}

concat :: fn(a: *Arena, x: []const u8, y: []const u8) -> []const u8 {
    out := a.alloc_bytes(x.len + y.len);
    for i in 0..x.len { out[i] = x[i]; }
    for i in 0..y.len { out[x.len + i] = y[i]; }
    return out;
}

lower :: fn(c: u8) -> u8 { return if c >= 'A' && c <= 'Z' { c + 32 } else { c }; }

// env var `name` in `a`; null if unset or empty
env_value :: fn(a: *Arena, name: []const u8) -> ?[]const u8 {
    name_buf: [128]u8 = .{};
    cname := fs_to_cstr(name, name_buf[:]) catch err { return null; };
    value: [4096]u8 = .{};
    n := os_get_env(cname, value[:]);
    if n <= 0 { return null; }
    return copy_text(a, value[0..(n as usize)]);
}

// `p` without a trailing separator, unless it is a root ("/", "C:\")
trim_sep :: fn(p: []const u8) -> []const u8 {
    n := p.len;
    while n > 1 && path::is_sep(p[n - 1]) && !(n == 3 && p[1] == ':') { n -= 1; }
    return p[0..n];
}

#if TARGET.os == .windows {
    temp_default :: fn(a: *Arena) -> []const u8 {
        if env_value(a, "TMP") |v| { return v; }
        if env_value(a, "TEMP") |v| { return v; }
        if env_value(a, "USERPROFILE") |v| { return v; }
        return "C:\\Windows\\Temp";
    }
    home_default :: fn(a: *Arena) -> ?[]const u8 { return env_value(a, "USERPROFILE"); }
} else {
    temp_default :: fn(a: *Arena) -> []const u8 {
        if env_value(a, "TMPDIR") |v| { return v; }
        return "/tmp";
    }
    home_default :: fn(a: *Arena) -> ?[]const u8 { return env_value(a, "HOME"); }
}

// user folders

// temp folder, no trailing sep (windows: TMP, TEMP, USERPROFILE; else TMPDIR or /tmp)
pub temp_dir :: fn(a: *Arena) -> []const u8 { return trim_sep(temp_default(a)); }

// USERPROFILE on windows, HOME elsewhere; null if unset
pub home_dir :: fn(a: *Arena) -> ?[]const u8 {
    if home_default(a) |h| { return trim_sep(h); }
    return null;
}

// temp files and folders

// from create_temp: the file, open to write, and its path
pub TempFile :: struct {
    file: File,
    path: []const u8,
}

// new exclusive file in `dir` ("" = temp_dir()); last `*` of `pattern` -> 16 hex digits
// caller closes and deletes it; owner-only on linux; create_failed if no name worked
pub create_temp :: fn(a: *Arena, dir: []const u8, pattern: []const u8) -> TempFile ! FsError {
    folder := if dir.len == 0 { temp_dir(a) } else { dir };
    for attempt in 0..100 {
        p := temp_name(a, folder, pattern, attempt);
        path_buf: [1024]u8 = .{};
        cpath := fs_to_cstr(p, path_buf[:])?;
        h := os_file_open(cpath, 3);
        if h != FS_INVALID {
            t: TempFile = .{ .{ h }, p };
            return t;
        }
        if os_path_kind(cpath) == 0 { break; }      // not a name taken: the folder is not there
    }
    fail .create_failed;
}

// new temp folder, named like create_temp; path in `a`; create_failed if none worked
pub make_temp_dir :: fn(a: *Arena, dir: []const u8, pattern: []const u8) -> []const u8 ! FsError {
    folder := if dir.len == 0 { temp_dir(a) } else { dir };
    for attempt in 0..100 {
        p := temp_name(a, folder, pattern, attempt);
        path_buf: [1024]u8 = .{};
        cpath := fs_to_cstr(p, path_buf[:])?;
        if os_mkdir(cpath) == 0 { return p; }
        if os_path_kind(cpath) == 0 { break; }
    }
    fail .create_failed;
}

// `dir` + sep + `pattern` with 16 hex digits for its last `*` (or appended)
temp_name :: fn(a: *Arena, dir: []const u8, pattern: []const u8, attempt: usize) -> []const u8 {
    star: usize = pattern.len;
    for k in 0..pattern.len { if pattern[k] == '*' { star = k; } }
    after: usize = if star < pattern.len { star + 1 } else { pattern.len };
    // seed differs per program, call and attempt
    local: u64 = 0;
    seed := (os_wall_nanos() as u64) ^ ((os_monotonic_nanos() as u64) << 17)
        ^ ((os_pid() as u64) << 40) ^ (unsafe ((&local) as usize) as u64) ^ ((attempt as u64) *% 0x9E3779B97F4A7C15u64);
    r := hash::mix64(seed);
    digits := "0123456789abcdef";
    sep: usize = if dir.len > 0 && !path::is_sep(dir[dir.len - 1]) { 1 } else { 0 };
    out := a.alloc_bytes(dir.len + sep + star + 16 + (pattern.len - after));
    n: usize = 0;
    for c in dir {
        out[n] = c;
        n += 1;
    }
    if sep == 1 {
        out[n] = path::SEP;
        n += 1;
    }
    for c in pattern[0..star] {
        out[n] = c;
        n += 1;
    }
    for k in 0..16 {
        out[n] = digits[((r >> ((60 - 4 * k) as u64)) & 15) as usize];
        n += 1;
    }
    for c in pattern[after..pattern.len] {
        out[n] = c;
        n += 1;
    }
    return out;
}

// delete a file or a whole folder tree; links are removed, not followed
// not_found if missing; delete_failed (open, read-only) after deleting what it could
pub remove_tree :: fn(path: []const u8) -> void ! FsError {
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:])?;
    // file or link, else empty folder or windows dir link; never a link's target
    if os_unlink(cpath) == 0 || os_rmdir(cpath) == 0 { return; }
    kind := os_path_kind(cpath);
    if kind == 0 { fail .not_found; }
    if kind == 1 || !remove_folder(path) { fail .delete_failed; }
}

// empty `dir` and delete it; false if anything stayed
remove_folder :: fn(dir: []const u8) -> bool {
    it := open_dir(dir) catch err { return false; };
    ok := true;
    while true {
        if dir_next(&it) |name| {
            if !remove_entry(&it, dir, name) { ok = false; }
        } else {
            break;
        }
    }
    dir_close(&it);
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(dir, path_buf[:]) catch err { return false; };
    if os_rmdir(cpath) != 0 { return false; }
    return ok;
}

// delete entry `name` of `dir` (where `it` is); false if anything stayed
remove_entry :: fn(it: *DirIter, dir: []const u8, name: []const u8) -> bool {
    if name == "." || name == ".." { return true; }
    if name.len == 0 { return false; }             // a name too long to read
    buf: [1024]u8 = .{};
    sep: usize = if path::is_sep(dir[dir.len - 1]) { 0 } else { 1 };
    len := dir.len + sep + name.len;
    if len + 1 > buf.len { return false; }
    for k in 0..dir.len { buf[k] = dir[k]; }
    if sep == 1 { buf[dir.len] = '/'; }
    for k in 0..name.len { buf[dir.len + sep + k] = name[k]; }
    buf[len] = 0;
    if dir_is_dir(it) && !dir_is_reparse(it) { return remove_folder(buf[0..len]); }
    if dir_is_dir(it) { return os_rmdir(&buf[0]) == 0; }     // a junction, or a link to a folder
    return os_unlink(&buf[0]) == 0;
}

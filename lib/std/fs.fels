// SPDX-License-Identifier: Apache-2.0
// std.fs — minimal synchronous file I/O for Fels. OS calls go through the platform
// runtime (windows.fels → kernel32; linux.fels → openat/read/write/..), so this file is
// OS-agnostic. File implements std.io.Reader and Writer; there's open/create/append,
// exists/is_dir/delete, read_all, write_file, copy_file, rename, info (size, last write),
// make_dir/make_dirs/remove_dir/remove_tree, DirIter for one folder and walk for a whole tree,
// cwd/set_cwd/absolute, temp_dir/make_temp_dir/create_temp and home_dir, all sharing FsError.
//
// Paths are plain []const u8, copied into a small stack buffer and NUL-terminated for
// the OS; anything too long fails with path_too_long.
//
//   f := fs.create("out.txt") catch err { return 1; };
//   w: *Writer = &f;
//   w.write_all("hello\n") catch err {};
//   (&f).close();

#import std.io.{ Writer, Reader, IoError };
#import std.heap.{ Arena };
#import std.vec as vec;
#import std.vec.{ Vec };
#import std.path as path;
#import std.hash as hash;

// The file/dir seam, provided by the platform runtime:
//   os_file_open(path, mode) -> i64   mode 0=read, 1=create/trunc, 2=append; -1 = fail
//   os_file_read(h, buf, len) -> i64  bytes read, or -1
//   os_file_write(h, buf, len) -> i64 bytes written, or -1
//   os_file_close(h)
//   os_file_seek(h, off, whence) -> i64   whence 0=set, 1=cur, 2=end; new pos or -1
//   os_path_kind(path) -> i32         0=missing, 1=file, 2=directory
//   os_unlink(path) -> i32            0 = ok
//   os_mkdir(path) / os_rmdir(path) -> i32    0 = ok
//   os_dir_open(path) -> i64          opaque iterator handle, or -1
//   os_dir_next(h, name) -> i64       entry-name length copied into `name`, or -1 at end
//   os_dir_is_dir(h)/os_dir_is_reparse(h) -> bool, os_dir_size(h) -> u64   (last entry)
//   os_dir_close(h)
//   os_rename(from, to) -> i32        0 = ok; replaces a file at `to`
//   os_file_info(path, size, mtime, kind) -> i32   0 = ok; mtime in ns since 1970, kind 1/2
//   os_cwd(out) -> i64                bytes of the current folder copied into `out`, or -1
//   os_chdir(path) -> i32             0 = ok
//   os_file_open(path, 3)             a new file to write; -1 when there is one

FS_INVALID :: -1i64;       // a closed/invalid handle (matches the seam's failure value)
MAX_PATH_BYTES :: 1024usize;

// Errors

pub FsError :: errors {
    not_found,       // open of an existing file failed — the path doesn't exist (or access denied)
    create_failed,   // create/append failed
    read_failed,     // a read returned an error
    write_failed,    // a write returned an error
    seek_failed,     // a seek returned an error
    delete_failed,   // delete failed (a file, or a folder that is not empty)
    path_too_long,   // path (plus NUL terminator) doesn't fit in the internal buffer
    rename_failed,   // rename could not move the file
}

// Path helpers

// Copy `path` into `buf`, append a NUL terminator, and return a pointer to the
// start of `buf` for the OS calls (UTF-8; on Windows the runtime makes UTF-16 of it).
fs_to_cstr :: fn(path: []const u8, buf: []u8) -> *const u8 ! FsError {
    if path.len + 1 > buf.len { fail .path_too_long; }
    for i in 0..path.len {
        buf[i] = path[i];
    }
    buf[path.len] = 0;
    return buf.ptr;
}

// File

// An open OS file handle. Implements both `Reader` and `Writer`, so it works
// anywhere a `*Reader`/`*Writer` is expected — pipelines, formatters, loggers.
pub File :: struct {
    handle: i64,
}

File as Reader {
    read :: fn(self: *Self, buf: []u8) -> usize ! IoError {
        if buf.len == 0 { return 0; }
        n := os_file_read(self.handle, buf.ptr, buf.len);
        if n < 0 { fail .read_failed; }
        return n as usize;
    }
}

File as Writer {
    write :: fn(self: *Self, data: []const u8) -> usize ! IoError {
        if data.len == 0 { return 0; }
        n := os_file_write(self.handle, data.ptr, data.len);
        if n < 0 { fail .write_failed; }
        return n as usize;
    }
    flush :: fn(self: *Self) -> void ! IoError {
        return;
    }
}

// True while the handle is open. Call as `(&file).is_open()`.
pub is_open :: fn(self: *File) -> bool {
    return self.handle != FS_INVALID;
}

// Close the underlying OS handle. Safe to call more than once. Call as
// `(&file).close()`.
pub close :: fn(self: *File) {
    if self.handle == FS_INVALID { return; }
    os_file_close(self.handle);
    self.handle = FS_INVALID;
}

// Open an existing file for reading. Fails with `not_found` if it can't be
// opened for read access.
pub open :: fn(path: []const u8) -> File ! FsError {
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:])?;
    h := os_file_open(cpath, 0);
    if h == FS_INVALID { fail .not_found; }
    return .{ h };
}

// Create a file for writing, truncating it if it already exists (`fopen(…,"w")`).
pub create :: fn(path: []const u8) -> File ! FsError {
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:])?;
    h := os_file_open(cpath, 1);
    if h == FS_INVALID { fail .create_failed; }
    return .{ h };
}

// Open a file for appending, creating it if it doesn't exist (`fopen(…,"a")`).
pub append :: fn(path: []const u8) -> File ! FsError {
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:])?;
    h := os_file_open(cpath, 2);
    if h == FS_INVALID { fail .create_failed; }
    return .{ h };
}

// True if `path` refers to an existing file or directory. Never fails.
pub exists :: fn(path: []const u8) -> bool {
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:]) catch err { return false; };
    return os_path_kind(cpath) != 0;
}

// True if `path` is a directory.
pub is_dir :: fn(path: []const u8) -> bool {
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:]) catch err { return false; };
    return os_path_kind(cpath) == 2;
}

// Remove a file. Fails with `delete_failed` if it can't be removed.
pub delete :: fn(path: []const u8) -> void ! FsError {
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:])?;
    if os_unlink(cpath) != 0 { fail .delete_failed; }
    return;
}

// Make the folder `path`. A folder that is there already is fine; `create_failed` when it
// cannot be made (the folder above it is missing, or a file has the name).
pub make_dir :: fn(path: []const u8) -> void ! FsError {
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:])?;
    if os_mkdir(cpath) != 0 && os_path_kind(cpath) != 2 { fail .create_failed; }
    return;
}

// Make the folder `path` and every folder above it that is missing (`a/b/c`, with `/` or `\`).
pub make_dirs :: fn(path: []const u8) -> void ! FsError {
    for i in 1..path.len {
        c := path[i];
        // the folder up to here, unless that is a drive (`C:`)
        if (c == 47 || c == 92) && path[i - 1] != 58 && !is_dir(path[0..i]) {
            make_dir(path[0..i])?;
        }
    }
    make_dir(path)?;
    return;
}

// Remove the folder `path`, which must be empty. Fails with `delete_failed`.
pub remove_dir :: fn(path: []const u8) -> void ! FsError {
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:])?;
    if os_rmdir(cpath) != 0 { fail .delete_failed; }
    return;
}

// Read an entire file into a fresh buffer allocated in `a`. Returns the bytes.
pub read_all :: fn(path: []const u8, a: *Arena) -> []u8 ! FsError {
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:])?;
    h := os_file_open(cpath, 0);
    if h == FS_INVALID { fail .not_found; }
    sz := os_file_seek(h, 0, 2);     // SEEK_END → size
    back := os_file_seek(h, 0, 0);   // SEEK_SET → rewind
    if sz < 0 || back < 0 { os_file_close(h); fail .seek_failed; }
    buf: []u8 = a.alloc_bytes(sz as usize);
    total: usize = 0;
    while total < buf.len {
        n := os_file_read(h, &buf[total], buf.len - total);
        if n < 0 { os_file_close(h); fail .read_failed; }
        if n == 0 { break; }
        total += n as usize;
    }
    os_file_close(h);
    return buf[0..total];
}

// Directory iteration
// `open_dir` takes a directory PATH (each platform adds its own glob/listing
// mechanism). `dir_next` yields each entry name (including "." and ".."), valid
// only until the following `dir_next` call.
pub DirIter :: struct {
    handle:  i64,
    namebuf: [1024]u8,
    namelen: usize,
}

pub open_dir :: fn(path: []const u8) -> DirIter ! FsError {
    iter: DirIter = .{ FS_INVALID, .{}, 0 };
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:])?;
    iter.handle = os_dir_open(cpath);
    if iter.handle == FS_INVALID { fail .not_found; }
    return iter;
}

// The next entry name, or null at the end. Call as `(&it).dir_next()`.
pub dir_next :: fn(self: *DirIter) -> ?[]const u8 {
    if self.handle == FS_INVALID { return null; }
    n := os_dir_next(self.handle, self.namebuf[:]);
    if n < 0 { return null; }
    self.namelen = n as usize;
    return self.namebuf[0..self.namelen];
}

// Whether the entry most recently returned by `dir_next` is a subdirectory.
pub dir_is_dir :: fn(self: *DirIter) -> bool {
    if self.handle == FS_INVALID { return false; }
    return os_dir_is_dir(self.handle);
}

// Size in bytes of the most recent entry (free on Windows; 0 on Linux, whose
// getdents64 doesn't carry it — stat the path if you need it there).
pub dir_size :: fn(self: *DirIter) -> u64 {
    if self.handle == FS_INVALID { return 0; }
    return os_dir_size(self.handle);
}

// True if the most recent entry is a symlink/reparse point — skip these when
// scanning to avoid cycles and double-counting.
pub dir_is_reparse :: fn(self: *DirIter) -> bool {
    if self.handle == FS_INVALID { return false; }
    return os_dir_is_reparse(self.handle);
}

pub dir_close :: fn(self: *DirIter) {
    if self.handle == FS_INVALID { return; }
    os_dir_close(self.handle);
    self.handle = FS_INVALID;
}

// Metadata, renaming, copying

/// What `info` says about a path.
pub Info :: struct {
    size: u64,           // bytes (0 for a folder on Linux and others)
    modified_ns: i64,    // the last write, in nanoseconds since 1970-01-01 UTC
    is_dir: bool,
}

/// The size, last write time and kind of `path`; `not_found` when there is nothing there.
pub info :: fn(path: []const u8) -> Info ! FsError {
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:])?;
    size: i64 = 0;
    mtime: i64 = 0;
    kind: i64 = 0;
    if os_file_info(cpath, &size, &mtime, &kind) != 0 { fail .not_found; }
    i: Info = .{ size as u64, mtime, kind == 2 };
    return i;
}

/// Rename (or move) `from` to `to`, replacing a file that is there. `rename_failed` when it
/// cannot (`from` is missing, `to` is a folder, they are on volumes that cannot move between).
pub rename :: fn(from: []const u8, to: []const u8) -> void ! FsError {
    a_buf: [1024]u8 = .{};
    b_buf: [1024]u8 = .{};
    a := fs_to_cstr(from, a_buf[:])?;
    b := fs_to_cstr(to, b_buf[:])?;
    if os_rename(a, b) != 0 { fail .rename_failed; }
}

/// Write `data` to the file `path`, made or emptied first.
pub write_file :: fn(path: []const u8, data: []const u8) -> void ! FsError {
    f := create(path)?;
    done: usize = 0;
    while done < data.len {
        n := os_file_write(f.handle, &data[done], data.len - done);
        if n <= 0 {
            close(&f);
            fail .write_failed;
        }
        done += n as usize;
    }
    close(&f);
}

/// Copy the file `from` to `to` (made or emptied first); the bytes copied.
pub copy_file :: fn(from: []const u8, to: []const u8) -> u64 ! FsError {
    src := open(from)?;
    dst := create(to) catch err {
        close(&src);
        fail .create_failed;
    };
    buf: [16384]u8 = .{};
    total: u64 = 0;
    while true {
        n := os_file_read(src.handle, &buf[0], 16384);
        if n < 0 {
            close(&src);
            close(&dst);
            fail .read_failed;
        }
        if n == 0 { break; }
        done: i64 = 0;
        while done < n {
            w := os_file_write(dst.handle, &buf[done as usize], (n - done) as usize);
            if w <= 0 {
                close(&src);
                close(&dst);
                fail .write_failed;
            }
            done += w;
        }
        total += n as u64;
    }
    close(&src);
    close(&dst);
    return total;
}

// Walking a folder tree

/// An entry `walk` gives.
pub Entry :: struct {
    path: []const u8,   // the root, then each folder name below it, joined by "/"
    name: []const u8,   // the last part of `path`
    is_dir: bool,
    depth: usize,       // 1 for an entry of the root folder itself
}

/// The files and folders below a folder, each folder before what is in it (`walk`). A link
/// (a symlink, a junction) is given but not followed.
pub Walker :: struct {
    region: *Arena,
    dirs: Vec(DirIter),        // the open folders, the innermost last
    paths: Vec([]const u8),    // their paths
    /// A folder below the root could not be opened (no access, a path too long); it was
    /// given as an entry and skipped.
    failed: bool,

    pub next :: fn(self: *Self) -> ?Entry {
        while self.dirs.len() > 0 {
            top := self.dirs.at(self.dirs.len() - 1);
            if dir_next(top) |name| {
                if name == "." || name == ".." { continue; }
                dir := self.paths.last();
                path := join_path(self.region, dir, name);
                is_folder := dir_is_dir(top) && !dir_is_reparse(top);
                e: Entry = .{ path, path[path.len - name.len..path.len], is_folder, self.dirs.len() };
                if is_folder {
                    it := open_dir(path) catch err {
                        self.failed = true;
                        return e;
                    };
                    self.dirs.push(it);
                    self.paths.push(path);
                }
                return e;
            }
            done := self.dirs.pop();
            dir_close(&done);
            last := self.paths.pop();
        }
        return null;
    }

    /// Close what is still open, when the loop stops early.
    pub close :: fn(self: *Self) {
        while self.dirs.len() > 0 {
            d := self.dirs.pop();
            dir_close(&d);
        }
        self.paths.clear();
    }
}

join_path :: fn(a: *Arena, dir: []const u8, name: []const u8) -> []const u8 {
    sep: usize = if dir.len > 0 && dir[dir.len - 1] != '/' && dir[dir.len - 1] != '\\' { 1 } else { 0 };
    out := a.alloc_bytes(dir.len + sep + name.len);
    for i in 0..dir.len { out[i] = dir[i]; }
    if sep == 1 { out[dir.len] = '/'; }
    for i in 0..name.len { out[dir.len + sep + i] = name[i]; }
    return out;
}

/// The files and folders below `root`, at any depth:
///
///   w := fs::walk(&a, "src")?;
///   for e in w { if !e.is_dir && strings::str_ends_with(e.name, ".fels") { … } }
///
/// The paths are in `a`. `not_found` when `root` cannot be opened.
pub walk :: fn(a: *Arena, root: []const u8) -> Walker ! FsError {
    it := open_dir(root)?;
    w: Walker = .{ a, vec::make(DirIter, a), vec::make([]const u8, a), false };
    w.dirs.push(it);
    w.paths.push(root);
    return w;
}

// The current folder and absolute paths

/// The current folder, an absolute path in `a`. `not_found` when it cannot be read (it was
/// removed, or its path is too long).
pub cwd :: fn(a: *Arena) -> []const u8 ! FsError {
    buf: [1024]u8 = .{};
    n := os_cwd(buf[:]);
    if n < 0 { fail .not_found; }
    return copy_text(a, buf[0..(n as usize)]);
}

/// Make `path` the current folder, for every thread: relative paths start from it from now on.
/// `not_found` when it is no folder.
pub set_cwd :: fn(path: []const u8) -> void ! FsError {
    path_buf: [1024]u8 = .{};
    cpath := fs_to_cstr(path, path_buf[:])?;
    if os_chdir(cpath) != 0 { fail .not_found; }
}

/// `p` as an absolute path in `a`, by `path::normalize`: a relative one starts from the current
/// folder. On Windows `\x` is on the current folder's drive, and `D:x` starts from the current
/// folder when that is on D:, else from D:'s root. Nothing else is read from the disk, so the path
/// need not exist, and `..` after a link goes back over the link's name.
pub absolute :: fn(a: *Arena, p: []const u8) -> []const u8 ! FsError {
    if p.len >= 2 && path::is_sep(p[0]) && path::is_sep(p[1]) { return path::normalize(a, p); }
    if p.len >= 1 && path::is_sep(p[0]) {
        here := cwd(a)?;
        if here.len >= 2 && here[1] == ':' { return path::normalize(a, concat(a, here[0..2], p)); }
        return path::normalize(a, p);
    }
    if p.len >= 2 && p[1] == ':' {
        if p.len >= 3 && path::is_sep(p[2]) { return path::normalize(a, p); }
        here := cwd(a)?;
        if here.len >= 2 && here[1] == ':' && lower(here[0]) == lower(p[0]) {
            return path::normalize(a, path::join(a, here, p[2..p.len]));
        }
        return path::normalize(a, concat(a, p[0..2], concat(a, "/", p[2..p.len])));
    }
    here := cwd(a)?;
    return path::normalize(a, path::join(a, here, p));
}

copy_text :: fn(a: *Arena, s: []const u8) -> []const u8 {
    out := a.alloc_bytes(s.len);
    for i in 0..s.len { out[i] = s[i]; }
    return out;
}

concat :: fn(a: *Arena, x: []const u8, y: []const u8) -> []const u8 {
    out := a.alloc_bytes(x.len + y.len);
    for i in 0..x.len { out[i] = x[i]; }
    for i in 0..y.len { out[x.len + i] = y[i]; }
    return out;
}

lower :: fn(c: u8) -> u8 { return if c >= 'A' && c <= 'Z' { c + 32 } else { c }; }

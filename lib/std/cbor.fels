// SPDX-License-Identifier: Apache-2.0
// std.cbor: rfc 8949; writer emits preferred (shortest) forms, reader allocates nothing

#import std.io as io;
#import std.io.{ Writer, IoError };
#import std.utf8 as utf8;

pub CborError :: errors {
    truncated,      // the bytes end in the middle of an item
    malformed,      // invalid header, or a stray `break`
    bad_text,       // a text string that is not UTF-8
    too_deep,       // `skip` hit 1000 nesting levels
}

pub Kind :: enum {
    uint,           // `value`
    negint,         // -1 - `value`
    bytes,          // `data`
    text,           // `data`, UTF-8
    array,          // `value` items follow
    map,            // `value` pairs follow, each a key and its value
    tag,            // the tag `value`; the item it tags follows
    simple,         // unassigned simple value, number in `value`
    boolean,        // `value` 1 for true, 0 for false
    null_value,
    undefined,
    float,          // `number`
    end,            // `break` closing an `indefinite` item
}

// from Reader.next; `data` slices the input
pub Item :: struct {
    kind: Kind,
    value: u64,
    data: []const u8,
    number: f64,
    // items (string parts) follow until a kind `end` item
    indefinite: bool,

    // uint/negint as i64; null if it doesn't fit
    pub as_i64 :: fn(self: *Self) -> ?i64 {
        if self.kind == .uint && self.value <= 0x7FFFFFFFFFFFFFFFu64 { return self.value as i64; }
        if self.kind == .negint && self.value <= 0x7FFFFFFFFFFFFFFFu64 { return -1 - (self.value as i64); }
        return null;
    }
}

// writing

// caller keeps item counts right; `end` closes indefinites; write errors show in finish
pub Out :: struct {
    w: *Writer,
    failed: bool,

    put :: fn(self: *Self, s: []const u8) {
        if self.failed { return; }
        n := io::write_all(self.w, s) catch err {
            self.failed = true;
            yield 0usize;
        };
    }

    // item head: major type + number, in 1, 2, 3, 5 or 9 bytes
    head :: fn(self: *Self, major: u8, v: u64) {
        b: [9]u8 = .{};
        m := major << 5;
        n: usize = 0;
        if v < 24 {
            b[0] = m | (v as u8);
            n = 1;
        } else if v <= 0xFF {
            b[0] = m | 24;
            n = 2;
        } else if v <= 0xFFFF {
            b[0] = m | 25;
            n = 3;
        } else if v <= 0xFFFFFFFF {
            b[0] = m | 26;
            n = 5;
        } else {
            b[0] = m | 27;
            n = 9;
        }
        for k in 1..n { b[k] = ((v >> ((8 * (n - 1 - k)) as u64)) & 0xFF) as u8; }
        self.put(b[0..n]);
    }

    pub uint :: fn(self: *Self, v: u64) { self.head(0, v); }

    pub int :: fn(self: *Self, v: i64) {
        if v >= 0 { self.head(0, v as u64); } else { self.head(1, (-1 - v) as u64); }
    }

    pub bytes :: fn(self: *Self, b: []const u8) {
        self.head(2, b.len as u64);
        self.put(b);
    }

    // utf-8 not checked
    pub text :: fn(self: *Self, s: []const u8) {
        self.head(3, s.len as u64);
        self.put(s);
    }

    // write n items next
    pub begin_array :: fn(self: *Self, n: usize) { self.head(4, n as u64); }

    // write n key/value pairs next
    pub begin_map :: fn(self: *Self, n: usize) { self.head(5, n as u64); }

    // write the items, then `end`
    pub begin_array_indefinite :: fn(self: *Self) { self.put("\x9f"); }

    // write the pairs, then `end`
    pub begin_map_indefinite :: fn(self: *Self) { self.put("\xbf"); }

    // closes an indefinite array or map
    pub end :: fn(self: *Self) { self.put("\xff"); }

    // tags the next item (1 = epoch seconds, 32 = uri, ...)
    pub tag :: fn(self: *Self, t: u64) { self.head(6, t); }

    pub boolean :: fn(self: *Self, v: bool) { self.put(if v { "\xf5" } else { "\xf4" }); }
    pub null_value :: fn(self: *Self) { self.put("\xf6"); }
    pub undefined :: fn(self: *Self) { self.put("\xf7"); }

    // 0..19 or 32..255; anything else writes nothing
    pub simple :: fn(self: *Self, v: u8) {
        if v < 20 { self.head(7, v as u64); }
        else if v >= 32 {
            b: [2]u8 = .{ 0xf8, v };
            self.put(b[:]);
        }
    }

    // shortest exact width; NaN as half
    pub float :: fn(self: *Self, v: f64) {
        if v != v {
            self.put("\xf9\x7e\x00");
            return;
        }
        if float_bits(v, 5, 10) |h| {
            self.word(0xf9, h, 2);
        } else if float_bits(v, 8, 23) |s| {
            self.word(0xfa, s, 4);
        } else {
            self.word(0xfb, float_bits(v, 11, 52) ?? 0u64, 8);
        }
    }

    word :: fn(self: *Self, first: u8, v: u64, n: usize) {
        b: [9]u8 = .{};
        b[0] = first;
        for k in 0..n { b[1 + k] = ((v >> ((8 * (n - 1 - k)) as u64)) & 0xFF) as u8; }
        self.put(b[0..n + 1]);
    }

    // pre-encoded cbor, as is
    pub raw :: fn(self: *Self, b: []const u8) { self.put(b); }

    // .write_failed if any write failed
    pub finish :: fn(self: *Self) -> void ! IoError {
        if self.failed { fail .write_failed; }
    }
}

pub writer :: fn(w: *Writer) -> Out {
    o: Out = .{ w, false };
    return o;
}

// reading

// one item at a time; a container's items follow its header
pub Reader :: struct {
    data: []const u8,
    pos: usize,

    pub at_end :: fn(self: *Self) -> bool { return self.pos >= self.data.len; }

    pub next :: fn(self: *Self) -> Item ! CborError {
        it: Item = .{ .uint, 0, "", 0.0, false };
        if self.pos >= self.data.len { fail .truncated; }
        ib := self.data[self.pos];
        self.pos += 1;
        major := ib >> 5;
        ai := ib & 31;
        if major == 7 {
            if ai < 20 {
                it.kind = .simple;
                it.value = ai as u64;
            } else if ai == 20 || ai == 21 {
                it.kind = .boolean;
                it.value = (ai - 20) as u64;
            } else if ai == 22 {
                it.kind = .null_value;
            } else if ai == 23 {
                it.kind = .undefined;
            } else if ai == 24 {
                v := self.take(1)?;
                if v < 32 { fail .malformed; }
                it.kind = .simple;
                it.value = v;
            } else if ai == 25 {
                it.kind = .float;
                it.number = from_bits(self.take(2)?, 5, 10);
            } else if ai == 26 {
                it.kind = .float;
                it.number = from_bits(self.take(4)?, 8, 23);
            } else if ai == 27 {
                it.kind = .float;
                it.number = from_bits(self.take(8)?, 11, 52);
            } else if ai == 31 {
                it.kind = .end;
            } else {
                fail .malformed;
            }
            return it;
        }
        if ai >= 28 && ai <= 30 { fail .malformed; }
        if ai == 31 {
            if major == 0 || major == 1 || major == 6 { fail .malformed; }
            it.indefinite = true;
        } else if ai < 24 {
            it.value = ai as u64;
        } else {
            it.value = self.take((1 as usize) << ((ai - 24) as usize))?;
        }
        if major == 0 { it.kind = .uint; }
        else if major == 1 { it.kind = .negint; }
        else if major == 2 || major == 3 {
            it.kind = if major == 2 { Kind.bytes } else { Kind.text };
            if !it.indefinite {
                if it.value > (self.data.len - self.pos) as u64 { fail .truncated; }
                n := it.value as usize;
                it.data = self.data[self.pos..self.pos + n];
                self.pos += n;
                if major == 3 && !utf8::valid(it.data) { fail .bad_text; }
            }
        }
        else if major == 4 { it.kind = .array; }
        else if major == 5 { it.kind = .map; }
        else { it.kind = .tag; }
        return it;
    }

    // skips the next item and everything in it
    pub skip :: fn(self: *Self) -> void ! CborError {
        self.skip_items(1)?;
    }

    // skips what `it` (just read) holds: items, pairs, tagged item, string parts
    pub skip_contents :: fn(self: *Self, it: Item) -> void ! CborError {
        n := self.held(it)?;
        if n != 0 { self.skip_items(n)?; }
    }

    // item count inside `it`; UNTIL_BREAK if indefinite
    held :: fn(self: *Self, it: Item) -> u64 ! CborError {
        if it.indefinite { return UNTIL_BREAK; }
        if it.kind == .tag { return 1; }
        if it.kind == .array || it.kind == .map {
            // each item takes a byte at least
            if it.value > (self.data.len - self.pos) as u64 { fail .truncated; }
            return if it.kind == .map { it.value * 2 } else { it.value };
        }
        return 0;
    }

    // skips n items (UNTIL_BREAK: through the break); explicit stack, no recursion
    skip_items :: fn(self: *Self, n: u64) -> void ! CborError {
        left: [MAX_DEPTH]u64 = .{};
        top: usize = 0;
        left[0] = n;
        while true {
            if left[top] == 0 {
                if top == 0 { return; }
                top -= 1;
                continue;
            }
            if left[top] == UNTIL_BREAK {
                if self.pos >= self.data.len { fail .truncated; }
                if self.data[self.pos] == 0xff {
                    self.pos += 1;
                    if top == 0 { return; }
                    top -= 1;
                    continue;
                }
            }
            it := self.next()?;
            if it.kind == .end { fail .malformed; }
            if left[top] != UNTIL_BREAK { left[top] -= 1; }
            inner := self.held(it)?;
            if inner != 0 {
                if top + 1 >= MAX_DEPTH { fail .too_deep; }
                top += 1;
                left[top] = inner;
            }
        }
    }

    // next n bytes, big-endian
    take :: fn(self: *Self, n: usize) -> u64 ! CborError {
        if self.data.len - self.pos < n { fail .truncated; }
        v: u64 = 0;
        for k in 0..n { v = (v << 8) | (self.data[self.pos + k] as u64); }
        self.pos += n;
        return v;
    }
}

MAX_DEPTH :: 1000usize;
UNTIL_BREAK :: 0xFFFFFFFFFFFFFFFFu64;

pub reader :: fn(data: []const u8) -> Reader {
    r: Reader = .{ data, 0 };
    return r;
}

// float bits via exact pow2 scaling, so compile-time code can use them too

TWO64 :: 18446744073709551616.0;

// x * 2^k; exact while each step holds x's bits
scale2 :: fn(x: f64, k: i32) -> f64 {
    v := x;
    e := k;
    while e >= 64 {
        v = v * TWO64;
        e -= 64;
    }
    while e <= -64 {
        v = v / TWO64;
        e += 64;
    }
    while e > 0 {
        v = v * 2.0;
        e -= 1;
    }
    while e < 0 {
        v = v * 0.5;
        e += 1;
    }
    return v;
}

// float from bits; exp/mant bits: half 5/10, single 8/23, double 11/52
from_bits :: fn(bits: u64, exp_bits: u32, mant_bits: u32) -> f64 {
    e_all := (1u64 << (exp_bits as u64)) - 1;
    bias := ((1u64 << ((exp_bits - 1) as u64)) - 1) as i32;
    neg := ((bits >> ((exp_bits + mant_bits) as u64)) & 1) == 1;
    e := (bits >> (mant_bits as u64)) & e_all;
    m := bits & ((1u64 << (mant_bits as u64)) - 1);
    v: f64 = 0.0;
    if e == e_all {
        v = scale2(1.0, 1024);                       // infinity
        if m != 0 { v = v - v; }                     // NaN
    } else if e == 0 {
        v = scale2(m as f64, 1 - bias - (mant_bits as i32));
    } else {
        v = scale2(((1u64 << (mant_bits as u64)) | m) as f64, (e as i32) - bias - (mant_bits as i32));
    }
    return if neg { -v } else { v };
}

// v's bits in that format if exact; null if not, or v is NaN
float_bits :: fn(v: f64, exp_bits: u32, mant_bits: u32) -> ?u64 {
    if v != v { return null; }
    total := (exp_bits + mant_bits) as u64;
    e_all := (1u64 << (exp_bits as u64)) - 1;
    bias := ((1u64 << ((exp_bits - 1) as u64)) - 1) as i32;
    sign: u64 = if v < 0.0 || (v == 0.0 && 1.0 / v < 0.0) { 1u64 << total } else { 0 };
    a := if v < 0.0 { -v } else { v };
    if a == 0.0 { return sign; }
    if a > 1.7976931348623157e308 { return sign | (e_all << (mant_bits as u64)); }
    // a = x * 2^e, 1 <= x < 2
    x := a;
    e: i32 = 0;
    while x >= TWO64 {
        x = x / TWO64;
        e += 64;
    }
    while x >= 2.0 {
        x = x * 0.5;
        e += 1;
    }
    while x < 1.0 / TWO64 {
        x = x * TWO64;
        e -= 64;
    }
    while x < 1.0 {
        x = x * 2.0;
        e -= 1;
    }
    if e > bias { return null; }
    if e >= 1 - bias {
        f := scale2(x - 1.0, mant_bits as i32);
        fm := f as u64;
        if (fm as f64) != f { return null; }
        return sign | (((e + bias) as u64) << (mant_bits as u64)) | fm;
    }
    // subnormal: a multiple of the smallest one
    f := scale2(a, (mant_bits as i32) - (1 - bias));
    fm := f as u64;
    if (fm as f64) != f { return null; }
    return sign | fm;
}

// SPDX-License-Identifier: Apache-2.0
// std.path: pure path string ops; reads / and \, writes SEP; builders take an *Arena

#import std.heap.{ Arena };
#import std.strings as strings;

// separator written by join and normalize
#if TARGET.os == .windows {
    pub SEP :: 92u8;   // '\'
} else {
    pub SEP :: 47u8;   // '/'
}

// either separator
pub is_sep :: fn(c: u8) -> bool { return c == 47u8 || c == 92u8; }   // '/' or '\'

// after the last separator; `p` if none, "" on a trailing separator
pub basename :: fn(p: []const u8) -> []const u8 {
    i: usize = p.len;
    while i > 0 {
        if is_sep(p[i - 1]) { return p[i..p.len]; }
        i = i - 1;
    }
    return p;
}

// up to the last separator, trailing ones trimmed; "." if none; a lone root stays
pub dirname :: fn(p: []const u8) -> []const u8 {
    i: usize = p.len;
    while i > 0 {
        if is_sep(p[i - 1]) {
            j: usize = i - 1;
            while j > 0 {
                if is_sep(p[j - 1]) { j = j - 1; } else { break; }
            }
            if j == 0 { return p[0..1usize]; }   // a rooted path like "\a"
            return p[0..j];
        }
        i = i - 1;
    }
    return ".";
}

// alias of dirname
pub parent :: fn(p: []const u8) -> []const u8 { return dirname(p); }

// includes the dot (".txt"); "" if none; ".gitignore" has none
pub extension :: fn(p: []const u8) -> []const u8 {
    b := basename(p);
    i: usize = b.len;
    while i > 0 {
        c := b[i - 1];
        if c == 46 {                                 // '.'
            if i - 1 == 0 { return ""; }     // leading-dot file
            return b[(i - 1)..b.len];
        }
        i = i - 1;
    }
    return "";
}

// basename minus extension
pub stem :: fn(p: []const u8) -> []const u8 {
    b := basename(p);
    e := extension(p);
    return b[0..(b.len - e.len)];
}

// leading separator, \ UNC prefix, or X: drive
pub is_absolute :: fn(p: []const u8) -> bool {
    if p.len == 0 { return false; }
    if is_sep(p[0]) { return true; }
    if p.len >= 2 {
        if p[1] == 58 { return true; }               // ':' -> drive letter
    }
    return false;
}

pub is_relative :: fn(p: []const u8) -> bool { return !is_absolute(p); }

// leading dot in `want` optional
pub has_extension :: fn(p: []const u8, want: []const u8) -> bool {
    e := extension(p);
    if want.len > 0 {
        if want[0] == 46 { return strings::str_eq(e, want); }
    }
    // `want` has no dot: compare without it
    if e.len == 0 { return want.len == 0; }
    return strings::str_eq(e[1..e.len], want);
}

// builders (need an arena)

// one SEP between; extra separators collapsed; an absolute `y` wins
pub join :: fn(a: *Arena, x: []const u8, y: []const u8) -> []const u8 {
    if x.len == 0 { return strings::str_dup(a, y); }
    if y.len == 0 { return strings::str_dup(a, x); }
    if is_absolute(y) { return strings::str_dup(a, y); }

    xe: usize = x.len;
    while xe > 0 {
        if is_sep(x[xe - 1]) { xe = xe - 1; } else { break; }
    }
    ys: usize = 0;
    while ys < y.len {
        if is_sep(y[ys]) { ys = ys + 1; } else { break; }
    }

    sb := strings::builder(a);
    strings::append(&sb, x[0..xe]);
    strings::append_byte(&sb, SEP);
    strings::append(&sb, y[ys..y.len]);
    return strings::str(&sb);
}

pub join3 :: fn(a: *Arena, x: []const u8, y: []const u8, z: []const u8) -> []const u8 {
    return join(a, join(a, x, y), z);
}

// leading dot optional; "" removes the extension
pub with_extension :: fn(a: *Arena, p: []const u8, new_ext: []const u8) -> []const u8 {
    e := extension(p);
    base := p[0..(p.len - e.len)];
    sb := strings::builder(a);
    strings::append(&sb, base);
    if new_ext.len > 0 {
        if new_ext[0] != 46 { strings::append_byte(&sb, 46); }
        strings::append(&sb, new_ext);
    }
    return strings::str(&sb);
}
// lexical clean-up: drops `.`, doubled seps and `x/..`; writes SEP; empty -> "."
// no disk access, so `..` past a symlink is lexical; leading `..` kept, root `..` dropped
pub normalize :: fn(a: *Arena, p: []const u8) -> []const u8 {
    out := a.alloc_bytes(p.len + 2);
    n: usize = 0;
    i: usize = 0;
    rooted := false;
    if p.len >= 2 && is_sep(p[0]) && is_sep(p[1]) {
        // \\server\share
        out[0] = SEP;
        out[1] = SEP;
        n = 2;
        i = 2;
        parts: usize = 0;
        for part in 0..2 {
            while i < p.len && is_sep(p[i]) { i += 1; }
            if i >= p.len { break; }
            parts += 1;
            if part == 1 {
                out[n] = SEP;
                n += 1;
            }
            while i < p.len && !is_sep(p[i]) {
                out[n] = p[i];
                n += 1;
                i += 1;
            }
        }
        rooted = parts > 0;
    } else if p.len >= 2 && p[1] == ':' && is_letter(p[0]) {
        out[0] = p[0];
        out[1] = ':';
        n = 2;
        i = 2;
        rooted = i < p.len && is_sep(p[i]);
    } else if p.len >= 1 && is_sep(p[0]) {
        rooted = true;
    }
    if rooted {
        out[n] = SEP;
        n += 1;
    }
    base := n;      // where the parts start
    while i < p.len {
        while i < p.len && is_sep(p[i]) { i += 1; }
        if i >= p.len { break; }
        s := i;
        while i < p.len && !is_sep(p[i]) { i += 1; }
        part := p[s..i];
        if part == "." { continue; }
        if part == ".." {
            if n > base {
                k := n;
                while k > base && out[k - 1] != SEP { k -= 1; }
                if !(n - k == 2 && out[k] == '.' && out[k + 1] == '.') {
                    n = if k > base { k - 1 } else { base };
                    continue;
                }
            } else if rooted {
                continue;
            }
        }
        if n > base {
            out[n] = SEP;
            n += 1;
        }
        for c in part {
            out[n] = c;
            n += 1;
        }
    }
    if n == 0 { return "."; }
    return out[0..n];
}

is_letter :: fn(c: u8) -> bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); }

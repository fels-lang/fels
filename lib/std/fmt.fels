// std.fmt — formatting on top of std.io.Writer: padding/alignment, width-justified
// numbers, joining. Fels has no varargs or format strings, so you compose *Writer
// calls directly and reach for these helpers for the fiddly parts (padding to a
// column, right-justifying a number, joining with a separator). Width-aware padding
// measures the value with a NullWriter first, then pads — allocation-free.
//
// No Display interface for now: dynamic dispatch to an interface method that itself
// takes another interface pointer trips a compiler bug (bad bitcast / segfault), so
// implement Writer directly on your type instead.

#import std.io.{ Writer, IoError, null_writer };

// Byte-slice padding
//
// If `data` is already at least `width` bytes, it is written as-is — these
// never truncate.

pub write_padded_left :: fn(w: *Writer, data: []const u8, width: usize, fill: u8) -> usize ! IoError {
    if data.len >= width {
        return w.write_all(data)?;
    }
    a := w.write_repeat(fill, width - data.len)?;
    b := w.write_all(data)?;
    return a + b;
}

pub write_padded_right :: fn(w: *Writer, data: []const u8, width: usize, fill: u8) -> usize ! IoError {
    if data.len >= width {
        return w.write_all(data)?;
    }
    a := w.write_all(data)?;
    b := w.write_repeat(fill, width - data.len)?;
    return a + b;
}

// Centers `data`, putting any odd leftover padding on the right.
pub write_padded_center :: fn(w: *Writer, data: []const u8, width: usize, fill: u8) -> usize ! IoError {
    if data.len >= width {
        return w.write_all(data)?;
    }
    total := width - data.len;
    left := total / 2;
    right := total - left;
    a := w.write_repeat(fill, left)?;
    b := w.write_all(data)?;
    c := w.write_repeat(fill, right)?;
    return a + b + c;
}

// Width-justified numbers
//
// Right-justify a number within `width`, padding on the left with `fill`
// (spaces for column alignment, '0' for fixed-width fields like "007").
// The value is measured with a NullWriter first so the padding can precede it
// without ever buffering or allocating the rendered text.

pub write_u64_padded :: fn(w: *Writer, value: u64, width: usize, fill: u8) -> usize ! IoError {
    measure := null_writer();
    mw: *Writer = &measure;
    n := mw.write_u64(value)?;

    pad := 0usize;
    if measure.count < width { pad = width - measure.count; }
    a := w.write_repeat(fill, pad)?;
    b := w.write_u64(value)?;
    return a + b;
}

pub write_i64_padded :: fn(w: *Writer, value: i64, width: usize, fill: u8) -> usize ! IoError {
    measure := null_writer();
    mw: *Writer = &measure;
    n := mw.write_i64(value)?;

    pad := 0usize;
    if measure.count < width { pad = width - measure.count; }
    a := w.write_repeat(fill, pad)?;
    b := w.write_i64(value)?;
    return a + b;
}

pub write_hex_u64_padded :: fn(w: *Writer, value: u64, width: usize, fill: u8) -> usize ! IoError {
    measure := null_writer();
    mw: *Writer = &measure;
    n := mw.write_hex_u64(value)?;

    pad := 0usize;
    if measure.count < width { pad = width - measure.count; }
    a := w.write_repeat(fill, pad)?;
    b := w.write_hex_u64(value)?;
    return a + b;
}

// Joining

// Write each byte slice in `items`, separated by `sep`.
//   join_bytes(w, .{"a", "b", "c"}[:], ", ")  ->  "a, b, c"
pub join_bytes :: fn(w: *Writer, items: []const []const u8, sep: []const u8) -> usize ! IoError {
    written := 0usize;
    for i in 0..items.len {
        if i > 0 {
            written += w.write_all(sep)?;
        }
        written += w.write_all(items[i])?;
    }
    return written;
}
// Parsing numbers

pub ParseError :: errors {
    empty,      // no digits
    invalid,    // a character that is no digit of the base, or a sign or `_` out of place
    overflow,   // the number does not fit the type
}

/// The integer `text` writes, as a `T` (any integer type). `base` is 2 to 36, or 0 to take it
/// from a prefix: `0x` hexadecimal, `0o` octal, `0b` binary, decimal without one. A `+` may
/// lead, and a `-` for a signed type; `_` may stand between digits (`1_000_000`).
///   fmt::parse_int(i32, "-42", 10)      // -42
///   fmt::parse_int(u8, "0xff", 0)       // 255
///   fmt::parse_int(u8, "256", 10)       // fails .overflow
pub parse_int :: fn($T: type, text: []const u8, base: u8) -> T ! ParseError {
    i: usize = 0;
    negative := false;
    if i < text.len && (text[i] == '+' || text[i] == '-') {
        negative = text[i] == '-';
        i += 1;
    }
    b: u64 = base as u64;
    if base == 0 {
        b = 10;
        if i + 1 < text.len && text[i] == '0' {
            p := text[i + 1] | 0x20;
            if p == 'x' {
                b = 16;
                i += 2;
            } else if p == 'o' {
                b = 8;
                i += 2;
            } else if p == 'b' {
                b = 2;
                i += 2;
            }
        }
    }
    if b < 2 || b > 36 { fail .invalid; }
    signed := ~(0 as T) < (0 as T);
    if negative && !signed { fail .invalid; }
    // The largest magnitude a `T` holds: its maximum, or for a negative number its minimum's.
    bits := (core::sizeof(T) * 8) as u64;
    limit: u64 = 0;
    if signed {
        limit = (1u64 << (bits - 1)) - 1;
        if negative { limit += 1; }
    } else if bits >= 64 {
        limit = 0xFFFFFFFFFFFFFFFF;
    } else {
        limit = (1u64 << bits) - 1;
    }
    value: u64 = 0;
    digits := 0;
    after_underscore := false;
    while i < text.len {
        c := text[i];
        i += 1;
        if c == '_' {
            if digits == 0 || after_underscore { fail .invalid; }
            after_underscore = true;
            continue;
        }
        d := digit_value(c);
        if d >= b { fail .invalid; }
        if value > (limit - d) / b { fail .overflow; }
        value = value * b + d;
        digits += 1;
        after_underscore = false;
    }
    if digits == 0 { fail .empty; }
    if after_underscore { fail .invalid; }
    if negative { return (0 -% value) as T; }
    return value as T;
}

/// The value of a digit in any base up to 36 (`0`–`9`, then `a`/`A` for 10 up to `z`/`Z`), or 99.
digit_value :: fn(c: u8) -> u64 {
    if c >= '0' && c <= '9' { return (c - '0') as u64; }
    if c >= 'a' && c <= 'z' { return (c - 'a') as u64 + 10; }
    if c >= 'A' && c <= 'Z' { return (c - 'A') as u64 + 10; }
    return 99;
}

/// The number `text` writes, as an `f64`: an optional sign, digits with an optional `.` (`2.5`,
/// `.5`, `5.`), and an optional exponent (`1e-3`, `6.02E23`); also `inf`, `infinity` and `nan`.
/// Too large is an infinity, too small zero. It is the closest `f64` for up to 15 significant
/// digits and an exponent within ±22; beyond that it may be off by one in the last bit.
pub parse_float :: fn(text: []const u8) -> f64 ! ParseError {
    i: usize = 0;
    negative := false;
    if i < text.len && (text[i] == '+' || text[i] == '-') {
        negative = text[i] == '-';
        i += 1;
    }
    rest := text[i..text.len];
    if eq_lower(rest, "inf") || eq_lower(rest, "infinity") { return if negative { -1.0 / 0.0 } else { 1.0 / 0.0 }; }
    if eq_lower(rest, "nan") { return 0.0 / 0.0; }
    // The first 19 significant digits as a whole number, and the power of ten it is scaled by.
    mantissa: u64 = 0;
    kept: u32 = 0;
    exp10: i64 = 0;
    digits := 0;
    while i < text.len && text[i] >= '0' && text[i] <= '9' {
        if kept < 19 {
            mantissa = mantissa * 10 + (text[i] - '0') as u64;
            if mantissa != 0 { kept += 1; }
        } else {
            exp10 += 1;
        }
        digits += 1;
        i += 1;
    }
    if i < text.len && text[i] == '.' {
        i += 1;
        while i < text.len && text[i] >= '0' && text[i] <= '9' {
            if kept < 19 {
                mantissa = mantissa * 10 + (text[i] - '0') as u64;
                if mantissa != 0 { kept += 1; }
                exp10 -= 1;
            }
            digits += 1;
            i += 1;
        }
    }
    if digits == 0 { fail .empty; }
    if i < text.len && (text[i] == 'e' || text[i] == 'E') {
        i += 1;
        exp_negative := false;
        if i < text.len && (text[i] == '+' || text[i] == '-') {
            exp_negative = text[i] == '-';
            i += 1;
        }
        e: i64 = 0;
        exp_digits := 0;
        while i < text.len && text[i] >= '0' && text[i] <= '9' {
            if e < 100000 { e = e * 10 + (text[i] - '0') as i64; }
            exp_digits += 1;
            i += 1;
        }
        if exp_digits == 0 { fail .invalid; }
        exp10 += if exp_negative { -e } else { e };
    }
    if i != text.len { fail .invalid; }
    value := scale(mantissa, exp10);
    return if negative { -value } else { value };
}

/// `mantissa` times ten to `exp10`. A mantissa below 2^53 and a power of ten up to 10^22 are both
/// exact as doubles, so one multiplication or division rounds once and is exact; otherwise the
/// powers are applied in steps.
scale :: fn(mantissa: u64, exp10: i64) -> f64 {
    if mantissa == 0 { return 0.0; }
    m := mantissa as f64;
    if mantissa < 9007199254740992 && exp10 >= -22 && exp10 <= 22 {
        if exp10 >= 0 { return m * pow10(exp10 as u32); }
        return m / pow10((-exp10) as u32);
    }
    if exp10 > 330 { return 1.0 / 0.0; }
    if exp10 < -360 { return 0.0; }
    e := exp10;
    while e > 22 {
        m *= 1e22;
        e -= 22;
    }
    while e < -22 {
        m /= 1e22;
        e += 22;
    }
    if e >= 0 { return m * pow10(e as u32); }
    return m / pow10((-e) as u32);
}

/// Ten to the `n`, for `n` up to 22: every one of them is exact as an `f64`.
pow10 :: fn(n: u32) -> f64 {
    p: f64 = 1.0;
    k: u32 = 0;
    while k < n {
        p *= 10.0;
        k += 1;
    }
    return p;
}

/// Whether `text` is `word` (lower case) in any case.
eq_lower :: fn(text: []const u8, word: []const u8) -> bool {
    if text.len != word.len { return false; }
    i: usize = 0;
    while i < text.len {
        if (text[i] | 0x20) != word[i] { return false; }
        i += 1;
    }
    return true;
}

// SPDX-License-Identifier: Apache-2.0
// std.net: tcp/udp facade over net.os/addr/socket/tcp/udp; re-exports their types
// call net::init() once per process before any socket call

#import std.net.os as os;
#import std.net.addr as addr;
#import std.net.tcp as tcp;
#import std.net.udp as udp;
#import std.net.dns as dns;
#import std.strings as strings;
#import std.heap.{ Arena };
#import std.fs as fs;
#import std.time as time;

pub NetError    :: os::NetError;
pub SocketAddr  :: addr::SocketAddr;
pub TcpStream   :: tcp::TcpStream;
pub TcpListener :: tcp::TcpListener;
pub Accepted    :: tcp::Accepted;
pub UdpSocket   :: udp::UdpSocket;
pub Datagram    :: udp::Datagram;

// lifecycle

// init winsock; once, before any socket call
pub init :: fn() -> void ! NetError { os::init()?; return; }

// tear down winsock; optional, at exit
pub shutdown :: fn() { os::cleanup(); }

// last winsock error on this thread (WSAGetLastError)
pub last_error :: fn() -> i32 { return os::last_error(); }

// tcp

// connect to `sa` (client)
pub connect :: fn(sa: SocketAddr) -> TcpStream ! NetError {
    return tcp::connect(sa)?;
}

// bind + listen on `sa`, backlog 16
pub listen :: fn(sa: SocketAddr) -> TcpListener ! NetError {
    return tcp::listen(sa)?;
}

// names

// ipv4 of `host`: dotted, localhost, or looked up (after init); files read into `a`
// windows: system resolver; linux: /etc/hosts, then resolv.conf servers, 2 s each
pub resolve :: fn(a: *Arena, host: []const u8) -> addr::IpV4 ! NetError {
    ok := true;
    ip := addr::parse(host) catch err {
        ok = false;
        yield addr::any();
    };
    if ok { return ip; }
    if strings::str_eq_ignore_case(host, "localhost") { return addr::localhost(); }
    return resolve_os(a, host);
}

// resolve `host`, connect at `port`
pub connect_host :: fn(a: *Arena, host: []const u8, port: u16) -> TcpStream ! NetError {
    ip := resolve(a, host)?;
    return connect(addr::socket_addr(ip, port));
}

#if TARGET.os == .windows {
    resolve_os :: fn(a: *Arena, host: []const u8) -> addr::IpV4 ! NetError {
        name: [300]u8 = .{};
        if host.len >= 300 { fail .unknown_host; }
        for k in 0..host.len { name[k] = host[k]; }
        v := os_net_resolve(&name[0]);
        if v == 0 { fail .unknown_host; }
        return addr::from_net(v);
    }
} else {
    resolve_os :: fn(a: *Arena, host: []const u8) -> addr::IpV4 ! NetError {
        hosts := fs::read_all("/etc/hosts", a) catch err { yield a.alloc_bytes(0); };
        if dns::from_hosts(hosts, host) |found| { return found; }
        conf := fs::read_all("/etc/resolv.conf", a) catch err { yield a.alloc_bytes(0); };
        list: [3]addr::IpV4 = .{};
        n := dns::servers(conf, list[:]);
        id := (time::unix_nanos() & 0xFFFF) as u16;
        query: [512]u8 = .{};
        len := dns::build_query(host, id, query[:]);
        if len == 0 { fail .unknown_host; }
        for k in 0..n {
            s := udp::unbound() catch err { continue; };
            s.set_read_timeout(2000) catch err {};
            sent := s.send_to(query[0..len], addr::socket_addr(list[k], 53)) catch err {
                s.close();
                continue;
            };
            answer: [1500]u8 = .{};
            d := s.recv_from(answer[:]) catch err {
                s.close();
                continue;
            };
            s.close();
            if dns::parse_answer(answer[0..d.len], id) |found| { return found; }
        }
        fail .unknown_host;
    }
}

// udp

// UdpSocket bound to `sa`
pub udp_bind :: fn(sa: SocketAddr) -> UdpSocket ! NetError {
    return udp::bind(sa)?;
}
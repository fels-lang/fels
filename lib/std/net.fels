// SPDX-License-Identifier: Apache-2.0
// std.net — TCP/UDP networking over Winsock2. A thin facade over a layered set of
// submodules: net.os (raw ws2_32 + NetError), net.addr (IpV4/SocketAddr), net.socket
// (the typed Socket handle), net.tcp (TcpStream/TcpListener), net.udp (UdpSocket).
//
// Call net::init() once per process, then use the helpers here:
//
//   net::init() catch e { return; };
//   s: net::TcpStream = net::connect(addr::socket_addr(addr::localhost(), 8080u16)) catch e { return; };
//   ignored := s.send_all("ping") catch e {};
//   net::shutdown();
//
// The types of the submodules are re-exported here (`net::TcpStream`, `net::NetError`), so
// only std.net.addr is needed besides, for building an address.

#import std.net.os as os;
#import std.net.addr as addr;
#import std.net.tcp as tcp;
#import std.net.udp as udp;

pub NetError    :: os::NetError;
pub SocketAddr  :: addr::SocketAddr;
pub TcpStream   :: tcp::TcpStream;
pub TcpListener :: tcp::TcpListener;
pub Accepted    :: tcp::Accepted;
pub UdpSocket   :: udp::UdpSocket;
pub Datagram    :: udp::Datagram;

// Library lifecycle

// Initialise Winsock — call once before any socket call.
pub init :: fn() -> void ! NetError { os::init()?; return; }

// Tear Winsock down (optional, at process exit).
pub shutdown :: fn() { os::cleanup(); }

// The last Winsock error code on this thread (`WSAGetLastError`), for diagnosing
// a `NetError`.
pub last_error :: fn() -> i32 { return os::last_error(); }

// TCP convenience

// Connect to `sa` and return a ready `TcpStream` (client side).
pub connect :: fn(sa: SocketAddr) -> TcpStream ! NetError {
    return tcp::connect(sa)?;
}

// Bind + listen on `sa`, returning a `TcpListener` (server side, backlog 16).
pub listen :: fn(sa: SocketAddr) -> TcpListener ! NetError {
    return tcp::listen(sa)?;
}

// UDP convenience

// A `UdpSocket` bound to `sa`.
pub udp_bind :: fn(sa: SocketAddr) -> UdpSocket ! NetError {
    return udp::bind(sa)?;
}
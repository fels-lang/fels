// std.bufio: buffered io::Reader/io::Writer wrappers; the caller owns the buffer

#import std.io.{ Reader, Writer, IoError };
#import std.heap.{ Arena, alloc_bytes };

// unread bytes are buf[start..end]
pub BufReader :: struct {
    src: *Reader,
    buf: []u8,
    start: usize,
    end: usize,
    // src returned 0 bytes
    at_end: bool,
    // a read in lines() failed or a line overflowed the buffer; the loop stopped
    failed: bool,

    // read but not yet taken
    pub buffered :: fn(self: *Self) -> []const u8 { return self.buf[self.start..self.end]; }

    // compacts, reads more from src; returns bytes added (0 at end or when full)
    pub fill :: fn(self: *Self) -> usize ! IoError {
        if self.start > 0 {
            n := self.end - self.start;
            for i in 0..n { self.buf[i] = self.buf[self.start + i]; }
            self.start = 0;
            self.end = n;
        }
        if self.at_end || self.end == self.buf.len { return 0; }
        got := self.src.read(self.buf[self.end..self.buf.len])?;
        if got == 0 { self.at_end = true; }
        self.end += got;
        return got;
    }

    // null at the end
    pub read_byte :: fn(self: *Self) -> ?u8 ! IoError {
        if self.start == self.end {
            if self.fill()? == 0 { return null; }
        }
        b := self.buf[self.start];
        self.start += 1;
        return b;
    }

    // up to `delim`, excluded; the tail at end, then null; buffer_full if no delim fits
    // slice into the buffer; valid until the next read
    pub read_until :: fn(self: *Self, delim: u8) -> ?[]const u8 ! IoError {
        scanned: usize = 0;
        while true {
            i := self.start + scanned;
            while i < self.end {
                if self.buf[i] == delim {
                    part := self.buf[self.start..i];
                    self.start = i + 1;
                    return part;
                }
                i += 1;
            }
            scanned = self.end - self.start;
            if self.at_end {
                if self.start == self.end { return null; }
                part := self.buf[self.start..self.end];
                self.start = self.end;
                return part;
            }
            if self.start == 0 && self.end == self.buf.len { fail .buffer_full; }
            self.fill()?;
        }
        return null;
    }

    // like read_until('\n'), "\r" stripped too; no empty last line
    pub read_line :: fn(self: *Self) -> ?[]const u8 ! IoError {
        if self.read_until('\n')? |line| {
            if line.len > 0 && line[line.len - 1] == '\r' { return line[0..line.len - 1]; }
            return line;
        }
        return null;
    }

    // remaining lines; a failed read ends the loop and sets `failed`
    pub lines :: fn(self: *Self) -> Lines {
        it: Lines = .{ self };
        return it;
    }
}

BufReader as Reader {
    read :: fn(self: *Self, out: []u8) -> usize ! IoError {
        if self.start == self.end {
            // empty buffer and a big read: straight to src
            if out.len >= self.buf.len { return self.src.read(out)?; }
            if self.fill()? == 0 { return 0; }
        }
        n := self.end - self.start;
        if n > out.len { n = out.len; }
        for i in 0..n { out[i] = self.buf[self.start + i]; }
        self.start += n;
        return n;
    }
}

// iterator from BufReader.lines
pub Lines :: struct {
    r: *BufReader,

    pub next :: fn(self: *Self) -> ?[]const u8 {
        line := self.r.read_line() catch err {
            self.r.failed = true;
            yield null;
        };
        return line;
    }
}

// uses `buf` as the buffer
pub reader :: fn(src: *Reader, buf: []u8) -> BufReader {
    r: BufReader = .{ src, buf, 0, 0, false, false };
    return r;
}

// `size`-byte buffer in `a`
pub reader_in :: fn(a: *Arena, src: *Reader, size: usize) -> BufReader {
    return reader(src, a.alloc_bytes(size));
}

// buf[0..n] waits to be written; flush writes it
pub BufWriter :: struct {
    dst: *Writer,
    buf: []u8,
    n: usize,

    // writes the buffer to dst; does not flush dst
    pub drain :: fn(self: *Self) -> void ! IoError {
        if self.n == 0 { return; }
        done: usize = 0;
        while done < self.n {
            got := self.dst.write(self.buf[done..self.n])?;
            if got == 0 { fail .write_failed; }
            done += got;
        }
        self.n = 0;
    }
}

BufWriter as Writer {
    write :: fn(self: *Self, data: []const u8) -> usize ! IoError {
        if data.len > self.buf.len - self.n { self.drain()?; }
        // big writes go straight to dst
        if data.len >= self.buf.len {
            done: usize = 0;
            while done < data.len {
                got := self.dst.write(data[done..data.len])?;
                if got == 0 { fail .write_failed; }
                done += got;
            }
            return data.len;
        }
        for i in 0..data.len { self.buf[self.n + i] = data[i]; }
        self.n += data.len;
        return data.len;
    }
    flush :: fn(self: *Self) -> void ! IoError {
        self.drain()?;
        self.dst.flush()?;
    }
}

// uses `buf` as the buffer
pub writer :: fn(dst: *Writer, buf: []u8) -> BufWriter {
    w: BufWriter = .{ dst, buf, 0 };
    return w;
}

// `size`-byte buffer in `a`
pub writer_in :: fn(a: *Arena, dst: *Writer, size: usize) -> BufWriter {
    return writer(dst, a.alloc_bytes(size));
}

// reads src to its end into `a`
pub read_all :: fn(a: *Arena, src: *Reader) -> []u8 ! IoError {
    buf := a.alloc_bytes(4096);
    n: usize = 0;
    while true {
        if n == buf.len {
            // arena can't grow a block: allocate twice as big and copy
            bigger := a.alloc_bytes(buf.len * 2);
            for i in 0..n { bigger[i] = buf[i]; }
            buf = bigger;
        }
        got := src.read(buf[n..buf.len])?;
        if got == 0 { return buf[0..n]; }
        n += got;
    }
    return buf[0..n];
}

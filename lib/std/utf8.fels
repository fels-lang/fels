// SPDX-License-Identifier: Apache-2.0
// std.utf8: strict utf-8 decode/encode/validate; a bad byte decodes as REPLACEMENT, len 1

// U+FFFD, what a bad byte decodes to
pub REPLACEMENT :: 0xFFFDu32;

// rune + bytes used
pub Decoded :: struct {
    rune: u32,
    len: usize,
}

// rune at the start of `s`; REPLACEMENT, 1 for a bad sequence; `s` must not be empty
pub decode :: fn(s: []const u8) -> Decoded {
    b0 := s[0];
    if b0 < 0x80 { return .{ b0 as u32, 1 }; }
    bad: Decoded = .{ REPLACEMENT, 1 };
    // second byte's range rules out overlong forms, surrogates, > U+10FFFF
    n: usize = 0;
    lo: u8 = 0x80;
    hi: u8 = 0xBF;
    first: u32 = 0;
    if b0 >= 0xC2 && b0 <= 0xDF {
        n = 2;
        first = (b0 & 0x1F) as u32;
    } else if b0 >= 0xE0 && b0 <= 0xEF {
        n = 3;
        first = (b0 & 0x0F) as u32;
        if b0 == 0xE0 { lo = 0xA0; }
        if b0 == 0xED { hi = 0x9F; }
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
        n = 4;
        first = (b0 & 0x07) as u32;
        if b0 == 0xF0 { lo = 0x90; }
        if b0 == 0xF4 { hi = 0x8F; }
    } else {
        return bad;
    }
    if s.len < n { return bad; }
    if s[1] < lo || s[1] > hi { return bad; }
    r := (first << 6) | (s[1] & 0x3F) as u32;
    i: usize = 2;
    while i < n {
        if s[i] < 0x80 || s[i] > 0xBF { return bad; }
        r = (r << 6) | (s[i] & 0x3F) as u32;
        i += 1;
    }
    return .{ r, n };
}

// utf-8 length of `r`, 1..4; 0 if not a rune (surrogate or > U+10FFFF)
pub encoded_len :: fn(r: u32) -> usize {
    if r < 0x80 { return 1; }
    if r < 0x800 { return 2; }
    if r >= 0xD800 && r <= 0xDFFF { return 0; }
    if r < 0x10000 { return 3; }
    if r <= 0x10FFFF { return 4; }
    return 0;
}

// encode `r` into `out`; its len, or 0 and nothing written if invalid or too short
pub encode :: fn(out: []u8, r: u32) -> usize {
    n := encoded_len(r);
    if n == 0 || out.len < n { return 0; }
    if n == 1 {
        out[0] = r as u8;
    } else if n == 2 {
        out[0] = 0xC0 | (r >> 6) as u8;
        out[1] = 0x80 | (r & 0x3F) as u8;
    } else if n == 3 {
        out[0] = 0xE0 | (r >> 12) as u8;
        out[1] = 0x80 | ((r >> 6) & 0x3F) as u8;
        out[2] = 0x80 | (r & 0x3F) as u8;
    } else {
        out[0] = 0xF0 | (r >> 18) as u8;
        out[1] = 0x80 | ((r >> 12) & 0x3F) as u8;
        out[2] = 0x80 | ((r >> 6) & 0x3F) as u8;
        out[3] = 0x80 | (r & 0x3F) as u8;
    }
    return n;
}

// all of `s` is valid utf-8
pub valid :: fn(s: []const u8) -> bool {
    i: usize = 0;
    while i < s.len {
        if s[i] < 0x80 {
            i += 1;
            continue;
        }
        d := decode(s[i..s.len]);
        // a literal U+FFFD is 3 bytes; a bad byte is 1
        if d.rune == REPLACEMENT && d.len == 1 { return false; }
        i += d.len;
    }
    return true;
}

// rune count; each bad byte counts as one
pub count :: fn(s: []const u8) -> usize {
    n: usize = 0;
    i: usize = 0;
    while i < s.len {
        i += if s[i] < 0x80 { 1 } else { decode(s[i..s.len]).len };
        n += 1;
    }
    return n;
}

// iterator from `runes`
pub Runes :: struct {
    rest: []const u8,

    pub next :: fn(self: *Self) -> ?u32 {
        if self.rest.len == 0 { return null; }
        d := decode(self.rest);
        self.rest = self.rest[d.len..self.rest.len];
        return d.rune;
    }
}

// iterate the runes of `s`
pub runes :: fn(s: []const u8) -> Runes {
    it: Runes = .{ s };
    return it;
}

// `b` is a continuation byte (10xxxxxx)
pub is_continuation :: fn(b: u8) -> bool { return (b & 0xC0) == 0x80; }

// std.utf16 - convert between UTF-8 and UTF-16.
//
// Pure Fels: no OS calls, so it behaves the same on every target. (On Windows,
// MultiByteToWideChar / WideCharToMultiByte do a related job, but they are a separate API
// with their own treatment of malformed input; nothing here depends on them.)
//
// Representations. UTF-8 text is a `[]const u8`, as everywhere in Fels; nothing
// guarantees a string is valid UTF-8, which is why every conversion here validates.
// UTF-16 text is a `[]const u16` of code units in the machine's own order: no byte-order
// mark, no serialisation. A supplementary character (above U+FFFF) is a surrogate pair.
//
// Malformed input is an error, never repaired. There is no replacement character.
//   UTF-8 is malformed if it has: a byte that cannot start a sequence (a stray
//   continuation byte 80..BF, C0, C1, F5..FF); a sequence cut short by the end of the
//   input or by a byte that is not a continuation; an overlong encoding (E0 80..9F, F0
//   80..8F, C0/C1); an encoded surrogate (ED A0..BF); or a value above U+10FFFF
//   (F4 90..BF). -> `.invalid_utf8`
//   UTF-16 is malformed if it has a high surrogate (D800..DBFF) not immediately followed
//   by a low one (DC00..DFFF), or a low surrogate not preceded by a high one.
//   -> `.invalid_utf16`
// U+0000 is an ordinary character, converted like any other.
//
// Sizing and capacity are explicit. `utf16_len` / `utf8_len` validate the input and give
// the exact size of the result. The conversion functions write into a buffer you provide:
// they validate and count first, and if the buffer is too small they fail with
// `.buffer_too_small`. On any error the destination is not modified.
//
//     n := utf16::utf16_len(text)?;
//     buf := a.alloc(u16, n + 1);                 // room for a terminating 0 if you want one
//     utf16::utf8_to_utf16(text, buf[0..n])?;
//     buf[n] = 0u16;
//
// `alloc_utf16`, `alloc_utf16z` and `alloc_utf8` do that sizing and allocation from an
// `*Arena` for you. The memory belongs to the arena; nothing here frees it.

#import std.heap.{ Arena, try_alloc };

pub Utf16Error :: errors {
    invalid_utf8,       // the UTF-8 input is not well formed
    invalid_utf16,      // the UTF-16 input has an unpaired surrogate
    buffer_too_small,   // the destination cannot hold the whole result
    out_of_memory,      // the arena could not supply the result's storage
}

// One decoded code point and the number of input units it used. `len == 0` means the input
// at that position is malformed.
Decoded :: struct { cp: u32, len: usize }

malformed :: fn() -> Decoded {
    return .{ 0, 0 };
}

// Decode the UTF-8 sequence that starts at src[i] (i < src.len). Every continuation byte
// and every bound is checked before it is read.
decode_utf8 :: fn(src: []const u8, i: usize) -> Decoded {
    b0 := src[i] as u32;
    if b0 < 0x80 { return .{ b0, 1 }; }
    if b0 < 0xC2 { return malformed(); }              // stray continuation, or C0/C1 (overlong)
    rest := src.len - i;
    if b0 < 0xE0 {
        if rest < 2 { return malformed(); }
        b1 := src[i + 1] as u32;
        if b1 < 0x80 || b1 > 0xBF { return malformed(); }
        return .{ ((b0 & 0x1F) << 6) | (b1 & 0x3F), 2 };
    }
    if b0 < 0xF0 {
        if rest < 3 { return malformed(); }
        b1 := src[i + 1] as u32;
        b2 := src[i + 2] as u32;
        lo: u32 = 0x80;
        hi: u32 = 0xBF;
        if b0 == 0xE0 { lo = 0xA0; }               // E0 80..9F would be overlong
        if b0 == 0xED { hi = 0x9F; }               // ED A0..BF would be a surrogate
        if b1 < lo || b1 > hi { return malformed(); }
        if b2 < 0x80 || b2 > 0xBF { return malformed(); }
        return .{ ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F), 3 };
    }
    if b0 < 0xF5 {
        if rest < 4 { return malformed(); }
        b1 := src[i + 1] as u32;
        b2 := src[i + 2] as u32;
        b3 := src[i + 3] as u32;
        lo: u32 = 0x80;
        hi: u32 = 0xBF;
        if b0 == 0xF0 { lo = 0x90; }               // F0 80..8F would be overlong
        if b0 == 0xF4 { hi = 0x8F; }               // F4 90..BF would exceed U+10FFFF
        if b1 < lo || b1 > hi { return malformed(); }
        if b2 < 0x80 || b2 > 0xBF { return malformed(); }
        if b3 < 0x80 || b3 > 0xBF { return malformed(); }
        return .{ ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F), 4 };
    }
    return malformed();                                  // F5..FF never start a sequence
}

// Decode the UTF-16 code point that starts at src[i] (i < src.len).
decode_utf16 :: fn(src: []const u16, i: usize) -> Decoded {
    u := src[i] as u32;
    if u < 0xD800 || u > 0xDFFF { return .{ u, 1 }; }
    if u >= 0xDC00 { return malformed(); }            // a low surrogate with no high one before it
    if i + 1 >= src.len { return malformed(); }     // a high surrogate at the end
    v := src[i + 1] as u32;
    if v < 0xDC00 || v > 0xDFFF { return malformed(); }
    return .{ 0x10000 + ((u - 0xD800) << 10) + (v - 0xDC00), 2 };
}

units_utf16 :: fn(cp: u32) -> usize {
    if cp >= 0x10000 { return 2; }
    return 1;
}

bytes_utf8 :: fn(cp: u32) -> usize {
    if cp < 0x80 { return 1; }
    if cp < 0x800 { return 2; }
    if cp < 0x10000 { return 3; }
    return 4;
}

// The exact number of UTF-16 code units that encode `src`, or `.invalid_utf8`.
pub utf16_len :: fn(src: []const u8) -> usize ! Utf16Error {
    n := 0usize;
    i := 0usize;
    while i < src.len {
        d := decode_utf8(src, i);
        if d.len == 0 { fail .invalid_utf8; }
        n += units_utf16(d.cp);
        i += d.len;
    }
    return n;
}

// The exact number of bytes that encode `src` as UTF-8, or `.invalid_utf16`.
pub utf8_len :: fn(src: []const u16) -> usize ! Utf16Error {
    n := 0usize;
    i := 0usize;
    while i < src.len {
        d := decode_utf16(src, i);
        if d.len == 0 { fail .invalid_utf16; }
        n += bytes_utf8(d.cp);
        i += d.len;
    }
    return n;
}

// Convert UTF-8 `src` to UTF-16 in `dst` and return the number of code units written
// (`utf16_len(src)`). Fails with `.invalid_utf8` or `.buffer_too_small`; on failure `dst`
// is untouched. `dst` may be longer than needed; the rest is left as it was.
pub utf8_to_utf16 :: fn(src: []const u8, dst: []u16) -> usize ! Utf16Error {
    need := utf16_len(src)?;
    if dst.len < need { fail .buffer_too_small; }
    i := 0usize;
    j := 0usize;
    while i < src.len {
        d := decode_utf8(src, i);                        // valid: utf16_len checked it
        if d.cp >= 0x10000 {
            c := d.cp - 0x10000;
            dst[j] = (0xD800 + (c >> 10)) as u16;
            dst[j + 1] = (0xDC00 + (c & 0x3FF)) as u16;
            j += 2;
        } else {
            dst[j] = d.cp as u16;
            j += 1;
        }
        i += d.len;
    }
    return need;
}

// Convert UTF-16 `src` to UTF-8 in `dst` and return the number of bytes written
// (`utf8_len(src)`). Fails with `.invalid_utf16` or `.buffer_too_small`; on failure `dst`
// is untouched. `dst` may be longer than needed; the rest is left as it was.
pub utf16_to_utf8 :: fn(src: []const u16, dst: []u8) -> usize ! Utf16Error {
    need := utf8_len(src)?;
    if dst.len < need { fail .buffer_too_small; }
    i := 0usize;
    j := 0usize;
    while i < src.len {
        d := decode_utf16(src, i);                       // valid: utf8_len checked it
        cp := d.cp;
        if cp < 0x80 {
            dst[j] = cp as u8;
            j += 1;
        } else if cp < 0x800 {
            dst[j] = (0xC0 | (cp >> 6)) as u8;
            dst[j + 1] = (0x80 | (cp & 0x3F)) as u8;
            j += 2;
        } else if cp < 0x10000 {
            dst[j] = (0xE0 | (cp >> 12)) as u8;
            dst[j + 1] = (0x80 | ((cp >> 6) & 0x3F)) as u8;
            dst[j + 2] = (0x80 | (cp & 0x3F)) as u8;
            j += 3;
        } else {
            dst[j] = (0xF0 | (cp >> 18)) as u8;
            dst[j + 1] = (0x80 | ((cp >> 12) & 0x3F)) as u8;
            dst[j + 2] = (0x80 | ((cp >> 6) & 0x3F)) as u8;
            dst[j + 3] = (0x80 | (cp & 0x3F)) as u8;
            j += 4;
        }
        i += d.len;
    }
    return need;
}

// UTF-16 copy of `src`, in storage taken from `a`. The result has exactly `utf16_len(src)`
// units. Fails with `.invalid_utf8` or `.out_of_memory`.
pub alloc_utf16 :: fn(a: *Arena, src: []const u8) -> []u16 ! Utf16Error {
    n := utf16_len(src)?;
    out := try_alloc(u16, a, n) catch e { fail .out_of_memory; };
    ig := utf8_to_utf16(src, out)?;
    return out;
}

// Like `alloc_utf16`, but the storage has one more unit after the end, set to 0, so
// `result.ptr` is a NUL-terminated wide string (a Win32 `LPCWSTR`). The returned slice's
// length does not count the terminator.
pub alloc_utf16z :: fn(a: *Arena, src: []const u8) -> []u16 ! Utf16Error {
    n := utf16_len(src)?;
    out := try_alloc(u16, a, n + 1) catch e { fail .out_of_memory; };
    ig := utf8_to_utf16(src, out[0..n])?;
    out[n] = 0;
    return out[0..n];
}

// UTF-8 copy of `src`, in storage taken from `a`. The result has exactly `utf8_len(src)`
// bytes. Fails with `.invalid_utf16` or `.out_of_memory`.
pub alloc_utf8 :: fn(a: *Arena, src: []const u16) -> []u8 ! Utf16Error {
    n := utf8_len(src)?;
    out := try_alloc(u8, a, n) catch e { fail .out_of_memory; };
    ig := utf16_to_utf8(src, out)?;
    return out;
}

// SPDX-License-Identifier: Apache-2.0
// std.log: leveled format logging to stderr or any io::Writer
// below-level messages are never formatted; failed writes are dropped, never fatal

#import std.io as io;
#import std.io.{ Writer, Stderr };

// severity, lowest first
pub Level :: enum { debug, info, warn, error }

level_name :: fn(l: Level) -> []const u8 {
    match l {
        .debug => { return "debug"; },
        .info => { return "info"; },
        .warn => { return "warn"; },
        .error => { return "error"; },
    }
}

level_rank :: fn(l: Level) -> u8 {
    match l {
        .debug => { return 0; },
        .info => { return 1; },
        .warn => { return 2; },
        .error => { return 3; },
    }
}

// writes `min` and above to `w`, one line each: `[level] scope: msg`
pub Logger :: struct {
    w: *Writer,
    scope: []const u8,
    min: Level,

    // would level `l` be written
    pub enabled :: fn(self: *Self, l: Level) -> bool { return level_rank(l) >= level_rank(self.min); }

    pub log :: fn(self: *Self, l: Level, f: Format) {
        if !self.enabled(l) { return; }
        write_line(self.w, l, self.scope, f);
    }

    pub debug :: fn(self: *Self, f: Format) { self.log(.debug, f); }
    pub info :: fn(self: *Self, f: Format) { self.log(.info, f); }
    pub warn :: fn(self: *Self, f: Format) { self.log(.warn, f); }
    pub error :: fn(self: *Self, f: Format) { self.log(.error, f); }

    // write `l` and above from now on
    pub set_level :: fn(self: *Self, l: Level) { self.min = l; }
}

// `[level] scope: message` + newline; a failed write is dropped
write_line :: fn(w: *Writer, l: Level, scope: []const u8, f: Format) {
    put(w, "[");
    put(w, level_name(l));
    put(w, "] ");
    if scope.len > 0 {
        put(w, scope);
        put(w, ": ");
    }
    n := io::write_fmt_line(w, f) catch err { yield 0usize; };
}

put :: fn(w: *Writer, s: []const u8) {
    n := io::write_all(w, s) catch err { yield 0usize; };
}

// logger to `w`; empty `scope` for none; writes `min` and above
pub to :: fn(w: *Writer, scope: []const u8, min: Level) -> Logger {
    l: Logger = .{ w, scope, min };
    return l;
}

// global logger: stderr, no scope, `info` and up by default

LEVEL: Level = .info;

// global level: log::debug etc. write `l` and above from now on
pub set_level :: fn(l: Level) { LEVEL = l; }

// current global level
pub level :: fn() -> Level { return LEVEL; }

global_log :: fn(l: Level, f: Format) {
    if level_rank(l) < level_rank(LEVEL) { return; }
    out := io::stderr();
    write_line(&out, l, "", f);
}

pub debug :: fn(f: Format) { global_log(.debug, f); }
pub info :: fn(f: Format) { global_log(.info, f); }
pub warn :: fn(f: Format) { global_log(.warn, f); }
pub error :: fn(f: Format) { global_log(.error, f); }

// std.log — messages by level, written to stderr or any `io::Writer`, each a format.
//
//   log::info("listening on {port}");             // [info] listening on 8080
//   log::warn("{n} retries left");
//   log::set_level(.debug);                        // from here on debug messages show too
//
//   net := log::to(&file, "net", .debug);           // its own writer, scope and level
//   net.debug("got {len} bytes");                   // [debug] net: got 512 bytes
//
// A message below the level is dropped before its format is written, so its values are not
// read. A write that fails is dropped too: logging never stops the program.

#import std.io as io;
#import std.io.{ Writer, Stderr };

/// How much a message matters, least first.
pub Level :: enum { debug, info, warn, error }

level_name :: fn(l: Level) -> []const u8 {
    match l {
        .debug => { return "debug"; },
        .info => { return "info"; },
        .warn => { return "warn"; },
        .error => { return "error"; },
    }
}

level_rank :: fn(l: Level) -> u8 {
    match l {
        .debug => { return 0; },
        .info => { return 1; },
        .warn => { return 2; },
        .error => { return 3; },
    }
}

/// Writes messages of `min` and above to `w`, each on a line of its own, after the level and
/// the scope (when it has one).
pub Logger :: struct {
    w: *Writer,
    scope: []const u8,
    min: Level,

    /// Whether a message of level `l` is written.
    pub enabled :: fn(self: *Self, l: Level) -> bool { return level_rank(l) >= level_rank(self.min); }

    pub log :: fn(self: *Self, l: Level, f: Format) {
        if !self.enabled(l) { return; }
        write_line(self.w, l, self.scope, f);
    }

    pub debug :: fn(self: *Self, f: Format) { self.log(.debug, f); }
    pub info :: fn(self: *Self, f: Format) { self.log(.info, f); }
    pub warn :: fn(self: *Self, f: Format) { self.log(.warn, f); }
    pub error :: fn(self: *Self, f: Format) { self.log(.error, f); }

    /// From here on messages of `l` and above are written.
    pub set_level :: fn(self: *Self, l: Level) { self.min = l; }
}

// `[level] scope: message`, then a line break. A failed write is dropped.
write_line :: fn(w: *Writer, l: Level, scope: []const u8, f: Format) {
    put(w, "[");
    put(w, level_name(l));
    put(w, "] ");
    if scope.len > 0 {
        put(w, scope);
        put(w, ": ");
    }
    n := io::write_fmt_line(w, f) catch err { yield 0usize; };
}

put :: fn(w: *Writer, s: []const u8) {
    n := io::write_all(w, s) catch err { yield 0usize; };
}

/// A logger that writes to `w`, its messages after `scope` (none when empty), from level `min` on.
pub to :: fn(w: *Writer, scope: []const u8, min: Level) -> Logger {
    l: Logger = .{ w, scope, min };
    return l;
}

// The logger of `log::info` and the rest: stderr, no scope, from `info` on.

LEVEL: Level = .info;

/// From here on `log::debug` and the rest write messages of `l` and above.
pub set_level :: fn(l: Level) { LEVEL = l; }

/// The level `log::debug` and the rest write from.
pub level :: fn() -> Level { return LEVEL; }

global_log :: fn(l: Level, f: Format) {
    if level_rank(l) < level_rank(LEVEL) { return; }
    out := io::stderr();
    write_line(&out, l, "", f);
}

pub debug :: fn(f: Format) { global_log(.debug, f); }
pub info :: fn(f: Format) { global_log(.info, f); }
pub warn :: fn(f: Format) { global_log(.warn, f); }
pub error :: fn(f: Format) { global_log(.error, f); }

// SPDX-License-Identifier: Apache-2.0
// std.base64 — bytes as text in 64 characters, and back (RFC 4648).
//
//   text := base64::encode_in(&a, bytes);              // "aGVsbG8=" for "hello"
//   back := base64::decode_in(&a, text)?;              // the bytes again
//
//   n := base64::URL_NO_PAD.encode(out[:], bytes);     // into your own buffer, for a URL
//   m := base64::URL_NO_PAD.decode(out[:], text)?;
//
// A `Codec` is an alphabet and whether `=` pads the text to a multiple of 4: `STANDARD` (`+`
// and `/`, padded), `STANDARD_NO_PAD`, `URL` (`-` and `_`, for URLs and file names, padded) and
// `URL_NO_PAD`. Decoding takes the codec's own form only: a padded codec wants the padding, one
// without refuses it, and a character of the other alphabet, a space or a line break is
// `invalid_character`.

#import std.heap.{ Arena, alloc_bytes };

pub Base64Error :: errors {
    invalid_character,   // not in the alphabet, or `=` where it does not belong
    invalid_length,      // a length no encoding has (a padded text not a multiple of 4)
    buffer_too_small,    // `out` cannot hold the result; nothing was written
}

/// An alphabet and its padding.
pub Codec :: struct {
    /// The 64 characters, for the values 0 to 63.
    chars: []const u8,
    /// Whether the text is padded with `=` to a multiple of 4.
    pad: bool,

    /// The length of the text for `n` bytes.
    pub encoded_len :: fn(self: *Self, n: usize) -> usize {
        if self.pad { return (n + 2) / 3 * 4; }
        return n / 3 * 4 + (n % 3 * 4 + 2) / 3;
    }

    /// The length of the bytes `text` decodes to, when it is well formed.
    pub decoded_len :: fn(self: *Self, text: []const u8) -> usize ! Base64Error {
        n := text.len;
        if self.pad {
            if n % 4 != 0 { fail .invalid_length; }
            if n >= 1 && text[n - 1] == '=' { n -= 1; }
            if n >= 1 && text[n - 1] == '=' { n -= 1; }
        }
        if n % 4 == 1 { fail .invalid_length; }
        return n / 4 * 3 + (n % 4 * 3) / 4;
    }

    /// Write the text of `src` at the start of `out`; its length (`encoded_len`).
    pub encode :: fn(self: *Self, out: []u8, src: []const u8) -> usize ! Base64Error {
        need := self.encoded_len(src.len);
        if out.len < need { fail .buffer_too_small; }
        o: usize = 0;
        i: usize = 0;
        while i + 3 <= src.len {
            v := ((src[i] as u32) << 16) | ((src[i + 1] as u32) << 8) | (src[i + 2] as u32);
            out[o] = self.chars[((v >> 18) & 63) as usize];
            out[o + 1] = self.chars[((v >> 12) & 63) as usize];
            out[o + 2] = self.chars[((v >> 6) & 63) as usize];
            out[o + 3] = self.chars[(v & 63) as usize];
            i += 3;
            o += 4;
        }
        left := src.len - i;
        if left > 0 {
            v := (src[i] as u32) << 16;
            if left == 2 { v = v | ((src[i + 1] as u32) << 8); }
            out[o] = self.chars[((v >> 18) & 63) as usize];
            out[o + 1] = self.chars[((v >> 12) & 63) as usize];
            o += 2;
            if left == 2 {
                out[o] = self.chars[((v >> 6) & 63) as usize];
                o += 1;
            } else if self.pad {
                out[o] = '=';
                o += 1;
            }
            if self.pad {
                out[o] = '=';
                o += 1;
            }
        }
        return o;
    }

    /// The bytes of `text`, written at the start of `out`; their length (`decoded_len`). The
    /// bits past the last whole byte are not looked at.
    pub decode :: fn(self: *Self, out: []u8, text: []const u8) -> usize ! Base64Error {
        need := self.decoded_len(text)?;
        if out.len < need { fail .buffer_too_small; }
        n := text.len;
        if self.pad {
            if n >= 1 && text[n - 1] == '=' { n -= 1; }
            if n >= 1 && text[n - 1] == '=' { n -= 1; }
        }
        o: usize = 0;
        acc: u32 = 0;
        bits: u32 = 0;
        for i in 0..n {
            d := self.value_of(text[i]);
            if d < 0 { fail .invalid_character; }
            acc = ((acc << 6) | (d as u32)) & 0xFFFF;
            bits += 6;
            if bits >= 8 {
                bits -= 8;
                out[o] = ((acc >> bits) & 0xFF) as u8;
                o += 1;
            }
        }
        return o;
    }

    /// The text of `src`, in memory from `a`.
    pub encode_in :: fn(self: *Self, a: *Arena, src: []const u8) -> []u8 {
        out := a.alloc_bytes(self.encoded_len(src.len));
        n := self.encode(out, src) catch err { yield 0; };
        return out[0..n];
    }

    /// The bytes of `text`, in memory from `a`.
    pub decode_in :: fn(self: *Self, a: *Arena, text: []const u8) -> []u8 ! Base64Error {
        out := a.alloc_bytes(self.decoded_len(text)?);
        n := self.decode(out, text)?;
        return out[0..n];
    }

    // The value of character `c`, or -1 for one not in the alphabet.
    value_of :: fn(self: *Self, c: u8) -> i32 {
        if c >= 'A' && c <= 'Z' { return (c - 'A') as i32; }
        if c >= 'a' && c <= 'z' { return (c - 'a') as i32 + 26; }
        if c >= '0' && c <= '9' { return (c - '0') as i32 + 52; }
        if c == self.chars[62] { return 62; }
        if c == self.chars[63] { return 63; }
        return -1;
    }
}

STANDARD_CHARS :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
URL_CHARS :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";

/// `+` and `/`, padded with `=`: MIME, PEM, data: URLs.
pub STANDARD: Codec = .{ STANDARD_CHARS, true };
pub STANDARD_NO_PAD: Codec = .{ STANDARD_CHARS, false };
/// `-` and `_`, padded with `=`: safe in a URL or a file name.
pub URL: Codec = .{ URL_CHARS, true };
/// `-` and `_` without padding: JWT, most URL tokens.
pub URL_NO_PAD: Codec = .{ URL_CHARS, false };

/// `STANDARD.encode_in`: the text of `src`, in memory from `a`.
pub encode_in :: fn(a: *Arena, src: []const u8) -> []u8 {
    c := STANDARD;
    return c.encode_in(a, src);
}

/// `STANDARD.decode_in`: the bytes of `text`, in memory from `a`.
pub decode_in :: fn(a: *Arena, text: []const u8) -> []u8 ! Base64Error {
    c := STANDARD;
    return c.decode_in(a, text);
}

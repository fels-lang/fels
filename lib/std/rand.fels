// SPDX-License-Identifier: Apache-2.0
// std.rand: xorshift64* prng; same seed, same sequence; not for crypto

pub Rng :: struct { state: u64 }

// generator from a seed; 0 is remapped to a valid state
pub seed :: fn(s: u64) -> Rng {
    st: u64 = s;
    if st == 0 { st = 0x9E3779B97F4A7C15; }
    r: Rng = .{ st };
    return r;
}

// next raw u64; advances the state
pub next_u64 :: fn(self: *Rng) -> u64 {
    x: u64 = self.state;
    x = x ^ (x >> 12);
    x = x ^ (x << 25);
    x = x ^ (x >> 27);
    self.state = x;
    return x *% 0x2545F4914F6CDD1D;
}

pub next_u32 :: fn(self: *Rng) -> u32 { return (next_u64(self) >> 32u64) as u32; }

// float in [0, 1), 24-bit mantissa
pub next_f32 :: fn(self: *Rng) -> f32 {
    bits: u32 = (next_u64(self) >> 40) as u32;   // top 24 bits
    return (bits as f32) / 16777216.0f32;            // / 2^24
}

// uniform int in [lo, hi); `lo` if empty
pub range_i32 :: fn(self: *Rng, lo: i32, hi: i32) -> i32 {
    if hi <= lo { return lo; }
    span := ((hi as i64) - (lo as i64)) as u64;
    return ((lo as i64) + (below(self, span) as i64)) as i32;
}

// float in [lo, hi)
pub range_f32 :: fn(self: *Rng, lo: f32, hi: f32) -> f32 {
    return lo + next_f32(self) * (hi - lo);
}

// true with probability `p`, clamped to 0..1
pub chance :: fn(self: *Rng, p: f32) -> bool { return next_f32(self) < p; }

// -1 or +1
pub sign :: fn(self: *Rng) -> f32 {
    if (next_u64(self) & 1) == 0 { return -1.0f32; }
    return 1.0f32;
}

// uniform int in [0, n), unbiased (rejection); 0 if `n` is 0
pub below :: fn(self: *Rng, n: u64) -> u64 {
    if n == 0 { return 0; }
    // 2^64 mod n: low values that would bias small results
    skip := (0 -% n) % n;
    while true {
        x := next_u64(self);
        if x >= skip { return x % n; }
    }
    return 0;
}

// uniform int in [lo, hi); `lo` if empty
pub range_u64 :: fn(self: *Rng, lo: u64, hi: u64) -> u64 {
    if hi <= lo { return lo; }
    return lo + below(self, hi - lo);
}

// float in [0, 1), 53-bit mantissa
pub next_f64 :: fn(self: *Rng) -> f64 {
    return ((next_u64(self) >> 11) as f64) / 9007199254740992.0;   // / 2^53
}

pub fill_bytes :: fn(self: *Rng, out: []u8) {
    i: usize = 0;
    while i < out.len {
        x := next_u64(self);
        k: usize = 0;
        while k < 8 && i < out.len {
            out[i] = ((x >> ((8 * k) as u64)) & 0xFF) as u8;
            i += 1;
            k += 1;
        }
    }
}

// uniform shuffle, fisher-yates
pub shuffle :: fn($T: type, self: *Rng, xs: []T) {
    i := xs.len;
    while i > 1 {
        j := below(self, i as u64) as usize;
        i -= 1;
        tmp := xs[i];
        xs[i] = xs[j];
        xs[j] = tmp;
    }
}

// uniform pick; null if empty
pub choose :: fn($T: type, self: *Rng, xs: []const T) -> ?T {
    if xs.len == 0 { return null; }
    return xs[below(self, xs.len as u64) as usize];
}

// SPDX-License-Identifier: Apache-2.0
// std.bytes: le/be fixed-width ints at any offset in a byte slice; no alignment needed
// checked in every build mode: .out_of_bounds, and nothing read or written

pub BytesError :: errors {
    out_of_bounds,      // value would run past the slice end
}

// `n` bytes at `off` fit in `len`; no overflow for any `off`
fits :: fn(len: usize, off: usize, n: usize) -> bool {
    if off > len { return false; }
    return len - off >= n;
}

pub read_u8 :: fn(self: []const u8, off: usize) -> u8 ! BytesError {
    if !fits(self.len, off, 1) { fail .out_of_bounds; }
    return self[off];
}

pub write_u8 :: fn(self: []u8, off: usize, v: u8) -> void ! BytesError {
    if !fits(self.len, off, 1) { fail .out_of_bounds; }
    self[off] = v;
    return;
}

pub read_u16_le :: fn(self: []const u8, off: usize) -> u16 ! BytesError {
    if !fits(self.len, off, 2) { fail .out_of_bounds; }
    return (self[off] as u16) | ((self[off + 1] as u16) << 8);
}

pub read_u16_be :: fn(self: []const u8, off: usize) -> u16 ! BytesError {
    if !fits(self.len, off, 2) { fail .out_of_bounds; }
    return ((self[off] as u16) << 8) | (self[off + 1] as u16);
}

pub read_u32_le :: fn(self: []const u8, off: usize) -> u32 ! BytesError {
    if !fits(self.len, off, 4) { fail .out_of_bounds; }
    return (self[off] as u32) | ((self[off + 1] as u32) << 8) | ((self[off + 2] as u32) << 16) | ((self[off + 3] as u32) << 24);
}

pub read_u32_be :: fn(self: []const u8, off: usize) -> u32 ! BytesError {
    if !fits(self.len, off, 4) { fail .out_of_bounds; }
    return ((self[off] as u32) << 24) | ((self[off + 1] as u32) << 16) | ((self[off + 2] as u32) << 8) | (self[off + 3] as u32);
}

pub read_u64_le :: fn(self: []const u8, off: usize) -> u64 ! BytesError {
    if !fits(self.len, off, 8) { fail .out_of_bounds; }
    return (self[off] as u64) | ((self[off + 1] as u64) << 8) | ((self[off + 2] as u64) << 16) | ((self[off + 3] as u64) << 24) | ((self[off + 4] as u64) << 32) | ((self[off + 5] as u64) << 40) | ((self[off + 6] as u64) << 48) | ((self[off + 7] as u64) << 56);
}

pub read_u64_be :: fn(self: []const u8, off: usize) -> u64 ! BytesError {
    if !fits(self.len, off, 8) { fail .out_of_bounds; }
    return ((self[off] as u64) << 56) | ((self[off + 1] as u64) << 48) | ((self[off + 2] as u64) << 40) | ((self[off + 3] as u64) << 32) | ((self[off + 4] as u64) << 24) | ((self[off + 5] as u64) << 16) | ((self[off + 6] as u64) << 8) | (self[off + 7] as u64);
}

pub write_u16_le :: fn(self: []u8, off: usize, v: u16) -> void ! BytesError {
    if !fits(self.len, off, 2) { fail .out_of_bounds; }
    self[off] = v as u8;
    self[off + 1] = (v >> 8) as u8;
    return;
}

pub write_u16_be :: fn(self: []u8, off: usize, v: u16) -> void ! BytesError {
    if !fits(self.len, off, 2) { fail .out_of_bounds; }
    self[off] = (v >> 8) as u8;
    self[off + 1] = v as u8;
    return;
}

pub write_u32_le :: fn(self: []u8, off: usize, v: u32) -> void ! BytesError {
    if !fits(self.len, off, 4) { fail .out_of_bounds; }
    self[off] = v as u8;
    self[off + 1] = (v >> 8) as u8;
    self[off + 2] = (v >> 16) as u8;
    self[off + 3] = (v >> 24) as u8;
    return;
}

pub write_u32_be :: fn(self: []u8, off: usize, v: u32) -> void ! BytesError {
    if !fits(self.len, off, 4) { fail .out_of_bounds; }
    self[off] = (v >> 24) as u8;
    self[off + 1] = (v >> 16) as u8;
    self[off + 2] = (v >> 8) as u8;
    self[off + 3] = v as u8;
    return;
}

pub write_u64_le :: fn(self: []u8, off: usize, v: u64) -> void ! BytesError {
    if !fits(self.len, off, 8) { fail .out_of_bounds; }
    self[off] = v as u8;
    self[off + 1] = (v >> 8) as u8;
    self[off + 2] = (v >> 16) as u8;
    self[off + 3] = (v >> 24) as u8;
    self[off + 4] = (v >> 32) as u8;
    self[off + 5] = (v >> 40) as u8;
    self[off + 6] = (v >> 48) as u8;
    self[off + 7] = (v >> 56) as u8;
    return;
}

pub write_u64_be :: fn(self: []u8, off: usize, v: u64) -> void ! BytesError {
    if !fits(self.len, off, 8) { fail .out_of_bounds; }
    self[off] = (v >> 56) as u8;
    self[off + 1] = (v >> 48) as u8;
    self[off + 2] = (v >> 40) as u8;
    self[off + 3] = (v >> 32) as u8;
    self[off + 4] = (v >> 24) as u8;
    self[off + 5] = (v >> 16) as u8;
    self[off + 6] = (v >> 8) as u8;
    self[off + 7] = v as u8;
    return;
}

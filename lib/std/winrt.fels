// SPDX-License-Identifier: Apache-2.0
// std.winrt: COM/WinRT init, activation, HSTRING; windows only (ole32, combase)

#import std.com.{ Guid, IUnknown, IInspectable, ComError, check, failed, S_OK, E_POINTER };
#import std.utf16;

// ---- COM ----

#extern("ole32", "CoInitializeEx")     winrt_co_initialize_ex :: fn(reserved: ?*void, flags: u32) -> i32;
#extern("ole32", "CoUninitialize")     winrt_co_uninitialize :: fn();
#extern("ole32", "CoCreateInstance")   winrt_co_create_instance :: fn(clsid: *const Guid, outer: ?*void, context: u32, iid: *const Guid, out: **void) -> i32;
#extern("ole32", "CoTaskMemFree")      winrt_co_task_mem_free :: fn(p: ?*void);
#extern("ole32", "CoCreateGuid")       winrt_co_create_guid :: fn(out: *Guid) -> i32;

// COINIT for co_initialize
pub CO_MULTITHREADED     :: 0;
pub CO_APARTMENTTHREADED :: 2;

// the usual context for co_create_instance
pub CLSCTX_INPROC_SERVER :: 1;

// this thread only; S_FALSE too owes a co_uninitialize on the same thread
// `.changed_mode` if the thread already initialised the other way
pub co_initialize :: fn(mode: u32) -> void ! ComError {
    check(winrt_co_initialize_ex(null, mode))?;
    return;
}

// undoes one co_initialize, same thread
pub co_uninitialize :: fn() { winrt_co_uninitialize(); }

// `*out` has one ref to release, null on failure; `context` is a CLSCTX value
pub co_create_instance :: fn(clsid: *const Guid, context: u32, iid: *const Guid, out: **void) -> i32 {
    return winrt_co_create_instance(clsid, null, context, iid, out);
}

// COM task allocator memory, e.g. the IInspectable.get_iids array
pub co_task_mem_free :: fn(p: ?*void) { winrt_co_task_mem_free(p); }

// CoCreateGuid, random (RFC 4122 v4)
pub new_guid :: fn() -> Guid ! ComError {
    g: Guid = .{ 0, 0, 0, .{} };
    check(winrt_co_create_guid(&g))?;
    return g;
}

// ---- Windows Runtime ----

#extern("combase", "RoInitialize")             winrt_ro_initialize :: fn(kind: i32) -> i32;
#extern("combase", "RoUninitialize")           winrt_ro_uninitialize :: fn();
#extern("combase", "RoGetActivationFactory")   winrt_ro_get_activation_factory :: fn(class_id: usize, iid: *const Guid, out: **void) -> i32;
#extern("combase", "RoActivateInstance")       winrt_ro_activate_instance :: fn(class_id: usize, out: **IInspectable) -> i32;

// RO_INIT_TYPE for ro_initialize
pub RO_SINGLETHREADED :: 0;
pub RO_MULTITHREADED  :: 1;

// this thread only; S_FALSE too owes a ro_uninitialize on the same thread
// `.changed_mode` if the thread already initialised the other way
pub ro_initialize :: fn(kind: i32) -> void ! ComError {
    check(winrt_ro_initialize(kind))?;
    return;
}

// undoes one ro_initialize, same thread
pub ro_uninitialize :: fn() { winrt_ro_uninitialize(); }

// `class_id` is an HSTRING; owned ref, release it; `.class_not_registered` if unknown
pub activation_factory :: fn(class_id: usize, iid: *const Guid) -> *IUnknown ! ComError {
    out: *void = unsafe (core::ptr_from_int(*void, 0));
    check(winrt_ro_get_activation_factory(class_id, iid, &out))?;
    if unsafe (out as usize) == 0 { fail .invalid_pointer; }
    return unsafe (out as *IUnknown);
}

// default ctor; owned ref
pub activate_instance :: fn(class_id: usize) -> *IInspectable ! ComError {
    out: *IInspectable = unsafe (core::ptr_from_int(*IInspectable, 0));
    check(winrt_ro_activate_instance(class_id, &out))?;
    if unsafe (out as usize) == 0 { fail .invalid_pointer; }
    return out;
}

// ---- HSTRING ----
// refcounted UTF-16 handle (usize), 0 = empty; strings handed out are yours to delete

#extern("combase", "WindowsCreateString")           winrt_create_string :: fn(src: ?*const u16, len: u32, out: *usize) -> i32;
#extern("combase", "WindowsCreateStringReference")  winrt_create_string_reference :: fn(src: *const u16, len: u32, header: *HStringRef, out: *usize) -> i32;
#extern("combase", "WindowsDeleteString")           winrt_delete_string :: fn(h: usize) -> i32;
#extern("combase", "WindowsDuplicateString")        winrt_duplicate_string :: fn(h: usize, out: *usize) -> i32;
#extern("combase", "WindowsGetStringLen")           winrt_string_len :: fn(h: usize) -> u32;
#extern("combase", "WindowsGetStringRawBuffer")     winrt_string_raw_buffer :: fn(h: usize, len: *u32) -> *const u16;
#extern("combase", "WindowsCompareStringOrdinal")   winrt_compare_string_ordinal :: fn(a: usize, b: usize, result: *i32) -> i32;

// owned; release once, never release two copies of one
pub HString :: struct {
    h: usize

    // safe to call twice or on an empty string
    pub release :: fn(self: *Self) {
        if self.h != 0 {
            ig := winrt_delete_string(self.h);
            self.h = 0;
        }
    }

    // UTF-16 code units
    pub len :: fn(self: *const Self) -> usize { return winrt_string_len(self.h) as usize; }

    pub is_empty :: fn(self: *const Self) -> bool { return winrt_string_len(self.h) == 0u32; }

    // borrowed, valid until release(); no NUL in the slice
    pub units :: fn(self: *const Self) -> []const u16 {
        n: u32 = 0;
        p := winrt_string_raw_buffer(self.h, &n);
        return unsafe core::slice_from_raw_parts(u16, p, n as usize);
    }

    // cheap second owned ref; release both
    pub duplicate :: fn(self: *const Self) -> HString ! ComError {
        out: usize = 0;
        check(winrt_duplicate_string(self.h, &out))?;
        r: HString = .{ out };
        return r;
    }

    // ordinal, case-sensitive
    pub eq :: fn(self: *const Self, other: *const HString) -> bool {
        r: i32 = 1;
        hr := winrt_compare_string_ordinal(self.h, other.h, &r);
        if failed(hr) { return false; }
        return r == 0;
    }

    // `.invalid_utf16` or `.buffer_too_small`; size it with utf16::utf8_len(self.units())
    pub to_utf8 :: fn(self: *const Self, out: []u8) -> usize ! utf16::Utf16Error {
        n := utf16::utf16_to_utf8(self.units(), out)?;
        return n;
    }
}

// owned copy, may be empty or hold zeros; `.out_of_memory` if the OS can't allocate
pub hstring :: fn(units: []const u16) -> HString ! ComError {
    out: usize = 0;
    check(winrt_create_string(units.ptr, units.len as u32, &out))?;
    r: HString = .{ out };
    return r;
}

// `scratch` needs utf16_len(text) units, free after; `.invalid_utf8`, `.buffer_too_small`
pub hstring_from_utf8 :: fn(text: []const u8, scratch: []u16) -> HString ! utf16::Utf16Error {
    n := utf16::utf8_to_utf16(text, scratch)?;
    out: usize = 0;
    hr := winrt_create_string(scratch.ptr, n as u32, &out);
    if failed(hr) { fail .out_of_memory; }
    r: HString = .{ out };
    return r;
}

// borrowed HSTRING, no alloc, nothing to release
// don't move or copy after init(); the UTF-16 buffer must outlive `h`
pub HStringRef :: struct {
    header: [3]u64      // HSTRING_HEADER, 24 bytes
    h: usize            // the handle; valid after init()

    // `z` must end in one 0 unit (not part of the string), else `.invalid_arg`
    pub init :: fn(self: *Self, z: []const u16) -> void ! ComError {
        if z.len == 0 { fail .invalid_arg; }
        if z[z.len - 1] != 0 { fail .invalid_arg; }
        check(winrt_create_string_reference(z.ptr, (z.len - 1) as u32, self, &self.h))?;
        return;
    }
}

// winstring.h: HSTRING one pointer, HSTRING_HEADER 24 bytes
#assert(core::sizeof(HStringRef) == 32, "HSTRING_HEADER (24) then the handle");
#assert(core::offset_of(HStringRef, "h") == 24);
#assert(core::sizeof(HString) == 8, "an HSTRING is one pointer");

// std.mem: slice helpers; generics take the element type first: copy(u8, dst, src)

shorter_len :: fn(a: usize, b: usize) -> usize {
    if a < b { return a; }
    return b;
}

pub eql :: fn($T: type, self: []const T, b: []const T) -> bool {
    if self.len != b.len { return false; }

    for i in 0..self.len {
        if self[i] != b[i] { return false; }
    }
    return true;
}

pub starts_with :: fn($T: type, self: []const T, prefix: []const T) -> bool {
    if prefix.len > self.len { return false; }

    for i in 0..prefix.len {
        if self[i] != prefix[i] { return false; }
    }
    return true;
}

pub ends_with :: fn($T: type, self: []const T, suffix: []const T) -> bool {
    if suffix.len > self.len { return false; }

    offset := self.len - suffix.len;
    for i in 0..suffix.len {
        if self[offset + i] != suffix[i] { return false; }
    }
    return true;
}

// copies min(len) elements, returns the count; must not overlap
pub copy :: fn($T: type, self: []T, source: []const T) -> usize {
    count := shorter_len(self.len, source.len);
    for i in 0..count {
        self[i] = source[i];
    }
    return count;
}

pub fill :: fn($T: type, self: []T, value: T) {
    i := 0usize;
    while i < self.len {
        self[i] = value;
        i += 1;
    }
}

pub swap :: fn($T: type, self: []T, i: usize, j: usize) {
    tmp := self[i];
    self[i] = self[j];
    self[j] = tmp;
}

pub reverse :: fn($T: type, self: []T) {
    if self.len < 2 { return; }
    i := 0usize;
    j := self.len - 1;

    while i < j {
        swap(T, self, i, j);
        i += 1;
        j -= 1;
    }
}

pub index_of :: fn($T: type, self: []const T, needle: T) -> ?usize {
    for i in 0..self.len {
        if self[i] == needle { return i; }
    }
    return null;
}

pub contains :: fn($T: type, self: []const T, needle: T) -> bool {
    return index_of(T, self, needle) != null;
}

pub eql_bytes :: fn(self: []const u8, b: []const u8) -> bool {
    return eql(u8, self, b);
}

// byte order: -1, 0 or 1; a prefix sorts first
pub compare_bytes :: fn(self: []const u8, b: []const u8) -> i32 {
    n := shorter_len(self.len, b.len);
    i: usize = 0;
    while i < n {
        if self[i] != b[i] { return if self[i] < b[i] { -1 } else { 1 }; }
        i += 1;
    }
    if self.len == b.len { return 0; }
    return if self.len < b.len { -1 } else { 1 };
}

// byte-order less-than; for sort::by
pub less_bytes :: fn(self: []const u8, b: []const u8) -> bool {
    return compare_bytes(self, b) < 0;
}

pub copy_bytes :: fn(self: []u8, source: []const u8) -> usize {
    return copy(u8, self, source);
}

pub zero :: fn(self: []u8) {
    fill(u8, self, 0);
}

// searching

// first start of `needle` in `self`, or null; empty needle -> 0
pub index_of_slice :: fn($T: type, self: []const T, needle: []const T) -> ?usize {
    if needle.len > self.len { return null; }
    i: usize = 0;
    while i + needle.len <= self.len {
        if eql(T, self[i..i + needle.len], needle) { return i; }
        i += 1;
    }
    return null;
}

pub last_index_of :: fn($T: type, self: []const T, needle: T) -> ?usize {
    i := self.len;
    while i > 0 {
        i -= 1;
        if self[i] == needle { return i; }
    }
    return null;
}

pub last_index_of_slice :: fn($T: type, self: []const T, needle: []const T) -> ?usize {
    if needle.len > self.len { return null; }
    i := self.len - needle.len + 1;
    while i > 0 {
        i -= 1;
        if eql(T, self[i..i + needle.len], needle) { return i; }
    }
    return null;
}

// non-overlapping occurrences; empty needle -> 0
pub count :: fn($T: type, self: []const T, needle: []const T) -> usize {
    if needle.len == 0 { return 0; }
    n: usize = 0;
    i: usize = 0;
    while i + needle.len <= self.len {
        if eql(T, self[i..i + needle.len], needle) {
            n += 1;
            i += needle.len;
        } else {
            i += 1;
        }
    }
    return n;
}

// trimming

// drops leading elements in `set`
pub trim_left :: fn($T: type, self: []const T, set: []const T) -> []const T {
    i: usize = 0;
    while i < self.len && contains(T, set, self[i]) { i += 1; }
    return self[i..self.len];
}

// drops trailing elements in `set`
pub trim_right :: fn($T: type, self: []const T, set: []const T) -> []const T {
    n := self.len;
    while n > 0 && contains(T, set, self[n - 1]) { n -= 1; }
    return self[0..n];
}

// both ends
pub trim :: fn($T: type, self: []const T, set: []const T) -> []const T {
    return trim_right(T, trim_left(T, self, set), set);
}

// iterating over parts

// parts between separators, empty ones kept: "a,,b" -> "a", "", "b"
pub Split :: struct($T: type) {
    rest: []const T,
    sep: []const T,
    done: bool,

    pub next :: fn(self: *Self) -> ?[]const T {
        if self.done { return null; }
        if self.sep.len > 0 {
            if index_of_slice(T, self.rest, self.sep) |i| {
                part := self.rest[0..i];
                self.rest = self.rest[i + self.sep.len..self.rest.len];
                return part;
            }
        }
        self.done = true;
        return self.rest;
    }

    // the unsplit rest
    pub remaining :: fn(self: *Self) -> []const T { return self.rest; }
}

// empty `sep` gives `self` as one part
pub split :: fn($T: type, self: []const T, sep: []const T) -> Split(T) {
    return .{ self, sep, false };
}

// parts between runs of delimiters, empty ones skipped
pub Tokens :: struct($T: type) {
    rest: []const T,
    delims: []const T,

    pub next :: fn(self: *Self) -> ?[]const T {
        i: usize = 0;
        while i < self.rest.len && contains(T, self.delims, self.rest[i]) { i += 1; }
        if i == self.rest.len {
            self.rest = self.rest[i..i];
            return null;
        }
        start := i;
        while i < self.rest.len && !contains(T, self.delims, self.rest[i]) { i += 1; }
        part := self.rest[start..i];
        self.rest = self.rest[i..self.rest.len];
        return part;
    }
}

// any element of `delims` splits
pub tokenize :: fn($T: type, self: []const T, delims: []const T) -> Tokens(T) {
    return .{ self, delims };
}

// result of split_once
pub Halves :: struct($T: type) {
    before: []const T,
    after: []const T,
}

// before and after the first `sep`, or null if absent
pub split_once :: fn($T: type, self: []const T, sep: []const T) -> ?Halves(T) {
    if index_of_slice(T, self, sep) |i| {
        h: Halves(T) = .{ self[0..i], self[i + sep.len..self.len] };
        return h;
    }
    return null;
}

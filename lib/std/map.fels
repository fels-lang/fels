// std.map: open-addressed maps/sets and SortedMap, all in an Arena; no per-entry frees

#import std.heap.{ Arena, alloc, dupe };
#import std.hash as hash;
#import std.sort as sort;

// slot states
EMPTY :: 0u8;
USED  :: 1u8;
TOMB  :: 2u8;   // deleted; probing continues past it

INIT_CAP :: 8usize;   // power of two: `hash & (cap-1)` is a slot

// FNV-1a over raw key bytes
fnv_bytes :: fn(p: *const u8, n: usize) -> u64 {
    h: u64 = 14695981039346656037;
    for i in 0..n {
        h = (h ^ (p[i] as u64)) *% 1099511628211;
    }
    return h;
}

eq_bytes :: fn(a: *const u8, b: *const u8, n: usize) -> bool {
    for i in 0..n {
        if a[i] != b[i] { return false; }
    }
    return true;
}

// keys whose bytes are their value: no floats, slices, unions or padding
pub ByteKey :: constraint($K) {
    if core::has_padding(K) { core::reject("it has bytes no value sets (padding, an optional's flag or an enum payload), which differ between equal keys"); }
    why := byte_key_problem(core::type_info(K));
    if why.len != 0 { core::reject(why); }
}

byte_key_problem :: fn(ti: TypeInfo) -> []const u8 {
    match ti {
        .float => { return "a float key is compared by its bytes, where `-0.0` and `0.0` differ and a NaN equals nothing"; },
        .slice => { return "a slice key is compared by its address and length, not its contents: key strings with `StrMap`"; },
        .union_ => { return "a union key is compared by all its bytes, which hold the field written last and what that field does not cover"; },
        .array |a| => { return byte_key_problem(*a.elem); },
        .struct_ |st| => {
            for f in st.fields {
                why := byte_key_problem(*f.ty);
                if why.len != 0 { return why; }
            }
            return "";
        },
        else => { return ""; },
    }
}

// keys hashed and compared by their raw bytes
pub AutoHashMap :: struct($K: ByteKey, $V: type) {
    region: *Arena,
    states: []u8,
    keys:   []K,
    vals:   []V,
    count:  usize,    // live entries
    tombs:  usize     // tombstone slots (count toward the load factor)

    pub len      :: fn(self: *Self) -> usize { return self.count; }
    pub cap      :: fn(self: *Self) -> usize { return self.states.len; }
    pub is_empty :: fn(self: *Self) -> bool  { return self.count == 0usize; }

    // copied to a local for a stable address
    hash_of :: fn(self: *Self, k: K) -> u64 {
        kk: K = k;
        return fnv_bytes(unsafe ((&kk) as *const u8), core::sizeof(K));
    }

    // slot `i` byte-equal to `k`
    same_key :: fn(self: *Self, i: usize, k: K) -> bool {
        sk: K = self.keys[i];
        kk: K = k;
        return eq_bytes(unsafe ((&sk) as *const u8), unsafe ((&kk) as *const u8), core::sizeof(K));
    }

    // insert/overwrite without growing; reuses the first tombstone on the probe path
    place :: fn(self: *Self, k: K, v: V) {
        mask: usize = self.states.len - 1;
        i: usize = (self.hash_of(k) as usize) & mask;
        tomb: usize = self.states.len;             // sentinel "no tombstone seen"
        steps: usize = 0;
        while steps <= self.states.len {
            st: u8 = self.states[i];
            if st == EMPTY {
                slot: usize = i;
                if tomb < self.states.len { slot = tomb; self.tombs -= 1; }
                self.states[slot] = USED;
                self.keys[slot] = k;
                self.vals[slot] = v;
                self.count += 1;
                return;
            }
            if st == TOMB {
                if tomb == self.states.len { tomb = i; }
            } else {
                if self.same_key(i, k) { self.vals[i] = v; return; }
            }
            i = (i + 1) & mask;
            steps += 1;
        }
    }

    // doubles the table, drops tombstones
    grow :: fn(self: *Self) {
        old_states: []u8 = self.states;
        old_keys:   []K  = self.keys;
        old_vals:   []V  = self.vals;
        new_cap: usize = self.states.len * 2;
        if new_cap < INIT_CAP { new_cap = INIT_CAP; }
        self.states = alloc(u8, self.region, new_cap);
        self.keys   = alloc(K,  self.region, new_cap);
        self.vals   = alloc(V,  self.region, new_cap);
        c: usize = 0;
        while c < new_cap { self.states[c] = EMPTY; c += 1; }
        self.count = 0;
        self.tombs = 0;
        for j in 0..old_states.len {
            if old_states[j] == USED { self.place(old_keys[j], old_vals[j]); }
        }
    }

    // overwrites; grows past 0.75 load (live + tombstones)
    pub put :: fn(self: *Self, k: K, v: V) {
        if (self.count + self.tombs + 1) * 4 >= self.states.len * 3 {
            self.grow();
        }
        self.place(k, v);
    }

    // index of `k`, or `cap` if absent
    find :: fn(self: *Self, k: K) -> usize {
        mask: usize = self.states.len - 1;
        i: usize = (self.hash_of(k) as usize) & mask;
        steps: usize = 0;
        while steps <= self.states.len {
            st: u8 = self.states[i];
            if st == EMPTY { return self.states.len; }
            if st == USED {
                if self.same_key(i, k) { return i; }
            }
            i = (i + 1) & mask;
            steps += 1;
        }
        return self.states.len;
    }

    pub get :: fn(self: *Self, k: K) -> ?V {
        i: usize = self.find(k);
        if i == self.states.len { return null; }
        return self.vals[i];
    }

    pub contains :: fn(self: *Self, k: K) -> bool {
        return self.find(k) != self.states.len;
    }

    // false if absent; leaves a tombstone
    pub remove :: fn(self: *Self, k: K) -> bool {
        i: usize = self.find(k);
        if i == self.states.len { return false; }
        self.states[i] = TOMB;
        self.count -= 1;
        self.tombs += 1;
        return true;
    }

    // keeps the tables for reuse
    pub clear :: fn(self: *Self) {
        c: usize = 0;
        while c < self.states.len { self.states[c] = EMPTY; c += 1; }
        self.count = 0;
        self.tombs = 0;
    }

    // no particular order; put/remove while iterating may skip or repeat
    pub entries :: fn(self: *Self) -> AutoEntries(K, V) {
        it: AutoEntries(K, V) = .{ self, 0 };
        return it;
    }
}

pub Entry :: struct($K: type, $V: type) {
    key: K,
    value: V,
}

// AutoHashMap.entries iterator
pub AutoEntries :: struct($K: ByteKey, $V: type) {
    m: *AutoHashMap(K, V),
    i: usize,   // the next slot to look at

    pub next :: fn(self: *Self) -> ?Entry(K, V) {
        while self.i < self.m.states.len {
            at := self.i;
            self.i += 1;
            if self.m.states[at] == USED {
                e: Entry(K, V) = .{ self.m.keys[at], self.m.vals[at] };
                return e;
            }
        }
        return null;
    }
}

// empty map in `a`
pub auto :: fn($K: ByteKey, $V: type, a: *Arena) -> AutoHashMap(K, V) {
    states: []u8 = alloc(u8, a, INIT_CAP);
    i: usize = 0;
    while i < INIT_CAP { states[i] = EMPTY; i += 1; }
    r: AutoHashMap(K, V) = .{ a, states, alloc(K, a, INIT_CAP), alloc(V, a, INIT_CAP), 0, 0 };
    return r;
}

// string keys by content; keys are copied into the arena
pub StrMap :: struct($V: type) {
    region: *Arena,
    states: []u8,
    keys:   [][]const u8,
    vals:   []V,
    count:  usize,
    tombs:  usize

    pub len      :: fn(self: *Self) -> usize { return self.count; }
    pub cap      :: fn(self: *Self) -> usize { return self.states.len; }
    pub is_empty :: fn(self: *Self) -> bool  { return self.count == 0usize; }

    place :: fn(self: *Self, k: []const u8, v: V) {
        mask: usize = self.states.len - 1;
        i: usize = (hash::fnv1a_64(k) as usize) & mask;
        tomb: usize = self.states.len;
        steps: usize = 0;
        while steps <= self.states.len {
            st: u8 = self.states[i];
            if st == EMPTY {
                slot: usize = i;
                if tomb < self.states.len { slot = tomb; self.tombs -= 1; }
                self.states[slot] = USED;
                self.keys[slot] = dupe(u8, self.region, k);   // own the key bytes
                self.vals[slot] = v;
                self.count += 1;
                return;
            }
            if st == TOMB {
                if tomb == self.states.len { tomb = i; }
            } else {
                if self.keys[i] == k { self.vals[i] = v; return; }   // content `==`
            }
            i = (i + 1) & mask;
            steps += 1;
        }
    }

    grow :: fn(self: *Self) {
        old_states: []u8 = self.states;
        old_keys: [][]const u8 = self.keys;
        old_vals: []V = self.vals;
        new_cap: usize = self.states.len * 2;
        if new_cap < INIT_CAP { new_cap = INIT_CAP; }
        self.states = alloc(u8, self.region, new_cap);
        self.keys   = alloc([]const u8, self.region, new_cap);
        self.vals   = alloc(V, self.region, new_cap);
        c: usize = 0;
        while c < new_cap { self.states[c] = EMPTY; c += 1; }
        self.count = 0;
        self.tombs = 0;
        for j in 0..old_states.len {
            if old_states[j] == USED {
                // key is already owned, don't dupe
                self.place_owned(old_keys[j], old_vals[j]);
            }
        }
    }

    // `place` for an already-owned key (grow)
    place_owned :: fn(self: *Self, k: []const u8, v: V) {
        mask: usize = self.states.len - 1;
        i: usize = (hash::fnv1a_64(k) as usize) & mask;
        steps: usize = 0;
        while steps <= self.states.len {
            if self.states[i] == EMPTY {
                self.states[i] = USED;
                self.keys[i] = k;
                self.vals[i] = v;
                self.count += 1;
                return;
            }
            i = (i + 1) & mask;
            steps += 1;
        }
    }

    pub put :: fn(self: *Self, k: []const u8, v: V) {
        if (self.count + self.tombs + 1) * 4 >= self.states.len * 3 {
            self.grow();
        }
        self.place(k, v);
    }

    find :: fn(self: *Self, k: []const u8) -> usize {
        mask: usize = self.states.len - 1;
        i: usize = (hash::fnv1a_64(k) as usize) & mask;
        for steps in 0..=self.states.len {
            st: u8 = self.states[i];
            if st == EMPTY { return self.states.len; }
            if st == USED {
                if self.keys[i] == k { return i; }
            }
            i = (i + 1) & mask;
        }
        return self.states.len;
    }

    pub get :: fn(self: *Self, k: []const u8) -> ?V {
        i: usize = self.find(k);
        if i == self.states.len { return null; }
        return self.vals[i];
    }

    pub contains :: fn(self: *Self, k: []const u8) -> bool {
        return self.find(k) != self.states.len;
    }

    pub remove :: fn(self: *Self, k: []const u8) -> bool {
        i: usize = self.find(k);
        if i == self.states.len { return false; }
        self.states[i] = TOMB;
        self.count -= 1;
        self.tombs += 1;
        return true;
    }

    pub clear :: fn(self: *Self) {
        c: usize = 0;
        while c < self.states.len { self.states[c] = EMPTY; c += 1; }
        self.count = 0;
        self.tombs = 0;
    }

    // no particular order; put/remove while iterating may skip or repeat
    pub entries :: fn(self: *Self) -> StrEntries(V) {
        it: StrEntries(V) = .{ self, 0 };
        return it;
    }
}

// StrMap.entries iterator; keys are the map's own copies
pub StrEntries :: struct($V: type) {
    m: *StrMap(V),
    i: usize,

    pub next :: fn(self: *Self) -> ?Entry([]const u8, V) {
        while self.i < self.m.states.len {
            at := self.i;
            self.i += 1;
            if self.m.states[at] == USED {
                e: Entry([]const u8, V) = .{ self.m.keys[at], self.m.vals[at] };
                return e;
            }
        }
        return null;
    }
}

// empty map in `a`
pub strmap :: fn($V: type, a: *Arena) -> StrMap(V) {
    states: []u8 = alloc(u8, a, INIT_CAP);
    i: usize = 0;
    while i < INIT_CAP { states[i] = EMPTY; i += 1; }
    r: StrMap(V) = .{ a, states, alloc([]const u8, a, INIT_CAP), alloc(V, a, INIT_CAP), 0, 0 };
    return r;
}

// ---- sets ----

// AutoHashMap(K, u8) with nothing stored
pub AutoSet :: struct($K: ByteKey) {
    m: AutoHashMap(K, u8),

    pub len :: fn(self: *Self) -> usize { return self.m.count; }
    pub is_empty :: fn(self: *Self) -> bool { return self.m.count == 0; }
    pub contains :: fn(self: *Self, k: K) -> bool { return self.m.contains(k); }

    // true if newly added
    pub add :: fn(self: *Self, k: K) -> bool {
        if self.m.contains(k) { return false; }
        self.m.put(k, 0);
        return true;
    }

    // true if it was there
    pub remove :: fn(self: *Self, k: K) -> bool { return self.m.remove(k); }
    pub clear :: fn(self: *Self) { self.m.clear(); }

    // no particular order
    pub each :: fn(self: *Self) -> AutoSetKeys(K) {
        it: AutoSetKeys(K) = .{ self.m.entries() };
        return it;
    }
}

// AutoSet.each iterator
pub AutoSetKeys :: struct($K: ByteKey) {
    it: AutoEntries(K, u8),

    pub next :: fn(self: *Self) -> ?K {
        if self.it.next() |e| { return e.key; }
        return null;
    }
}

// strings by content; keeps its own copies
pub StrSet :: struct {
    m: StrMap(u8),

    pub len :: fn(self: *Self) -> usize { return self.m.count; }
    pub is_empty :: fn(self: *Self) -> bool { return self.m.count == 0; }
    pub contains :: fn(self: *Self, k: []const u8) -> bool { return self.m.contains(k); }

    // true if newly added
    pub add :: fn(self: *Self, k: []const u8) -> bool {
        if self.m.contains(k) { return false; }
        self.m.put(k, 0);
        return true;
    }

    // true if it was there
    pub remove :: fn(self: *Self, k: []const u8) -> bool { return self.m.remove(k); }
    pub clear :: fn(self: *Self) { self.m.clear(); }

    // no particular order
    pub each :: fn(self: *Self) -> StrSetKeys {
        it: StrSetKeys = .{ self.m.entries() };
        return it;
    }
}

// StrSet.each iterator
pub StrSetKeys :: struct {
    it: StrEntries(u8),

    pub next :: fn(self: *Self) -> ?[]const u8 {
        if self.it.next() |e| { return e.key; }
        return null;
    }
}

// empty set in `a`
pub autoset :: fn($K: ByteKey, a: *Arena) -> AutoSet(K) {
    s: AutoSet(K) = .{ auto(K, u8, a) };
    return s;
}

// empty set in `a`
pub strset :: fn(a: *Arena) -> StrSet {
    s: StrSet = .{ strmap(u8, a) };
    return s;
}

// ---- SortedMap ----

// sorted arrays in the arena; binary-search get, put/remove shift (fine to ~10k entries)
// `C` has `less(self, a, b)`, like sort::Asc(K) or sort::By(K)
pub SortedMap :: struct($K: type, $V: type, $C: type) {
    region: *Arena,
    keys:   []K,      // first `count` in use
    vals:   []V,
    count:  usize,
    order:  C,

    pub len      :: fn(self: *Self) -> usize { return self.count; }
    pub is_empty :: fn(self: *Self) -> bool  { return self.count == 0; }

    // first index whose key is not before `k`
    find :: fn(self: *Self, k: K) -> usize {
        lo: usize = 0;
        hi := self.count;
        while lo < hi {
            mid := lo + (hi - lo) / 2;
            if self.order.less(self.keys[mid], k) { lo = mid + 1; } else { hi = mid; }
        }
        return lo;
    }

    // key at `i` (from find) equals `k`
    holds :: fn(self: *Self, i: usize, k: K) -> bool {
        return i < self.count && !self.order.less(k, self.keys[i]);
    }

    // replaces an existing value
    pub put :: fn(self: *Self, k: K, v: V) {
        i := self.find(k);
        if self.holds(i, k) {
            self.vals[i] = v;
            return;
        }
        if self.count == self.keys.len {
            cap := self.keys.len * 2;
            if cap < 8 { cap = 8; }
            nk := alloc(K, self.region, cap);
            nv := alloc(V, self.region, cap);
            for j in 0..self.count {
                nk[j] = self.keys[j];
                nv[j] = self.vals[j];
            }
            self.keys = nk;
            self.vals = nv;
        }
        j := self.count;
        while j > i {
            self.keys[j] = self.keys[j - 1];
            self.vals[j] = self.vals[j - 1];
            j -= 1;
        }
        self.keys[i] = k;
        self.vals[i] = v;
        self.count += 1;
    }

    pub get :: fn(self: *Self, k: K) -> ?V {
        i := self.find(k);
        if self.holds(i, k) { return self.vals[i]; }
        return null;
    }

    pub contains :: fn(self: *Self, k: K) -> bool { return self.holds(self.find(k), k); }

    // true if it was there
    pub remove :: fn(self: *Self, k: K) -> bool {
        i := self.find(k);
        if !self.holds(i, k) { return false; }
        for j in i..self.count - 1 {
            self.keys[j] = self.keys[j + 1];
            self.vals[j] = self.vals[j + 1];
        }
        self.count -= 1;
        return true;
    }

    // smallest key; null if empty
    pub first :: fn(self: *Self) -> ?Entry(K, V) {
        if self.count == 0 { return null; }
        e: Entry(K, V) = .{ self.keys[0], self.vals[0] };
        return e;
    }

    // largest key; null if empty
    pub last :: fn(self: *Self) -> ?Entry(K, V) {
        if self.count == 0 { return null; }
        e: Entry(K, V) = .{ self.keys[self.count - 1], self.vals[self.count - 1] };
        return e;
    }

    // smallest first; put/remove while iterating may skip or repeat
    pub entries :: fn(self: *Self) -> SortedEntries(K, V, C) {
        it: SortedEntries(K, V, C) = .{ self, 0 };
        return it;
    }

    // from the first key not before `k`
    pub from :: fn(self: *Self, k: K) -> SortedEntries(K, V, C) {
        it: SortedEntries(K, V, C) = .{ self, self.find(k) };
        return it;
    }

    pub clear :: fn(self: *Self) { self.count = 0; }
}

// SortedMap.entries/from iterator, key order
pub SortedEntries :: struct($K: type, $V: type, $C: type) {
    m: *SortedMap(K, V, C),
    i: usize,

    pub next :: fn(self: *Self) -> ?Entry(K, V) {
        if self.i >= self.m.count { return null; }
        e: Entry(K, V) = .{ self.m.keys[self.i], self.m.vals[self.i] };
        self.i += 1;
        return e;
    }
}

// map in `a` ordered by `order`
pub sorted_with :: fn($K: type, $V: type, $C: type, a: *Arena, order: C) -> SortedMap(K, V, C) {
    m: SortedMap(K, V, C) = .{ a, alloc(K, a, 0), alloc(V, a, 0), 0, order };
    return m;
}

// keys ordered by `<`
pub sorted :: fn($K: type, $V: type, a: *Arena) -> SortedMap(K, V, sort::Asc(K)) {
    o: sort::Asc(K) = .{ 0 };
    return sorted_with(K, V, sort::Asc(K), a, o);
}

// keys ordered by `less` (mem::less_bytes for text)
pub sorted_by :: fn($K: type, $V: type, a: *Arena, less: fn(K, K) -> bool) -> SortedMap(K, V, sort::By(K)) {
    o: sort::By(K) = .{ less };
    return sorted_with(K, V, sort::By(K), a, o);
}

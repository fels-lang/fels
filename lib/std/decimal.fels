// SPDX-License-Identifier: Apache-2.0
// std.decimal — exact decimal numbers, for money and anything else counted in tenths and
// hundredths: 0.1 + 0.2 is 0.3 here, not 0.30000000000000004.
//
//   price := decimal::parse("19.99")?;
//   qty := decimal::from_int(3);
//   total := decimal::mul(price, qty)?;                    // 59.97
//   share := decimal::div(total, decimal::from_int(7), 2, .half_even)?;   // 8.57
//   io::println("{total} / 7 = {share}");
//
// A `Decimal` is a whole number `coef` and a `scale`: its value is coef / 10^scale, with up to 18
// digits after the point and about 18 in all (coef is an i64). Adding and subtracting are exact.
// Multiplying is exact as long as the result fits, and keeps the digits of both sides (1.25 *
// 2.5 is 3.125); `round` then brings it to the places wanted. Dividing takes the places of the
// result and a rounding mode. A result that does not fit fails with `overflow` instead of
// wrapping or losing digits silently.

pub DecimalError :: errors {
    invalid,            // text that is no decimal number
    overflow,           // a result past about 9.2 * 10^18 / 10^scale, or more than 18 places
    division_by_zero,
}

/// How a result drops digits it cannot keep.
pub Rounding :: enum {
    half_even,     // to the nearest, a tie to the even digit (banker's rounding): 2.5 → 2, 3.5 → 4
    half_up,       // to the nearest, a tie away from zero: 2.5 → 3, -2.5 → -3
    half_down,     // to the nearest, a tie toward zero: 2.5 → 2
    down,          // toward zero: 2.9 → 2, -2.9 → -2
    up,            // away from zero: 2.1 → 3, -2.1 → -3
    floor,         // toward minus infinity: -2.1 → -3
    ceiling,       // toward plus infinity: 2.1 → 3
}

pub MAX_SCALE :: 18u32;

pub Decimal :: struct {
    coef: i64,
    scale: u32,

    /// Writes it in a format: `io::println("{price}")` gives `19.99`.
    pub format :: fn(self: Decimal, f: *Formatter) {
        buf: [48]u8 = .{};
        n := write_text(self, buf[:]);
        f.text(buf[0..n]);
    }
}

POW10: [19]u64 = .{
    1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000,
    10000000000, 100000000000, 1000000000000, 10000000000000, 100000000000000,
    1000000000000000, 10000000000000000, 100000000000000000, 1000000000000000000,
};

I64_MAX_MAG :: 9223372036854775807u64;    // the largest magnitude of a positive coef
I64_MIN_MAG :: 9223372036854775808u64;    // of a negative one

// Building

/// `coef` / 10^`scale`: `from_parts(1999, 2)` is 19.99.
pub from_parts :: fn(coef: i64, scale: u32) -> Decimal ! DecimalError {
    if scale > MAX_SCALE { fail .overflow; }
    d: Decimal = .{ coef, scale };
    return d;
}

/// The whole number `n`.
pub from_int :: fn(n: i64) -> Decimal {
    d: Decimal = .{ n, 0 };
    return d;
}

pub zero :: fn() -> Decimal { return from_int(0); }

// Magnitudes and signs

magnitude :: fn(c: i64) -> u64 {
    if c >= 0 { return c as u64; }
    if c == -9223372036854775807 - 1 { return I64_MIN_MAG; }
    return (-c) as u64;
}

// The coef of magnitude `m` and sign `negative`, if it fits.
signed :: fn(m: u64, negative: bool) -> i64 ! DecimalError {
    if negative {
        if m > I64_MIN_MAG { fail .overflow; }
        if m == I64_MIN_MAG { return -9223372036854775807 - 1; }
        return -(m as i64);
    }
    if m > I64_MAX_MAG { fail .overflow; }
    return m as i64;
}

// 128-bit arithmetic on magnitudes, as two u64 halves

U128 :: struct { hi: u64, lo: u64 }

mul64 :: fn(a: u64, b: u64) -> U128 {
    a0 := a & 0xFFFFFFFF;
    a1 := a >> 32;
    b0 := b & 0xFFFFFFFF;
    b1 := b >> 32;
    p00 := a0 * b0;
    p01 := a0 * b1;
    p10 := a1 * b0;
    p11 := a1 * b1;
    mid := (p00 >> 32) + (p01 & 0xFFFFFFFF) + (p10 & 0xFFFFFFFF);
    r: U128 = .{ p11 + (p01 >> 32) + (p10 >> 32) + (mid >> 32), (p00 & 0xFFFFFFFF) | (mid << 32) };
    return r;
}

// `n` / `d` (d not 0): the quotient, which must fit in 128 bits (it does: d >= 1), and the
// remainder.
DivResult :: struct { q: U128, rem: u64 }

div128 :: fn(n: U128, d: u64) -> DivResult {
    q: U128 = .{ 0, 0 };
    rem: u64 = 0;
    // a bit at a time, from the top: 128 steps
    for i in 0..128 {
        top := rem >> 63;
        bit: u64 = 0;
        if i < 64 { bit = (n.hi >> ((63 - i) as u64)) & 1; } else { bit = (n.lo >> ((127 - i) as u64)) & 1; }
        rem = (rem << 1) | bit;
        q.hi = (q.hi << 1) | (q.lo >> 63);
        q.lo = q.lo << 1;
        if top == 1 || rem >= d {
            rem = rem -% d;
            q.lo = q.lo | 1;
        }
    }
    r: DivResult = .{ q, rem };
    return r;
}

// 192 bits, for a numerator scaled by up to 10^36: `a` the top word, `c` the bottom.
U192 :: struct { a: u64, b: u64, c: u64 }

// `x` * `f`.
mul3 :: fn(x: U128, f: u64) -> U192 {
    lo := mul64(x.lo, f);
    hi := mul64(x.hi, f);
    mid := lo.hi +% hi.lo;
    carry: u64 = if mid < lo.hi { 1 } else { 0 };
    r: U192 = .{ hi.hi + carry, mid, lo.lo };
    return r;
}

Div3Result :: struct { q: U192, rem: u64 }

// `n` / `d` (d not 0), a bit at a time.
div3 :: fn(n: U192, d: u64) -> Div3Result {
    q: U192 = .{ 0, 0, 0 };
    rem: u64 = 0;
    for i in 0..192 {
        top := rem >> 63;
        word := if i < 64 { n.a } else if i < 128 { n.b } else { n.c };
        bit := (word >> ((63 - (i % 64)) as u64)) & 1;
        rem = (rem << 1) | bit;
        q.a = (q.a << 1) | (q.b >> 63);
        q.b = (q.b << 1) | (q.c >> 63);
        q.c = q.c << 1;
        if top == 1 || rem >= d {
            rem = rem -% d;
            q.c = q.c | 1;
        }
    }
    r: Div3Result = .{ q, rem };
    return r;
}

// Whether to add one to a quotient `q` (its last digit kept) whose dropped part was `half`
// (-1 below a half, 0 exactly a half, 1 above) and not zero when `inexact`.
round_up :: fn(mode: Rounding, negative: bool, q_odd: bool, half: i32, inexact: bool) -> bool {
    if !inexact { return false; }
    match mode {
        .half_even => { return half > 0 || (half == 0 && q_odd); },
        .half_up => { return half >= 0; },
        .half_down => { return half > 0; },
        .down => { return false; },
        .up => { return true; },
        .floor => { return negative; },
        .ceiling => { return !negative; },
    }
}

// `m` (a 128-bit magnitude) divided by 10^k, rounded by `mode`, as a coef of sign `negative`.
// `sticky`: digits below `m` that were already dropped and are not all zero.
shrink :: fn(m: U128, k: u32, negative: bool, mode: Rounding, sticky: bool) -> i64 ! DecimalError {
    q := m;
    half: i32 = -1;
    inexact := sticky;
    left := k;
    while left > 0 {
        step: u32 = if left > 18 { 18 } else { left };
        d := POW10[step as usize];
        r := div128(q, d);
        // the part dropped in this step, against a half of 10^step
        if left == step {
            if r.rem > d / 2 { half = 1; } else if r.rem == d / 2 && !inexact { half = 0; } else if r.rem == d / 2 { half = 1; } else { half = -1; }
        } else if r.rem != 0 {
            inexact = true;
        }
        if r.rem != 0 { inexact = true; }
        q = r.q;
        left -= step;
    }
    if q.hi != 0 { fail .overflow; }
    m2 := q.lo;
    if round_up(mode, negative, (m2 & 1) == 1, half, inexact) { m2 += 1; }
    return signed(m2, negative);
}

// Arithmetic

/// The scale both get when added: the larger of the two.
widen :: fn(d: Decimal, scale: u32) -> U128 {
    return mul64(magnitude(d.coef), POW10[(scale - d.scale) as usize]);
}

/// `a` + `b`, exact, at the larger scale of the two.
pub add :: fn(a: Decimal, b: Decimal) -> Decimal ! DecimalError {
    scale := if a.scale > b.scale { a.scale } else { b.scale };
    x := widen(a, scale);
    y := widen(b, scale);
    if x.hi != 0 || y.hi != 0 { fail .overflow; }
    na := a.coef < 0;
    nb := b.coef < 0;
    r: Decimal = .{ 0, scale };
    if na == nb {
        s := x.lo +% y.lo;
        if s < x.lo { fail .overflow; }
        r.coef = signed(s, na)?;
    } else if x.lo >= y.lo {
        r.coef = signed(x.lo - y.lo, na)?;
    } else {
        r.coef = signed(y.lo - x.lo, nb)?;
    }
    return r;
}

/// `a` - `b`, exact, at the larger scale of the two.
pub sub :: fn(a: Decimal, b: Decimal) -> Decimal ! DecimalError {
    return add(a, neg(b)?);
}

/// `a` * `b`, exact, with the places of both (`1.25 * 2.5` is `3.125`). When those are more than
/// 18, or the coef does not fit, the last places are dropped with `half_even`; `overflow` when
/// even the whole part does not fit.
pub mul :: fn(a: Decimal, b: Decimal) -> Decimal ! DecimalError {
    p := mul64(magnitude(a.coef), magnitude(b.coef));
    negative := (a.coef < 0) != (b.coef < 0) && a.coef != 0 && b.coef != 0;
    scale := a.scale + b.scale;
    // drop places until the scale is at most 18 and the coef fits
    k: u32 = 0;
    if scale > MAX_SCALE { k = scale - MAX_SCALE; }
    while k <= scale {
        ok := true;
        coef := shrink(p, k, negative, .half_even, false) catch err {
            ok = false;
            yield 0i64;
        };
        if ok {
            r: Decimal = .{ coef, scale - k };
            return r;
        }
        k += 1;
    }
    fail .overflow;
}

/// `a` / `b` with `scale` places, rounded by `mode`.
pub div :: fn(a: Decimal, b: Decimal, scale: u32, mode: Rounding) -> Decimal ! DecimalError {
    if b.coef == 0 { fail .division_by_zero; }
    if scale > MAX_SCALE { fail .overflow; }
    negative := (a.coef < 0) != (b.coef < 0) && a.coef != 0;
    // a / b at `scale` places is a.coef * 10^(scale + b.scale - a.scale) / b.coef. With more
    // places to take than to give (e < 0), divide at the exact scale and drop the rest after.
    e: i64 = (scale as i64) + (b.scale as i64) - (a.scale as i64);
    up: u32 = if e > 0 { e as u32 } else { 0 };
    drop: u32 = if e < 0 { (-e) as u32 } else { 0 };
    if up > 36 { fail .overflow; }
    first: u32 = if up > 18 { 18 } else { up };
    n := mul3(mul64(magnitude(a.coef), POW10[first as usize]), POW10[(up - first) as usize]);
    d := magnitude(b.coef);
    r := div3(n, d);
    if drop == 0 {
        if r.q.a != 0 || r.q.b != 0 { fail .overflow; }
        q := r.q.c;
        half: i32 = -1;
        if r.rem > d - r.rem { half = 1; } else if r.rem == d - r.rem { half = 0; }
        if round_up(mode, negative, (q & 1) == 1, half, r.rem != 0) { q += 1; }
        out: Decimal = .{ signed(q, negative)?, scale };
        return out;
    }
    if r.q.a != 0 { fail .overflow; }
    wide: U128 = .{ r.q.b, r.q.c };
    out: Decimal = .{ shrink(wide, drop, negative, mode, r.rem != 0)?, scale };
    return out;
}

/// `d` with `scale` places: more places are exact, fewer drop digits by `mode`
/// (`round(2.345, 2, .half_up)` is 2.35).
pub round :: fn(d: Decimal, scale: u32, mode: Rounding) -> Decimal ! DecimalError {
    if scale > MAX_SCALE { fail .overflow; }
    if scale >= d.scale {
        w := widen(d, scale);
        if w.hi != 0 { fail .overflow; }
        r: Decimal = .{ signed(w.lo, d.coef < 0)?, scale };
        return r;
    }
    m: U128 = .{ 0, magnitude(d.coef) };
    r: Decimal = .{ shrink(m, d.scale - scale, d.coef < 0, mode, false)?, scale };
    return r;
}

/// `-d`.
pub neg :: fn(d: Decimal) -> Decimal ! DecimalError {
    if d.coef == -9223372036854775807 - 1 { fail .overflow; }
    r: Decimal = .{ -d.coef, d.scale };
    return r;
}

/// `d` without its sign.
pub abs :: fn(d: Decimal) -> Decimal ! DecimalError {
    if d.coef < 0 { return neg(d); }
    return d;
}

/// The same value with no zeros at the end of its places: 2.500 → 2.5, 3.00 → 3.
pub normalize :: fn(d: Decimal) -> Decimal {
    r := d;
    while r.scale > 0 && r.coef % 10 == 0 {
        r.coef = r.coef / 10;
        r.scale -= 1;
    }
    return r;
}

// Comparing

/// -1, 0 or 1 as `a` is less than, equal to or greater than `b` (whatever their scales: 2.50 is
/// 2.5).
pub cmp :: fn(a: Decimal, b: Decimal) -> i32 {
    na := a.coef < 0;
    nb := b.coef < 0;
    if na != nb { return if na { -1 } else { 1 }; }
    scale := if a.scale > b.scale { a.scale } else { b.scale };
    x := widen(a, scale);
    y := widen(b, scale);
    c: i32 = 0;
    if x.hi != y.hi { c = if x.hi < y.hi { -1 } else { 1 }; }
    else if x.lo != y.lo { c = if x.lo < y.lo { -1 } else { 1 }; }
    return if na { -c } else { c };
}

pub eq :: fn(a: Decimal, b: Decimal) -> bool { return cmp(a, b) == 0; }
pub less :: fn(a: Decimal, b: Decimal) -> bool { return cmp(a, b) < 0; }
pub is_zero :: fn(d: Decimal) -> bool { return d.coef == 0; }
pub is_negative :: fn(d: Decimal) -> bool { return d.coef < 0; }

// Text

/// The decimal number `text` writes: an optional sign, digits with at most one point, and an
/// optional exponent (`-12.50`, `.5`, `1e3`, `2.5E-3`). Its places are those written: "2.50" has
/// scale 2. `overflow` for more than 18 places or a coef that does not fit.
pub parse :: fn(text: []const u8) -> Decimal ! DecimalError {
    i: usize = 0;
    negative := false;
    if i < text.len && (text[i] == '-' || text[i] == '+') {
        negative = text[i] == '-';
        i += 1;
    }
    m: u64 = 0;
    scale: i64 = 0;
    digits: usize = 0;
    seen_point := false;
    while i < text.len {
        c := text[i];
        if c == '.' {
            if seen_point { fail .invalid; }
            seen_point = true;
        } else if c >= '0' && c <= '9' {
            if m > (0xFFFFFFFFFFFFFFFFu64 - 9) / 10 { fail .overflow; }
            m = m * 10 + (c - '0') as u64;
            digits += 1;
            if seen_point { scale += 1; }
        } else {
            break;
        }
        i += 1;
    }
    if digits == 0 { fail .invalid; }
    if i < text.len && (text[i] == 'e' || text[i] == 'E') {
        i += 1;
        eneg := false;
        if i < text.len && (text[i] == '-' || text[i] == '+') {
            eneg = text[i] == '-';
            i += 1;
        }
        ev: i64 = 0;
        edigits: usize = 0;
        while i < text.len && text[i] >= '0' && text[i] <= '9' {
            ev = ev * 10 + (text[i] - '0') as i64;
            if ev > 1000 { fail .overflow; }
            edigits += 1;
            i += 1;
        }
        if edigits == 0 { fail .invalid; }
        scale = if eneg { scale + ev } else { scale - ev };
    }
    if i != text.len { fail .invalid; }
    // a negative scale is a coef with zeros added: 1e3 is 1000
    while scale < 0 {
        if m > 0xFFFFFFFFFFFFFFFFu64 / 10 { fail .overflow; }
        m = m * 10;
        scale += 1;
    }
    if scale > MAX_SCALE as i64 { fail .overflow; }
    r: Decimal = .{ signed(m, negative && m != 0)?, scale as u32 };
    return r;
}

// Write `d` into `out` (48 bytes are always enough); the length.
write_text :: fn(d: Decimal, out: []u8) -> usize {
    digits: [24]u8 = .{};
    m := magnitude(d.coef);
    nd: usize = 0;
    while m > 0 || nd <= d.scale as usize {
        digits[nd] = '0' + (m % 10) as u8;
        m = m / 10;
        nd += 1;
    }
    o: usize = 0;
    if d.coef < 0 {
        out[o] = '-';
        o += 1;
    }
    k := nd;
    while k > 0 {
        k -= 1;
        out[o] = digits[k];
        o += 1;
        if k == d.scale as usize && k > 0 {
            out[o] = '.';
            o += 1;
        }
    }
    return o;
}

/// `d` as text, all its places written (`19.90` stays `19.90`), into `out`; the slice of it
/// used. 48 bytes always suffice.
pub to_text :: fn(d: Decimal, out: []u8) -> []const u8 {
    n := write_text(d, out);
    return out[0..n];
}

/// The nearest `f64` (exact up to about 15 significant digits).
pub to_f64 :: fn(d: Decimal) -> f64 {
    return (d.coef as f64) / (POW10[d.scale as usize] as f64);
}

/// `x` with `scale` places, rounded half to even. A float is binary: 0.1 is a little more than
/// a tenth, so this is for numbers that came as floats, not for exact work.
pub from_f64 :: fn(x: f64, scale: u32) -> Decimal ! DecimalError {
    if scale > MAX_SCALE || x != x { fail .overflow; }
    y := x * (POW10[scale as usize] as f64);
    if y > 9.2e18 || y < -9.2e18 { fail .overflow; }
    w := y as i64;
    frac := y - (w as f64);
    if frac > 0.5 || (frac == 0.5 && w % 2 != 0) { w += 1; }
    if frac < -0.5 || (frac == -0.5 && w % 2 != 0) { w -= 1; }
    r: Decimal = .{ w, scale };
    return r;
}

/// The sum of `xs`, exact, at the largest scale among them.
pub sum :: fn(xs: []const Decimal) -> Decimal ! DecimalError {
    total := zero();
    for x in xs { total = add(total, x)?; }
    return total;
}

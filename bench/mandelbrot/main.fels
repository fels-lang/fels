// mandelbrot: the Benchmarks Game's Mandelbrot set, an n x n bitmap of 50 iterations each.
// A tight floating-point loop, and bits packed into bytes. Instead of the bitmap it prints a
// checksum of its bytes.

#import std.io;
#import std.heap;
#import std.process;

// The first argument as a number, or `fallback`.
arg_int :: fn(fallback: i64) -> i64 {
    a := heap::make();
    args := process::args(&a);
    if args.len < 2 { return fallback; }
    n: i64 = 0;
    for c in args[1] { n = n * 10 + ((c - 48) as i64); }
    return n;
}

main :: fn() -> i32 {
    n := arg_int(200) as usize;
    w := n as f64;
    checksum: u32 = 0;
    for y in 0..n {
        ci := 2.0 * (y as f64) / w - 1.0;
        byte: u32 = 0;
        bits: u32 = 0;
        for x in 0..n {
            cr := 2.0 * (x as f64) / w - 1.5;
            zr := 0.0;
            zi := 0.0;
            tr := 0.0;
            ti := 0.0;
            i := 0;
            while i < 50 && tr + ti <= 4.0 {
                zi = 2.0 * zr * zi + ci;
                zr = tr - ti + cr;
                tr = zr * zr;
                ti = zi * zi;
                i += 1;
            }
            byte = byte << 1;
            if tr + ti <= 4.0 { byte = byte | 1; }
            bits += 1;
            if bits == 8 {
                checksum = checksum *% 31 +% byte;
                byte = 0;
                bits = 0;
            } else if x == n - 1 {
                byte = (byte << (8 - (n % 8) as u32)) & 255;
                checksum = checksum *% 31 +% byte;
                byte = 0;
                bits = 0;
            }
        }
    }
    io::println("{n} {checksum}") catch e {};
    return 0;
}

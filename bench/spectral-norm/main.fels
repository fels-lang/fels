// spectral-norm: the Benchmarks Game's spectral norm of an infinite matrix, by the power method.
// Floating-point division and dot products in nested loops. Prints the norm to 9 decimals.

#import std.io;
#import std.heap;
#import std.process;

eval_a :: fn(i: usize, j: usize) -> f64 {
    return 1.0 / (((i + j) * (i + j + 1) / 2 + i + 1) as f64);
}

mul_av :: fn(v: []f64, out: []f64) {
    for i in 0..out.len {
        s := 0.0;
        for j in 0..v.len { s += eval_a(i, j) * v[j]; }
        out[i] = s;
    }
}

mul_atv :: fn(v: []f64, out: []f64) {
    for i in 0..out.len {
        s := 0.0;
        for j in 0..v.len { s += eval_a(j, i) * v[j]; }
        out[i] = s;
    }
}

mul_atav :: fn(v: []f64, out: []f64, tmp: []f64) {
    mul_av(v, tmp);
    mul_atv(tmp, out);
}

// The first argument as a number, or `fallback`.
arg_int :: fn(fallback: i64) -> i64 {
    a := heap::make();
    args := process::args(&a);
    if args.len < 2 { return fallback; }
    n: i64 = 0;
    for c in args[1] { n = n * 10 + ((c - 48) as i64); }
    return n;
}

main :: fn() -> i32 {
    n := arg_int(100) as usize;
    a := heap::make();
    u := heap::alloc(f64, &a, n);
    v := heap::alloc(f64, &a, n);
    tmp := heap::alloc(f64, &a, n);
    for i in 0..n { u[i] = 1.0; }
    for k in 0..10 {
        mul_atav(u, v, tmp);
        mul_atav(v, u, tmp);
    }
    vbv := 0.0;
    vv := 0.0;
    for i in 0..n {
        vbv += u[i] * v[i];
        vv += v[i] * v[i];
    }
    io::println("{core::sqrt(vbv / vv):.9}") catch e {};
    return 0;
}

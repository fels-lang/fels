// SPDX-License-Identifier: Apache-2.0
// Obsidian's x86-64 encoder: machine code into a byte buffer.
//
// Each function emits one instruction. Operands are named in the function (`mov_rr`, `alu_ri`,
// `mov_rm` for a load, `mov_mr` for a store), so a call says what it encodes. A size is the
// operand width in bytes, 1, 2, 4 or 8. Registers are numbers: the general ones `RAX` to `R15`,
// and `XMM0` to `XMM15` for the floating-point instructions. Where an instruction has a shorter
// form, the encoder writes the one llvm-mc writes.
//
// Jumps go to labels: `new_label` makes one, `bind` places it at the current offset, and
// `finish` patches every jump once the code is complete. A jump is always the 5- or 6-byte form,
// so code is written in one pass, without relaxing jumps that turn out short.
//
// Each encoding is checked against llvm-mc in `x64_tests.fels`, which
// `tools/gen_x64_tests.py` writes.

#import std.heap.{ Arena };
#import std.vec.{ Vec };
#import std.vec as vec;

// Registers

pub RAX :: 0u8;
pub RCX :: 1u8;
pub RDX :: 2u8;
pub RBX :: 3u8;
pub RSP :: 4u8;
pub RBP :: 5u8;
pub RSI :: 6u8;
pub RDI :: 7u8;
pub R8 :: 8u8;
pub R9 :: 9u8;
pub R10 :: 10u8;
pub R11 :: 11u8;
pub R12 :: 12u8;
pub R13 :: 13u8;
pub R14 :: 14u8;
pub R15 :: 15u8;

pub XMM0 :: 0u8;
pub XMM1 :: 1u8;
pub XMM2 :: 2u8;
pub XMM3 :: 3u8;
pub XMM4 :: 4u8;
pub XMM5 :: 5u8;
pub XMM6 :: 6u8;
pub XMM7 :: 7u8;
pub XMM8 :: 8u8;
pub XMM9 :: 9u8;
pub XMM10 :: 10u8;
pub XMM11 :: 11u8;
pub XMM12 :: 12u8;
pub XMM13 :: 13u8;
pub XMM14 :: 14u8;
pub XMM15 :: 15u8;

/// No register (a memory operand without an index).
pub NO_REG :: 255u8;
/// The base of a RIP-relative memory operand.
pub RIP :: 254u8;

// Condition codes, as the low nibble of `jcc`, `setcc` and `cmovcc`

pub CC_O :: 0u8;
pub CC_NO :: 1u8;
pub CC_B :: 2u8;    // below (unsigned <), carry
pub CC_AE :: 3u8;   // above or equal (unsigned >=), no carry
pub CC_E :: 4u8;    // equal, zero
pub CC_NE :: 5u8;
pub CC_BE :: 6u8;
pub CC_A :: 7u8;
pub CC_S :: 8u8;
pub CC_NS :: 9u8;
pub CC_P :: 10u8;
pub CC_NP :: 11u8;
pub CC_L :: 12u8;   // less (signed <)
pub CC_GE :: 13u8;
pub CC_LE :: 14u8;
pub CC_G :: 15u8;

// The arithmetic group: `add` to `cmp` share their encodings, told apart by this number.

pub ALU_ADD :: 0u8;
pub ALU_OR :: 1u8;
pub ALU_ADC :: 2u8;
pub ALU_SBB :: 3u8;
pub ALU_AND :: 4u8;
pub ALU_SUB :: 5u8;
pub ALU_XOR :: 6u8;
pub ALU_CMP :: 7u8;

// Shifts and rotates, the `/digit` of their encodings.

pub SH_ROL :: 0u8;
pub SH_ROR :: 1u8;
pub SH_SHL :: 4u8;
pub SH_SHR :: 5u8;
pub SH_SAR :: 7u8;

/// A memory operand: `[base + index * scale + disp]`. `index` is `NO_REG` when there is none,
/// `base` is `RIP` for `[rip + disp]`; `scale` is 1, 2, 4 or 8.
pub Mem :: struct {
    base: u8,
    index: u8,
    scale: u8,
    disp: i32,
}

/// `[base + disp]`.
pub at :: fn(base: u8, disp: i32) -> Mem {
    return .{ .base = base, .index = NO_REG, .scale = 1u8, .disp = disp };
}

/// `[base + index * scale + disp]`.
pub at_index :: fn(base: u8, index: u8, scale: u8, disp: i32) -> Mem {
    return .{ .base = base, .index = index, .scale = scale, .disp = disp };
}

/// A jump not yet patched: the offset of its 32-bit displacement and the label it goes to.
Fixup :: struct {
    at: usize,
    label: u32,
}

/// Machine code being written, and its labels.
pub Code :: struct {
    bytes: Vec(u8),
    /// Where each label is, or -1 while it is not bound.
    labels: Vec(i64),
    fixups: Vec(Fixup),

    pub len :: fn(self: *Self) -> usize { return self.bytes.len(); }

    pub byte :: fn(self: *Self, b: u8) { self.bytes.push(b); }

    pub u16le :: fn(self: *Self, v: u16) {
        self.bytes.push((v & 255u16) as u8);
        self.bytes.push((v >> 8u16) as u8);
    }

    pub u32le :: fn(self: *Self, v: u32) {
        self.bytes.push((v & 255u32) as u8);
        self.bytes.push(((v >> 8u32) & 255u32) as u8);
        self.bytes.push(((v >> 16u32) & 255u32) as u8);
        self.bytes.push((v >> 24u32) as u8);
    }

    pub i32le :: fn(self: *Self, v: i32) { self.u32le(v as u32); }

    pub u64le :: fn(self: *Self, v: u64) {
        self.u32le((v & 4294967295u64) as u32);
        self.u32le((v >> 32u64) as u32);
    }

    /// Overwrite the 32-bit value at `at`.
    pub patch32 :: fn(self: *Self, at: usize, v: u32) {
        self.bytes.set(at, (v & 255u32) as u8);
        self.bytes.set(at + 1, ((v >> 8u32) & 255u32) as u8);
        self.bytes.set(at + 2, ((v >> 16u32) & 255u32) as u8);
        self.bytes.set(at + 3, (v >> 24u32) as u8);
    }

    // Labels

    pub new_label :: fn(self: *Self) -> u32 {
        self.labels.push(-1i64);
        return (self.labels.len() - 1) as u32;
    }

    /// Place `label` here.
    pub bind :: fn(self: *Self, label: u32) {
        self.labels.set(label as usize, self.len() as i64);
    }

    /// Patch every jump to a label that is bound. Call once, when the code is complete.
    pub finish :: fn(self: *Self) {
        for f in self.fixups.items() {
            target := self.labels.get(f.label as usize);
            self.patch32(f.at, ((target - (f.at as i64 + 4i64)) as i32) as u32);
        }
        self.fixups.clear();
    }

    /// A 32-bit displacement to `label`, patched by `finish`.
    rel32_to :: fn(self: *Self, label: u32) {
        self.fixups.push(.{ .at = self.len(), .label = label });
        self.u32le(0u32);
    }
}

/// An empty buffer that grows in `a`.
pub code :: fn(a: *Arena) -> Code {
    return .{ .bytes = vec::make(u8, a), .labels = vec::make(i64, a), .fixups = vec::make(Fixup, a) };
}

// Encoding helpers

fn_low :: fn(r: u8) -> u8 { return r & 7u8; }
fn_ext :: fn(r: u8) -> u8 { return (r >> 3u8) & 1u8; }

/// A register operand of 8 bits that needs a REX prefix to mean spl, bpl, sil or dil (and not
/// ah, ch, dh, bh).
byte_needs_rex :: fn(size: u8, r: u8) -> bool {
    return size == 1u8 && r >= 4u8 && r <= 7u8;
}

/// The operand-size prefix of a 16-bit operation.
size_prefix :: fn(c: *Code, size: u8) {
    if size == 2u8 { c.byte(102u8); }   // 0x66
}

/// A REX prefix, when one is needed: `w` for a 64-bit operand, `r` the ModRM.reg register,
/// `x` the index register, `b` the ModRM.rm or base register.
rex :: fn(c: *Code, w: bool, r: u8, x: u8, b: u8, force: bool) {
    bits: u8 = (fn_ext(r) << 2u8) | (fn_ext(x) << 1u8) | fn_ext(b);
    if w { bits = bits | 8u8; }
    if bits != 0u8 || force { c.byte(64u8 | bits); }   // 0x40 | WRXB
}

modrm :: fn(c: *Code, md: u8, reg: u8, rm: u8) {
    c.byte((md << 6u8) | (fn_low(reg) << 3u8) | fn_low(rm));
}

fits_i8 :: fn(v: i64) -> bool { return v >= -128i64 && v <= 127i64; }
fits_i32 :: fn(v: i64) -> bool { return v >= -2147483648i64 && v <= 2147483647i64; }

/// The ModRM, SIB and displacement of a memory operand, with `reg` in ModRM.reg.
mem_operand :: fn(c: *Code, reg: u8, m: Mem) {
    if m.base == RIP {
        modrm(c, 0u8, reg, 5u8);
        c.i32le(m.disp);
        return;
    }
    d := m.disp as i64;
    // [rbp] and [r13] have no form without a displacement: they take a zero byte.
    md: u8 = 2u8;
    if d == 0i64 && fn_low(m.base) != 5u8 { md = 0u8; } else if fits_i8(d) { md = 1u8; }
    if m.index != NO_REG || fn_low(m.base) == 4u8 {
        // a SIB byte: an index, or a base of rsp or r12
        modrm(c, md, reg, 4u8);
        ss: u8 = 0u8;
        if m.scale == 2u8 { ss = 1u8; } else if m.scale == 4u8 { ss = 2u8; } else if m.scale == 8u8 { ss = 3u8; }
        idx: u8 = 4u8;  // none
        if m.index != NO_REG { idx = fn_low(m.index); }
        c.byte((ss << 6u8) | (idx << 3u8) | fn_low(m.base));
    } else {
        modrm(c, md, reg, m.base);
    }
    if md == 1u8 { c.byte((m.disp as i8) as u8); } else if md == 2u8 { c.i32le(m.disp); }
}

/// The REX prefix of an instruction with a memory operand.
rex_mem :: fn(c: *Code, w: bool, reg: u8, m: Mem, force: bool) {
    idx: u8 = 0u8;
    if m.index != NO_REG { idx = m.index; }
    base: u8 = 0u8;
    if m.base != RIP { base = m.base; }
    rex(c, w, reg, idx, base, force);
}

/// Prefixes and opcode of an operation of `size` between `reg` and the register `rm`: the
/// opcode for 8 bits is `op8`, for 16, 32 and 64 `op`.
op_rr :: fn(c: *Code, size: u8, op8: u8, op: u8, reg: u8, rm: u8) {
    size_prefix(c, size);
    rex(c, size == 8u8, reg, 0u8, rm, byte_needs_rex(size, reg) || byte_needs_rex(size, rm));
    if size == 1u8 { c.byte(op8); } else { c.byte(op); }
    modrm(c, 3u8, reg, rm);
}

/// The same between `reg` and memory.
op_rm :: fn(c: *Code, size: u8, op8: u8, op: u8, reg: u8, m: Mem) {
    size_prefix(c, size);
    rex_mem(c, size == 8u8, reg, m, byte_needs_rex(size, reg));
    if size == 1u8 { c.byte(op8); } else { c.byte(op); }
    mem_operand(c, reg, m);
}

/// An immediate of `size` (8 bits, 16, or 32 for 32 and 64-bit operations).
imm_of :: fn(c: *Code, size: u8, v: i64) {
    if size == 1u8 { c.byte(((v as i32) as i8) as u8); }
    else if size == 2u8 { c.u16le(((v as i32) as i16) as u16); }
    else { c.i32le(v as i32); }
}

// Moves

/// `mov dst, src`.
pub mov_rr :: fn(c: *Code, size: u8, dst: u8, src: u8) { op_rr(c, size, 136u8, 137u8, src, dst); }   // 88, 89 /r

/// `mov dst, [m]`: a load.
pub mov_rm :: fn(c: *Code, size: u8, dst: u8, m: Mem) { op_rm(c, size, 138u8, 139u8, dst, m); }    // 8A, 8B /r

/// `mov [m], src`: a store.
pub mov_mr :: fn(c: *Code, size: u8, m: Mem, src: u8) { op_rm(c, size, 136u8, 137u8, src, m); }    // 88, 89 /r

/// `mov dst, imm` in the shortest form: a 32-bit move for a value that fits 32 unsigned bits
/// (it clears the upper half), a sign-extended 32-bit immediate, or the full 64 bits.
pub mov_ri :: fn(c: *Code, size: u8, dst: u8, v: i64) {
    if size == 8u8 && v >= 0i64 && v <= 4294967295i64 {
        rex(c, false, 0u8, 0u8, dst, false);
        c.byte(184u8 + fn_low(dst));   // B8+r
        c.u32le(v as u32);
        return;
    }
    if size == 8u8 && fits_i32(v) {
        rex(c, true, 0u8, 0u8, dst, false);
        c.byte(199u8);   // C7 /0
        modrm(c, 3u8, 0u8, dst);
        c.i32le(v as i32);
        return;
    }
    size_prefix(c, size);
    rex(c, size == 8u8, 0u8, 0u8, dst, byte_needs_rex(size, dst));
    if size == 1u8 { c.byte(176u8 + fn_low(dst)); c.byte(((v as i32) as i8) as u8); return; }   // B0+r
    c.byte(184u8 + fn_low(dst));   // B8+r
    if size == 2u8 { c.u16le(((v as i32) as i16) as u16); }
    else if size == 4u8 { c.u32le((v as i32) as u32); }
    else { c.u64le(v as u64); }
}

/// `mov [m], imm`: an immediate of up to 32 bits (sign-extended for a 64-bit store).
pub mov_mi :: fn(c: *Code, size: u8, m: Mem, v: i64) {
    size_prefix(c, size);
    rex_mem(c, size == 8u8, 0u8, m, false);
    if size == 1u8 { c.byte(198u8); } else { c.byte(199u8); }   // C6, C7 /0
    mem_operand(c, 0u8, m);
    imm_of(c, size, v);
}

/// `lea dst, [m]`.
pub lea :: fn(c: *Code, size: u8, dst: u8, m: Mem) {
    size_prefix(c, size);
    rex_mem(c, size == 8u8, dst, m, false);
    c.byte(141u8);   // 8D /r
    mem_operand(c, dst, m);
}

/// `movzx dst, src` from 8 or 16 bits (`from` is 1 or 2) to `size`.
pub movzx_rr :: fn(c: *Code, size: u8, dst: u8, from: u8, src: u8) {
    size_prefix(c, size);
    rex(c, size == 8u8, dst, 0u8, src, from == 1u8 && byte_needs_rex(1u8, src));
    c.byte(15u8);
    if from == 1u8 { c.byte(182u8); } else { c.byte(183u8); }   // 0F B6, 0F B7
    modrm(c, 3u8, dst, src);
}

/// `movzx dst, [m]`, a load that clears the upper bits.
pub movzx_rm :: fn(c: *Code, size: u8, dst: u8, from: u8, m: Mem) {
    size_prefix(c, size);
    rex_mem(c, size == 8u8, dst, m, false);
    c.byte(15u8);
    if from == 1u8 { c.byte(182u8); } else { c.byte(183u8); }
    mem_operand(c, dst, m);
}

/// `movsx dst, src` from 8 or 16 bits, `movsxd` from 32 (`from` is 1, 2 or 4).
pub movsx_rr :: fn(c: *Code, size: u8, dst: u8, from: u8, src: u8) {
    size_prefix(c, size);
    rex(c, size == 8u8, dst, 0u8, src, from == 1u8 && byte_needs_rex(1u8, src));
    if from == 4u8 { c.byte(99u8); }   // 63 /r
    else {
        c.byte(15u8);
        if from == 1u8 { c.byte(190u8); } else { c.byte(191u8); }   // 0F BE, 0F BF
    }
    modrm(c, 3u8, dst, src);
}

/// `movsx dst, [m]` (`movsxd` from 4 bytes).
pub movsx_rm :: fn(c: *Code, size: u8, dst: u8, from: u8, m: Mem) {
    size_prefix(c, size);
    rex_mem(c, size == 8u8, dst, m, false);
    if from == 4u8 { c.byte(99u8); }
    else {
        c.byte(15u8);
        if from == 1u8 { c.byte(190u8); } else { c.byte(191u8); }
    }
    mem_operand(c, dst, m);
}

// Arithmetic

/// `op dst, src` for `op` one of `ALU_ADD` to `ALU_CMP`.
pub alu_rr :: fn(c: *Code, op: u8, size: u8, dst: u8, src: u8) {
    op_rr(c, size, op << 3u8, (op << 3u8) + 1u8, src, dst);   // 00+8op, 01+8op /r
}

/// `op dst, [m]`.
pub alu_rm :: fn(c: *Code, op: u8, size: u8, dst: u8, m: Mem) {
    op_rm(c, size, (op << 3u8) + 2u8, (op << 3u8) + 3u8, dst, m);   // 02+8op, 03+8op /r
}

/// `op [m], src`.
pub alu_mr :: fn(c: *Code, op: u8, size: u8, m: Mem, src: u8) {
    op_rm(c, size, op << 3u8, (op << 3u8) + 1u8, src, m);
}

/// `op dst, imm`, with an 8-bit immediate where it fits, and the short form for `al`/`ax`/`eax`/`rax`.
pub alu_ri :: fn(c: *Code, op: u8, size: u8, dst: u8, v: i64) {
    size_prefix(c, size);
    rex(c, size == 8u8, 0u8, 0u8, dst, byte_needs_rex(size, dst));
    if size == 1u8 && dst == RAX { c.byte(op * 8u8 + 4u8); c.byte(((v as i32) as i8) as u8); return; }   // 04+8op ib
    if size == 1u8 { c.byte(128u8); modrm(c, 3u8, op, dst); c.byte(((v as i32) as i8) as u8); return; }   // 80 /op ib
    if fits_i8(v) { c.byte(131u8); modrm(c, 3u8, op, dst); c.byte((v as i8) as u8); return; }   // 83 /op ib
    if dst == RAX { c.byte(op * 8u8 + 5u8); imm_of(c, size, v); return; }   // 05+8op iw/id
    c.byte(129u8);   // 81 /op iw/id
    modrm(c, 3u8, op, dst);
    imm_of(c, size, v);
}

/// `op [m], imm`.
pub alu_mi :: fn(c: *Code, op: u8, size: u8, m: Mem, v: i64) {
    size_prefix(c, size);
    rex_mem(c, size == 8u8, 0u8, m, false);
    if size == 1u8 { c.byte(128u8); mem_operand(c, op, m); c.byte(((v as i32) as i8) as u8); return; }
    if fits_i8(v) { c.byte(131u8); mem_operand(c, op, m); c.byte((v as i8) as u8); return; }
    c.byte(129u8);
    mem_operand(c, op, m);
    imm_of(c, size, v);
}

/// `test a, b`.
pub test_rr :: fn(c: *Code, size: u8, a: u8, b: u8) { op_rr(c, size, 132u8, 133u8, b, a); }   // 84, 85 /r

/// `test r, imm`.
pub test_ri :: fn(c: *Code, size: u8, r: u8, v: i64) {
    size_prefix(c, size);
    rex(c, size == 8u8, 0u8, 0u8, r, byte_needs_rex(size, r));
    if r == RAX {
        if size == 1u8 { c.byte(168u8); } else { c.byte(169u8); }   // A8 ib, A9 iw/id
        imm_of(c, size, v);
        return;
    }
    if size == 1u8 { c.byte(246u8); } else { c.byte(247u8); }   // F6, F7 /0
    modrm(c, 3u8, 0u8, r);
    imm_of(c, size, v);
}

/// `imul dst, src`.
pub imul_rr :: fn(c: *Code, size: u8, dst: u8, src: u8) {
    size_prefix(c, size);
    rex(c, size == 8u8, dst, 0u8, src, false);
    c.byte(15u8);
    c.byte(175u8);   // 0F AF /r
    modrm(c, 3u8, dst, src);
}

/// `imul dst, src, imm`.
pub imul_rri :: fn(c: *Code, size: u8, dst: u8, src: u8, v: i64) {
    size_prefix(c, size);
    rex(c, size == 8u8, dst, 0u8, src, false);
    if fits_i8(v) { c.byte(107u8); modrm(c, 3u8, dst, src); c.byte((v as i8) as u8); return; }   // 6B /r ib
    c.byte(105u8);   // 69 /r id
    modrm(c, 3u8, dst, src);
    imm_of(c, size, v);
}

/// The one-operand group F7 (F6 for 8 bits): `/2` not, `/3` neg, `/4` mul, `/5` imul, `/6`
/// div, `/7` idiv.
unary :: fn(c: *Code, digit: u8, size: u8, r: u8) {
    size_prefix(c, size);
    rex(c, size == 8u8, 0u8, 0u8, r, byte_needs_rex(size, r));
    if size == 1u8 { c.byte(246u8); } else { c.byte(247u8); }
    modrm(c, 3u8, digit, r);
}

pub not_r :: fn(c: *Code, size: u8, r: u8) { unary(c, 2u8, size, r); }
pub neg_r :: fn(c: *Code, size: u8, r: u8) { unary(c, 3u8, size, r); }
/// `mul r`: rdx:rax = rax * r, unsigned.
pub mul_r :: fn(c: *Code, size: u8, r: u8) { unary(c, 4u8, size, r); }
/// `div r`: rax = rdx:rax / r, rdx = the remainder, unsigned.
pub div_r :: fn(c: *Code, size: u8, r: u8) { unary(c, 6u8, size, r); }
/// `idiv r`: the same, signed.
pub idiv_r :: fn(c: *Code, size: u8, r: u8) { unary(c, 7u8, size, r); }

/// `cqo` (64 bits) or `cdq` (32): rdx gets the sign of rax, before `idiv`.
pub sign_extend_rax :: fn(c: *Code, size: u8) {
    if size == 8u8 { c.byte(72u8); }   // REX.W
    c.byte(153u8);   // 99
}

/// `shift r, cl`.
pub shift_cl :: fn(c: *Code, op: u8, size: u8, r: u8) {
    size_prefix(c, size);
    rex(c, size == 8u8, 0u8, 0u8, r, byte_needs_rex(size, r));
    if size == 1u8 { c.byte(210u8); } else { c.byte(211u8); }   // D2, D3 /op
    modrm(c, 3u8, op, r);
}

/// `shift r, n` (the one-byte form for a shift by 1).
pub shift_ri :: fn(c: *Code, op: u8, size: u8, r: u8, n: u8) {
    size_prefix(c, size);
    rex(c, size == 8u8, 0u8, 0u8, r, byte_needs_rex(size, r));
    if n == 1u8 {
        if size == 1u8 { c.byte(208u8); } else { c.byte(209u8); }   // D0, D1 /op
        modrm(c, 3u8, op, r);
        return;
    }
    if size == 1u8 { c.byte(192u8); } else { c.byte(193u8); }   // C0, C1 /op ib
    modrm(c, 3u8, op, r);
    c.byte(n);
}

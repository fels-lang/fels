#test
arithmetic :: fn(t: *Test) {
    a := heap::make();
    c := x64::code(&a);
    x64::alu_rr(&c, x64::ALU_ADD, 8, x64::RAX, x64::RCX);
    check(t, &c, &a, "add rax, rcx", "4801c8");
    x64::alu_rr(&c, x64::ALU_SUB, 4, x64::R8, x64::RDX);
    check(t, &c, &a, "sub r8d, edx", "4129d0");
    x64::alu_rr(&c, x64::ALU_XOR, 4, x64::RAX, x64::RAX);
    check(t, &c, &a, "xor eax, eax", "31c0");
    x64::alu_rr(&c, x64::ALU_CMP, 8, x64::RCX, x64::R11);
    check(t, &c, &a, "cmp rcx, r11", "4c39d9");
    x64::alu_rr(&c, x64::ALU_AND, 1, x64::RSI, x64::RAX);
    check(t, &c, &a, "and sil, al", "4020c6");
    x64::alu_rr(&c, x64::ALU_OR, 2, x64::RCX, x64::RDX);
    check(t, &c, &a, "or cx, dx", "6609d1");
    x64::alu_rm(&c, x64::ALU_ADD, 4, x64::RAX, x64::at(x64::RBP, -28));
    check(t, &c, &a, "add eax, dword ptr [rbp - 28]", "0345e4");
    x64::alu_rm(&c, x64::ALU_CMP, 8, x64::RCX, x64::at(x64::RBP, -8));
    check(t, &c, &a, "cmp rcx, qword ptr [rbp - 8]", "483b4df8");
    x64::alu_mr(&c, x64::ALU_ADD, 8, x64::at(x64::RAX, 0), x64::RCX);
    check(t, &c, &a, "add qword ptr [rax], rcx", "480108");
    x64::alu_ri(&c, x64::ALU_ADD, 8, x64::RSP, 8);
    check(t, &c, &a, "add rsp, 8", "4883c408");
    x64::alu_ri(&c, x64::ALU_SUB, 8, x64::RSP, 4096);
    check(t, &c, &a, "sub rsp, 4096", "4881ec00100000");
    x64::alu_ri(&c, x64::ALU_CMP, 4, x64::RAX, 127);
    check(t, &c, &a, "cmp eax, 127", "83f87f");
    x64::alu_ri(&c, x64::ALU_CMP, 4, x64::RAX, 128);
    check(t, &c, &a, "cmp eax, 128", "3d80000000");
    x64::alu_ri(&c, x64::ALU_AND, 8, x64::R9, -128);
    check(t, &c, &a, "and r9, -128", "4983e180");
    x64::alu_ri(&c, x64::ALU_AND, 8, x64::R9, -129);
    check(t, &c, &a, "and r9, -129", "4981e17fffffff");
    x64::alu_ri(&c, x64::ALU_XOR, 1, x64::RDI, 1);
    check(t, &c, &a, "xor dil, 1", "4080f701");
    x64::alu_ri(&c, x64::ALU_OR, 2, x64::RAX, 1000);
    check(t, &c, &a, "or ax, 1000", "660de803");
    x64::alu_ri(&c, x64::ALU_ADD, 1, x64::RAX, 1);
    check(t, &c, &a, "add al, 1", "0401");
    x64::alu_ri(&c, x64::ALU_SUB, 8, x64::RAX, 300);
    check(t, &c, &a, "sub rax, 300", "482d2c010000");
    x64::alu_ri(&c, x64::ALU_ADD, 4, x64::RAX, 3);
    check(t, &c, &a, "add eax, 3", "83c003");
    x64::alu_ri(&c, x64::ALU_CMP, 4, x64::RCX, 128);
    check(t, &c, &a, "cmp ecx, 128", "81f980000000");
    x64::alu_mi(&c, x64::ALU_ADD, 4, x64::at(x64::RBP, -12), 1);
    check(t, &c, &a, "add dword ptr [rbp - 12], 1", "8345f401");
    x64::alu_mi(&c, x64::ALU_CMP, 8, x64::at(x64::RSP, 16), 100000);
    check(t, &c, &a, "cmp qword ptr [rsp + 16], 100000", "48817c2410a0860100");
    x64::test_rr(&c, 8, x64::RAX, x64::RAX);
    check(t, &c, &a, "test rax, rax", "4885c0");
    x64::test_rr(&c, 4, x64::RDX, x64::RDX);
    check(t, &c, &a, "test edx, edx", "85d2");
    x64::test_rr(&c, 1, x64::RSI, x64::RSI);
    check(t, &c, &a, "test sil, sil", "4084f6");
    x64::test_ri(&c, 4, x64::RAX, 1);
    check(t, &c, &a, "test eax, 1", "a901000000");
    x64::test_ri(&c, 1, x64::RCX, 128);
    check(t, &c, &a, "test cl, -128", "f6c180");
    x64::test_ri(&c, 1, x64::RAX, 1);
    check(t, &c, &a, "test al, 1", "a801");
    x64::test_ri(&c, 8, x64::RAX, 255);
    check(t, &c, &a, "test rax, 255", "48a9ff000000");
    x64::test_ri(&c, 4, x64::R8, 1);
    check(t, &c, &a, "test r8d, 1", "41f7c001000000");
    x64::imul_rr(&c, 8, x64::RAX, x64::RCX);
    check(t, &c, &a, "imul rax, rcx", "480fafc1");
    x64::imul_rr(&c, 4, x64::R12, x64::R13);
    check(t, &c, &a, "imul r12d, r13d", "450fafe5");
    x64::imul_rri(&c, 8, x64::RAX, x64::RCX, 31);
    check(t, &c, &a, "imul rax, rcx, 31", "486bc11f");
    x64::imul_rri(&c, 4, x64::RDX, x64::RDX, 1000);
    check(t, &c, &a, "imul edx, edx, 1000", "69d2e8030000");
    x64::not_r(&c, 8, x64::RAX);
    check(t, &c, &a, "not rax", "48f7d0");
    x64::neg_r(&c, 4, x64::R10);
    check(t, &c, &a, "neg r10d", "41f7da");
    x64::mul_r(&c, 8, x64::RCX);
    check(t, &c, &a, "mul rcx", "48f7e1");
    x64::div_r(&c, 4, x64::RBX);
    check(t, &c, &a, "div ebx", "f7f3");
    x64::idiv_r(&c, 8, x64::R8);
    check(t, &c, &a, "idiv r8", "49f7f8");
    x64::sign_extend_rax(&c, 8);
    check(t, &c, &a, "cqo", "4899");
    x64::sign_extend_rax(&c, 4);
    check(t, &c, &a, "cdq", "99");
    x64::shift_cl(&c, x64::SH_SHL, 8, x64::RAX);
    check(t, &c, &a, "shl rax, cl", "48d3e0");
    x64::shift_cl(&c, x64::SH_SAR, 4, x64::RDX);
    check(t, &c, &a, "sar edx, cl", "d3fa");
    x64::shift_ri(&c, x64::SH_SHR, 8, x64::RAX, 1);
    check(t, &c, &a, "shr rax, 1", "48d1e8");
    x64::shift_ri(&c, x64::SH_SHL, 4, x64::R9, 3);
    check(t, &c, &a, "shl r9d, 3", "41c1e103");
    x64::shift_ri(&c, x64::SH_SAR, 8, x64::RCX, 63);
    check(t, &c, &a, "sar rcx, 63", "48c1f93f");
    x64::shift_ri(&c, x64::SH_ROL, 1, x64::RAX, 4);
    check(t, &c, &a, "rol al, 4", "c0c004");
}

#test
control :: fn(t: *Test) {
    a := heap::make();
    c := x64::code(&a);
    x64::push_r(&c, x64::RBP);
    check(t, &c, &a, "push rbp", "55");
    x64::push_r(&c, x64::R12);
    check(t, &c, &a, "push r12", "4154");
    x64::pop_r(&c, x64::RBX);
    check(t, &c, &a, "pop rbx", "5b");
    x64::pop_r(&c, x64::R15);
    check(t, &c, &a, "pop r15", "415f");
    x64::ret(&c);
    check(t, &c, &a, "ret", "c3");
    x64::leave(&c);
    check(t, &c, &a, "leave", "c9");
    x64::int3(&c);
    check(t, &c, &a, "int3", "cc");
    x64::ud2(&c);
    check(t, &c, &a, "ud2", "0f0b");
    x64::syscall(&c);
    check(t, &c, &a, "syscall", "0f05");
    x64::nop(&c);
    check(t, &c, &a, "nop", "90");
    x64::call_r(&c, x64::RAX);
    check(t, &c, &a, "call rax", "ffd0");
    x64::call_r(&c, x64::R11);
    check(t, &c, &a, "call r11", "41ffd3");
    x64::call_m(&c, x64::at(x64::RIP, 64));
    check(t, &c, &a, "call qword ptr [rip + 64]", "ff1540000000");
    x64::jmp_r(&c, x64::RCX);
    check(t, &c, &a, "jmp rcx", "ffe1");
    x64::setcc(&c, x64::CC_E, x64::RAX);
    check(t, &c, &a, "sete al", "0f94c0");
    x64::setcc(&c, x64::CC_L, x64::RSI);
    check(t, &c, &a, "setl sil", "400f9cc6");
    x64::setcc(&c, x64::CC_A, x64::R9);
    check(t, &c, &a, "seta r9b", "410f97c1");
    x64::cmovcc(&c, x64::CC_NE, 8, x64::RAX, x64::RCX);
    check(t, &c, &a, "cmovne rax, rcx", "480f45c1");
    x64::cmovcc(&c, x64::CC_GE, 4, x64::R8, x64::RDX);
    check(t, &c, &a, "cmovge r8d, edx", "440f4dc2");
    x64::rep_movsb(&c);
    check(t, &c, &a, "rep movsb byte ptr es:[rdi], byte ptr [rsi]", "f3a4");
    x64::rep_stosb(&c);
    check(t, &c, &a, "rep stosb byte ptr es:[rdi], al", "f3aa");
}

#test
floats :: fn(t: *Test) {
    a := heap::make();
    c := x64::code(&a);
    x64::fmov_xx(&c, 8, x64::XMM0, x64::XMM1);
    check(t, &c, &a, "movsd xmm0, xmm1", "f20f10c1");
    x64::fmov_xx(&c, 4, x64::XMM8, x64::XMM2);
    check(t, &c, &a, "movss xmm8, xmm2", "f3440f10c2");
    x64::fmov_xm(&c, 8, x64::XMM1, x64::at(x64::RBP, -16));
    check(t, &c, &a, "movsd xmm1, qword ptr [rbp - 16]", "f20f104df0");
    x64::fmov_mx(&c, 8, x64::at(x64::RSP, 8), x64::XMM15);
    check(t, &c, &a, "movsd qword ptr [rsp + 8], xmm15", "f2440f117c2408");
    x64::fmov_mx(&c, 4, x64::at(x64::RAX, 0), x64::XMM3);
    check(t, &c, &a, "movss dword ptr [rax], xmm3", "f30f1118");
    x64::fop_xx(&c, x64::FP_ADD, 8, x64::XMM0, x64::XMM1);
    check(t, &c, &a, "addsd xmm0, xmm1", "f20f58c1");
    x64::fop_xx(&c, x64::FP_MUL, 4, x64::XMM2, x64::XMM3);
    check(t, &c, &a, "mulss xmm2, xmm3", "f30f59d3");
    x64::fop_xx(&c, x64::FP_SUB, 8, x64::XMM8, x64::XMM0);
    check(t, &c, &a, "subsd xmm8, xmm0", "f2440f5cc0");
    x64::fop_xx(&c, x64::FP_DIV, 8, x64::XMM4, x64::XMM15);
    check(t, &c, &a, "divsd xmm4, xmm15", "f2410f5ee7");
    x64::fop_xx(&c, x64::FP_SQRT, 8, x64::XMM0, x64::XMM0);
    check(t, &c, &a, "sqrtsd xmm0, xmm0", "f20f51c0");
    x64::fop_xx(&c, x64::FP_MIN, 4, x64::XMM1, x64::XMM2);
    check(t, &c, &a, "minss xmm1, xmm2", "f30f5dca");
    x64::fop_xm(&c, x64::FP_ADD, 8, x64::XMM0, x64::at(x64::RBP, -24));
    check(t, &c, &a, "addsd xmm0, qword ptr [rbp - 24]", "f20f5845e8");
    x64::fcmp_xx(&c, 8, x64::XMM0, x64::XMM1);
    check(t, &c, &a, "ucomisd xmm0, xmm1", "660f2ec1");
    x64::fcmp_xx(&c, 4, x64::XMM8, x64::XMM2);
    check(t, &c, &a, "ucomiss xmm8, xmm2", "440f2ec2");
    x64::cvt_int_to_fp(&c, 8, 8, x64::XMM0, x64::RAX);
    check(t, &c, &a, "cvtsi2sd xmm0, rax", "f2480f2ac0");
    x64::cvt_int_to_fp(&c, 8, 4, x64::XMM1, x64::RCX);
    check(t, &c, &a, "cvtsi2sd xmm1, ecx", "f20f2ac9");
    x64::cvt_int_to_fp(&c, 4, 8, x64::XMM8, x64::R9);
    check(t, &c, &a, "cvtsi2ss xmm8, r9", "f34d0f2ac1");
    x64::cvt_fp_to_int(&c, 8, 8, x64::RAX, x64::XMM0);
    check(t, &c, &a, "cvttsd2si rax, xmm0", "f2480f2cc0");
    x64::cvt_fp_to_int(&c, 4, 4, x64::RDX, x64::XMM9);
    check(t, &c, &a, "cvttss2si edx, xmm9", "f3410f2cd1");
    x64::cvt_fp_to_fp(&c, 8, x64::XMM0, x64::XMM1);
    check(t, &c, &a, "cvtss2sd xmm0, xmm1", "f30f5ac1");
    x64::cvt_fp_to_fp(&c, 4, x64::XMM2, x64::XMM3);
    check(t, &c, &a, "cvtsd2ss xmm2, xmm3", "f20f5ad3");
    x64::movq_xr(&c, x64::XMM0, x64::RAX);
    check(t, &c, &a, "movq xmm0, rax", "66480f6ec0");
    x64::movq_rx(&c, x64::RCX, x64::XMM1);
    check(t, &c, &a, "movq rcx, xmm1", "66480f7ec9");
    x64::movq_xr(&c, x64::XMM8, x64::R10);
    check(t, &c, &a, "movq xmm8, r10", "664d0f6ec2");
    x64::fxor_xx(&c, 8, x64::XMM0, x64::XMM0);
    check(t, &c, &a, "xorpd xmm0, xmm0", "660f57c0");
    x64::fxor_xx(&c, 4, x64::XMM1, x64::XMM9);
    check(t, &c, &a, "xorps xmm1, xmm9", "410f57c9");
}

#test
a_loop_jumps_back_and_out :: fn(t: *Test) {
    a := heap::make();
    c := x64::code(&a);
    top := c.new_label();
    out := c.new_label();
    c.bind(top);
    x64::alu_rr(&c, x64::ALU_ADD, 8, x64::RAX, x64::RCX);
    x64::jcc(&c, x64::CC_E, out);
    x64::jmp(&c, top);
    c.bind(out);
    x64::ret(&c);
    c.finish();
    // add rax, rcx; je +5; jmp -14; ret
    check(t, &c, &a, "loop", "4801c80f8405000000e9f2ffffffc3");
}

#test
a_jump_to_the_next_instruction_goes_no_distance :: fn(t: *Test) {
    a := heap::make();
    c := x64::code(&a);
    next := c.new_label();
    x64::jmp(&c, next);
    c.bind(next);
    x64::jcc(&c, x64::CC_NE, next);
    c.finish();
    check(t, &c, &a, "jmp next; jne next", "e9000000000f85faffffff");
}

#test
a_call_is_patched_by_its_caller :: fn(t: *Test) {
    a := heap::make();
    c := x64::code(&a);
    x64::push_r(&c, x64::RBP);
    at := x64::call_rel32(&c);
    t.eq(at, 2);
    c.patch32(at, 4294967289u32);
    check(t, &c, &a, "push rbp; call -7", "55e8f9ffffff");
}

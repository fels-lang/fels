// capability: a bare #run is pure; dep code can't reach the host while you build
// try: uncomment `PID` below, `fels build` -> comptime FFI error; build.fels may call it

#import std.io.{ println };

#extern("kernel32", "GetCurrentProcessId")
current_pid :: fn() -> u32;

// PID :: #run current_pid();

#entry
main :: fn() -> i32 {
    println("built — and nothing in this file touched your machine to get here");
    return 0;
}

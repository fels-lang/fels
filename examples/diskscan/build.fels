// diskscan: multithreaded disk-usage analyzer; cli + win32 gui share one scanner
// run: fels build [run|gui] [-Ddebug]; output in ./out
#import std.build.{ Build, Optimize, executable, optimize, release, debug,
                    subsystem, console, windowed, version, description,
                    install, out_dir, run_step, option, summary };

VERSION :: "0.1.0";

build :: fn(b: Build) {
    dev: bool = b.option("debug");

    // cli: console subsystem
    cli := b.executable("diskscan", "src/cli.fels");
    cli.description("Fast multithreaded disk-usage analyzer (CLI)");
    cli.version(VERSION);
    cli.console();
    cli.out_dir("out");
    if dev { cli.debug(); } else { cli.release(); }
    cli.install();

    // gui: windowed, no console
    gui := b.executable("diskscan-gui", "src/gui.fels");
    gui.description("Disk-usage analyzer with a native browser GUI");
    gui.version(VERSION);
    gui.windowed();
    gui.out_dir("out");
    if dev { gui.debug(); } else { gui.release(); }
    gui.install();

    // no default: bare `fels build` builds both
    b.run_step("run", cli);     // cli on the current dir
    b.run_step("gui", gui);     // launch the gui
    b.summary();
}

// The smallest shared library Fels can produce. No `#entry`, no `main` — a DLL
// is a bag of exported symbols, and a host resolves them by name.
//
// This exists to prove the plumbing a native plugin needs: `b.shared` emits a real DLL,
// `#export` puts a symbol in its export table, and a host process can find it and use it.
// Both kinds of symbol are exported here: functions, and data.

#export("gab_add")
gab_add :: fn(a: i32, b: i32) -> i32 { return a + b; }

#export("gab_version")
gab_version :: fn() -> u32 { return 101u32; }

// A plain exported global. The host reads it through the address it resolves; the functions
// below write it.
#export("gab_calls")
calls: i32 = 0;

// An entry point that is data. A plugin host looks up one name and reads a struct of version
// numbers and function pointers from it (that is what CLAP's `clap_entry` is). The struct is
// laid out in the image at build time — the function addresses are fixed by the linker and
// the loader — and nothing in this library runs to build the table.
Version :: struct { major: u32, minor: u32, revision: u32 }

PluginEntry :: struct {
    version: Version,
    init:    extern fn(u32) -> u32,
    scale:   extern fn(i32) -> i32,
    deinit:  extern fn(),
}

plugin_init :: fn(host_api: u32) -> u32 { calls += 1; return host_api + 1u32; }
plugin_scale :: fn(x: i32) -> i32 { calls += 1; return x * 3; }
plugin_deinit :: fn() { calls = 0; }

#export("gab_entry")
ENTRY: PluginEntry = .{ .{ 1u32, 2u32, 0u32 }, plugin_init, plugin_scale, plugin_deinit };

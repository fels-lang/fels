// dll: minimal shared lib; no #entry, just #export'ed fns + data a host finds by name

#export("gab_add")
gab_add :: fn(a: i32, b: i32) -> i32 { return a + b; }

#export("gab_version")
gab_version :: fn() -> u32 { return 101u32; }

// exported global; the host reads it, the fns below write it
#export("gab_calls")
calls: i32 = 0;

// data entry point (like CLAP's `clap_entry`); table laid out at build time, no init code
Version :: struct { major: u32, minor: u32, revision: u32 }

PluginEntry :: struct {
    version: Version,
    init:    extern fn(u32) -> u32,
    scale:   extern fn(i32) -> i32,
    deinit:  extern fn(),
}

plugin_init :: fn(host_api: u32) -> u32 { calls += 1; return host_api + 1u32; }
plugin_scale :: fn(x: i32) -> i32 { calls += 1; return x * 3; }
plugin_deinit :: fn() { calls = 0; }

#export("gab_entry")
ENTRY: PluginEntry = .{ .{ 1u32, 2u32, 0u32 }, plugin_init, plugin_scale, plugin_deinit };

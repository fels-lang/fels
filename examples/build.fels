// example build script for `fels build`; design in docs/10_build_system.md

#import std.build.{ Build, executable, shared, release, debug, link, lib_path,
                    output, define, require_path, depend, run_step, test_dir, default };

build :: fn(b: Build) {
    game := b.executable("game", "src/main.fels");
    game.release();
    game.link("raylib");
    game.link("user32");
    game.lib_path("vendor/raylib/lib");
    game.output("bin/game.exe");
    game.define("MAX_ENTITIES", "4096");

    // build-time dep; its build.fels runs sandboxed
    rl := b.require_path("raylib", "vendor/raylib");
    game.depend(rl);

    // hot-reloadable gameplay dll
    logic := b.shared("logic", "src/logic.fels");
    logic.debug();
    logic.output("bin/logic.dll");

    // `fels build run`, `fels build test`
    b.run_step("run", game);
    b.test_dir("test", "tests/");

    // bare `fels build`
    b.default(game);
}
